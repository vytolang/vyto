// vyto/hw/usb and vyto/hw/sdr properties that hold on any machine: the list
// itself is machine-specific, the shape of each entry is not.
import { usb_devices } from "vyto/hw/usb";
import { sdr_devices } from "vyto/hw/sdr";
import { platform } from "vyto/os";

fn main() {
    let devs = usb_devices();
    let ids = true;
    let fmt = true;
    for (let d in devs) {
        if (d.vid < 0 || d.vid > 0xFFFF || d.pid < 0 || d.pid > 0xFFFF) { ids = false; }
        let id = d.id();
        if (id.len != 9 || id[4] != 58) { fmt = false; }       // "vvvv:pppp"
        if (d.name() == "") { fmt = false; }
    }
    print(`ids are 16-bit: {ids}`);
    print(`id() is vvvv:pppp and name() is never empty: {fmt}`);
    // Every SDR found is one of the USB devices.
    let sub = true;
    for (let r in sdr_devices()) {
        let found = false;
        for (let d in devs) { if (d.vid == r.vid && d.pid == r.pid) { found = true; } }
        if (!found) { sub = false; }
    }
    print(`sdr devices come from the usb list: {sub}`);
    // Transfers are usbfs: nothing to open on Windows.
    let open_ok = true;
    if (platform() == "windows" && devs.len > 0) { open_ok = devs[0].open() == null; }
    print(`open() is null where transfers are not supported: {open_ok}`);
}
