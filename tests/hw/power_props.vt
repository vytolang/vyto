// vyto/hw/power properties that hold on any machine, battery or not: the
// values are machine-specific, their shape is not. On Windows the supplies can
// only be AC and BAT0 and there are no thermal zones.
import { power_supplies, thermal_zones } from "vyto/hw/power";
import { platform } from "vyto/os";

fn main() {
    let ok_kind = true;
    let ok_cap = true;
    let ok_status = true;
    let ok_names = true;
    let statuses = ["Charging", "Discharging", "Full", "Not charging", "Unknown"];
    for (let s in power_supplies()) {
        if (s.name == "" || s.kind() == "") { ok_kind = false; }
        if (s.isBattery()) {
            let c = s.capacity();
            if (c < -1 || c > 100) { ok_cap = false; }
            let st = s.status();
            let known = st == "";
            for (let k in statuses) { if (st == k) { known = true; } }
            if (!known) { ok_status = false; }
        }
        if (platform() == "windows" && s.name != "AC" && s.name != "BAT0") { ok_names = false; }
    }
    print(`every supply has a name and a type: {ok_kind}`);
    print(`battery capacity is -1..100: {ok_cap}`);
    print(`battery status is a known word: {ok_status}`);
    print(`windows names are AC and BAT0: {ok_names}`);
    let zones_ok = true;
    if (platform() == "windows") { zones_ok = thermal_zones().len == 0; }
    print(`thermal zones only where sysfs has them: {zones_ok}`);
}
