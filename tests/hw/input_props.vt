// vyto/hw/input properties that hold on any machine: entries are well-formed,
// and a listed device that opens has a pollable fd and drains without blocking.
// (Linux lists only nodes this user may open, so the list may be empty there.)
import { input_devices, input_open } from "vyto/hw/input";

fn main() {
    let devs = input_devices();
    let shape = true;
    for (let d in devs) {
        if (d.path == "" || d.name == "" || d.id().len != 9) { shape = false; }
    }
    print(`entries have a path, a name and an id: {shape}`);
    let opened = true;
    if (devs.len > 0) {
        let dev = input_open(devs[0].path);
        if (dev == null) {
            opened = false;
        } else {
            opened = dev.pollFd() >= 0 && dev.isValid();
            dev.drain();
            dev.close();
            opened = opened && !dev.isValid();
        }
    }
    print(`a listed device opens, polls and closes: {opened}`);
    print(`an unknown path does not open: {input_open("vyto-no-such-device") == null}`);
}
