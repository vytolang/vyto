// vyto/desktop/service on Windows, end to end (run_tests_wine.sh drives it;
// on a real box run the same commands from an administrator prompt):
//
//   service_demo.exe install     register this exe as service "VytoDemoSvc"
//   service_demo.exe start       ask the SCM to start it
//   service_demo.exe state       -1 not installed, 1 stopped, 4 running
//   service_demo.exe stop
//   service_demo.exe uninstall
//
// With no argument it is the service itself: started by the SCM it logs to
// %ProgramData%\VytoDemoSvc\VytoDemoSvc.log ("started", a heartbeat, then
// "stopped" when asked); started from a console it runs until Ctrl+C.
import { Service, serviceInstall, serviceUninstall, serviceStart, serviceStop,
         serviceState, serviceError, START_MANUAL } from "vyto/desktop/service";

fn main() {
    let a = args();
    let name = "VytoDemoSvc";
    if (a.len > 0) {
        let ok = true;
        if (a[0] == "install") {
            ok = serviceInstall(name, "Vyto Demo Service", "vyto/desktop/service test",
                                "", "", START_MANUAL);
        } else if (a[0] == "uninstall") {
            ok = serviceUninstall(name);
        } else if (a[0] == "start") {
            ok = serviceStart(name);
        } else if (a[0] == "stop") {
            ok = serviceStop(name);
        } else if (a[0] == "state") {
            print(`state: {serviceState(name)}`);
            return;
        }
        if (ok) { print(`{a[0]}: ok`); } else { print(`{a[0]}: FAILED {serviceError()}`); }
        return;
    }
    let svc = new Service(name);
    svc.run(() => {
        svc.log(`started (service: {svc.isService()})`);
        let beats = 0;
        while (!svc.wait(500)) { beats += 1; }
        svc.log(`stopped after {beats} heartbeat(s)`);
    });
}
