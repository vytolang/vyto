// The --manifest for service_demo's installer test: the installer registers
// the exe as service VytoDemoSvc and starts it.
import { WinManifest } from "vyto/win/manifest";

fn main() {
    new WinManifest("Vyto Demo Service")
        .version("1.2.3")
        .company("Vyto Tests")
        .service("VytoDemoSvc", "Vyto Demo Service", "vyto/desktop/service installer test", "auto")
        .emit();
}
