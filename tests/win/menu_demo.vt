// vyto/desktop/menu on Windows: the real Win32 menu bar.
//
// run_tests_wine.sh drives it with xdotool (Alt+letter, arrows, Enter go to
// the OS menu, exactly as a person's keys would); on a Windows box, run it from
// cmd and use the menus — every choice is logged to stdout.
//
// What to check by hand:
//   - a native menu bar (File, Edit, Window), not a drawn strip, and the
//     window's client area is still 420x260 (the window grew by the bar)
//   - File shows "Ctrl+N" right-aligned beside New, a separator, a greyed
//     "Disabled", and a ▸ on Open Recent that cascades
//   - Alt+F opens File; underlines appear on the access keys
//   - Edit > Word Wrap gets a check mark; ticking it greys out File > New
//   - Ctrl+N fires New with the menus closed (the shortcut is Vyto's)
//   - File > Exit (Alt+F4 shown, as a hint) closes the window
import { Window, Column, Label } from "vyto/ui";
import { AppMenu } from "vyto/desktop/menu";

fn main() {
    let win = new Window("Vyto Menu", 420, 260);
    let menus = new AppMenu(win);
    let file = menus.file();
    let nw = file.item("&New", "Ctrl+N", () => print("fire:new client="
        + win.surface().width() + "x" + win.surface().height()));
    let recent = file.submenu("Open &Recent");
    recent.item("&a.txt", "", () => print("fire:recent a.txt"));
    recent.item("&b.txt", "", () => print("fire:recent b.txt"));
    file.separator();
    file.item("&Disabled", "", () => print("WRONG: disabled fired")).set_enabled(false);
    file.separator();
    menus.addQuit(file);
    menus.edit().check("Word &Wrap", "", false, (on) => {
        print("wrap=" + on);
        nw.set_enabled(!on);
    });
    menus.addFullScreen(menus.window());
    win.root = new Column([new Label("The menu bar above is the OS's own.")]);
    print("native=" + menus.attach());
    win.run();
    print("done");
}
