// HTTPS through vyto/net against a local test server, for the Windows build's
// vendored curl + mbedTLS (tests/run_tests_wine.sh drives it). Prints the
// status and whether the request succeeded; a failed TLS verification is a
// status of 0 and ok=false, never a silent success.
//
//   HTTPS_URL  the URL to fetch
//   HTTPS_CA   optional PEM bundle for http_set_ca_file (may be non-ASCII)
import { getenv } from "vyto/os";
import { http_get, http_set_ca_file } from "vyto/net/http";

fn main() {
    let ca = getenv("HTTPS_CA");
    if (ca != "") { http_set_ca_file(ca); }
    let r = http_get(getenv("HTTPS_URL")).send();
    print(`status={r.status()} ok={r.ok()}`);
}
