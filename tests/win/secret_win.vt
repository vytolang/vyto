// vyto/desktop/secret on Windows (staged by run_tests_win.sh): DPAPI is
// available, the file holds a DPAPI blob rather than the plain text, and it
// reads back for the same user. A file from another OS reads as nothing.
import { secret_save, secret_load, secret_found, secret_private, secret_remove, secret_encrypted } from "vyto/desktop/secret";
import { readfile, file_exists, file_remove, writefile } from "vyto/io/file";

fn main() {
    let p = "secret_win.sec";
    if (file_exists(p)) { file_remove(p); }
    print(`encrypted: {secret_encrypted()}`);
    print(`saved: {secret_save(p, "passkey-Zoë-123")}`);
    let raw = readfile(p);
    print(`dpapi header: {raw.starts_with("VTSEC1 D")}`);
    print(`plain text absent: {!raw.contains("passkey")}`);
    let got = secret_load(p);
    print("loaded: " + got + ` found={secret_found()}`);
    print(`private: {secret_private(p)}`);
    // a POSIX-format file (plain) is not trusted on Windows
    writefile(p, "VTSEC1 P\nleaked");
    let x = secret_load(p);
    print(`plain-format file: [{x}] found={secret_found()}`);
    print(`removed: {secret_remove(p)}`);
}
