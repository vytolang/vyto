// vyto/desktop's per-user folders on Windows (staged by run_tests_win.sh):
// SHGetKnownFolderPath's Roaming and Local AppData with the app name joined
// on. The folders' names depend on the Windows version and the account
// (Windows 7+ say AppData\Roaming; Wine and XP say Application Data), so
// the structure is what is checked, not the spelling.
import { configDir, dataDir, cacheDir } from "vyto/desktop";

fn absolute(p: string): bool { return p.len > 3 && p[1] == 58 && p[2] == 92; }  // "C:\"

fn main() {
    let c = configDir("myapp");
    let d = dataDir("myapp");
    let k = cacheDir("myapp");
    print(`absolute: {absolute(c) && absolute(d)}`);
    print(`app name joined: {c.ends_with("\\myapp") && d.ends_with("\\myapp")}`);
    print(`cache under data: {k == d + "\\cache"}`);
    print(`roaming is not local: {c != d}`);
    print(`bad name: [{configDir("..\\x")}]`);
}
