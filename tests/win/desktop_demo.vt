// vyto/desktop on Windows, one dialog after another. Staged by
// run_tests_win.sh; run_tests_wine.sh answers each dialog with xdotool, and on
// a real Windows box a person does (README in the staging dir). Each dialog
// has a fixed title so a script can find it; each result is printed.
//
// With the argument "window", a window is opened first and every dialog is
// owned by it — the check that a dialog is modal to its app.
import { FileDialog, message, messageFor, confirm, confirmFor, openUrl,
         MSG_INFO, MSG_WARN } from "vyto/desktop";
import { Surface } from "vyto/surface";

fn show(label: string, p: string?) {
    if (p == null) { print(`{label}: null`); } else { print(`{label}: {p}`); }
}

fn main() {
    let a = args();
    let owner = 0 as culong;
    let keep: Surface? = null;
    if (a.len > 0 && a[0] == "window") {
        let s = new Surface("vyto-desk owner — Zöë", 480, 320);
        owner = s.native_window();
        keep = s;
    }
    print(`message: {messageFor(owner, "vyto-desk-msg", "Hello from vyto/desktop — Zöë 日本", MSG_INFO)}`);
    print(`confirm: {confirmFor(owner, "vyto-desk-ask", "Press Yes")}`);
    let d = new FileDialog().title("vyto-desk-open").filter("Text", "*.txt").owner(owner);
    show("open", d.open());
    let many = new FileDialog().title("vyto-desk-many").filter("Text", "*.txt").owner(owner).openMany();
    print(`many: {many.len}`);
    for (let p in many) { print(`  {p}`); }
    // save() only asks for a path, like every OS save dialog; writing the
    // file is the app's job. The demo writes one so the round trip shows.
    let sp = new FileDialog().title("vyto-desk-save").owner(owner).save("vyto-new.txt");
    show("save", sp);
    if (sp != null) { print(`wrote: {writefile(sp, "saved by desktop_demo — Zöë 日本\n")}`); }
    show("folder", new FileDialog().title("vyto-desk-folder").owner(owner).folder());
    if (a.len > 0 && a[0] == "window") {
        print(`warn: {message("vyto-desk-warn", "No owner: this one is task-modal", MSG_WARN)}`);
        print(`url: {openUrl("https://example.com")}`);
    }
    print("done");
}
