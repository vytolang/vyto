// Manual check of per-monitor DPI, staged in the Windows kit (README there).
// Needs Windows 8.1 or later and two displays set to different scales in
// Display Settings, say 100% and 150%.
//
// Drag the window from one display to the other. When more than half of it
// crosses, Windows resizes it for the new scale and vyto/ui rescales: the
// text stays crisp (not stretched and blurry), the buttons and spacing grow
// or shrink with it, and the line below reports the new scale. Drag it back
// and everything returns to how it started.
//
// On Windows 7 the window never rescales: Windows 7 has no per-monitor DPI,
// so the line keeps the one system scale and nothing else changes.
import { Window, Column, Row, Label, Button, Widget, Painter, Theme, Size,
         BoxConstraints } from "vyto/ui";
import { Rect } from "vyto/surface";

// Reports the window's scale each time it is drawn, so the change is visible
// the moment the window's next frame lands.
class ScaleLine extends Widget {
    override fn measure(s: Painter, th: Theme): Size {
        return Size(320.0 * th.scale_applied, th.text_md * 1.6);
    }
    override fn render(s: Painter, th: Theme) {
        let w = this.win;
        if (w == null) { return; }
        let pct = (w.scale * 100.0).round();
        s.push_font(th.text_md, th.type_body_weight);
        s.text_in(this.bounds, 0.0, `scale now: {pct}%  (window {w.surface().width()} x {w.surface().height()} px)`,
                  th.on_surface);
        s.pop_font();
    }
}

fn main() {
    let win = new Window("Vyto per-monitor DPI", 520, 260);
    win.root = new Column([
        new Label("Drag me to a display with another scale."),
        new ScaleLine(),
        new Row([new Button("Primary"), new Button("Second")]),
        new Label("Text must stay sharp on both displays."),
    ]);
    win.run();
}
