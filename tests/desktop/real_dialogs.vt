// vyto/desktop against the REAL dialog program (zenity or kdialog), driven by
// tests/run_tests_desktop.sh with xdotool on a private Xvfb display. The
// argv-level checks in make test use a fake; this is the end-to-end one: the
// program really starts, really shows each dialog, and its real output is
// parsed. Each dialog has a fixed title so the script can find it.
//
//   real_dialogs <dir> [window]
//
// <dir> holds files/desk_a.txt, files/desk_b.txt and a folder pick/. With
// "window", an X window is opened first and owns every dialog (--attach).
import { FileDialog, messageFor, confirmFor, desktop_available, MSG_INFO } from "vyto/desktop";
import { Surface } from "vyto/surface";

fn show(label: string, p: string?) {
    if (p == null) { print(`{label}: null`); } else { print(`{label}: {p}`); }
}

fn main() {
    let a = args();
    let dir = a[0];
    let owner = 0 as culong;
    let keep: Surface? = null;
    if (a.len > 1 && a[1] == "window") {
        let s = new Surface("vyto-desk owner", 480, 320);
        owner = s.native_window();
        keep = s;
    }
    print(`available: {desktop_available()}`);
    print(`message: {messageFor(owner, "vyto-desk-msg", "Hello — Zöë 日本", MSG_INFO)}`);
    print(`confirm: {confirmFor(owner, "vyto-desk-ask", "Press Yes")}`);
    show("open", new FileDialog().title("vyto-desk-open").startIn(dir + "/files")
        .filter("Text", "*.txt").owner(owner).open());
    let many = new FileDialog().title("vyto-desk-many").startIn(dir + "/files").owner(owner).openMany();
    print(`many: {many.len}`);
    let sp = new FileDialog().title("vyto-desk-save").startIn(dir).owner(owner).save("saved.txt");
    show("save", sp);
    if (sp != null) { print(`wrote: {writefile(sp, "saved — Zöë 日本\n")}`); }
    show("folder", new FileDialog().title("vyto-desk-folder").startIn(dir).owner(owner).folder());
    print("done");
}
