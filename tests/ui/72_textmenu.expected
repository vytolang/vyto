-- a field with no selection --
menu: Copy all | Select all
clip: hello world
-- a field with a selection --
menu: Cut | Copy | Paste | Select all
clip: hello
text:  world
-- paste into a text area --
menu: Copy line | Paste | Select all
text: hellofirst line\nsecond line
-- the same, from the keyboard --
clip: hellofirst line
-- a read-only area --
menu: Copy line | Select all
clip: read only
text: read only   (unchanged)
-- a field with an empty clipboard offers no Paste --
menu: Copy all | Select all
