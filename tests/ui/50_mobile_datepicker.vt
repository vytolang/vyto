// DatePicker: the month grid, the header arrows, and keyboard selection.
// August 2026 starts on a Saturday (lead = 6), which is what puts day 1 in the
// last column of the first row — the interesting case for the grid arithmetic.
import { Window } from "vyto/ui";
import { DatePicker } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Date", 300, 400);
    let dp = new DatePicker(2026, 8);
    dp.onSelect = (y, m, d) => { print("pick " + y + "-" + m + "-" + d); };
    win.root = dp;
    win.run();
    print("view=" + dp.view_year + "-" + dp.view_month);
}
