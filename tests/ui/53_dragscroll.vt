// Drag-scroll and fling (ANDROID.md Track C item 2). Before this, ScrollView
// and ListView never overrode on_drag and the base only forwarded to the
// scrollbar, so dragging inside scrollable content did nothing at all.
//
// The finger drags the list up by 60px, then releases while still moving. The
// release velocity is what turns 60 into ~400: without the fling the list
// would stop dead at 60. The headless clock advances a fixed 16ms per scripted
// event, so the measured velocity — and therefore every number below — is
// deterministic.
import { Window, ListView, Label } from "vyto/ui";

// Sample the offset every Nth frame: the whole coast is ~55 frames, which is
// the right *feel* and the wrong amount of golden.
class Trace {
    n: int;
    every: int;
    fn init(every: int) { this.n = 0; this.every = every; }
    fn tick(v: float) {
        if (this.n % this.every == 0) { print("y=" + v); }
        this.n = this.n + 1;
    }
}

fn main() {
    let win = new Window("Fling", 200, 200);
    let lv = new ListView(20.0, () => { return 100; },
                          (i) => { return new Label("row " + i); });
    win.root = lv;
    let tr = new Trace(8);
    lv.ticker(16, () => { tr.tick(lv.scroll); });
    win.run();
    print("final=" + lv.scroll);
    print("max=" + (lv.content_h() - 200.0));
}
