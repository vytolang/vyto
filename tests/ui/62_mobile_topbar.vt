// TopBar: the nav band, the trailing actions, a widget slot, and extra rows.
//
// Geometry is deterministic under the headless surface (9px/char, 15px line
// height, scale 1), so every coordinate in the .events file is derived:
//   nav band  = space_4 * 2 + text_lg = 50px, so x < 50 is "go back"
//   actions   = text width + 2 * space_4, raised to the 48px touch minimum,
//               laid from the right edge inwards: "B" 236..284, "A" 188..236
//   a tap on the title is deliberately NOT a gesture
import { Window, Column, Label, Button, SizedBox } from "vyto/ui";
import { TopBar, TopBarAction, NAV_BACK } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Bar", 300, 400);

    let bar = new TopBar("Inbox")
        .with_nav(NAV_BACK, () => { print("nav"); })
        .with_actions([new TopBarAction("A", () => { print("action A"); }),
                       new TopBarAction("B", () => { print("action B"); })])
        .row(new SizedBox(-1.0, 30.0, null))
        .row(new SizedBox(-1.0, 20.0, null));

    // Slot widgets are ordinary children: they lay out and take their own taps.
    let btn = new Button("Go");
    btn.onClick = (b) => { print("slot button"); };
    let bar2 = new TopBar("")
        .leading(btn)
        .middle(new Label("middle"));

    win.root = new Column([bar, bar2]);
    win.run();

    print("bar1 bar_px=" + bar.bar_px + " total=" + bar.total_px + " band=" + bar.band_w);
    print("bar1 h=" + bar.bounds.h);
    print("bar2 h=" + bar2.bounds.h + " band=" + bar2.band_w);
}
