// Monitor enumeration and the sizing calls. Headless has no window system, so
// this asserts the CONTRACT a backend without one must honour: report exactly
// one monitor rather than none (callers index [0] and must not have to guard),
// and take the sizing calls without faulting.
import { Surface, surface_monitors } from "vyto/surface";

fn main() {
    let ms = surface_monitors();
    // Never empty: "no monitors" would make every caller write a special case.
    print("count>=1: " + (ms.len >= 1));

    let m = ms[0];
    print("has size: " + (m.w > 0 && m.h > 0));
    print("scale>0: " + (m.scale > 0.0));

    // Exactly one monitor must claim primary, or "pick the main screen" is
    // ambiguous.
    let prim = 0;
    for (let x in ms) { if (x.primary) { prim += 1; } }
    print("primary count: " + prim);

    let s = new Surface("Mon", 200, 150);
    s.set_size(320, 240);
    print("set_size survived");
    // No WM headless, so this must answer false rather than claim success.
    print("fullscreen took: " + s.set_fullscreen(true));
    s.set_fullscreen(false);
    print("ok");
}
