// Overlay gesture dispatch (ANDROID.md Track C item 1), through the mobile
// widget that needs it most. Before the fix, Window.on_mouse_ev dispatched
// on_click to the overlay and returned before set_press, so press_w stayed null
// and an overlay never saw a drag — this file printed nothing at all.
//
// The dismissing drag starts *inside* the panel, so a plain click cannot
// account for it: only a real on_drag_start/on_drag/on_drag_end sequence
// delivered to the overlay closes this sheet.
import { Window } from "vyto/ui";
import { BottomSheet } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Sheet", 200, 400);
    let sheet = new BottomSheet(200.0);
    sheet.offset = 0.0;                 // start open; the slide-in is animation, not gesture
    sheet.onDismiss = () => { print("dismissed"); };
    win.open_overlay(sheet);
    win.run();
    print("offset=" + sheet.offset);
}
