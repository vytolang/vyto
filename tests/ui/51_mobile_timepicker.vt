// TimePicker: the dial maps a point to a clock value, the header switches
// which ring is live, and AM/PM shifts the stored 24-hour value by 12.
// Also covers the header hit order — the three targets must not intersect, or
// the first test wins and the rest become unreachable.
import { Window } from "vyto/ui";
import { TimePicker } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Time", 300, 400);
    let tp = new TimePicker(9, 30);
    tp.onChange = (h, m) => { print("time " + h + ":" + m); };
    win.root = tp;
    win.run();
    print("final=" + tp.hour + ":" + tp.minute);
}
