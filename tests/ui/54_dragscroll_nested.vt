// Two halves of Track C item 2 that the flat ListView case cannot show.
//
// 1. The press lands on a Label, deep inside the ScrollView. Window dispatches
//    on_drag only to the widget that took the press, so without the walk up the
//    parent chain a finger on content would scroll nothing. The Label and the
//    Column both report "cannot scroll" and the ScrollView takes it.
//
// 2. Grabbing a coasting view pins it, the way every touch platform behaves.
//    The second gesture stops the fling, drags 40px further, then holds still
//    before lifting — so it must NOT throw on release. Velocity is only
//    sampled on movement, so a stale sample is a stop, not a flick. The flat
//    tail is the assertion.
import { Window, ScrollView, Column, Label } from "vyto/ui";

class Trace {
    n: int;
    every: int;
    fn init(every: int) { this.n = 0; this.every = every; }
    fn tick(v: float) {
        if (this.n % this.every == 0) { print("y=" + v); }
        this.n = this.n + 1;
    }
}

fn main() {
    let win = new Window("Nested", 200, 200);
    let col = new Column([]);
    for (let i in 0..60) { col.add(new Label("row " + i)); }
    let sv = new ScrollView(col);
    win.root = sv;
    let tr = new Trace(4);
    sv.ticker(16, () => { tr.tick(sv.scroll_y); });
    win.run();
    print("final=" + sv.scroll_y);
}
