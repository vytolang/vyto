// ActionsFab: the speed dial opens, runs one action, and closes.
//
// Three passes, because the failure modes differ: a menu that opens but does
// not close; an action that runs from the wrong cell; and a scrim tap that
// runs something instead of just putting the menu away.
//
// Window 300x400, no bars, so the FAB is 16px in from the bottom-right corner:
// 228..284 x 328..384. The mini FABs stack above it 12px apart at 40px across,
// centred on the FAB, so action 0 is centred at y=296 and action 1 at y=244.
import { Window, Column, Label } from "vyto/ui";
import { Scaffold, ActionsFab, FabAction } from "vyto/mobile/android/ui";

// Reports what each tap on the dial did, so the scrim-tap pass (which must
// print nothing of its own) is testing silence against a menu that really was
// open rather than against one that never opened.
class Probe extends ActionsFab {
    override fn on_tap(x: int, y: int): bool {
        let r = super.on_tap(x, y);
        print("dial tapped, open=" + this.is_open());
        return r;
    }
}

fn main() {
    let win = new Window("Fab", 300, 400);

    let fab = new Probe("+");
    fab.actions = [new FabAction("A", "Post", () => { print("post"); }),
                   new FabAction("B", "Photo", () => { print("photo"); })];

    let sc = new Scaffold(new Column([new Label("body")])).with_fab(fab);
    win.root = sc;
    // The menu is an overlay, so an open one is exactly what Back would pop —
    // print the depth the Window would report at each step.
    win.run();

    print("fab=" + fab.bounds.x + "," + fab.bounds.y);
    print("open_at_end=" + fab.is_open());
    print("glyph=" + fab.glyph());
}
