// Two Surfaces, one process: an event addressed to window B must never be
// reported by window A. That is exactly what the file-scope input statics made
// impossible — both windows read the same last_x/last_y/last_key, so whichever
// asked first got the other's event.
//
// The script addresses windows with `win N` (open order). Each surface is
// polled, so a surface whose turn it is not reports EV_NONE rather than
// draining an event meant for its sibling.
import { Surface, EV_NONE, EV_CLOSE, EV_MOUSE_DOWN, EV_KEY } from "vyto/surface";

fn name(i: int): string {
    if (i == 0) { return "A"; }
    return "B";
}

fn main() {
    let a = new Surface("A", 200, 150);
    let b = new Surface("B", 300, 200);
    let surfaces = [a, b];

    let live = true;
    let guard = 0;
    while (live && guard < 40) {
        guard += 1;
        for (let i in 0..surfaces.len) {
            let s = surfaces[i];
            let ev = s.poll();
            if (ev == EV_NONE) { continue; }
            if (ev == EV_CLOSE) { live = false; break; }
            if (ev == EV_MOUSE_DOWN) {
                print(name(i) + " click " + s.mouse_x() + "," + s.mouse_y());
            } else if (ev == EV_KEY) {
                print(name(i) + " key " + s.key());
            }
        }
    }
    print("done");
}
