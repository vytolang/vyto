// The button and wheel contract every backend shares, replayed headless:
// left keeps MOUSE_DOWN/UP, a right press stays MOUSE_RDOWN, and every other
// press or release is BUTTON_DOWN/UP with button() naming it. The wheel's
// sign is positive = down / right, which is what the Win32 backend got
// backwards before (it reported a wheel-up as +3).
import { Surface, EV_CLOSE, EV_NONE, EV_MOUSE_DOWN, EV_MOUSE_UP, EV_MOUSE_RDOWN,
         EV_BUTTON_DOWN, EV_BUTTON_UP, EV_MOUSE_WHEEL, EV_MOUSE_MOVE,
         BUTTON_RIGHT, BUTTON_MIDDLE, BUTTON_BACK, BUTTON_FORWARD,
         EVENT } from "vyto/surface";

fn bname(b: int): string {
    if (b == BUTTON_RIGHT) { return "right"; }
    if (b == BUTTON_MIDDLE) { return "middle"; }
    if (b == BUTTON_BACK) { return "back"; }
    if (b == BUTTON_FORWARD) { return "forward"; }
    return "?" + b;
}

fn main() {
    let s = new Surface("buttons", 200, 120);
    let n = 0;
    while (n < 64) {
        n += 1;
        let ev = s.wait();
        if (ev == EV_CLOSE) { break; }
        if (ev == EV_NONE) { continue; }
        let at = " @" + s.mouse_x() + "," + s.mouse_y();
        // The enum cast must accept the two new classes in debug builds.
        let e = ev as EVENT;
        if (e == EVENT.BUTTON_DOWN) {
            print("button down " + bname(s.button()) + at);
        } else if (e == EVENT.BUTTON_UP) {
            print("button up " + bname(s.button()) + at);
        } else if (ev == EV_MOUSE_DOWN) {
            print("left down" + at);
        } else if (ev == EV_MOUSE_UP) {
            print("left up" + at);
        } else if (ev == EV_MOUSE_RDOWN) {
            print("right down" + at);
        } else if (ev == EV_MOUSE_WHEEL) {
            print("wheel y=" + s.wheel() + " x=" + s.wheel_x() + at);
        } else if (ev == EV_MOUSE_MOVE) {
            print("move" + at);
        } else {
            print("event " + ev);
        }
    }
    print("done");
}
