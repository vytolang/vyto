// Dropdown: a list taller than the window is clamped to it and scrolls. The
// last item is reachable by keyboard (End), a reopened popup starts scrolled to
// the selection, and the wheel scrolls it back to the top.
import { Window, Column, Dropdown } from "vyto/ui";

fn main() {
    let win = new Window("Dropdown", 320, 240);
    let labels: string[] = [];
    for (let i in 0..30) { labels.push(`item {i}`); }
    let dd = new Dropdown(labels);
    dd.onSelect = (i) => { print("pick " + `{i}`); };
    win.root = new Column([dd]);
    win.run();
    print("dropdown " + `{dd.bounds.x} {dd.bounds.y} {dd.bounds.w} {dd.bounds.h}` + " selected " + `{dd.selected}`);
}
