# New, by id: the body starts at the very top (no drawn strip)
command 100
# Wrap, inside a submenu: flips, the OS copy is told, then it fires
command 102
# Lock disables Save from code: the OS copy is told
command 103
# Save is disabled now: neither its id nor its shortcut fires
command 101
mods ctrl
type s
# bound shortcuts are still Vyto's: Ctrl+N fires
type n
# Alt+F belongs to the OS menu: no drawn popup opens
mods alt
type f
mods none
# an unknown id and id 0 do nothing
command 999
command 0
close
