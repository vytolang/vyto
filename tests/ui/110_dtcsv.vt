// DataTable's CSV export and clipboard TSV make formula cells inert
// (csv_sheet_safe): a name typed as =HYPERLINK(...) must not run when the
// export is opened in a spreadsheet. Plain numbers, negative ones included,
// stay numbers. No Window: the export reads the frame directly.
import { DataTable } from "vyto/ui/datatable";
import { DataFrame, CK_F64, CK_STR } from "vyto/data/frame";

fn main() {
    let df = new DataFrame(4);
    let name = df.addColumn("name", CK_STR);
    let amt = df.addColumn("amount", CK_F64);
    df.reserve(3);
    df.beginRow().setStr(name, "=HYPERLINK(\"http://x\",\"pay\")").setFloat(amt, -12.5).endRow();
    df.beginRow().setStr(name, "@SUM(A1)").setFloat(amt, 3.0).endRow();
    df.beginRow().setStr(name, "Wanjiru").setFloat(amt, -1.25).endRow();
    let dt = new DataTable(df);
    print(dt.exportCsv());
    dt.selected = 0;
    print(dt.selectionTsv());
}
