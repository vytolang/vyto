// Scaffold: fixed chrome, scrolling content, and a FAB pinned to the screen.
//
// The assertion that matters is the last pair of lines: the content scrolls
// several hundred px and the FAB's bounds do not move by a pixel. A FAB placed
// in the content — which is what every app did before this widget — scrolls
// away with it, and a golden that only checked the initial layout would pass
// for that too. The bar's shadow flag flips on the same gesture.
//
// Window 300x400: top bar 56, bottom nav 80, so content is 56..320 and the FAB
// sits 16px in from the right and 16px above the bottom bar.
import { Window, Column, Label, ScrollView } from "vyto/ui";
import { Scaffold, TopBar, FloatingActionButton, BottomNavigationBar,
         NAV_MENU, FAB_BOTTOM_LEFT } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Sc", 300, 400);

    let body = new Column([]);
    for (let i in 0..40) { body.add(new Label("row " + i)); }
    // A FAB placed the old way — inside the scrolling content — as the control
    // case. It travels with the rows; the Scaffold's does not. The contrast is
    // built into the fixture rather than asserted in prose, because "it did not
    // move" is a claim a golden of a single widget cannot distinguish from
    // "nothing was scrolled".
    let stray = new FloatingActionButton("s");
    body.add(stray);
    let sv = new ScrollView(body);

    let bar = new TopBar("Feed").with_nav(NAV_MENU, () => { print("menu"); });
    let fab = new FloatingActionButton("+");
    fab.onClick = (f) => { print("fab"); };

    let sc = new Scaffold(sv)
        .top(bar)
        .bottom(new BottomNavigationBar(["A", "B"]))
        .with_fab(fab);
    win.root = sc;
    win.run();

    print("top=" + bar.bounds.y + " h=" + bar.bounds.h);
    print("content=" + sv.bounds.y + " h=" + sv.bounds.h);
    print("fab=" + fab.bounds.x + "," + fab.bounds.y + " " + fab.bounds.w + "x" + fab.bounds.h);
    print("scrolled_content=" + (sv.scroll_y > 100.0));
    // The control FAB has been displaced by exactly the scroll distance —
    // adding it back recovers its layout position — while the Scaffold's FAB
    // above is still at the y it started at.
    print("stray_y+scroll=" + (stray.bounds.y + sv.scroll_y));
    print("bar_raised=" + bar.scrolled);

    // The corner is a setting, not a constant.
    sc.fab_corner = FAB_BOTTOM_LEFT;
    sc.arrange(win.painter, win.theme, sc.bounds);
    print("fab_left=" + fab.bounds.x);
}
