// PullToRefresh driven by a real finger, which is what Track C item 2 unlocked.
// Nothing wires the two together explicitly: Widget.on_drag walks up the parent
// chain, the ScrollView refuses a downward drag it is already at the top of,
// and the walk carries it to the PullToRefresh wrapping it.
//
// First gesture is short of the threshold, so it snaps back with no refresh.
// Second clears it and fires.
import { Window, ScrollView, Column, Label } from "vyto/ui";
import { PullToRefresh } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Pull", 200, 200);
    let col = new Column([]);
    for (let i in 0..60) { col.add(new Label("row " + i)); }
    let ptr = new PullToRefresh();
    ptr.add(new ScrollView(col));
    ptr.onRefresh = () => { print("refresh"); };
    win.root = ptr;
    win.run();
    print("pull=" + ptr.pull);
    print("refreshing=" + ptr.refreshing);
}
