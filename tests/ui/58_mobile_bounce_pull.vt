// Bounce must not eat pull-to-refresh.
//
// The two gestures are the same gesture: a downward drag on content already at
// its top. PullToRefresh exists only because the ScrollView *refuses* that
// drag and Widget.on_drag carries it up the parent chain — so a bounce that
// consumed it first would leave pull-to-refresh silently dead in every app
// that switched bounce on, with nothing failing anywhere to say so.
//
// The ordering in on_drag is what prevents it: bounce is tried in a second
// walk, only after the first walk has offered the drag to every ancestor.
// PullToRefresh takes it there, by overriding drag_scroll.
//
// Same script as 55_mobile_pull_gesture, with bounce switched on. Identical
// outcome — refresh fires, and the content never leaves its edge — is the
// assertion.
import { Window, ScrollView, Column, Label } from "vyto/ui";
import { PullToRefresh } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Pull", 200, 200);
    let col = new Column([]);
    for (let i in 0..60) { col.add(new Label("row " + i)); }
    let sv = new ScrollView(col);
    sv.bounce = true;
    let ptr = new PullToRefresh();
    ptr.add(sv);
    ptr.onRefresh = () => { print("refresh"); };
    win.root = ptr;
    win.run();
    print("pull=" + ptr.pull);
    print("refreshing=" + ptr.refreshing);
    print("overscroll=" + sv.overscroll);
}
