// Per-monitor scale. The machine this runs on has one screen, so what is
// exercised here is the ARITHMETIC and the precedence, driven by $VYTO_SCALE:
// the platform queries themselves need mixed-DPI hardware to test.
//
// The contract that matters: a scalar $VYTO_SCALE applies to everything (the
// long-standing behaviour, which tests/ui/scale.vt and every existing user
// depend on), while a comma list names monitors in order.
import { Surface, surface_monitors } from "vyto/surface";

fn main() {
    let ms = surface_monitors();
    // Never empty, whatever the backend: callers index [0] without guarding.
    print("monitors>=1: " + (ms.len >= 1));

    // Whatever the source, a scale must be usable as a multiplier.
    let ok = true;
    for (let m in ms) { if (m.scale <= 0.0) { ok = false; } }
    print("all scales positive: " + ok);

    // The window's own scale must agree with the monitor it is on. With one
    // screen that is monitor 0; the point is that the two answers cannot
    // disagree, which they did when every monitor reported the global scale.
    let s = new Surface("DPI", 200, 150);
    print("surface scale matches its monitor: " + (s.scale() == ms[0].scale));
    print("ok");
}
