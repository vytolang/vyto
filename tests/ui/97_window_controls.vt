// The chromeless-window controls: decorations off, position round-trip, and
// the drag/resize handoff. Headless has no window manager, so this asserts the
// CONTRACT rather than the visual result — every call must be safe and report
// honestly, which is what a backend without a WM has to do.
import { Surface, EDGE } from "vyto/surface";

fn main() {
    let s = new Surface("Controls", 200, 150);

    // Decoration toggling must never fault, with or without a WM.
    s.set_decorated(false);
    s.set_decorated(true);
    s.set_decorated(false);
    print("decoration calls survived");

    // position() always answers; headless has no placement, so it reads 0,0.
    let p = s.position();
    print("position " + p[0] + "," + p[1]);

    // move_to is a no-op where the system owns placement, but must not fault.
    s.move_to(100, 80);
    print("move_to survived");

    // drag_start reports whether a WM took the drag. Headless has none, so it
    // must answer false rather than pretending — a caller that believes a false
    // "true" would skip its own fallback and the window would never move.
    let took = s.drag_start(EDGE.MOVE, 10, 5);
    print("drag_start took=" + took);

    // every edge value must be accepted and answer honestly
    let any = false;
    for (let e in 0..9) {
        if (s.drag_start(e as EDGE, 1, 1)) { any = true; }
    }
    print("any edge accepted=" + any);
    print("ok");
}
