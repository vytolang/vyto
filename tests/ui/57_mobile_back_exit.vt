// System Back down to the base screen, and one press past it.
//
// The press past the base is the one that matters. AndroidWindow turns
// close_on_esc off because the depth Native.back() reads can be one frame
// stale, so an Escape that arrives with nothing left to pop has to be a no-op
// rather than an app exit — the app is meant to end by Native.back() answering
// false and the Activity finishing, and by no other route.
//
// The resize is the proof that it was a no-op: it only reaches layout if the
// loop is still running, and `home` is then measured against a taller window.
import { Label } from "vyto/ui";
import { AndroidWindow } from "vyto/mobile/android/ui";

extern "C" {
    fn vta_back_depth(): i32;
}

fn show(tag: string, win: AndroidWindow) {
    print(tag + " depth=" + vta_back_depth() + " screens=" + win.screens.len);
}

fn main() {
    let win = new AndroidWindow("Back", 200, 400);
    // Held outside the tree: Window.run() releases the widget tree on the way
    // out, so win.root is null by the time anything down here could read it.
    let home = new Label("home");
    win.set_content(home);

    win.push_screen(new Label("story"));
    show("pushed", win);

    win.run();

    show("after", win);
    print("still_running=" + (home.bounds.h > 400.0));
}
