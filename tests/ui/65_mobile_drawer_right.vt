// NavigationDrawer from the right edge, with arbitrary content in the panel.
//
// The mirror is one number (drag_sign), and getting it wrong is invisible in
// the static layout — the panel still lands in the right place, it is the
// gesture that inverts. So this drags both ways and asserts each:
//
//   window 300 wide, panel = min(320dp, 85% of the width) = 255, so an open
//   right drawer occupies x 45..300
//   dragging RIGHT (towards its own edge) closes it
//   dragging LEFT does not — it is already fully open, and the clamp holds
import { Window, Column, Label } from "vyto/ui";
import { NavigationDrawer, DRAWER_RIGHT } from "vyto/mobile/android/ui";

// Reports where each gesture left the panel. The static geometry is printed at
// the end; this is what distinguishes "the left drag did nothing" from "the
// left drag closed it and the right one reopened it".
class Probe extends NavigationDrawer {
    override fn on_drag_end(x: int, y: int): bool {
        let r = super.on_drag_end(x, y);
        print("drag end at open_frac=" + this.open_frac);
        return r;
    }
}

fn main() {
    let win = new Window("End drawer", 300, 400);

    let panel = new Column([new Label("Filters"), new Label("Sort")]);
    let drawer = new Probe([])
        .from_side(DRAWER_RIGHT)
        .add(panel);
    drawer.open_frac = 1.0;             // start open
    drawer.onDismiss = () => { print("dismissed"); };
    win.open_overlay(drawer);
    win.run();

    print("closed_panel_x=" + drawer.panel.x);
    print("open_frac=" + drawer.open_frac);

    // Open geometry, re-derived rather than remembered: a right drawer sits
    // flush with the right edge and its content fills the panel.
    drawer.open_frac = 1.0;
    drawer.place(win.painter, win.theme);
    print("open_panel=" + drawer.panel.x + " w=" + drawer.panel.w);
    print("content_x=" + panel.bounds.x + " w=" + panel.bounds.w);
}
