// Toolkit side of the pointer work: the hovered widget's cursor() reaches the
// surface (an I-beam over a text field, the arrow elsewhere), the extra
// buttons bubble to Widget.on_button, and a horizontal wheel — or Shift plus
// the vertical one — reaches on_scroll_x. Headless backends only remember the
// cursor, which is exactly what Surface.cursor() reads back here.
import { Window, Widget, Column, Expanded, TextField } from "vyto/ui";
import { CURSOR_ARROW, CURSOR_IBEAM, BUTTON_MIDDLE, BUTTON_BACK, BUTTON_RIGHT } from "vyto/surface";

fn cname(c: int): string {
    if (c == CURSOR_IBEAM) { return "ibeam"; }
    if (c == CURSOR_ARROW) { return "arrow"; }
    return "#" + c;
}

class Pad extends Widget {
    fn init() { super.init(); }
    override fn on_hover_enter(): bool {
        if (this.win != null) { print("pad hover, cursor " + cname(this.win.surface().cursor())); }
        return false;
    }
    override fn on_button(button: int, down: bool, x: int, y: int): bool {
        let state = "up";
        if (down) { state = "down"; }
        let name = "#" + button;
        if (button == BUTTON_MIDDLE) { name = "middle"; }
        if (button == BUTTON_BACK) { name = "back"; }
        if (button == BUTTON_RIGHT) { name = "right"; }
        print("pad button " + name + " " + state);
        return true;
    }
    override fn on_scroll_x(delta: int): bool {
        print("pad scroll_x " + delta);
        return true;
    }
    override fn on_scroll(delta: int): bool {
        print("pad scroll " + delta);
        return true;
    }
}

class Field extends TextField {
    fn init() { super.init("type here"); }
    override fn on_hover_enter(): bool {
        if (this.win != null) { print("field hover, cursor " + cname(this.win.surface().cursor())); }
        return false;
    }
}

fn main() {
    let win = new Window("Cursor", 300, 200);
    win.root = new Column([new Field(), new Expanded(new Pad())]);
    win.run();
    print("final cursor " + cname(win.surface().cursor()));
}
