// NavigationDrawer: destination rows, and the scrim tap that closes it.
//
// The scrim is inside the drawer's own bounds (the widget covers the window so
// it can paint one), so the tap arrives as on_click rather than falling into
// Window's dismiss-outside branch — which is what lets the exit animate.
import { Window } from "vyto/ui";
import { NavigationDrawer } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Drawer", 300, 400);
    let drawer = new NavigationDrawer(["Inbox", "Starred", "Sent"]);
    drawer.open_frac = 1.0;             // start open
    drawer.selected = -1;
    drawer.onSelect = (i) => { print("select " + i); };
    drawer.onDismiss = () => { print("dismissed"); };
    win.open_overlay(drawer);
    win.run();
    print("selected=" + drawer.selected);
    print("open_frac=" + drawer.open_frac);
}
