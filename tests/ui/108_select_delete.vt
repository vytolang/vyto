// A selection made with the mouse, then Backspace or Ctrl+X. A double-click
// (or the end of a drag) opens the selection toolbar, an overlay; while it
// was open every key went to it, and it took none, so the selected text
// could not be deleted or cut. Keys now pass a toolbar by: it closes and the
// field gets the key.
import { Window, Column, TextField } from "vyto/ui";

fn main() {
    let win = new Window("Select", 300, 100);
    let input = new TextField("placeholder");
    win.root = new Column([input]);
    win.run();
    print("text=[" + input.text + "] caret=" + `{input.caret}` + " clip=[" + win.surf.clipboard() + "]");
}
