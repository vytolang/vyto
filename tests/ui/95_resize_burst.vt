// A burst of resizes, ending tiny enough that the padding alone exceeds the
// window. Two things are asserted: the tree re-arranges to each size, and a
// window smaller than twice its own padding still produces non-negative rects
// rather than the negative widths a naive inset subtraction gives.
//
// The X11 backend additionally coalesces a run of these into one relayout; that
// is not observable here (the headless backend delivers one event per script
// line by construction), so this pins the layout maths, not the coalescing.
import { Window, Widget, Column, Row, Label, Button, ListBox } from "vyto/ui";

fn dump(name: string, w: Widget) {
    print(name + "=" + w.bounds.x + "," + w.bounds.y + " " + w.bounds.w + "x" + w.bounds.h);
}

// Nothing in a laid-out tree should ever be negative, at any window size.
fn check(name: string, w: Widget) {
    if (w.bounds.w < 0.0 || w.bounds.h < 0.0) {
        print("NEGATIVE " + name + "=" + w.bounds.w + "x" + w.bounds.h);
    }
}

fn main() {
    let win = new Window("ResizeBurst", 400, 300);
    let title = new Label("Title");
    let input = new Label("body");
    let add = new Button("Add");
    let list = new ListBox();
    input.grow = 1;
    list.grow = 1;
    let row = new Row([input, add]);
    win.root = new Column([title, row, list]);
    win.run();
    dump("title", title);
    dump("row", row);
    dump("list", list);
    check("title", title);
    check("row", row);
    check("input", input);
    check("add", add);
    check("list", list);
    print("ok");
}
