# bound shortcuts, from anywhere: Ctrl+N, F3, Ctrl+, and a disabled one
mods ctrl
type n
type ,
type d
mods none
key F3
# Alt+F opens File by keyboard; Down skips the separator and the disabled row
mods alt
type f
mods none
key Down
key Down
key Enter
# Alt+F, Down to Open Recent, Right cascades it, Enter fires its first row
mods alt
type f
mods none
key Down
key Right
key Enter
# Alt+F then Right: New has no submenu, so Right moves to Edit; Enter = Undo
mods alt
type f
mods none
key Right
key Enter
# Alt+E, w: the access key of a check item toggles it (twice)
mods alt
type e
mods none
type w
mods alt
type e
mods none
type w
# F10 opens the first menu; Esc closes it without firing
key F10
key Esc
# focus the field, type, then Edit > Select All, Edit > Copy by access key
click 50 40
type hello
mods alt
type e
mods none
type a
mods alt
type e
mods none
type c
# Ctrl+Shift+P prints what Copy put on the clipboard
mods ctrl+shift
type P
mods none
# mouse: open File, point at Edit's title (switches), click Edit's first row
click 20 10
move 70 10
click 70 40
# open File, hover Open Recent (cascades), Down + Enter in the submenu
click 20 10
move 30 60
key Down
key Down
key Enter
# open File, click far outside: closes, fires nothing
click 20 10
click 380 280
# Ctrl+Q is Quit off Windows
mods ctrl
type q
