// The other half of bounce: a flick that outruns the content.
//
// The fling and the bounce are two different animations on two different
// values — the coast moves `scroll`, the bounce moves `overscroll` — so the
// interesting moment is the handover. A throw asking for more content than
// exists is clipped at the end, and the part that was clipped becomes the
// speed the bounce starts with. Without the handover the list would arrive at
// its last row and stop flat, which is the thing that reads as a wall.
//
// A ListView on purpose, not a ScrollView: it positions its own rows in
// render() from the scroll offset, so it is a second, independent
// implementation of "where does the content sit" that overscroll has to reach.
//
// The trace shows scroll climbing to max and stopping there — it never leaves
// its range — while overscroll goes negative (content pulled up past the
// bottom) and returns to exactly 0.
import { Window, ListView, Label } from "vyto/ui";

class Trace {
    n: int;
    every: int;
    fn init(every: int) { this.n = 0; this.every = every; }
    fn tick(over: float, scroll: float) {
        if (this.n % this.every == 0) { print("over=" + over + " scroll=" + scroll); }
        this.n = this.n + 1;
    }
}

fn main() {
    let win = new Window("Bounce fling", 200, 200);
    // 20 rows of 20px in a 200px window: 200px of scroll range, far less than
    // a hard flick asks for, so the coast is guaranteed to be clipped.
    let lv = new ListView(20.0, () => { return 20; },
                          (i) => { return new Label("row " + i); });
    lv.bounce = true;
    win.root = lv;

    let tr = new Trace(6);
    lv.ticker(16, () => { tr.tick(lv.overscroll, lv.scroll); });
    win.run();

    print("final_over=" + lv.overscroll);
    print("final_scroll=" + lv.scroll);
    print("max=" + (lv.content_h() - 200.0));
}
