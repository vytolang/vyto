// A window moving to a display of another scale, replayed headless with the
// script's `scale N` (what Win32's WM_DPICHANGED becomes in vsurf). The theme
// must follow by the ratio, the painter must be told old and new, and the
// change must surface exactly once per notice: a RESIZE without one, the
// ordinary kind, must leave the scale alone.
//
// VYTO_SCALE is not set, so the window starts at 1.0.
import { Window, Column, Label, Painter } from "vyto/ui";
import { Rect } from "vyto/surface";

class ScalePainter extends Painter {
    log: string[];
    fn init() { this.log = []; }
    override fn on_scale(prev: float, next: float) { this.log.push(`painter {prev} -> {next}`); }
    override fn text_width(s: string): float { return (s.len * 7) as float; }
    override fn font_ascent(): float { return 11.0; }
    override fn font_height(): float { return 14.0; }
    override fn width(): float { return 300.0; }
    override fn height(): float { return 200.0; }
}

fn main() {
    let win = new Window("Rescale", 300, 200);
    let p = new ScalePainter();
    win.use_painter(p);
    win.root = new Column([new Label("hello")]);
    let md0 = win.theme.text_md;
    let sp0 = win.theme.space_3;
    win.run();

    for (let l in p.log) { print(l); }
    print(`window scale: {win.scale}`);
    print(`theme scale: {win.theme.scale_applied}`);
    // 150 -> 100 -> 200 nets out at 2x the start
    print(`text_md doubled: {win.theme.text_md == md0 * 2.0}`);
    print(`space_3 doubled: {win.theme.space_3 == sp0 * 2.0}`);
    print(`pad follows space_3: {win.theme.pad == win.theme.space_3}`);
    print(`notice consumed: {!win.surface().scale_changed()}`);
}
