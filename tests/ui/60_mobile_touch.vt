// AndroidWidget's touch contract, the part every mobile widget inherits.
//
// Four things are asserted, each of which was a per-widget bug before:
//   1. a tap fires on the RELEASE, and the press hooks bracket it
//   2. a drag is not a tap — the action must not fire when the finger moved
//   3. a long-press reaches on_context, and the release that ends it is not
//      also a tap
//   4. measure() raises a small widget to the 48dp touch minimum, but leaves a
//      0.0 axis alone (that is "fill me", not "a zero-size target")
import { Window, Painter, Theme, Size } from "vyto/ui";
import { AndroidWidget } from "vyto/mobile/android/ui";

class Probe extends AndroidWidget {
    override fn content_size(s: Painter, th: Theme): Size { return Size(10.0, 10.0); }
    override fn paint(s: Painter, th: Theme) { }

    override fn on_press_begin(x: int, y: int) { print("press " + x + "," + y); }
    override fn on_press_end() { print("unpress"); }
    override fn on_tap(x: int, y: int): bool { print("tap " + x + "," + y); return true; }
    override fn on_context(x: int, y: int): bool { print("context " + x + "," + y); return true; }
}

// Full-width bar: content_size leaves the width at 0.0, the fill convention.
class Bar extends AndroidWidget {
    override fn content_size(s: Painter, th: Theme): Size { return Size(0.0, 10.0); }
    override fn paint(s: Painter, th: Theme) { }
}

fn main() {
    let win = new Window("Touch", 200, 200);
    let p = new Probe();
    win.root = p;
    win.run();

    let sz = p.measure(win.painter, win.theme);
    print("probe measure " + sz.w + "x" + sz.h);
    let b = new Bar();
    b.win = win;
    let bs = b.measure(win.painter, win.theme);
    print("bar measure " + bs.w + "x" + bs.h);
}
