// PullToRefresh: the threshold decides whether a released pull starts a
// refresh, and the refresh runs until the app ends it. The pull itself is fed
// through set_pull/release_pull because ScrollView has no drag-scroll yet
// (ANDROID.md Track C item 2) — that gesture is the only missing caller.
import { Window, Label } from "vyto/ui";
import { PullToRefresh } from "vyto/mobile/android/ui";

fn main() {
    let win = new Window("Pull", 200, 200);
    let ptr = new PullToRefresh();
    ptr.add(new Label("content"));
    ptr.onRefresh = () => { print("refresh"); };
    win.root = ptr;

    // short of the threshold: released, and nothing happens
    ptr.set_pull(30.0);
    ptr.release_pull();
    print("after short: refreshing=" + ptr.refreshing + " pull=" + ptr.pull);

    // past it: the release arms a refresh
    ptr.set_pull(80.0);
    ptr.release_pull();
    print("after long: refreshing=" + ptr.refreshing);

    // a second release while already refreshing must not re-fire onRefresh
    ptr.release_pull();

    ptr.end_refresh();
    print("after end: refreshing=" + ptr.refreshing + " pull=" + ptr.pull);
    win.run();
}
