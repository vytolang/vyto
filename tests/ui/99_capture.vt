// vs_capture's contract. Headless has no window system, so what this asserts is
// the shape of the ANSWER rather than any pixels: capture must fail cleanly and
// say so, because "cannot read this window" is the ordinary case on Wayland and
// Android, not an error state.
import { Surface, capture_window } from "vyto/surface";

fn main() {
    let s = new Surface("Cap", 120, 80);

    // A window this backend cannot read must give null, not a crash and not an
    // empty-but-valid Capture that a caller would happily blit as garbage.
    let c = capture_window(s.native_window());
    print("own window capture null: " + (c == null));

    // Nonsense handles must take the same path rather than faulting.
    print("zero handle null: " + (capture_window(0 as culong) == null));
    print("bogus handle null: " + (capture_window(123456789 as culong) == null));
    print("ok");
}
