# selftest
-- ok
ok ok_pass
not ok ok_fail
-- eq
ok eq_pass
not ok eq_fail
  got:  abc
  want: abd
not ok eq_empty_vs_set
  got:  
  want: x
-- eqInt
ok eqInt_pass
not ok eqInt_fail
  got:  4
  want: 5
ok eqInt_negative
-- eqBool
ok eqBool_pass
not ok eqBool_fail
  got:  true
  want: false
-- eqFloat
ok eqFloat_pass
not ok eqFloat_fail
  got:  1
  want: 2
not ok eqFloat_just_outside
  got:  1
  want: 1.001
ok eqFloat_wide_eps
-- contains
ok contains_pass
not ok contains_fail
  got:  hello world
  want: (containing) goodbye
-- eqIntArr
ok eqIntArr_pass
not ok eqIntArr_fail_elem
  got:  [1]=2
  want: [1]=9
not ok eqIntArr_fail_len
  got:  len 3
  want: len 2
-- eqStrArr
ok eqStrArr_pass
not ok eqStrArr_fail
  got:  [1]=b
  want: [1]=c
-- fail and skip
not ok fail_is_always_red
  stated reason
skip skip_is_neither (nothing to run against)
-- return values
ok inner_pass
ok ok_returns_true
not ok inner_fail
ok ok_returns_false
ok inner_eq_pass
ok eqInt_returns_true
not ok inner_eq_fail
  got:  1
  want: 2
ok eqInt_returns_false
not ok inner_fail_call
  expected
ok fail_returns_false
-- counting
ok skipped_counted
ok some_passed
ok some_failed
# selftest: 20 passed, 15 failed, 1 skipped FAILED
# done() returned 1
