// tests/unit/silent_exit.vt — a suite that exits 0 without reporting.
//
// A NEGATIVE test of the runner, like aborts_midway, and the one that actually
// justifies the summary-line grep.
//
// aborts_midway dies at exit(101), so the runner's exit-status check catches it
// on its own — the grep is not what saves that case. THIS is: a suite whose
// main() returns without calling exitWith(t.done()) exits 0, having run one
// assertion out of however many it meant to. Judging on exit status alone
// scores it green.
//
// It is the likelier mistake of the two by some distance — forgetting the last
// line, or returning early from a guard (`if (!t.ok(...)) { return; }`) that
// sits directly in main(). The framework cannot detect it from the inside,
// because from the inside nothing happened at all.
//
// Passing here means the runner reported this file as FAILING. The runner
// special-cases it by name.
import { suite } from "vyto/dev/test";

fn main() {
    let t = suite("silent_exit");

    t.section("one assertion, then nothing");
    t.eqInt("this one runs", 1, 1);

    // No exitWith(t.done()). Falls off the end of main(): exit 0, no summary
    // line, and every assertion that should have followed never happened.
}
