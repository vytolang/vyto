// tests/unit/red_suite.vt — an ordinary suite with an ordinary failure.
//
// A NEGATIVE test of the runner, and the plainest one: this suite runs to the
// end, prints a well-formed summary, and exits 1 because an assertion failed.
// The runner must report it FAILING.
//
// It guards the EXIT-STATUS half of the verdict check, which the other two
// negative fixtures do not reach. aborts_midway and silent_exit are both caught
// by the missing summary line, so with the exit-status test deleted they still
// come out failing and nothing notices — fault injection showed exactly that.
// This file is the case where the summary line is present and correct, so the
// exit status is the only thing left to judge on.
//
// Between the three: red_suite is caught by the status, silent_exit by the
// summary line, and aborts_midway by either. Remove either half of the check
// and one of these three starts passing when it should not.
import { suite } from "vyto/dev/test";
import { exitWith } from "vyto/dev/test/exit";

fn main() {
    let t = suite("red_suite");

    t.section("one that passes and one that does not");
    t.eqInt("passes", 1, 1);
    t.eqInt("fails", 1, 2);

    exitWith(t.done());
}
