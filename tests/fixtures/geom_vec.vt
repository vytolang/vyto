// Pure-Vyto coverage for vyto/geom's Vec2/Vec3/Vec4 value types. No gfx, so
// this runs on every host. Deterministic, golden-checked.
//
// Floats are never printed bare: the runtime prints %g at 6 significant
// digits and the freestanding path uses a hand-rolled %g that is explicitly
// not shortest-round-trip. Everything below prints an int or a bool.
import { Vec2, Vec3, Vec4 } from "vyto/geom";

fn near(a: float, b: float, eps: float): bool {
    let d = a - b;
    if (d < 0.0) { d = -d; }
    return d < eps;
}

fn main() {
    // ---- Vec2 (regression: unchanged by the Vec3/Vec4 addition) ----
    let a = Vec2(3.0, 4.0);
    print("v2len=" + (a.len() as int));
    print("v2dot=" + (a.dot(Vec2(2.0, 1.0)) as int));
    print("v2perp=" + (a.perp().x as int) + "," + (a.perp().y as int));
    print("v2norm=" + near(a.normalized().len(), 1.0, 1e-12));
    print("v2zeronorm=" + (Vec2(0.0, 0.0).normalized().len() as int));

    // ---- Vec3 ----
    let b = Vec3(1.0, 2.0, 2.0);          // length exactly 3
    print("v3len=" + (b.len() as int));
    print("v3len2=" + (b.len2() as int));
    print("v3dot=" + (b.dot(Vec3(2.0, 1.0, 1.0)) as int));
    print("v3add=" + (b.add(Vec3(1.0, 1.0, 1.0)).x as int));
    print("v3sub=" + (b.sub(Vec3(1.0, 1.0, 1.0)).y as int));
    print("v3scale=" + (b.scale(3.0).z as int));
    print("v3neg=" + (b.neg().x as int));
    print("v3dist=" + (Vec3(0.0, 0.0, 0.0).dist(Vec3(0.0, 3.0, 4.0)) as int));
    print("v3lerp=" + (Vec3(0.0, 0.0, 0.0).lerp(Vec3(10.0, 20.0, 30.0), 0.5).y as int));
    print("v3norm=" + near(b.normalized().len(), 1.0, 1e-12));
    print("v3zeronorm=" + (Vec3(0.0, 0.0, 0.0).normalized().len() as int));
    print("v3xy=" + (b.xy().x as int) + "," + (b.xy().y as int));

    // cross: x cross y == z, and the result is perpendicular to both
    let ex = Vec3(1.0, 0.0, 0.0);
    let ey = Vec3(0.0, 1.0, 0.0);
    let ez = ex.cross(ey);
    print("cross=" + (ez.x as int) + "," + (ez.y as int) + "," + (ez.z as int));
    print("crossPerp=" + (near(ez.dot(ex), 0.0, 1e-12) && near(ez.dot(ey), 0.0, 1e-12)));
    // anticommutative
    print("crossAnti=" + (ey.cross(ex).z as int));
    // a vector crossed with itself is zero
    print("crossSelf=" + (b.cross(b).len() as int));

    // ---- Vec4 ----
    let c = Vec4(1.0, 2.0, 2.0, 4.0);
    print("v4len2=" + (c.len2() as int));
    print("v4dot=" + (c.dot(Vec4(1.0, 1.0, 1.0, 1.0)) as int));
    print("v4add=" + (c.add(Vec4(1.0, 1.0, 1.0, 1.0)).w as int));
    print("v4sub=" + (c.sub(Vec4(1.0, 1.0, 1.0, 1.0)).x as int));
    print("v4scale=" + (c.scale(2.0).w as int));
    print("v4neg=" + (c.neg().z as int));
    print("v4lerp=" + (Vec4(0.0, 0.0, 0.0, 0.0).lerp(c, 0.5).w as int));
    print("v4norm=" + near(c.normalized().len(), 1.0, 1e-12));
    print("v4zeronorm=" + (Vec4(0.0, 0.0, 0.0, 0.0).normalized().len() as int));

    // the perspective divide, and dropping w afterwards
    let h = Vec4(2.0, 4.0, 6.0, 2.0).homogenized();
    print("homog=" + (h.x as int) + "," + (h.y as int) + "," + (h.z as int) + "," + (h.w as int));
    print("xyz=" + (c.xyz().x as int) + "," + (c.xyz().y as int) + "," + (c.xyz().z as int));
    // w == 0 is a direction, not a position: returned unchanged, no infinities
    let dir = Vec4(1.0, 2.0, 3.0, 0.0).homogenized();
    print("homogW0=" + (dir.x as int) + "," + (dir.w as int));
}
