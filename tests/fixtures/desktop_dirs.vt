// vyto/desktop's per-user folders. tests/run_tests.sh runs this under
// controlled HOME and XDG_* values.
import { configDir, dataDir, cacheDir } from "vyto/desktop";

fn main() {
    print(`config: {configDir("myapp")}`);
    print(`data: {dataDir("myapp")}`);
    print(`cache: {cacheDir("myapp")}`);
    print(`dotdot: [{configDir("../etc")}]`);
    print(`slash: [{configDir("a/b")}]`);
    print(`empty: [{configDir("")}]`);
    print(`colon: [{configDir("c:x")}]`);
}
