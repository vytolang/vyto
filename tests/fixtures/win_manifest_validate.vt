// WinManifest validates before it renders, and renders the line format vytoc
// reads. Runs anywhere: the builder is pure Vyto, nothing Windows about it.
import { WinManifest } from "vyto/win/manifest";

fn show(label: string, m: WinManifest) {
    let probs = m.validate();
    print(`{label}: {probs.len} problem(s)`);
    for (let p in probs) { print(`  {p}`); }
}

fn main() {
    let good = new WinManifest("Vyto Files").version("1.2.0").icon("assets/icon.png")
        .company("Vyto").description("A file manager").copyright("(c) 2026 Vyto");
    show("good", good);
    print(good.render());
    print("--");
    show("minimal", new WinManifest("Tool"));
    print(new WinManifest("Tool").render());
    print("--");
    show("empty name", new WinManifest(""));
    show("version letters", new WinManifest("A").version("1.x"));
    show("version too big", new WinManifest("A").version("70000.0"));
    show("version five parts", new WinManifest("A").version("1.2.3.4.5"));
    show("version empty part", new WinManifest("A").version("1..2"));
    show("four parts ok", new WinManifest("A").version("0.1.65535.9"));
    show("bad dpi", new WinManifest("A").dpi("PerMonitorV2"));
    show("unaware ok", new WinManifest("A").dpi("unaware"));
    show("system ok", new WinManifest("A").dpi("system"));
    show("bmp icon", new WinManifest("A").icon("icon.bmp"));
    show("upper ICO ok", new WinManifest("A").icon("ICON.ICO"));
    show("newline", new WinManifest("A").company("Vyto\nInc"));
}
