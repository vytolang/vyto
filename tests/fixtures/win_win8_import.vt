// Imports a function Windows 7 does not have (GetSystemTimePreciseAsFileTime
// is Windows 8+). `vytoc build --audit` must refuse it: this is the fault
// injection for the import audit (tests/run_tests.sh, win_audit_win8_fails).
// Built, never run.
#link "kernel32" if "windows"

extern "C" {
    fn GetSystemTimePreciseAsFileTime(ft: rawptr);
}

fn main() {
    let ft: int[] = [0];
    GetSystemTimePreciseAsFileTime(ft as rawptr);
    print("built");
}
