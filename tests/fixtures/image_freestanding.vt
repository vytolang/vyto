// Exists to be built with --freestanding, not run. image_shim.c is compiled
// with -ffreestanding -DVT_NO_LIBC like every package shim, so without its stub
// arm the <stdlib.h> that stb_image_write.h needs would break the build of any
// program that merely imports vyto/media/image. The stubs return each entry
// point's failure sentinel, so encodeAvailable() is false and encodePNGBytes
// gives an empty buffer — image.vt needs no platform conditional of its own.
//
// Deliberately imports only vyto/media/image, never vyto/media/image/decode:
// that one pulls in blend2d, which is C++ and could never build freestanding.
// The split between the two modules is what makes this fixture possible.
import { Image, encodePNGBytes, encodeAvailable } from "vyto/media/image";

fn main() {
    let img = new Image(2, 2);
    img.fill(0xFF102030);
    if (!encodeAvailable()) { print("no image encoder on this target"); }
    else { print("encoded " + str(encodePNGBytes(img).len) + " bytes"); }
}
