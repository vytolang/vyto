// Used by run_tests.sh: overflows i64 max + 1.
// Debug build must PANIC (checked); --release with -fwrapv must WRAP to i64
// min. Plain --release is C undefined behaviour and is deliberately not tested.
fn main() {
    let m: int = 9223372036854775807;
    let one: int = 1;
    print("" + (m + one));
}
