// A Windows GUI program: importing vyto/surface makes vytoc link it for the
// GUI subsystem. It opens no window, so run.ps1 can run it with redirected
// output, which also proves the runtime's console attach leaves redirected
// handles alone (a GUI exe that clobbered them would print nothing here).
//
// appDir() must be the exe's own directory, as a Windows path with forward
// slashes; the staging dir ships no lib/, so libDir() finds none.
import { Surface } from "vyto/surface";
import { appDir, libDir } from "vyto/os";

fn main() {
    let d = appDir();
    let drive = d.len >= 3 && d[1] == 58 && d[2] == 47;   // "C:/"
    print(`appDir is a drive path: {drive}`);
    print(`appDir has a backslash: {d.contains("\\")}`);
    let lib = libDir();
    if (lib.len == 0) { print("libDir: none"); } else { print(`libDir: {lib}`); }
}
