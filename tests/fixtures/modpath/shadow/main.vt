// A file beside the entry still beats a package root: alpha/config resolves
// here, not in ../vyto_modules/alpha/config. The stdlib's equivalent guard is
// tests/fixtures/libpath/shadow/, whose name this mirrors -- it must NOT be
// called local/, because .gitignore's bare `local` pattern matches a directory
// of that name at any depth and would silently leave the fixture uncommitted.
import { name } from "alpha/config";

fn main() {
    print(name());
}
