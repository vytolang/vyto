// Package alpha's config module. Package beta ships one with the same file
// stem: before package-root-scoped naming both were named 'config' and the
// build failed with "two modules share the name".
//
// The import below is package-INTERNAL and written as a bare stem, resolved
// against this file's own directory -- probe #1, ahead of every root, which is
// what lets a package be dropped anywhere and keep working.
import { tag } from "detail";

export fn alpha_name(): string {
    return "alpha config (" + tag() + ")";
}
