// Exercises the implicit vyto_modules/ root beside the entry file.
// Two packages each ship a config.vt: they coexist because each is named by
// its package-root-relative path (alpha_config, beta_config), which is what
// package-root-scoped naming buys. Before it, both were 'config' and this was
// a fatal error with no workaround available to either package.
import { alpha_name } from "alpha/config";
import { beta_name } from "beta/config";

fn main() {
    print(alpha_name());
    print(beta_name());
}
