// Mirror of condlink.vt for the Windows staging suite (run_tests_win.sh): the
// linux-only library must NOT reach the linker on a windows-x64 build, or this
// program could never link. condlink.vt itself is unlinkable on Windows by
// design, so the platform filter needs proving in both directions.
#link "vyto_no_such_library" if "linux"
#link "m" if "windows"

fn main() {
    print("conditional link ok");
}
