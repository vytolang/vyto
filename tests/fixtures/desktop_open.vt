// vyto/desktop's openUrl / openPath against a fake xdg-open
// (VYTO_DESKTOP_OPEN). Refused URLs must never reach the program at all; the
// accepted ones must arrive as one argument each.
import { openUrl, openPath } from "vyto/desktop";

fn main() {
    print(`https: {openUrl("https://example.com/a b?q=1&x='y'")}`);
    print(`mailto: {openUrl("MAILTO:someone@example.com")}`);
    print(`javascript: {openUrl("javascript:alert(1)")}`);
    print(`file: {openUrl("file:///etc/passwd")}`);
    print(`bare path: {openUrl("/usr/bin/xterm")}`);
    print(`empty: {openUrl("")}`);
    print(`scheme only: {openUrl("https://")}`);
    print(`newline: {openUrl("https://a\nb")}`);
    print(`dash path: {openPath("-x")}`);
}
