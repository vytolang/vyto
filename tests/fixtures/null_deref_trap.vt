// Used by run_tests.sh: dereferences a null reference.
// Debug build must PANIC naming file:line; --release must not carry the check.
//
// This exercises the DELIBERATE hole in the weak rule (docs/memory.md §3):
// passing a possibly-null reference along is allowed — only following it is
// refused — so the checker cannot catch this and only the runtime guard can.
// Before vt_ck_ptr this was a bare segfault at 0x8 with nothing naming it.
class Grid {
    n: int;
    fn init() { this.n = 7; }
    fn get(): int { return this.n; }
}

fn use(g: Grid): int { return g.get(); }

class Holder {
    g: weak Grid;
    fn init() { this.g = null; }
    fn go(): int { return use(this.g); }
}

fn main() {
    let h = new Holder();
    print("" + h.go());
}
