// Exists to be built with --freestanding, not run. secret_shim.c is compiled
// with -ffreestanding -DVT_NO_LIBC like every package shim, so without its stub
// arm the <fcntl.h>/<windows.h> includes would break the build of any program
// that merely imports vyto/desktop/secret. The stubs return each entry point's
// failure sentinel: nothing saved, nothing found.
import { secret_save, secret_load, secret_found } from "vyto/desktop/secret";

fn main() {
    let ok = secret_save("x.sec", "v");
    let v = secret_load("x.sec");
    print(`saved {ok} found {secret_found()} [{v}]`);
}
