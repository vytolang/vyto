// Fixture for native/<triple>/src and native/<triple>/stage (src/main.c).
// pt_common() lives in native/src and builds for every target; pt_target()
// exists once per triple dir, so which one links says which dir compiled.
extern "C" {
    fn pt_common(): cstring;
    fn pt_target(): cstring;
}

export fn common(): string { return str(pt_common()); }
export fn target(): string { return str(pt_target()); }
