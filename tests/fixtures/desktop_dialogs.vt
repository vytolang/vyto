// vyto/desktop's dialog layer against a fake zenity / kdialog
// (tests/fixtures/desktop/fake_dialog.sh): what each call returns, and the
// exact argv each program received. tests/run_tests.sh runs it once per
// backend with a queue of canned answers, in the order of the calls below.
import { FileDialog, message, confirm, desktop_available, MSG_INFO, MSG_ERROR } from "vyto/desktop";
import { getenv } from "vyto/os";
import { file_exists } from "vyto/io/file";

fn show(label: string, p: string?) {
    if (p == null) { print(`{label}: null`); } else { print(`{label}: {p}`); }
}

fn main() {
    print(`available: {desktop_available()}`);
    let d = new FileDialog().title("Open image").startIn("/tmp/start")
        .filter("Images", "*.png;*.jpg").filter("Text", "*.txt");
    show("open", d.open());
    let many = new FileDialog().title("Pick").openMany();
    print(`openMany: {many.len}`);
    for (let p in many) { print(`  {p}`); }
    show("save", new FileDialog().startIn("/tmp/start").save("out.txt"));
    show("folder", new FileDialog().title("Folder").folder());
    show("cancelled", new FileDialog().open());
    show("broken program", new FileDialog().open());
    print(`message: {message("Saved", "All done", MSG_INFO)}`);
    print(`error: {message("Oops", "-x <b>not markup</b>", MSG_ERROR)}`);
    print(`confirm yes: {confirm("Quit", "Discard?")}`);
    print(`confirm no: {confirm("Quit", "Discard?")}`);
    show("hostile", new FileDialog().title("$(touch pwned)'\"; --help `id`").startIn("-rf").open());
    show("owned", new FileDialog().owner(12345 as culong).open());
    print(`pwned exists: {file_exists("pwned")}`);
    let dir = getenv("FAKE_DIR");
    if (dir != "" && file_exists(dir + "/log")) {
        print("--- argv log ---");
        print(readfile(dir + "/log"));
    }
}
