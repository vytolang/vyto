// Exists to be built with --freestanding, not run. term_shim.c is compiled with
// -ffreestanding -DVT_NO_LIBC like every package shim, so without its stub arm
// the <termios.h> include would break the build of any program that merely
// imports vyto/terminal. The stubs report "not a terminal" — a state the hosted
// arms reach too, under a pipe — so raw_mode() gives null and terminal.vt needs
// no platform conditional of its own.
//
// vyto/terminal/ansi is pure Vyto and has to survive this too: it builds its
// escapes with chr(), so the strings are still constructed here, they simply
// have nowhere to go.
import { raw_mode, isatty, size, emit } from "vyto/terminal";
import { paint, RED } from "vyto/terminal/ansi";

fn main() {
    let t = raw_mode();
    if (t == null) { print("no terminal on this target"); }
    else { print("raw mode entered"); }
    print("isatty " + str(isatty()) + ", cols " + str(size()[0]));
    emit(paint("styled", RED));
}
