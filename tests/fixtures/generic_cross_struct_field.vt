// Holds a foreign module's generic struct instance as a by-value field. Before
// the emit_one_struct fix this emitted a second copy of the instance's body
// into this module's header and failed to compile with a C redefinition error.

import { Span, span_width } from "genstruct";

struct Holder {
    range: Span<int>;
    label: int;
}

fn main() {
    let s = Span(3, 11);
    print(str(span_width(s)));

    let h = Holder(Span(2, 5), 42);
    print(str(span_width(h.range)));
    print(str(h.label));

    // A second instantiation with different args, also from this module.
    let f = Span(0.5, 2.5);
    print(str(f.hi - f.lo));
}
