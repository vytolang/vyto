// dir_readable: can this directory actually be listed?
//
// The case that matters is a directory that exists, that isdir() and
// file_exists() both call true, and that listdir() nonetheless PANICS on
// because the process cannot open it. Without this predicate there is no way
// to ask first, so anything walking user-chosen paths dies on the first
// unreadable directory it meets.
//
// /root is the portable instance of that on Linux under an unprivileged user.
// Running as root would make it readable, so the assertion below is written to
// accept either answer there while still proving the no-panic property: the
// listdir is guarded, so this program must reach the end in both cases.

import { dir_readable } from "vyto/io/file";

fn main() {
    // A real, listable directory.
    print("tmp: " + dir_readable("tests/tmp"));
    // Not a directory at all.
    print("file: " + dir_readable("tests/fixtures/dir_readable.vt"));
    // Does not exist.
    print("missing: " + dir_readable("tests/tmp/no/such/dir"));

    // The guarded-listdir idiom this predicate exists for. /root is either
    // unreadable (normal) or readable (running as root); either way the guard
    // means we never reach listdir on a directory that would abort.
    let p = "/root";
    if (dir_readable(p)) { print("root: readable"); }
    else { print("root: denied"); }

    print("survived");
}
