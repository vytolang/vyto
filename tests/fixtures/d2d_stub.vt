// vyto/win/d2d off Windows: the package must still compile and link, since
// every native/src file builds on every target, and it must report itself
// unavailable rather than pretend. A desktop app can then import it from
// shared code and pick a painter at run time without a build break.
import { d2d_available } from "vyto/win/d2d";

fn main() {
    print(`d2d available: {d2d_available()}`);
}
