// Window.set_icon reaches the surface and is a safe no-op where there is no
// window manager (headless here). Too-small arrays and bad sizes are refused
// before they reach C, so a mistake cannot read past the pixels.
import { Window } from "vyto/ui";

fn main() {
    let win = new Window("icon", 100, 80);
    let px: i32[] = [];
    for (let i in 0..(16 * 16)) { px.push(0xFF2050C0 as i32); }
    win.set_icon(px, 16, 16);
    win.set_icon(px, 32, 32);   // array too small: refused
    win.set_icon(px, 0, 16);    // bad size: refused
    win.surface().set_icon(px, 16, 16);
    print("set_icon ok");
}
