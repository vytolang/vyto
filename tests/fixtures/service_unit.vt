// vyto/desktop/service's Linux install path: the generated systemd unit, and
// install/state/uninstall against VYTO_SYSTEMD_DIR (a temp dir, so no root and
// no systemctl). tests/run_tests.sh compares the output with a golden.
import { serviceInstall, serviceUninstall, serviceState, serviceError, systemdUnit,
         START_AUTO, START_MANUAL } from "vyto/desktop/service";
import { getenv } from "vyto/os";

fn main() {
    print(systemdUnit("vyto-sync", "Vyto sync", "/opt/vyto sync/sync --quiet", START_AUTO));
    print("---");
    print(`bad name: {serviceInstall("../etc/x", "", "", "/bin/true", "", START_AUTO)}`);
    print(`install: {serviceInstall("vyto-sync", "Vyto sync", "", "/opt/vyto sync/sync", "--quiet", START_MANUAL)}`);
    print(`state: {serviceState("vyto-sync")}`);
    print(readfile(getenv("VYTO_SYSTEMD_DIR") + "/vyto-sync.service"));
    print(`uninstall: {serviceUninstall("vyto-sync")}`);
    print(`state: {serviceState("vyto-sync")}`);
}
