// vyto/desktop under --freestanding: the shim's VT_NO_LIBC arm must compile
// with no libc at all and answer "unavailable" (tests/run_tests.sh checks the
// archive with nm, not the exit status).
import { desktop_available, configDir } from "vyto/desktop";

fn main() {
    print(`desktop: {desktop_available()} {configDir("x")}`);
}
