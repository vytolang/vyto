// A suite manifest wrong in every way the validation knows: the build must
// fail listing each one (tests/run_tests.sh, win_manifest_programs_refused).
import { WinManifest } from "vyto/win/manifest";

fn main() {
    new WinManifest("Bad Suite")
        .program("Bad Id", "x.vt")
        .program("dup", "a.vt").program("dup", "b.vt")
        .program("nofile", "readme.txt")
        .serviceFor("ghost", "Ghost", "Ghost", "", "auto")
        .serviceFor("dup", "SvcA", "A", "", "auto")
        .serviceFor("nofile", "SvcB", "B", "", "auto")
        .dependsOn("SvcA", "SvcB").dependsOn("SvcB", "SvcA")
        .dependsOn("SvcA", "Nowhere")
        .emit();
}
