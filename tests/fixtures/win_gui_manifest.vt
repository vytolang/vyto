// host by `vytoc build ... --manifest tests/fixtures/win_gui_manifest.vt`.
import { WinManifest } from "vyto/win/manifest";

fn main() {
    let m = new WinManifest("Vyto Test App")
        .version("1.2.3")
        .icon("win_app_icon.png")
        .company("Vyto Test Co")
        .description("Windows exe groundwork fixture")
        .copyright("(c) 2026 Vyto \"tests\"");
    m.emit();
}
