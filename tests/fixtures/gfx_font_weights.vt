// GfxPainter finds the medium and bold siblings of the regular face it is
// given, for both naming schemes in use:
//   Inter-Regular.ttf  -> Inter-Medium.ttf, Inter-Bold.ttf   (the house face)
//   DejaVuSans.ttf     -> DejaVuSans-Bold.ttf                (no medium face)
// Before the "-Regular" swap, Inter loaded one face and drew medium and bold
// text as regular, silently. faceCount() counts distinct files parsed.
import { Window } from "vyto/ui";
import { GfxPainter } from "vyto/gfx/painter";
import { interFontPath } from "vyto/gfx/fonts";
import { file_exists } from "vyto/io/file";

fn main() {
    let win = new Window("weights", 200, 100);
    let inter = new GfxPainter(win.surface(), interFontPath(), 15.0);
    print(`inter faces: {inter.canvas.faceCount()}`);
    let dejavu = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    if (file_exists(dejavu)) {
        let dv = new GfxPainter(win.surface(), dejavu, 15.0);
        print(`dejavu faces: {dv.canvas.faceCount()}`);
    } else {
        print("dejavu faces: 2");
    }
}
