// Exists to be built with --freestanding, not run. notify_shim.c's Linux arm
// dlopens libdbus and starts a worker pthread; under -DVT_NO_LIBC its stub arm
// must answer alone, as a system with no notification service.
import { notify, notify_available, NOTIFY_INFO } from "vyto/desktop/notify";

fn main() {
    if (!notify_available()) { print("no notifications on this target"); }
    print(`id {notify("t", "b", NOTIFY_INFO)}`);
}
