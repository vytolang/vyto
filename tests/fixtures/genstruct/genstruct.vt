// A generic *struct* declared in one module and instantiated by another. The
// instance is emitted into mod_genstruct's header; a module that holds one as
// a by-value field must not emit a second copy of the body. That was a real
// redefinition bug in emit_one_struct -- it recursed into any struct with a
// generic_origin regardless of which module owned it.

export struct Span<T> {
    lo: T;
    hi: T;
}

export fn span_width(s: Span<int>): int { return s.hi - s.lo; }
