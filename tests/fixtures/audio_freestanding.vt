// Exists to be built with --freestanding, not run. audio_shim.c and audio_ma.c
// are compiled with -ffreestanding -DVT_NO_LIBC like every package shim, and
// miniaudio needs pthreads, dlopen, libm and the whole of libc, so without
// their stub arms the build of any program that merely imports
// vyto/media/audio would break. The stubs answer as a machine with no sound
// card: audio_available() false, every open null.
import { audio_available, audio_open_playback } from "vyto/media/audio";

fn main() {
    if (!audio_available()) { print("no audio on this target"); }
    let p = audio_open_playback(48000, 2);
    if (p == null) { print("no playback device"); }
}
