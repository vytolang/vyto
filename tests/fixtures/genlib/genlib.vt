// A stand-in for a stdlib collections module: generic declarations that a
// *different* module instantiates with its own classes. Everything here is
// emitted into mod_genlib, so this file is what proves a foreign class type
// argument only needs a forward typedef there.

export class Box<T> {
    item: T;
    fn init(v: T) { this.item = v; }
    fn get(): T { return this.item; }
    fn put(v: T) { this.item = v; }
}

export class Pair<A, B> {
    a: A;
    b: B;
    fn init(x: A, y: B) { this.a = x; this.b = y; }
    fn first(): A { return this.a; }
    fn second(): B { return this.b; }
}

// Generic class holding an array of the foreign type: the field is a VtArray*,
// so it never spells T in the header at all.
export class Bag<T> {
    items: T[];
    fn init() { this.items = []; }
    fn add(v: T): int { this.items.push(v); return this.items.len; }
    fn len(): int { return this.items.len; }
    fn at(i: int): T { return this.items[i]; }
}

// Generic fn whose signature is all pointers -- legal with a foreign struct too.
export fn count_all<T>(xs: T[]): int { return xs.len; }

// Generic fn that takes T by value: legal for a class (pointer), and the case
// that must be rejected for a foreign struct.
export fn echo<T>(v: T): T { return v; }
