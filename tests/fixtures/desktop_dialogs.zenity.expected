zenity:
  [--file-selection]
  [--title=Open image]
  [--filename=/tmp/start/]
  [--file-filter=Images | *.png *.jpg]
  [--file-filter=Text | *.txt]
zenity:
  [--file-selection]
  [--title=Pick]
  [--multiple]
  [--separator=
]
zenity:
  [--file-selection]
  [--save]
  [--confirm-overwrite]
  [--filename=/tmp/start/out.txt]
zenity:
  [--file-selection]
  [--title=Folder]
  [--directory]
zenity:
  [--file-selection]
zenity:
  [--file-selection]
zenity:
  [--info]
  [--title=Saved]
  [--text=All done]
  [--no-markup]
zenity:
  [--error]
  [--title=Oops]
  [--text=-x <b>not markup</b>]
  [--no-markup]
zenity:
  [--question]
  [--title=Quit]
  [--text=Discard?]
  [--no-markup]
