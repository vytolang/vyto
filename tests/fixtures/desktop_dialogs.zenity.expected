available: true
open: /home/u/a.png
openMany: 2
  /x/1.txt
  /x/2 two.txt
save: /tmp/start/out.txt
folder: /home/u/dir
cancelled: null
broken program: null
message: true
error: true
confirm yes: true
confirm no: false
hostile: /ok
owned: /o
pwned exists: false
