---- the four walkers agree ----
  words: 3 3 3 3 3 agree=true
  zero-width: 4 4 4 4 4 agree=true
  empty on utf8: 6 6 6 6 6 agree=true
  empty over crlf: 4 4 4 4 4 agree=true
  word boundary: 4 4 4 4 4 agree=true
  no match: 0 0 0 0 0 agree=true
---- findAllText / findAllGroup ----
text=a1,b2,c3
group1=a,b,c
group2=1,2,3
cached: all=a1,b2 g2=1,2
unset group skipped: matches=3 group1=2
---- count ----
count=3 none=0
---- rx_quote ----
round-trip=true full=true
no wildcard leak=false
quoted='a\.b'
---- fullMatch ----
leftmost-first find=[0,1] fullMatch=true
trailing newline: test=true fullMatch=false
partial=false whole=true
groups survive wrap=b full=true
---- findOr / group / named ----
findOr hit=42 miss=?
rx_find_or=fallback
rx_group=bob missing=''
rx_named=bob absent=''
---- grep ----
grep=1 grep_v=3
caseless grep=2
first=ERROR disk full
trailing newline=1
---- offsets ----
indexOf=1 last=3
absent=-1/-1
---- trim / strip ----
trim='hi'
trim nothing='hi'
trim all=''
prefix='ab' absent='ab12'
suffix='ab' absent='12ab'
---- partition / splitKeep ----
partition=[a|,|b,c] n=3
no match=[abc||] rejoins=true
splitKeep n=5 rejoins=true [a/,/b/,/c]
---- replaceFn / each / replaceN ----
replaceFn=a@*** and c@***
upper=A@B
each collected=a@b,c@d
replaceN(1)=<a> c@d
replaceN(0)=a@b c@d
replaceN(9)=<a> <c>
rx_replace_first=Xaa (contrast replace_all)
---- expand ----
numbered=corp/bob
named=corp/bob
literal=$5
out of range='[]'
unknown escape=$x
trailing dollar=a$
unclosed brace=a${b
---- flags default to 0 on every rx_* ----
with=true without=false
count with=3 without=2
find_all with=3 without=2
find with=true without=false
flags key the cache: slots=2
---- rx_test_any ----
hit=true miss=false
---- rx_is_email_loose ----
  accept a@b.co = true
  accept first.last@sub.example.co.uk = true
  accept user+tag@x.io = true
  accept UPPER@EXAMPLE.COM = true
  accept x@y.z = true
  accept a..b@c.de = true
  reject '' = false
  reject 'plain' = false
  reject 'no@domain' = false
  reject '@example.com' = false
  reject 'a@.com' = false
  reject 'a@b.' = false
  reject 'a b@c.de' = false
  reject 'a@b c.de' = false
  reject 'a@b..co' = false
  reject 'two@at@x.co' = false
  5000-char non-match returns=false
  composable=true
---- rx_is_ipv4 ----
  accept 0.0.0.0 = true
  accept 255.255.255.255 = true
  accept 192.168.1.1 = true
  accept 8.8.8.8 = true
  reject '256.1.1.1' = false
  reject '1.2.3' = false
  reject '1.2.3.4.5' = false
  reject '01.2.3.4' = false
  reject '1.2.3.-1' = false
  reject '999.999.999.999' = false
  reject 'a.b.c.d' = false
  reject '' = false
  finds one in text=10.0.0.7
---- cache is not leaked by the walkers ----
40 walks over one pattern: slots=1
