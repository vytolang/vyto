// Imports vyto/db and NO driver.
//
// The point of this fixture is what it must NOT cause: building it may not
// compile a single SQLite object. Native sources are globbed per package
// directory for every module in the transitive import closure, so the moment
// something in vyto/db imports a driver, 9.5 MB of amalgamation lands in every
// program that only wanted to render a query string. run_tests.sh checks the
// object list, not just that this compiles.

import { select, table, dbInt, pgDialect, isIdent,
         TableInfo, ColumnInfo, obj_name, OBJ_TABLE } from "vyto/db";

fn main() {
    print(select("t").where("a", dbInt(1)).render(pgDialect()));
    print(table("t").id().createSql(pgDialect()));

    // The introspection records are pure Vyto and reachable with no driver —
    // reading a schema needs a connection, but describing one does not.
    let t = new TableInfo("users");
    t.cols.push(new ColumnInfo("id", "INTEGER"));
    print(obj_name(t.kind) + " " + t.name + " " + t.columnNames()[0]
          + " " + str(isIdent(t.name)));
}
