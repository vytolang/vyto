// A shadow's colour alpha is its opacity. gfx ignored it until 2026-11 and drew
// every shadow at full strength, so a theme asking for a soft shadow got a hard
// one. Two shadows that differ only in alpha must differ on screen: the
// half-alpha one lighter, the full one as dark as before.
import { Canvas } from "vyto/gfx";
import { rgb, rgba } from "vyto/surface";

// Red channel just below the caster, where the shadow is darkest.
fn under(alpha: int): int {
    let cv = new Canvas(120, 100);
    cv.clear(rgb(255, 255, 255));
    cv.shadowRound(30.0, 20.0, 60.0, 40.0, 8.0, 6.0, 4.0, rgba(0, 0, 0, alpha));
    cv.flush();
    return (cv.pixelAt(60, 64) >> 16) & 255;
}

fn main() {
    let full = under(255);
    let half = under(128);
    print(`full shadow visible: {full < 200}`);
    print(`half alpha is lighter: {half > full}`);
    print(`half alpha still visible: {half < 255}`);
}
