// vyto/desktop/print under --freestanding: the shim's VT_NO_LIBC arm must
// compile with no libc at all and answer "unavailable" (tests/run_tests.sh
// checks the archive with nm, not the exit status).
import { print_available, printer_state } from "vyto/desktop/print";

fn main() {
    print(`print: {print_available()} {printer_state("x")}`);
}
