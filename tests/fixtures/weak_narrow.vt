// The shapes that DO compile: a weak load is an optional, and every ordinary
// way of checking it narrows the path for the rest of that branch.
class Win {
    n: int;
    fn init(n: int) { this.n = n; }
    fn get(): int { return this.n; }
}

class Widget {
    win: weak Win;
    fn init() { this.win = null; }

    fn guarded(): int {
        if (this.win != null) { return this.win.get(); }
        return -1;
    }
    fn earlyExit(): int {
        if (this.win == null) { return -1; }
        return this.win.get() + this.win.n;      // still narrowed further down
    }
    fn shortCircuit(): int {
        if (this.win != null && this.win.n > 0) { return this.win.n; }
        return -1;
    }
    fn bound(): int {
        let w = this.win;
        if (w == null) { return -1; }
        return w.get();
    }
    fn elseSide(): int {
        if (this.win == null) { return -1; } else { return this.win.n; }
    }
    fn negated(): int {
        if (!(this.win == null)) { return this.win.n; }
        return -1;
    }
    fn looped(): int {
        let seen = -1;
        while (this.win != null) { seen = this.win.n; break; }
        return seen;
    }
    fn copyOfNarrowed(): int {
        if (this.win == null) { return -1; }
        let w = this.win;                         // already known non-null
        return w.n;
    }
}

fn main() {
    let w = new Widget();
    print("unset " + str(w.guarded()) + " " + str(w.bound()));

    // A weak slot holds nothing on its own: the strong reference lives here.
    let keep = new Win(7);
    w.win = keep;
    print("set " + str(w.guarded()) + " " + str(w.earlyExit()) + " "
          + str(w.shortCircuit()) + " " + str(w.bound()) + " "
          + str(w.elseSide()) + " " + str(w.negated()) + " "
          + str(w.looped()) + " " + str(w.copyOfNarrowed()));
}
