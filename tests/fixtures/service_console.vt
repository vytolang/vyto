// vyto/desktop/service as an ordinary program: tests/run_tests.sh starts it, sends
// SIGTERM (what systemd sends) and checks the body saw stopping() and that
// wait() woke early instead of sleeping out its 60 s. With NOTIFY_SOCKET set
// the test also receives READY=1 and STOPPING=1.
import { Service } from "vyto/desktop/service";
import { monoMs } from "vyto/util/time";

fn main() {
    let svc = new Service("vyto-test-svc");
    svc.run(() => {
        print(`service mode: {svc.isService()}`);
        let t0 = monoMs();
        let ticks = 0;
        while (!svc.stopping()) {
            ticks += 1;
            if (ticks == 1) { print("running"); }
            svc.wait(60000);
        }
        let dt = monoMs() - t0;
        print(`stopped after {ticks} tick(s), early: {dt < 30000}`);
    });
    print("exited cleanly");
}
