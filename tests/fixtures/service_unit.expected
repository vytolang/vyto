[Unit]
Description=Vyto sync
After=network.target

[Service]
Type=notify
ExecStart=/opt/vyto sync/sync --quiet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

---
bad name: false
install: true
state: 1
[Unit]
Description=Vyto sync
After=network.target

[Service]
Type=notify
ExecStart="/opt/vyto sync/sync" --quiet
Restart=on-failure
RestartSec=5

uninstall: true
state: -1
