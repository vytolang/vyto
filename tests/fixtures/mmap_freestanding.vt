// Exists to be built with --freestanding, not run. mmap_shim.c is compiled with
// -ffreestanding -DVT_NO_LIBC like every package shim, so without its stub arm
// the <sys/mman.h> include would break the build of any program that merely
// imports vyto/mmap. The stubs return each entry point's failure sentinel, so
// mmap_file gives null and mmap.vt needs no platform conditional of its own.
import { mmap_file } from "vyto/mmap";

fn main() {
    let m = mmap_file("anything");
    if (m == null) { print("no mapping on this target"); }
    else { print("mapped " + str(m.size())); }
}
