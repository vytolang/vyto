// file_mkdirs on a path written with backslashes. On Windows '\' separates
// components, so the nested folders must all exist afterwards; on POSIX '\'
// is an ordinary filename character, so the same string is ONE folder name.
// Goldens: .expected (POSIX) and .expected.windows-x64.
import { file_mkdirs, file_exists } from "vyto/io/file";

fn main() {
    let base = "tests/tmp/mkbs";
    let p = base + "\\a\\b";
    print(`mkdirs: {file_mkdirs(p)}`);
    print(`nested a: {isdir(base + "/a")}`);
    print(`nested a/b: {isdir(base + "/a/b")}`);
}
