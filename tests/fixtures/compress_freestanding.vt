// tests/fixtures/compress_freestanding.vt — vyto/compress must not break a
// --freestanding build of a program that merely imports it.
//
// This file exists to be BUILT, not to be run. --freestanding splices
// -ffreestanding -DVT_NO_LIBC -fno-builtin into every package shim's compile
// line (src/main.c:878-879), and native/src/*.c is globbed with no per-file
// filter — so an unguarded include anywhere in this package would break the
// freestanding build of anything importing it. Nothing else catches that: the
// base freestanding test builds 01_hello.vt, which imports nothing.
//
// zlib is built on an allocator, so there is nothing to degrade to. The wrapper
// TUs compile to nothing under VT_NO_LIBC and zlib_shim.c's stub arm answers
// instead, exactly as lib/vyto/db/sqlite/native/src/vsqlite3.c:16-23 does for
// SQLite. compressAvailable() is what surfaces that to Vyto, so compress.vt
// needs no platform conditional of its own.
import { compressAvailable, gzip_compress } from "vyto/compress";

fn main() {
    if (compressAvailable()) {
        let b = bytes(4);
        print("compress available, " + str(gzip_compress(b).len) + " bytes");
    } else {
        print("compress unavailable (freestanding)");
    }
}
