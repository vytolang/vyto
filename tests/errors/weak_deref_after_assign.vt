// A check narrows the path — until something writes to it. Assigning null and
// then dereferencing must be refused even though the check is right there.
class Win {
    n: int;
    fn init() { this.n = 1; }
}

class Widget {
    win: weak Win;
    fn init() { this.win = null; }
    fn use(): int {
        if (this.win == null) { return 0; }
        this.win = null;
        return this.win.n;
    }
}

fn main() { let w = new Widget(); print(str(w.use())); }
