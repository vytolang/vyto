// `T?` says "this may be null", so it is meaningless on a type that cannot hold
// null. Refuse it rather than accept a no-op annotation — the same reason
// `weak` is restricted to class types (tests/errors/weak_deref.vt).
class Holder {
    count: int?;
    fn init() { this.count = 0; }
}

fn main() {
    let h = new Holder();
    print("unreachable");
}
