// `s as rawptr` hands C the address of the struct itself. A temporary has no
// storage that outlives the enclosing statement, so taking its address would
// give a shim a pointer into a dead slot the moment the call returned. The
// operand has to be a named location; binding it to a local is the fix.
struct Ts { sec: i64; nsec: i64; }

extern "C" {
    fn clock_gettime(clk: i32, tp: rawptr): i32;
}

fn main() {
    clock_gettime(0 as i32, Ts(0 as i64, 0 as i64) as rawptr);
}
