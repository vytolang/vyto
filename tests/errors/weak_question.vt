// `weak` already reads as null once its target is gone, so `weak T?` would be
// a synonym for `weak T`. Refuse it rather than accept two spellings of one
// thing — see docs/memory.md §3.
class Win {
    fn init() {}
}

class Widget {
    win: weak Win?;
    fn init() { this.win = null; }
}

fn main() {
    let w = new Widget();
    print("unreachable");
}
