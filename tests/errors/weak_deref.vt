// A weak slot reads as null once its target is gone, so loading one yields a
// value that must be checked before it is used. Dereferencing it unchecked is
// the null dereference this rule exists to prevent — it used to compile, and
// crashed inside whatever function happened to touch the field.
class Win {
    fn init() {}
    fn hi(): int { return 1; }
}

class Widget {
    win: weak Win;
    fn init() { this.win = null; }
    fn paint(): int { return this.win.hi(); }
}

fn main() { let w = new Widget(); print(str(w.paint())); }
