// The reason enums exist: a variant nobody handled is a compile error, not a
// silent fall-through to default. Adding a variant later breaks every switch
// that forgot it.
enum Color { Red, Green, Blue }

fn main() {
    let c = Color.Red;
    switch (c) {
        case Color.Red:   { print("red"); }
        case Color.Green: { print("green"); }
    }
}
