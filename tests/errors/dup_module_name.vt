// Two files with the same stem, neither under a search root, so both are named
// 'thing'. A module name prefixes every emitted C symbol, so this is
// unbuildable rather than merely untidy -- putting one under a package root
// (where it would be named by its root-relative path) is the fix.
import { a_thing } from "dupmod/a/thing";
import { b_thing } from "dupmod/b/thing";

fn main() {
    print(a_thing());
    print(b_thing());
}
