// `this` is not in scope inside a closure body. The message must say so, and
// point at the binding workaround — not claim we are outside a method.
class Counter {
    n: int;
    fn init() { this.n = 0; }
    fn bump(by: int) { this.n = this.n + by; }
    fn wire(): fn(int) { return (by) => this.bump(by); }
}
fn main() { let c = new Counter(); c.wire()(1); }
