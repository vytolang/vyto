// binary_search<T> takes `key: T` by value, so instantiating it from another
// module with a struct declared here would make vyto/util/sort's header spell
// a type it cannot include. A class would be fine -- it is a pointer.
import { binary_search } from "vyto/util/sort";

struct Point { x: int; y: int; }

fn main() {
    let ps: Point[] = [Point(1, 2), Point(3, 4)];
    print(str(binary_search(ps, Point(1, 2), (a, b) => a.x - b.x)));
}
