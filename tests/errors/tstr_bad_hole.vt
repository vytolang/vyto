// A template hole accepts exactly what `+` accepts: strings, numbers, bools.
// A class has no string form, so interpolating one is a compile error rather
// than a silently-printed pointer.
class Widget {
    x: int;
    fn init() { this.x = 1; }
}

fn main() {
    let w = new Widget();
    print(`widget is {w}`);
}
