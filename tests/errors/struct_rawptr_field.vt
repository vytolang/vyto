// The cast is only safe when every field is a plain C-shaped value. An enum is
// a value type, so it passes the struct-field rule, but it has no guaranteed C
// counterpart — letting it through would hand a shim a layout the checker never
// promised. The test is recursive, so a nested struct cannot smuggle one in.
enum Color { RED, GREEN }

struct Inner { c: Color; }
struct Outer { i: Inner; x: i64; }

extern "C" {
    fn clock_gettime(clk: i32, tp: rawptr): i32;
}

fn main() {
    let o = Outer(Inner(Color.RED), 1 as i64);
    clock_gettime(0 as i32, o as rawptr);
}
