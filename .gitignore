# vendored SQLite amalgamation for 08_sqlite — fetched, not committed (see benchmarks/README.md)
benchmarks/native/src/sqlite3.c
benchmarks/native/src/sqlite3.h
tests/tmp/

# app build artifacts (built by tests via -o, or manually)
apps/chip8/chip8

# vyto/gfx: blend2d prebuilt dep (populated by build-blend2d.sh, not vendored)
lib/vyto/gfx/native/src/blend2d/
lib/vyto/gfx/native/*/libblend2d.*

# Provisioned per-triple headers for prebuilt native deps. vytoc searches
# native/<triple>/include ahead of native/src; each package's native/*.sh
# regenerates these, so they are never vendored.
lib/vyto/**/native/*/include/

# vyto/net: libcurl for windows-x64 (see native/provision-curl.sh). The DLL
# itself is shipped with a Vyto release, not carried in git.
lib/vyto/net/native/*/libcurl*
lib/vyto/net/native/*/curl-ca-bundle.crt

# built calc app binary
apps/calc/vytocalc
# Android build-verification: local only, so GitHub CI never has to download an
# NDK or an SDK. Needs ~/Android/{Ndk,Sdk} (or $ANDROID_NDK_HOME/$ANDROID_SDK_HOME).
tests/run_tests_android.sh
tests/android_jni_check.py
