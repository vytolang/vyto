// vyto/util/ascii — ASCII byte codes, named.
//
// Vyto has no character literal, so a byte scan is written as `s[i] == 47`
// and a comment has to say what 47 is. These constants say it in the code.
//
// They cost nothing. A const emits as a `static const int64_t` that the C
// compiler folds, so an imported name is exactly the literal it stands for —
// measured identical to the bare number over a 2M-iteration scan. `ord("/", 0)`
// is NOT the same thing: it is a real call per character, 2.2x slower in that
// loop, and it belongs in code that reads a character from data rather than
// naming a fixed one.
//
// Digits and letters are deliberately absent. `c >= ZERO && c <= NINE` reads no
// better than `c >= 48 && c <= 57`, and a parser wanting that should say
// is_digit(c). The set here is what a scanner actually compares against: the
// separators, quotes, brackets and control bytes.

// ---- control ----
export const CHAR_NUL: int = 0;           // the NUL byte
export const CHAR_BS: int = 8;            // backspace
export const CHAR_TAB: int = 9;           // horizontal tab
export const CHAR_LF: int = 10;           // newline
export const CHAR_FF: int = 12;           // form feed
export const CHAR_CR: int = 13;           // carriage return
export const CHAR_ESC: int = 27;          // escape
export const CHAR_DEL: int = 127;         // delete

// ---- space and punctuation ----
export const CHAR_SPACE: int = 32;        // a space
export const CHAR_BANG: int = 33;         // !
export const CHAR_DQUOTE: int = 34;       // "
export const CHAR_HASH: int = 35;         // #
export const CHAR_DOLLAR: int = 36;       // $
export const CHAR_PERCENT: int = 37;      // %
export const CHAR_AMP: int = 38;          // &
export const CHAR_SQUOTE: int = 39;       // '
export const CHAR_LPAREN: int = 40;       // (
export const CHAR_RPAREN: int = 41;       // )
export const CHAR_STAR: int = 42;         // *
export const CHAR_PLUS: int = 43;         // +
export const CHAR_COMMA: int = 44;        // ,
export const CHAR_MINUS: int = 45;        // -
export const CHAR_DOT: int = 46;          // .
export const CHAR_SLASH: int = 47;        // /

// ---- after the digits ----
export const CHAR_COLON: int = 58;        // :
export const CHAR_SEMI: int = 59;         // ;
export const CHAR_LT: int = 60;           // <
export const CHAR_EQ: int = 61;           // =
export const CHAR_GT: int = 62;           // >
export const CHAR_QUESTION: int = 63;     // ?
export const CHAR_AT: int = 64;           // @

// ---- after the uppercase letters ----
export const CHAR_LBRACKET: int = 91;     // [
export const CHAR_BACKSLASH: int = 92;    // \
export const CHAR_RBRACKET: int = 93;     // ]
export const CHAR_CARET: int = 94;        // ^
export const CHAR_UNDERSCORE: int = 95;   // _
export const CHAR_BACKTICK: int = 96;     // `

// ---- after the lowercase letters ----
export const CHAR_LBRACE: int = 123;      // {
export const CHAR_PIPE: int = 124;        // |
export const CHAR_RBRACE: int = 125;      // }
export const CHAR_TILDE: int = 126;       // ~

// ---- the ranges a scanner actually asks about ----
//
// Named as predicates rather than as ZERO/NINE/A/Z constants: the question is
// always "is this a digit", never "is this the byte 48".

export fn is_digit(c: int): bool { return c >= 48 && c <= 57; }
export fn is_upper(c: int): bool { return c >= 65 && c <= 90; }
export fn is_lower(c: int): bool { return c >= 97 && c <= 122; }
export fn is_alpha(c: int): bool { return is_upper(c) || is_lower(c); }
export fn is_alnum(c: int): bool { return is_alpha(c) || is_digit(c); }
export fn is_hex(c: int): bool {
    return is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

// Space, tab, CR, LF, form feed. What a parser means by "skip whitespace".
export fn is_space(c: int): bool {
    return c == CHAR_SPACE || c == CHAR_TAB || c == CHAR_CR || c == CHAR_LF || c == CHAR_FF;
}

// Printable, excluding space itself.
export fn is_print(c: int): bool { return c > CHAR_SPACE && c < CHAR_DEL; }

