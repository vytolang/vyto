// vyto/util/ascii — ASCII byte codes, named.
//
// Vyto has no character literal, so a byte scan is written as `s[i] == 47`
// and a comment has to say what 47 is. These constants say it in the code.
//
// They cost nothing. A const emits as a `static const int64_t` that the C
// compiler folds, so an imported name is exactly the literal it stands for —
// measured identical to the bare number over a 2M-iteration scan. `ord("/", 0)`
// is NOT the same thing: it is a real call per character, 2.2x slower in that
// loop, and it belongs in code that reads a character from data rather than
// naming a fixed one.
//
// Digits are absent on purpose: `c >= CHAR_ZERO && c <= CHAR_NINE` reads no
// better than the numbers, and a parser wanting that range should say
// is_digit(c) — see the predicates at the bottom. Letters ARE here, because a
// scanner tests them one at a time (`c == CHAR_LOWER_E` for an exponent), and
// that is a different question from a range.
//
// ---- CHAR_* vs vyto/surface's KEY_* --------------------------------------
//
// Two sets that overlap in value and answer different questions. CHAR_SPACE
// and KEY_SPACE are both 32; CHAR_LOWER_A and KEY_A are both 97.
//
//   CHAR_*  what byte is this?      Bytes in a string you are parsing. A
//                                   closed set: every value is one byte.
//   KEY_*   which key was pressed?  Codes from Surface.key(). An OPEN set —
//                                   printable ASCII *or* a named code >= 1000.
//
// The line is sharpest where they disagree: CHAR_LF is 10, KEY_ENTER is 1000.
// Pressing Enter does not produce byte 10, and a byte 10 in a file was not a
// key press. Reach for CHAR_* when the number came from a string and KEY_*
// when it came from the keyboard — swapping them compiles and then misbehaves
// quietly, which is why this paragraph exists.

// ---- control ----
export const CHAR_NUL: int = 0;           // the NUL byte
export const CHAR_BS: int = 8;            // backspace
export const CHAR_TAB: int = 9;           // horizontal tab
export const CHAR_LF: int = 10;           // newline
export const CHAR_FF: int = 12;           // form feed
export const CHAR_CR: int = 13;           // carriage return
export const CHAR_ESC: int = 27;          // escape
export const CHAR_DEL: int = 127;         // delete

// ---- space and punctuation ----
export const CHAR_SPACE: int = 32;        // a space
export const CHAR_BANG: int = 33;         // !
export const CHAR_DQUOTE: int = 34;       // "
export const CHAR_HASH: int = 35;         // #
export const CHAR_DOLLAR: int = 36;       // $
export const CHAR_PERCENT: int = 37;      // %
export const CHAR_AMP: int = 38;          // &
export const CHAR_SQUOTE: int = 39;       // '
export const CHAR_LPAREN: int = 40;       // (
export const CHAR_RPAREN: int = 41;       // )
export const CHAR_STAR: int = 42;         // *
export const CHAR_PLUS: int = 43;         // +
export const CHAR_COMMA: int = 44;        // ,
export const CHAR_MINUS: int = 45;        // -
export const CHAR_DOT: int = 46;          // .
export const CHAR_SLASH: int = 47;        // /

// ---- after the digits ----
export const CHAR_COLON: int = 58;        // :
export const CHAR_SEMI: int = 59;         // ;
export const CHAR_LT: int = 60;           // <
export const CHAR_EQ: int = 61;           // =
export const CHAR_GT: int = 62;           // >
export const CHAR_QUESTION: int = 63;     // ?
export const CHAR_AT: int = 64;           // @

// ---- after the uppercase letters ----
export const CHAR_LBRACKET: int = 91;     // [
export const CHAR_BACKSLASH: int = 92;    // \
export const CHAR_RBRACKET: int = 93;     // ]
export const CHAR_CARET: int = 94;        // ^
export const CHAR_UNDERSCORE: int = 95;   // _
export const CHAR_BACKTICK: int = 96;     // `

// ---- after the lowercase letters ----
export const CHAR_LBRACE: int = 123;      // {
export const CHAR_PIPE: int = 124;        // |
export const CHAR_RBRACE: int = 125;      // }
export const CHAR_TILDE: int = 126;       // ~

// ---- letters ----
//
// Both cases, named symmetrically: a parser that accepts either writes
// `c == CHAR_LOWER_E || c == CHAR_UPPER_E`, and neither case is the silent
// default. (vyto/surface's KEY_A is lowercase-by-default for the opposite
// reason: that is what an unshifted press delivers.)

export const CHAR_LOWER_A: int = 97;   // 'a'
export const CHAR_LOWER_B: int = 98;   // 'b'
export const CHAR_LOWER_C: int = 99;   // 'c'
export const CHAR_LOWER_D: int = 100;   // 'd'
export const CHAR_LOWER_E: int = 101;   // 'e'
export const CHAR_LOWER_F: int = 102;   // 'f'
export const CHAR_LOWER_G: int = 103;   // 'g'
export const CHAR_LOWER_H: int = 104;   // 'h'
export const CHAR_LOWER_I: int = 105;   // 'i'
export const CHAR_LOWER_J: int = 106;   // 'j'
export const CHAR_LOWER_K: int = 107;   // 'k'
export const CHAR_LOWER_L: int = 108;   // 'l'
export const CHAR_LOWER_M: int = 109;   // 'm'
export const CHAR_LOWER_N: int = 110;   // 'n'
export const CHAR_LOWER_O: int = 111;   // 'o'
export const CHAR_LOWER_P: int = 112;   // 'p'
export const CHAR_LOWER_Q: int = 113;   // 'q'
export const CHAR_LOWER_R: int = 114;   // 'r'
export const CHAR_LOWER_S: int = 115;   // 's'
export const CHAR_LOWER_T: int = 116;   // 't'
export const CHAR_LOWER_U: int = 117;   // 'u'
export const CHAR_LOWER_V: int = 118;   // 'v'
export const CHAR_LOWER_W: int = 119;   // 'w'
export const CHAR_LOWER_X: int = 120;   // 'x'
export const CHAR_LOWER_Y: int = 121;   // 'y'
export const CHAR_LOWER_Z: int = 122;   // 'z'

export const CHAR_UPPER_A: int = 65;   // 'A'
export const CHAR_UPPER_B: int = 66;   // 'B'
export const CHAR_UPPER_C: int = 67;   // 'C'
export const CHAR_UPPER_D: int = 68;   // 'D'
export const CHAR_UPPER_E: int = 69;   // 'E'
export const CHAR_UPPER_F: int = 70;   // 'F'
export const CHAR_UPPER_G: int = 71;   // 'G'
export const CHAR_UPPER_H: int = 72;   // 'H'
export const CHAR_UPPER_I: int = 73;   // 'I'
export const CHAR_UPPER_J: int = 74;   // 'J'
export const CHAR_UPPER_K: int = 75;   // 'K'
export const CHAR_UPPER_L: int = 76;   // 'L'
export const CHAR_UPPER_M: int = 77;   // 'M'
export const CHAR_UPPER_N: int = 78;   // 'N'
export const CHAR_UPPER_O: int = 79;   // 'O'
export const CHAR_UPPER_P: int = 80;   // 'P'
export const CHAR_UPPER_Q: int = 81;   // 'Q'
export const CHAR_UPPER_R: int = 82;   // 'R'
export const CHAR_UPPER_S: int = 83;   // 'S'
export const CHAR_UPPER_T: int = 84;   // 'T'
export const CHAR_UPPER_U: int = 85;   // 'U'
export const CHAR_UPPER_V: int = 86;   // 'V'
export const CHAR_UPPER_W: int = 87;   // 'W'
export const CHAR_UPPER_X: int = 88;   // 'X'
export const CHAR_UPPER_Y: int = 89;   // 'Y'
export const CHAR_UPPER_Z: int = 90;   // 'Z'
// ---- the ranges a scanner actually asks about ----
//
// Named as predicates rather than as ZERO/NINE/A/Z constants: the question is
// always "is this a digit", never "is this the byte 48".

export fn is_digit(c: int): bool { return c >= 48 && c <= 57; }
export fn is_upper(c: int): bool { return c >= 65 && c <= 90; }
export fn is_lower(c: int): bool { return c >= 97 && c <= 122; }
export fn is_alpha(c: int): bool { return is_upper(c) || is_lower(c); }
export fn is_alnum(c: int): bool { return is_alpha(c) || is_digit(c); }
export fn is_hex(c: int): bool {
    return is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

// Space, tab, CR, LF, form feed. What a parser means by "skip whitespace".
export fn is_space(c: int): bool {
    return c == CHAR_SPACE || c == CHAR_TAB || c == CHAR_CR || c == CHAR_LF || c == CHAR_FF;
}

// Printable, excluding space itself.
export fn is_print(c: int): bool { return c > CHAR_SPACE && c < CHAR_DEL; }

