// vyto/util/json — a JSON parser and serializer, pure Vyto.
//
// The value tree is a tagged `JsonValue` (Vyto has no generics, so one class
// carries every kind). Parsing is recursive descent over the raw bytes:
//
//     let v = json_parse("{\"name\":\"ada\",\"score\":42,\"tags\":[\"x\",\"y\"]}");
//     v.get("name").asString()          // "ada"
//     v.get("score").asInt()            // 42
//     v.get("tags").at(0).asString()    // "x"
//     v.stringify()                     // compact round-trip
//
// Failure is *soft*: `json_parse` never panics on bad input — it returns a Null-kind
// value whose `parseError()` explains what went wrong. Accessors are forgiving
// too (missing key / wrong kind / out-of-range index yield a Null value or a
// zero default), so callers can walk an uncertain document without guarding
// every hop. Numbers are stored as `float`; `asInt` truncates.
//
// Caveat: a JSON string containing an embedded U+0000 is truncated at the NUL,
// because Vyto strings reach C as NUL-terminated buffers. Every other byte
// round-trips exactly.

import { fmt, fs, fi } from "vyto/util/fmt";
import { StringBuilder } from "vyto/util/text";
import { is_digit, is_hex, CHAR_BACKSLASH, CHAR_BS, CHAR_COLON, CHAR_COMMA,
         CHAR_CR, CHAR_DOT, CHAR_DQUOTE, CHAR_FF, CHAR_LBRACE,
         CHAR_LBRACKET, CHAR_LF, CHAR_LOWER_A, CHAR_LOWER_B, CHAR_LOWER_E,
         CHAR_LOWER_F, CHAR_LOWER_N, CHAR_LOWER_R, CHAR_LOWER_T,
         CHAR_LOWER_U, CHAR_MINUS, CHAR_PLUS, CHAR_RBRACE, CHAR_RBRACKET,
         CHAR_SLASH, CHAR_SPACE, CHAR_TAB, CHAR_UPPER_A, CHAR_UPPER_E,
         CHAR_UPPER_F, CHAR_ZERO } from "vyto/util/ascii";

// What a JsonValue is. The payload it selects among lives in the flattened
// num/bstr/bval/arr/keys/vals fields below, which the tag does not police.
export enum JSON { NULL, BOOL, NUM, STR, ARR, OBJ }

export class JsonValue {
    kind: JSON;
    num: float;
    bstr: string;               // string payload (kind == JSON.STR)
    bval: bool;                 // bool payload (kind == JSON.BOOL)
    arr: JsonValue[];           // array elements (kind == JSON.ARR only)
    keys: string[];             // object key insertion order (kind == JSON.OBJ)
    vals: JsonValue[];          // object member values, parallel to keys (JSON.OBJ)
    err: string;                // non-empty only on a parse-failure root

    // Sub-containers are allocated per kind, not up front: a leaf (null / bool /
    // number / string) holds none. Objects store members in parallel keys/vals
    // arrays (linear scan) rather than a hash Map, so a small object costs two
    // tiny arrays instead of a 64-bucket table — the difference between ~2.7 GB
    // and ~0.3 GB when parsing a million-object document.
    fn init(k: JSON) {
        this.kind = k;
        this.err = "";
        if (k == JSON.ARR) { this.arr = []; }
        if (k == JSON.OBJ) { this.keys = []; this.vals = []; }
    }

    fn isNull(): bool { return this.kind == JSON.NULL; }
    fn isObj(): bool  { return this.kind == JSON.OBJ; }
    fn isArr(): bool  { return this.kind == JSON.ARR; }
    fn isNum(): bool  { return this.kind == JSON.NUM; }
    fn isStr(): bool  { return this.kind == JSON.STR; }
    fn isBool(): bool { return this.kind == JSON.BOOL; }

    // Index of member `k` in an object's key list, or -1 (linear scan).
    fn keyIndex(k: string): int {
        if (this.kind != JSON.OBJ) { return -1; }
        let i = 0;
        while (i < this.keys.len) {
            if (this.keys[i] == k) { return i; }
            i += 1;
        }
        return -1;
    }

    // Object member, or a Null value if this is not an object / has no such key.
    fn get(k: string): JsonValue {
        let idx = this.keyIndex(k);
        if (idx >= 0) { return this.vals[idx]; }
        return new JsonValue(JSON.NULL);
    }
    fn has(k: string): bool { return this.keyIndex(k) >= 0; }

    // Array element, or a Null value if not an array / index out of range.
    fn at(i: int): JsonValue {
        if (this.kind == JSON.ARR && i >= 0 && i < this.arr.len) { return this.arr[i]; }
        return new JsonValue(JSON.NULL);
    }

    // Element count for arrays and objects; 0 otherwise.
    fn len(): int {
        if (this.kind == JSON.ARR) { return this.arr.len; }
        if (this.kind == JSON.OBJ) { return this.keys.len; }
        return 0;
    }

    fn asFloat(): float {
        if (this.kind == JSON.NUM) { return this.num; }
        if (this.kind == JSON.BOOL) { if (this.bval) { return 1.0; } return 0.0; }
        return 0.0;
    }
    fn asInt(): int { return this.asFloat() as int; }
    fn asBool(): bool {
        if (this.kind == JSON.BOOL) { return this.bval; }
        if (this.kind == JSON.NUM) { return this.num != 0.0; }
        return false;
    }
    fn asString(): string {
        if (this.kind == JSON.STR) { return this.bstr; }
        return "";
    }

    // Object keys in insertion order (empty for non-objects).
    fn objKeys(): string[] {
        if (this.kind == JSON.OBJ) { return this.keys; }
        return [];
    }

    fn parseError(): string { return this.err; }

    // Add/replace a member (only meaningful on an object).
    fn set(k: string, v: JsonValue) {
        if (this.kind != JSON.OBJ) { return; }
        let idx = this.keyIndex(k);
        if (idx >= 0) { this.vals[idx] = v; }
        else { this.keys.push(k); this.vals.push(v); }
    }
    fn append(v: JsonValue) {
        if (this.kind != JSON.ARR) { return; }
        this.arr.push(v);
    }

    fn stringify(): string {
        let sb = new StringBuilder(64);
        write_sb(this, sb, false, 0);
        return sb.toString();
    }
    fn stringifyPretty(): string {
        let sb = new StringBuilder(64);
        write_sb(this, sb, true, 0);
        return sb.toString();
    }
}

// ---- constructors --------------------------------------------------------

export fn jnull(): JsonValue { return new JsonValue(JSON.NULL); }
export fn jbool(b: bool): JsonValue { let v = new JsonValue(JSON.BOOL); v.bval = b; return v; }
export fn jnum(n: float): JsonValue { let v = new JsonValue(JSON.NUM); v.num = n; return v; }
export fn jint(n: int): JsonValue { let v = new JsonValue(JSON.NUM); v.num = n as float; return v; }
export fn jstr(s: string): JsonValue { let v = new JsonValue(JSON.STR); v.bstr = s; return v; }
export fn jarr(): JsonValue { return new JsonValue(JSON.ARR); }
export fn jobj(): JsonValue { return new JsonValue(JSON.OBJ); }

// ---- parser --------------------------------------------------------------

// Maximum container nesting the parser accepts (and the serializer emits).
// Recursive descent means depth = stack frames; unbounded input like
// "[[[[..." would otherwise crash on stack overflow instead of soft-failing.
const JSON_MAX_DEPTH: int = 1024;

class Parser {
    s: string;
    pos: int;
    n: int;
    err: string;
    depth: int;

    fn init(s: string) { this.s = s; this.pos = 0; this.n = s.len; this.err = ""; this.depth = 0; }

    fn fail(msg: string): JsonValue {
        if (this.err == "") { this.err = fmt("%s at byte %d", [fs(msg), fi(this.pos)]); }
        let v = new JsonValue(JSON.NULL);
        v.err = this.err;
        return v;
    }

    fn ws() {
        while (this.pos < this.n) {
            let c = this.s[this.pos];
            if (c == CHAR_SPACE || c == CHAR_TAB || c == CHAR_LF || c == CHAR_CR) { this.pos += 1; } else { break; }
        }
    }

    // Scalar-array decode helpers (jsonToInts/Floats/Strings). Consume the '['
    // opener; report the empty-array close; and after each element consume a
    // ',' (continue) or ']' (stop). Soft: any unexpected byte just stops.
    fn openArray(): bool {
        this.ws();
        if (this.pos >= this.n || this.s[this.pos] != CHAR_LBRACKET) { return false; }
        this.pos += 1;
        return true;
    }
    fn closeEmpty(): bool {
        this.ws();
        if (this.pos < this.n && this.s[this.pos] == CHAR_RBRACKET) { this.pos += 1; return true; }
        return false;
    }
    fn afterElement(): bool {
        this.ws();
        if (this.pos >= this.n) { return false; }
        let c = this.s[this.pos];
        if (c == CHAR_COMMA) { this.pos += 1; return true; }
        if (c == CHAR_RBRACKET) { this.pos += 1; return false; }
        return false;                                 // malformed → stop
    }

    fn value(): JsonValue {
        this.depth += 1;
        if (this.depth > JSON_MAX_DEPTH) {
            this.depth -= 1;
            return this.fail("nesting deeper than 1024 levels");
        }
        let v = this.value_inner();
        this.depth -= 1;
        return v;
    }

    fn value_inner(): JsonValue {
        this.ws();
        if (this.pos >= this.n) { return this.fail("unexpected end of input"); }
        let c = this.s[this.pos];
        if (c == CHAR_LBRACE) { return this.object(); }
        if (c == CHAR_LBRACKET) { return this.array(); }
        if (c == CHAR_DQUOTE) { return this.string_v(); }
        if (c == CHAR_LOWER_T) { return this.lit("true", jbool(true)); }
        if (c == CHAR_LOWER_F) { return this.lit("false", jbool(false)); }
        if (c == CHAR_LOWER_N) { return this.lit("null", jnull()); }
        if (c == CHAR_MINUS || is_digit(c)) { return this.number(); }
        return this.fail("unexpected character");
    }

    fn lit(word: string, v: JsonValue): JsonValue {
        if (this.pos + word.len > this.n) { return this.fail("invalid literal"); }
        if (this.s.slice(this.pos, this.pos + word.len) != word) { return this.fail("invalid literal"); }
        this.pos += word.len;
        return v;
    }

    // Strict number scan (sign, int, .frac, exponent). to_float_at PANICS on a
    // malformed token, so the shape must be fully validated here — the
    // "json_parse never panics" contract depends on it. Returns the value, or
    // sets this.err (via fail) and returns 0 on a malformed token. Shared by
    // number() and the scalar-array decoders, so neither allocates a JsonValue
    // node just to read a number.
    fn scan_number(): float {
        let start = this.pos;
        if (this.pos < this.n && this.s[this.pos] == CHAR_MINUS) { this.pos += 1; }
        let intStart = this.pos;
        while (this.pos < this.n && is_digit(this.s[this.pos])) { this.pos += 1; }
        if (this.pos == intStart) { this.fail("invalid number"); return 0.0; }
        if (this.pos < this.n && this.s[this.pos] == CHAR_DOT) {
            this.pos += 1;
            let fracStart = this.pos;
            while (this.pos < this.n && is_digit(this.s[this.pos])) { this.pos += 1; }
            if (this.pos == fracStart) { this.fail("invalid number"); return 0.0; }
        }
        if (this.pos < this.n && (this.s[this.pos] == CHAR_LOWER_E || this.s[this.pos] == CHAR_UPPER_E)) {
            this.pos += 1;
            if (this.pos < this.n && (this.s[this.pos] == CHAR_PLUS || this.s[this.pos] == CHAR_MINUS)) { this.pos += 1; }
            let expStart = this.pos;
            while (this.pos < this.n && is_digit(this.s[this.pos])) { this.pos += 1; }
            if (this.pos == expStart) { this.fail("invalid number"); return 0.0; }
        }
        // parse the float directly from the source range — no substring alloc
        return this.s.to_float_at(start, this.pos);
    }

    fn number(): JsonValue {
        let x = this.scan_number();
        if (this.err != "") { return this.fail("invalid number"); }
        return jnum(x);
    }

    // Parse a JSON string literal starting at the opening quote.
    fn string_v(): JsonValue {
        let sv = this.raw_string();
        if (this.err != "") { return this.fail(this.err); }
        return jstr(sv);
    }

    // Shared by string_v and object() (keys) — returns the decoded contents,
    // or sets this.err.
    fn raw_string(): string {
        this.pos += 1; // opening quote
        let out = "";
        let runStart = this.pos;
        while (this.pos < this.n) {
            let c = this.s[this.pos];
            if (c == CHAR_DQUOTE) { // closing quote
                // common case: no escape seen yet, so the run *is* the whole
                // string — return the slice directly, skipping the "" + slice
                // concat (one alloc per key/string value).
                if (out == "") {
                    let r = this.s.slice(runStart, this.pos);
                    this.pos += 1;
                    return r;
                }
                out = out + this.s.slice(runStart, this.pos);
                this.pos += 1;
                return out;
            }
            if (c == CHAR_BACKSLASH) { // backslash
                out = out + this.s.slice(runStart, this.pos);
                this.pos += 1;
                if (this.pos >= this.n) { this.err = "unterminated escape"; return ""; }
                let e = this.s[this.pos];
                if (e == CHAR_DQUOTE) { out = out + "\""; }
                else if (e == CHAR_BACKSLASH) { out = out + "\\"; }
                else if (e == CHAR_SLASH) { out = out + "/"; }
                else if (e == CHAR_LOWER_B) { out = out + chr(CHAR_BS); }
                else if (e == CHAR_LOWER_F) { out = out + chr(CHAR_FF); }
                else if (e == CHAR_LOWER_N) { out = out + chr(CHAR_LF); }
                else if (e == CHAR_LOWER_R) { out = out + chr(CHAR_CR); }
                else if (e == CHAR_LOWER_T) { out = out + chr(CHAR_TAB); }
                else if (e == CHAR_LOWER_U) { out = out + this.unicode_escape(); }
                else { this.err = "bad escape"; return ""; }
                this.pos += 1;
                runStart = this.pos;
            } else {
                this.pos += 1;
            }
        }
        this.err = "unterminated string";
        return "";
    }

    // At a 'u'; consume 4 hex digits (and a surrogate pair if present) and
    // return the UTF-8 encoding. Leaves pos on the last consumed hex digit.
    // Unpaired/stray surrogates become U+FFFD instead of invalid UTF-8.
    fn unicode_escape(): string {
        let cp = this.hex4();
        if (cp >= 0xD800 && cp <= 0xDBFF) {
            // high surrogate — expect a following \uXXXX low surrogate
            if (this.pos + 2 < this.n && this.s[this.pos + 1] == CHAR_BACKSLASH && this.s[this.pos + 2] == CHAR_LOWER_U) {
                this.pos += 2; // move onto the second 'u'
                let lo = this.hex4();
                if (lo >= 0xDC00 && lo <= 0xDFFF) {
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                } else {
                    // not a low surrogate: replace the high one, keep the
                    // second escape's character (itself replaced if stray)
                    let second = lo;
                    if (second >= 0xD800 && second <= 0xDFFF) { second = 0xFFFD; }
                    return utf8_encode(0xFFFD) + utf8_encode(second);
                }
            } else {
                cp = 0xFFFD; // unpaired high surrogate
            }
        } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
            cp = 0xFFFD; // stray low surrogate
        }
        return utf8_encode(cp);
    }

    // Reads 4 hex digits starting just after the current 'u'; advances pos to
    // the last digit. Sets err (and returns U+FFFD) on a short or non-hex
    // escape — silently reading garbage as 0 would corrupt round-trips.
    fn hex4(): int {
        let v = 0;
        let k = 0;
        while (k < 4 && this.pos + 1 < this.n) {
            this.pos += 1;
            let c = this.s[this.pos];
            if (!is_hex(c)) {
                if (this.err == "") { this.err = fmt("bad \\u escape at byte %d", [fi(this.pos)]); }
                return 0xFFFD;
            }
            v = (v << 4) | hex_digit(c);
            k += 1;
        }
        if (k < 4) {
            if (this.err == "") { this.err = "bad \\u escape (truncated)"; }
            return 0xFFFD;
        }
        return v;
    }

    fn array(): JsonValue {
        this.pos += 1; // '['
        let a = jarr();
        this.ws();
        if (this.pos < this.n && this.s[this.pos] == CHAR_RBRACKET) { this.pos += 1; return a; }
        while (true) {
            let el = this.value();
            if (this.err != "") { return this.fail(this.err); }
            a.arr.push(el);
            this.ws();
            if (this.pos >= this.n) { return this.fail("unterminated array"); }
            let c = this.s[this.pos];
            if (c == CHAR_COMMA) { this.pos += 1; continue; }
            if (c == CHAR_RBRACKET) { this.pos += 1; return a; }
            return this.fail("expected ',' or ']'");
        }
        return a;
    }

    fn object(): JsonValue {
        this.pos += 1; // '{'
        let o = jobj();
        this.ws();
        if (this.pos < this.n && this.s[this.pos] == CHAR_RBRACE) { this.pos += 1; return o; }
        while (true) {
            this.ws();
            if (this.pos >= this.n || this.s[this.pos] != CHAR_DQUOTE) { return this.fail("expected string key"); }
            let key = this.raw_string();
            if (this.err != "") { return this.fail(this.err); }
            this.ws();
            if (this.pos >= this.n || this.s[this.pos] != CHAR_COLON) { return this.fail("expected ':'"); }
            this.pos += 1;
            let val = this.value();
            if (this.err != "") { return this.fail(this.err); }
            o.set(key, val);
            this.ws();
            if (this.pos >= this.n) { return this.fail("unterminated object"); }
            let c = this.s[this.pos];
            if (c == CHAR_COMMA) { this.pos += 1; continue; }
            if (c == CHAR_RBRACE) { this.pos += 1; return o; }
            return this.fail("expected ',' or '}'");
        }
        return o;
    }
}

// Parse `text` into a navigable JsonValue. Never panics; on malformed input
// returns a Null value whose `parseError()` is non-empty.
export fn json_parse(text: string): JsonValue {
    let p = new Parser(text);
    let v = p.value();
    if (p.err != "") { return v; }
    p.ws();
    if (p.pos != p.n) { return p.fail("trailing characters after value"); }
    return v;
}

// Stream the elements of a top-level JSON array WITHOUT building the whole tree:
// `cb` is invoked with each element as a transient JsonValue that is freed
// before the next element is parsed. Peak memory is one element plus the source
// text — O(1) in the element count — so a million-object array parses in tens of
// MB instead of the full DOM's hundreds. The systems-friendly counterpart to
// json_parse; use json_parse when you need random access to the whole document.
//
//     let acc = [0];   // ref container: closures capture by value, so mutate
//     json_each(text, (o) => { acc[0] = acc[0] + o.get("value").asInt(); });
//
// Malformed input stops the stream (soft-fail, like json_parse). Do NOT retain
// the element past the callback — it is released as soon as `cb` returns.
export fn json_each(text: string, cb: fn(JsonValue)) {
    let p = new Parser(text);
    p.ws();
    if (p.pos >= p.n || p.s[p.pos] != CHAR_LBRACKET) { return; } // not a '[' array
    p.pos += 1;
    p.ws();
    if (p.pos < p.n && p.s[p.pos] == CHAR_RBRACKET) { return; }  // empty '[]'
    while (true) {
        let el = p.value();
        if (p.err != "") { return; }
        cb(el);                       // el is released at the end of this iteration
        p.ws();
        if (p.pos >= p.n) { return; }
        let c = p.s[p.pos];
        if (c == CHAR_COMMA) { p.pos += 1; continue; }
        return;                                // ']' or unexpected: done
    }
}

// Decode a JSON string into a value. In Vyto (no generics) a JsonValue *is* the
// map-or-list container: an object decodes to a value you index with `.get(key)`
// / `.objKeys()`, an array to one you index with `.at(i)` / `.len()`. Alias of
// json_parse, named for the encode/decode pair.
export fn json_decode(text: string): JsonValue { return json_parse(text); }

// Encode a JsonValue (objects, arrays, scalars — however deeply nested) to a
// compact JSON string. Free-function form of `v.stringify()`.
export fn json_encode(v: JsonValue): string { return v.stringify(); }

// Encode with 2-space indentation.
export fn json_encode_pretty(v: JsonValue): string { return v.stringifyPretty(); }

// ---- direct array <-> JSON (no JsonValue DOM) ----------------------------
//
// Encoding a native array through the DOM allocates one JsonValue node per
// element (jarr + append(jint(x))…) just to throw it away in stringify. These
// helpers serialize a native array straight into a StringBuilder in one pass —
// O(n), zero intermediate nodes. Their decoders parse a flat JSON array of
// scalars straight into a native array, likewise skipping the tree.
//
// Decoders soft-fail like json_parse/json_each: on malformed input they stop
// and return the elements decoded so far (non-arrays yield an empty array).

// int[] -> "[1,2,3]"
export fn jsonInts(xs: int[]): string {
    let sb = new StringBuilder(xs.len * 8 + 2);
    sb.append("[");
    let i = 0;
    while (i < xs.len) {
        if (i > 0) { sb.append(","); }
        sb.appendInt(xs[i]);
        i += 1;
    }
    sb.append("]");
    return sb.toString();
}

// float[] -> "[1,2.5,3]"
export fn jsonFloats(xs: float[]): string {
    let sb = new StringBuilder(xs.len * 8 + 2);
    sb.append("[");
    let i = 0;
    while (i < xs.len) {
        if (i > 0) { sb.append(","); }
        append_num(sb, xs[i]);
        i += 1;
    }
    sb.append("]");
    return sb.toString();
}

// string[] -> "[\"a\",\"b\"]" (each element JSON-escaped)
export fn jsonStrings(xs: string[]): string {
    let sb = new StringBuilder(xs.len * 8 + 2);
    sb.append("[");
    let i = 0;
    while (i < xs.len) {
        if (i > 0) { sb.append(","); }
        quote_into(sb, xs[i]);
        i += 1;
    }
    sb.append("]");
    return sb.toString();
}

// Generic array encoder: `emit(sb, elem)` appends one element's JSON. Callers
// that need a type the typed helpers above don't cover supply their own emit —
// e.g. jsonArray(rows, (sb, r) => quote_into(sb, r.name)). No DOM nodes.
export fn jsonArray<T>(xs: T[], emit: fn(StringBuilder, T)): string {
    let sb = new StringBuilder(xs.len * 8 + 2);
    sb.append("[");
    let i = 0;
    while (i < xs.len) {
        if (i > 0) { sb.append(","); }
        emit(sb, xs[i]);
        i += 1;
    }
    sb.append("]");
    return sb.toString();
}

// "[1,2,3]" -> int[]. Truncates fractional values (like asInt).
export fn jsonToInts(text: string): int[] {
    let out: int[] = [];
    let p = new Parser(text);
    if (!p.openArray()) { return out; }
    if (p.closeEmpty()) { return out; }
    while (true) {
        p.ws();
        if (p.pos >= p.n) { return out; }
        let c = p.s[p.pos];
        if (c != CHAR_MINUS && (c < 48 || c > 57)) { return out; }
        let x = p.scan_number();
        if (p.err != "") { return out; }
        out.push(x as int);
        if (!p.afterElement()) { return out; }
    }
    return out;
}

// "[1,2,3]" decoded into a caller-owned array, reused across calls. Clears
// `out` (keeping its capacity) and fills it; returns the element count. Lets a
// per-line loop decode 1M lines with one buffer instead of allocating a fresh
// int[] each call — the difference between O(lines) allocations and O(1).
export fn jsonToIntsInto(text: string, out: int[]): int {
    out.clear();
    let p = new Parser(text);
    if (!p.openArray()) { return 0; }
    if (p.closeEmpty()) { return 0; }
    while (true) {
        p.ws();
        if (p.pos >= p.n) { return out.len; }
        let c = p.s[p.pos];
        if (c != CHAR_MINUS && (c < 48 || c > 57)) { return out.len; }
        let x = p.scan_number();
        if (p.err != "") { return out.len; }
        out.push(x as int);
        if (!p.afterElement()) { return out.len; }
    }
    return out.len;
}

// Decode a JSON array of integers straight from a byte buffer range into a
// reused array — no string is created (the byte twin of jsonToIntsInto). Pairs
// with File.readLineBytes() for a fully allocation-free streaming parse loop:
//
//     while (!r.eof()) {
//         let n = r.readLineBytes(); if (n < 0) { break; }
//         jsonBytesToInts(r.lineBuf(), n, row);   // row reused each line
//         sum += row[1];
//     }
//
// Soft-fail like the other decoders: stops and returns what was decoded.
export fn jsonBytesToInts(b: byte[], len: int, out: int[]): int {
    out.clear();
    let i = 0;
    while (i < len && (b[i] as int) <= 32) { i += 1; }           // ws
    if (i >= len || (b[i] as int) != CHAR_LBRACKET) { return 0; }
    i += 1;
    while (i < len) {
        while (i < len && (b[i] as int) <= 32) { i += 1; }
        if (i < len && (b[i] as int) == CHAR_RBRACKET) { i += 1; return out.len; }
        let neg = false;
        if (i < len && (b[i] as int) == CHAR_MINUS) { neg = true; i += 1; }
        let start = i;
        let v = 0;
        while (i < len && is_digit(b[i] as int)) {
            v = v * 10 + ((b[i] as int) - 48);
            i += 1;
        }
        if (i == start) { return out.len; }                       // not a number
        if (neg) { v = -v; }
        out.push(v);
        while (i < len && (b[i] as int) <= 32) { i += 1; }
        if (i < len && (b[i] as int) == CHAR_COMMA) { i += 1; }
        else if (i < len && (b[i] as int) == CHAR_RBRACKET) { i += 1; return out.len; }
        else { return out.len; }
    }
    return out.len;
}

// "[1,2.5]" -> float[].
export fn jsonToFloats(text: string): float[] {
    let out: float[] = [];
    let p = new Parser(text);
    if (!p.openArray()) { return out; }
    if (p.closeEmpty()) { return out; }
    while (true) {
        p.ws();
        if (p.pos >= p.n) { return out; }
        let c = p.s[p.pos];
        if (c != CHAR_MINUS && (c < 48 || c > 57)) { return out; }
        let x = p.scan_number();
        if (p.err != "") { return out; }
        out.push(x);
        if (!p.afterElement()) { return out; }
    }
    return out;
}

// "[\"a\",\"b\"]" -> string[] (unescaped).
export fn jsonToStrings(text: string): string[] {
    let out: string[] = [];
    let p = new Parser(text);
    if (!p.openArray()) { return out; }
    if (p.closeEmpty()) { return out; }
    while (true) {
        p.ws();
        if (p.pos >= p.n || p.s[p.pos] != CHAR_DQUOTE) { return out; } // expect '"'
        let sv = p.raw_string();
        if (p.err != "") { return out; }
        out.push(sv);
        if (!p.afterElement()) { return out; }
    }
    return out;
}

// Append `x` as a JSON number: integral values in the exactly-representable
// range print without a decimal point (via appendInt, no intermediate string).
fn append_num(sb: StringBuilder, x: float) {
    if (x >= -9.0e15 && x <= 9.0e15) {
        let t = x as int;
        if ((t as float) == x) { sb.appendInt(t); return; }
    }
    sb.append(str(x));
}

// ---- serializer ----------------------------------------------------------

// Append v's serialization into `sb`. Appending into a growable builder makes
// stringify O(total output) instead of the O(n²) of threading and re-copying a
// string at every node.
// A parse can't exceed JSON_MAX_DEPTH, so only a hand-built cyclic/deep tree
// trips this — a programmer error, so panic (not sentinel).
fn write_sb(v: JsonValue, sb: StringBuilder, pretty: bool, depth: int) {
    if (depth > JSON_MAX_DEPTH) { panic("json: stringify nesting deeper than 1024 levels"); }
    switch (v.kind) {
    case JSON.NULL: { sb.append("null"); return; }
    case JSON.BOOL: { if (v.bval) { sb.append("true"); } else { sb.append("false"); } return; }
    case JSON.NUM:  { append_num(sb, v.num); return; }
    case JSON.STR:  { quote_into(sb, v.bstr); return; }
    case JSON.OBJ:  { }   // falls through to the object writer below
    case JSON.ARR: {
        sb.append("[");
        let i = 0;
        while (i < v.arr.len) {
            if (i > 0) { sb.append(","); }
            if (pretty) { sb.append("\n"); sb.append(indent(depth + 1)); }
            write_sb(v.arr[i], sb, pretty, depth + 1);
            i += 1;
        }
        if (pretty && v.arr.len > 0) { sb.append("\n"); sb.append(indent(depth)); }
        sb.append("]");
        return;
    }
    }
    // object
    sb.append("{");
    let i = 0;
    while (i < v.keys.len) {
        if (i > 0) { sb.append(","); }
        if (pretty) { sb.append("\n"); sb.append(indent(depth + 1)); }
        quote_into(sb, v.keys[i]);
        sb.append(":");
        if (pretty) { sb.append(" "); }
        write_sb(v.vals[i], sb, pretty, depth + 1);
        i += 1;
    }
    if (pretty && v.keys.len > 0) { sb.append("\n"); sb.append(indent(depth)); }
    sb.append("}");
}

fn indent(depth: int): string { return "  ".repeat(depth); }

// `s` as a JSON string literal, quotes included. Exported so that anything
// emitting JSON by hand — vyto/util/log's JSON-lines sink, say — escapes
// exactly as the encoder does rather than carrying a second, divergent copy of
// these rules.
export fn json_quote(s: string): string {
    let sb = new StringBuilder(s.len + 8);
    quote_into(sb, s);
    return sb.toString();
}

// Append `s` as a JSON string literal (with surrounding quotes) into `sb`,
// escaping runs directly into the builder — no intermediate O(n²) string.
fn quote_into(sb: StringBuilder, s: string) {
    sb.append("\"");
    let runStart = 0;
    let i = 0;
    while (i < s.len) {
        let c = s[i];
        let esc = "";
        if (c == CHAR_DQUOTE) { esc = "\\\""; }
        else if (c == CHAR_BACKSLASH) { esc = "\\\\"; }
        else if (c == CHAR_LF) { esc = "\\n"; }
        else if (c == CHAR_CR) { esc = "\\r"; }
        else if (c == CHAR_TAB) { esc = "\\t"; }
        else if (c == CHAR_BS) { esc = "\\b"; }
        else if (c == CHAR_FF) { esc = "\\f"; }
        else if (c < 0x20) { esc = fmt("\\u%04x", [fi(c)]); }
        if (esc != "") {
            if (i > runStart) { sb.append(s.slice(runStart, i)); }
            sb.append(esc);
            runStart = i + 1;
        }
        i += 1;
    }
    if (s.len > runStart) { sb.append(s.slice(runStart, s.len)); }
    sb.append("\"");
}

// ---- byte helpers --------------------------------------------------------

fn hex_digit(c: int): int {
    if (is_digit(c)) { return c - CHAR_ZERO; }
    if (c >= CHAR_LOWER_A && c <= CHAR_LOWER_F) { return c - CHAR_LOWER_A + 10; }
    if (c >= CHAR_UPPER_A && c <= CHAR_UPPER_F) { return c - CHAR_UPPER_A + 10; }
    return 0;
}


fn chr(code: int): string {
    let b = bytes(2);
    b[0] = code as byte;
    return str(b as cstring);
}

fn utf8_encode(cp: int): string {
    if (cp < 0x80) { return chr(cp); }
    if (cp < 0x800) {
        let b = bytes(3);
        b[0] = (0xC0 | (cp >> 6)) as byte;
        b[1] = (0x80 | (cp & 0x3F)) as byte;
        return str(b as cstring);
    }
    if (cp < 0x10000) {
        let b = bytes(4);
        b[0] = (0xE0 | (cp >> 12)) as byte;
        b[1] = (0x80 | ((cp >> 6) & 0x3F)) as byte;
        b[2] = (0x80 | (cp & 0x3F)) as byte;
        return str(b as cstring);
    }
    let b = bytes(5);
    b[0] = (0xF0 | (cp >> 18)) as byte;
    b[1] = (0x80 | ((cp >> 12) & 0x3F)) as byte;
    b[2] = (0x80 | ((cp >> 6) & 0x3F)) as byte;
    b[3] = (0x80 | (cp & 0x3F)) as byte;
    return str(b as cstring);
}
