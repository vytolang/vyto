// vyto/dev/test/exit — exitWith(code), the one thing the framework cannot do
// without touching the operating system.
//
//     exitWith(t.done());
//
// There is no `exit` builtin (docs/builtins.md §1 lists every one of them), so
// setting a process exit status means `vyto/os`, and vyto/os carries
// native/src/os_shim.c. A native/src is compiled once per package DIRECTORY for
// every module in it, so this lives in its own module — importing
// `vyto/dev/test` alone pulls in no native code, and the shim arrives only for
// a program that actually asks to exit.
//
// The cost of that shim, for the record, so nobody re-litigates the split: it
// is one small libc-only translation unit with no `#link` directives, and it is
// content-addressed into the shared object cache (src/main.c:245-258), so it
// compiles once per machine rather than once per test. That is nothing like the
// link cost that justified splitting vyto/crypto/ecc or vyto/validator/pattern.
//
// Why the caller writes `exitWith(t.done())` rather than done() exiting by
// itself: control flow that leaves main() should be visible at the call site,
// and done()'s return value has to stay inspectable — the selftest asserts on
// it, which is impossible if the call terminates the process.

import { exit } from "vyto/os";

// Exit the process with `code`. Does not return.
export fn exitWith(code: int) {
    exit(code);
}
