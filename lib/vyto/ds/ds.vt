// vyto/ds — trees, graphs and index structures.
//
// A barrel: `import { Dsu, Graph } from "vyto/ds";` works, and so does importing
// the individual module.
//
//   Trie            prefix tree over byte strings; autocomplete, routing
//   Dsu             union-find; connected components, Kruskal, flood fill
//   Fenwick         prefix sums that stay correct while values change
//   SegTree         any associative range query, with updates
//   Bloom           "definitely not present" in a fraction of the memory
//   SkipList<T>     an ordered set with O(log n) insert
//   SkipMap<K,V>    an ordered map; ceiling/floor answer "what is next after k"
//   Graph           directed weighted graph; BFS, DFS, topo sort, Dijkstra
//   IntervalTree    which ranges cover this point, or overlap this range
//
// ── HOW THIS DIFFERS FROM vyto/coll ─────────────────────────────────────────
// `vyto/coll` holds *values*: you put a Task in a Deque and get the Task back.
// Here the elements are *indices* — a vertex is an int, a Trie payload is an
// int, a Fenwick position is an int — and everything is backed by flat `int[]`s
// with no object per node.
//
// That is not a stylistic split. It is CLAUDE.md's bulk-data rule: a structure
// built one object per element pays a header, a refcount lifetime and a cache
// miss per element, and these are exactly the structures that get large. It is
// also what makes them safe under reference counting — a graph of objects
// leaks the moment it has a cycle and nothing detects it, while a graph of
// integers cannot form one at all.
//
// To attach real objects, keep them in a `vyto/coll` Slab (or a parallel array)
// and use the id as the index. That is the pattern all the way down.
// ─────────────────────────────────────────────────────────────────────────────
//
// Only `SkipList<T>` and `SkipMap<K,V>` are generic, because they are the only
// ones whose elements are not naturally indices. Everything else needs no type
// parameter, no `zero`, and no instantiation at all.

import { Trie, trie, TRIE_NONE } from "vyto/ds/trie";
import { Dsu, dsu } from "vyto/ds/dsu";
import { Fenwick, FenwickF, fenwick, fenwickF } from "vyto/ds/fenwick";
import { SegTree, segtree_sum, segtree_min, segtree_max, segtree_or, segtree_and,
         SEG_HI, SEG_LO } from "vyto/ds/segtree";
import { Bloom, bloom, bloom_for } from "vyto/ds/bloom";
import { SkipList, skiplist_int, skiplist_float } from "vyto/ds/skiplist";
import { SkipMap, skipmap_int_int, skipmap_int_str, skipmap_str_int,
         skipmap_str_str, cmp_str } from "vyto/ds/skipmap";
import { Graph, graph, INF } from "vyto/ds/graph";
import { IntervalTree, intervalTree } from "vyto/ds/interval";
