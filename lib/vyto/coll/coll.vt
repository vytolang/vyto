// vyto/coll — general-purpose containers.
//
// A barrel: importing from "vyto/coll" re-exports everything below, so
// `import { Deque, LRU } from "vyto/coll";` works. Importing the individual
// module (`vyto/coll/deque`) is equally fine and pulls in less.
//
//   Deque<T>        double-ended queue over a ring; O(1) at both ends
//   RingBuffer<T>   fixed capacity, overwrites the oldest, never allocates
//   Heap<T>         binary heap / priority queue, ordering by an explicit cmp
//   HashMap<K,V>    open-addressed table with keys of any type
//   HashSet<T>      the same table without values
//   BitSet          a bit per small integer; non-generic
//   LRU<K,V>        fixed-capacity cache, evicts least-recently-used
//   Slab<T>         index-based arena; handles are ints, so cycles cannot form
//
// Two conventions run through all of them:
//
// **Every generic container takes a `zero: T`.** v1 generics have no bounds and
// no default value for `T`, so a container that writes at an index rather than
// pushing cannot invent its own empty slots. It is also what lets a container
// clear a vacated slot instead of holding the object alive until the slot is
// reused. Each container ships `*_int` / `*_str` factories so the common cases
// never spell it.
//
// **Ordering and hashing are closure fields, never inferred.** There is no
// `Ord` and no `Hashable`; `Heap` takes a `cmp`, `HashMap` takes a `hash` and an
// `eq`. This is the same trade `vyto/util/sort` and `vyto/reactive`'s `Signal`
// already make, and it is why a container works with your own types without the
// language growing a trait system.
//
// Everything here is pure Vyto with no native code, so the whole package
// cross-compiles and builds freestanding.
//
// For trees, graphs and index structures — Trie, union-find, Fenwick, segment
// tree, Bloom filter, CSR graph — see `vyto/ds`.

import { Deque, deque_int, deque_float, deque_str, deque_bool } from "vyto/coll/deque";
import { RingBuffer, ring_int, ring_float, ring_str } from "vyto/coll/ring";
import { Heap, heap_int_min, heap_int_max, heap_float_min, heap_float_max,
         cmp_float } from "vyto/coll/heap";
import { HashMap, hashmap_int_int, hashmap_int_str, hashmap_str_int,
         hashmap_str_str, hashmap_str_float } from "vyto/coll/hashmap";
import { HashSet, hashset_int, hashset_str } from "vyto/coll/hashset";
import { BitSet, bitset } from "vyto/coll/bitset";
import { LRU, lru_str_str, lru_str_int, lru_int_str, lru_int_int } from "vyto/coll/lru";
import { Slab, slab_int, slab_str, NIL } from "vyto/coll/slab";
import { next_pow2, popcount64, ctz64 } from "vyto/coll/util";
