// vyto/coll/util — the two things every container in this package needs.
//
// Not part of the public surface; it exists so `next_pow2` is written once.

// Round up to a power of two, floor 8. Container capacities are powers of two
// so a ring wrap or a bucket index is a mask (`i & mask`) rather than a modulo,
// which is a divide.
export fn next_pow2(n: int): int {
    let p = 8;
    while (p < n) { p = p * 2; }
    return p;
}

// The number of set bits in a 64-bit word, by the standard SWAR reduction:
// pairs, then nibbles, then bytes, then one multiply to sum the bytes into the
// top one. No table, no branches, no loop over 64 bits.
export fn popcount64(x: u64): int {
    let v = x - ((x >> 1) & 0x5555555555555555);
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333);
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F;
    return ((v * 0x0101010101010101) >> 56) as int;
}

// Index of the lowest set bit, or 64 if x is zero. de Bruijn would be faster
// but needs a table and a module-level constant array, which Vyto does not
// have; this is a binary search over the word and is branch-light.
export fn ctz64(x: u64): int {
    if (x == 0) { return 64; }
    let n = 0;
    let v = x;
    if ((v & 0xFFFFFFFF) == 0) { n += 32; v = v >> 32; }
    if ((v & 0xFFFF) == 0)     { n += 16; v = v >> 16; }
    if ((v & 0xFF) == 0)       { n += 8;  v = v >> 8; }
    if ((v & 0xF) == 0)        { n += 4;  v = v >> 4; }
    if ((v & 0x3) == 0)        { n += 2;  v = v >> 2; }
    if ((v & 0x1) == 0)        { n += 1; }
    return n;
}
