// vyto/media/camera — capture from a camera, on any platform.
//
//     let cam = camera_open(640, 480);
//     if (cam == null) { print("no camera"); return; }
//     cam.start();
//     let img = cam.grab();               // an Image, or null if none ready yet
//
// STATUS: STUB. Every entry point below panics. The signatures are real and
// settled so they can be reviewed and imported against; see this package's
// README for what is planned and what is deliberately excluded.
//
// ---- THE RELATIONSHIP TO vyto/hw/camera, WHICH SHIPS AND WORKS -------------
//
// This module does NOT replace `vyto/hw/camera`, and if it ever becomes a
// second way to open /dev/video0 it should be deleted instead.
//
// `vyto/hw/camera` is the Linux V4L2 device interface. It is deliberately a
// device: it exposes a poll-able fd, hands back YUYV or RGBA buffers, follows
// the vyto/hw contract in docs/hardware.md, and returns null on every platform
// that is not Linux. That is the right shape for a program that is already
// driving hardware — it folds into the same PollSet as a serial port.
//
// This module is the façade above it: one API that also reaches AVFoundation on
// macOS/iOS, Media Foundation on Windows, and Camera2/NDK on Android, and that
// produces vyto/media/image `Image`s rather than raw device buffers. On Linux
// its backend IS vyto/hw/camera — it adds no second V4L2 implementation.
//
// So the division is platform reach and output type, not functionality:
//
//   | Want                                    | Use                |
//   |-----------------------------------------|--------------------|
//   | a camera on Linux, in a PollSet, as fd  | vyto/hw/camera     |
//   | a camera on whatever the user has       | this               |
//
// ---- WHY IT IS NOT JUST A THIN WRAPPER --------------------------------------
//
// The three non-Linux backends are not device files and do not resemble one.
// AVFoundation and Camera2 are both callback-driven — frames arrive on a thread
// the OS owns — which runs into the same constraint vyto/media/audio documents
// at length: a foreign thread may touch C memory only, never a Vyto object. So
// the frame path here is the same shape as the audio one, a C-owned buffer the
// Vyto side drains on its own thread, and `grab()` returning null means "no
// frame ready", not "failed".
//
// That is also why there is no fd in this API. Only one of the four backends
// has one.

import { Image } from "vyto/media/image";

// Device kinds, for choosing between the front and back camera on a phone —
// the one selection that is worth naming rather than leaving to an opaque id.
export const CAMERA_ANY: int = 0;
export const CAMERA_FRONT: int = 1;
export const CAMERA_BACK: int = 2;

fn todo(what: string) {
    panic("vyto/media/camera: " + what + " is not implemented yet — this module is"
        + " a stub with settled signatures; see its README");
}

// ---- devices ----------------------------------------------------------------

// One camera the platform can see. `id` is the backend's opaque identifier.
export class CameraDevice {
    id: string;
    name: string;
    facing: int;            // CAMERA_*

    fn init() {
        todo("CameraDevice");
    }
}

// Every camera available. An empty array is normal — a server has none — and
// must not be treated as an error.
export fn camera_devices(): CameraDevice[] {
    todo("camera_devices");
    return [];
}

// ---- capture ----------------------------------------------------------------

// An open camera. Owns the platform object; deinit stops capture and releases
// it, so a camera that goes out of scope turns its indicator light off.
export class Camera {
    handle: rawptr;
    width: int;
    height: int;

    fn init() {
        todo("Camera");
    }

    fn start(): bool {
        todo("Camera.start");
        return false;
    }

    fn stop(): bool {
        todo("Camera.stop");
        return false;
    }

    // The most recent frame, or null if none has arrived since the last call.
    //
    // Null is the ordinary polling result, not a failure: frames arrive at the
    // sensor's rate on a thread this one does not control. A caller drives this
    // from its own loop and draws when it gets something.
    fn grab(): Image {
        todo("Camera.grab");
        return null;
    }

    // Whether a frame is waiting, without taking it.
    fn hasFrame(): bool {
        todo("Camera.hasFrame");
        return false;
    }

    // Frames the backend delivered but nothing collected, because grab() was
    // not called often enough. The visible symptom of a too-slow consumer,
    // which is otherwise indistinguishable from a slow camera.
    fn dropped(): int {
        todo("Camera.dropped");
        return 0;
    }
}

// Open the default camera at roughly this size. The backend picks the nearest
// mode it supports — cameras offer a fixed list, not arbitrary sizes — so check
// `width`/`height` afterwards rather than assuming. Null when there is no
// camera or permission was refused, which on macOS, iOS and Android is a
// runtime prompt and can be denied.
export fn camera_open(width: int, height: int): Camera {
    todo("camera_open");
    return null;
}

export fn camera_open_device(id: string, width: int, height: int): Camera {
    todo("camera_open_device");
    return null;
}

// ---- library ----------------------------------------------------------------

export fn camera_available(): bool {
    todo("camera_available");
    return false;
}
