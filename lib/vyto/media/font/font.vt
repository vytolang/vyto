// vyto/media/font — text shaping: a string plus a font, into positioned glyphs.
//
//     let f = font_load("NotoNaskhArabic.ttf", 0);
//     let run = f.shape("مرحبا", 16.0, SCRIPT_ARABIC, DIR_RTL, "ar");
//     run.glyphs[0].id;      // a glyph index, not a character
//     run.glyphs[0].xAdvance;
//
// STATUS: STUB. Every entry point below panics. The signatures are real and
// settled so they can be reviewed and imported against; see this package's
// README for what is planned and what is deliberately excluded.
//
// The intended backend is FreeType for rasterization and metrics, HarfBuzz for
// shaping. Both are large C libraries with real build systems, so they would be
// provisioned by a build script the way blend2d and ICU are, not vendored.
//
// ---- WHY THIS IS NOT A vyto/gfx FEATURE ------------------------------------
//
// vyto/gfx already draws text through blend2d and does Latin well. What it does
// is map each character to a glyph and advance by that glyph's width, which is
// correct for scripts where those two operations are the whole story.
//
// They are not the whole story for most of the world. Arabic joins: one letter
// takes four different shapes depending on its neighbours. Devanagari reorders:
// a vowel written after a consonant is drawn before it. Latin itself has
// ligatures and kerning pairs. In every case the mapping is many-to-many and
// depends on the surrounding run, so it cannot be done a character at a time by
// anything, however careful.
//
// Shaping is that mapping. It is a separate concern from rasterization and from
// drawing, which is why this is a separate module and not a flag on Canvas.
//
// ---- WHAT SITS ABOVE THIS --------------------------------------------------
//
// Line breaking, bidi paragraph ordering and justification are NOT here. Those
// need Unicode data (UAX #9, UAX #14) that vyto/intl already carries via ICU,
// and they operate on shaped runs rather than producing them. This module's job
// ends at "these glyphs, at these positions, in this order".

// Text direction. AUTO asks the shaper to infer it from the script, which is
// right for a single-script run and wrong for mixed text — resolve bidi above
// this layer and pass the answer.
export const DIR_AUTO: int = 0;
export const DIR_LTR: int = 1;
export const DIR_RTL: int = 2;
export const DIR_TTB: int = 3;

// Scripts named explicitly rather than inferred, because inference from the
// first character is wrong for a run that starts with a space or a digit.
export const SCRIPT_AUTO: int = 0;
export const SCRIPT_LATIN: int = 1;
export const SCRIPT_ARABIC: int = 2;
export const SCRIPT_DEVANAGARI: int = 3;
export const SCRIPT_HEBREW: int = 4;
export const SCRIPT_THAI: int = 5;
export const SCRIPT_HAN: int = 6;
export const SCRIPT_HANGUL: int = 7;

fn todo(what: string) {
    panic("vyto/media/font: " + what + " is not implemented yet — this module is"
        + " a stub with settled signatures; see its README");
}

// ---- shaped output ----------------------------------------------------------

// One positioned glyph.
//
// `id` is an index into the font, NOT a Unicode codepoint — the whole point of
// shaping is that the two do not correspond. `cluster` is the byte offset in
// the source string that produced this glyph, and it is how a caret position or
// a selection maps back to text: several glyphs may share a cluster (one
// character drawn as two marks) and several characters may share one (a
// ligature).
export struct Glyph {
    id: int;
    cluster: int;
    xAdvance: float;
    yAdvance: float;
    xOffset: float;
    yOffset: float;
}

// The result of shaping one run of text in one font, size, script and
// direction. `width` is the sum of the advances — the value a layout needs and
// the reason a caller usually does not have to look at the glyphs at all.
export class GlyphRun {
    glyphs: Glyph[];
    width: float;
    ascent: float;
    descent: float;
    lineGap: float;

    fn init() {
        todo("GlyphRun");
    }
}

// ---- fonts ------------------------------------------------------------------

// A loaded face. Owns the C object; deinit frees it.
export class Font {
    handle: rawptr;
    family: string;
    style: string;
    unitsPerEm: int;

    fn init() {
        todo("Font");
    }

    // Shape one run. The run must be a single script, direction and language —
    // splitting mixed text into runs is the caller's job, and is what the bidi
    // algorithm above this layer produces.
    //
    // `lang` is a BCP 47 tag. It is not decorative: the same script renders
    // differently by language (Serbian vs Russian Cyrillic italics, Turkish
    // dotted i), and passing "" gets the font's default rather than an error.
    fn shape(text: string, sizePx: float, script: int, dir: int, lang: string): GlyphRun {
        todo("Font.shape");
        return null;
    }

    // Advance width only, without materialising glyphs. What a layout pass
    // wants when it is measuring rather than drawing.
    fn measure(text: string, sizePx: float, script: int, dir: int, lang: string): float {
        todo("Font.measure");
        return 0.0;
    }

    // Rasterize one glyph to 8-bit coverage, `w * h` bytes, row-major. Coverage
    // rather than colour: the caller multiplies by the text colour, which is
    // what lets one rasterized glyph serve every colour it is drawn in.
    fn rasterize(glyphId: int, sizePx: float): byte[] {
        todo("Font.rasterize");
        return bytes(0);
    }

    // Whether the face has a glyph for this codepoint. The check that decides
    // whether to fall back to another font before shaping produces boxes.
    fn hasGlyph(codepoint: int): bool {
        todo("Font.hasGlyph");
        return false;
    }
}

// Load a face from a file. `index` selects a face inside a collection (.ttc);
// pass 0 for an ordinary .ttf/.otf. Returns null if the file is absent or is
// not a font.
export fn font_load(path: string, index: int): Font {
    todo("font_load");
    return null;
}

// Load from memory — an embedded asset, or a font fetched over the network.
// The bytes are copied, so the caller may free them.
export fn font_load_bytes(data: byte[], index: int): Font {
    todo("font_load_bytes");
    return null;
}

