// vyto/media/video — decode video and audio streams into frames and samples.
//
//     let v = video_open("clip.mp4");
//     while (true) {
//         let f = v.nextFrame();
//         if (f == null) { break; }
//         surf.blit(f.image.pixels, f.image.width, f.image.height, dst);
//     }
//
// STATUS: STUB. Every entry point below panics. The signatures are real and
// settled so they can be reviewed and imported against; see this package's
// README for what is planned and what is deliberately excluded.
//
// The intended backend is FFmpeg's libavcodec/libswscale, provisioned by a
// build script rather than vendored — it is far too large and has a real build
// system, so it follows the blend2d and ICU pattern, not the stb one.
//
// ---- WHAT IT PRODUCES -------------------------------------------------------
//
// Decoded frames are vyto/media/image's `Image` — i32[] 0xAARRGGBB, row-major,
// no stride padding. That is why the pixel format was settled before this
// module was written: a decoder that invented its own layout would put a third
// incompatible pixel type in a tree that already had three.
//
// The colour conversion is real work, not a cast. Video is almost universally
// YUV 4:2:0 with chroma at half resolution, in one of several colour spaces
// (BT.601 for SD, BT.709 for HD, BT.2020 for HDR) — decoding with the wrong
// matrix produces an image that looks *plausible* and has visibly wrong skin
// tones. libswscale does this properly and is why it is a dependency rather
// than fifty lines of arithmetic here.
//
// ---- WHAT IT IS BUILT ON ----------------------------------------------------
//
// vyto/media/codec, which demuxes the container and hands over compressed
// packets. This module turns packets into pixels. A caller that only needs to
// know a file's duration and resolution should use that module directly and
// never link a decoder.

import { Image } from "vyto/media/image";

fn todo(what: string) {
    panic("vyto/media/video: " + what + " is not implemented yet — this module is"
        + " a stub with settled signatures; see its README");
}

// ---- frames -----------------------------------------------------------------

// One decoded picture, with the time it should be shown.
//
// `pts` is in SECONDS here, already multiplied out of the container's time
// base — this is the presentation layer, and making every caller carry a time
// base is how playback code acquires timing bugs.
export class VideoFrame {
    image: Image;
    pts: float;
    keyframe: bool;

    fn init() {
        todo("VideoFrame");
    }
}

// Decoded audio: interleaved f32, the same format vyto/media/audio consumes, so
// a decoded track can be written straight to a playback stream.
export class AudioFrame {
    samples: f32[];
    pts: float;
    rate: int;
    channels: int;

    fn init() {
        todo("AudioFrame");
    }
}

// ---- decoding ---------------------------------------------------------------

// An open file being decoded. Owns the C decoder; deinit frees it.
export class VideoDecoder {
    handle: rawptr;
    width: int;
    height: int;
    frameRate: float;
    duration: float;        // seconds; 0.0 for a stream that does not say

    fn init() {
        todo("VideoDecoder");
    }

    // The next picture in PRESENTATION order, or null at end of stream.
    //
    // Presentation order, not decode order: codecs reorder frames internally
    // (h264 B-frames reference pictures that come later in the file), so the
    // decoder buffers and reorders. That is also why a decoder cannot be
    // stateless and why this is a class rather than a function over packets.
    fn nextFrame(): VideoFrame {
        todo("VideoDecoder.nextFrame");
        return null;
    }

    // The next block of decoded audio, or null at end of stream. Independent of
    // nextFrame: video and audio advance at their own rates and a caller
    // interleaves them by timestamp.
    fn nextAudio(): AudioFrame {
        todo("VideoDecoder.nextAudio");
        return null;
    }

    // Whether the file has an audio track at all.
    fn hasAudio(): bool {
        todo("VideoDecoder.hasAudio");
        return false;
    }

    // Seek to `seconds`. Exact: it seeks to the preceding keyframe and decodes
    // forward, discarding frames, which is what "seek to 1:23.4" has to mean.
    // That makes a seek cost up to a keyframe interval of decoding — typically
    // a fraction of a second, but not free, and not constant.
    fn seek(seconds: float): bool {
        todo("VideoDecoder.seek");
        return false;
    }

    // Scale decoded frames to this size before they are returned. Set once, and
    // the scaling happens inside libswscale where it is vectorised — far
    // cheaper than decoding at full size and resampling afterwards, which is
    // what a video thumbnailer would otherwise do.
    fn setOutputSize(w: int, h: int): bool {
        todo("VideoDecoder.setOutputSize");
        return false;
    }
}

