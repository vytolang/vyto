// vyto/media/audio — playback, capture and device enumeration.
//
//     let devs = audio_devices();                   // what is plugged in
//     let p = audio_open_playback(48000, 2);        // 48 kHz stereo
//     p.start();
//     p.write(samples);                             // f32 interleaved, -1..1
//
// The backend is miniaudio 0.11, vendored byte-for-byte in native/src/miniaudio
// (see native/refresh-miniaudio.sh). It reaches WASAPI, DirectSound and WinMM
// on Windows, PulseAudio and ALSA on Linux, AAudio and OpenSL on Android, and
// CoreAudio on macOS — every one loaded at run time, so a program links nothing
// new and a machine without one of them falls through to the next.
//
// VYTO_AUDIO=null in the environment swaps in a device that consumes samples
// at real-time pace and plays nothing; VYTO_AUDIO=off makes the machine look
// like one with no sound card. That is how the tests exercise both paths.
//
// ---- THE CONSTRAINT THAT SHAPES THIS API ------------------------------------
//
// An audio callback runs on a thread the OS owns, at real-time priority, with a
// hard deadline of a few milliseconds. Vyto's memory model is single-address-
// space reference counting with no atomics on the refcount, so a foreign thread
// may touch C memory ONLY — it must never retain or release a Vyto object.
// That rules out the API every audio library reaches for first: a Vyto closure
// invoked from the callback.
//
// So the sample path is a lock-free ring buffer owned by C. The callback fills
// or drains it and touches nothing else; the Vyto side reads and writes it from
// its own thread whenever it likes. write() and read() below are that ring, and
// they are why this module has no `onAudio(cb)` and will not grow one.
//
// The second consequence: an underrun is normal, not exceptional. If the Vyto
// side is late the callback emits silence rather than blocking — blocking a
// real-time thread is how an audio glitch becomes a system-wide stutter. The
// underruns() counter is how that becomes visible instead of mysterious.

// miniaudio's threads, dlopen and libm. Windows needs nothing: every DLL it
// uses (ole32, winmm, dsound) is loaded with LoadLibrary. bionic has pthreads
// in libc, so android lists only the other two.
#link "pthread" if "linux"
#link "dl" if "linux"
#link "m" if "linux"
#link "dl" if "android"
#link "m" if "android"

extern "C" {
    fn vaud_available(): i32;
    fn vaud_backend(): cstring;
    fn vaud_dev_refresh(): i32;
    fn vaud_dev_kind(i: i32): i32;
    fn vaud_dev_name(i: i32): cstring;
    fn vaud_dev_id(i: i32): cstring;
    fn vaud_dev_channels(i: i32): i32;
    fn vaud_dev_rate(i: i32): i32;
    fn vaud_open(kind: i32, id: cstring, rate: i32, channels: i32): rawptr;
    fn vaud_close(h: rawptr);
    fn vaud_start(h: rawptr): i32;
    fn vaud_stop(h: rawptr): i32;
    fn vaud_write(h: rawptr, src: rawptr, n: i64): i64;
    fn vaud_read(h: rawptr, dst: rawptr, max: i64): i64;
    fn vaud_writable(h: rawptr): i64;
    fn vaud_readable(h: rawptr): i64;
    fn vaud_xruns(h: rawptr): i64;
    fn vaud_frames(h: rawptr): i64;
}

// Sample format: 32-bit float, interleaved, nominally -1.0 to 1.0. One format
// rather than an enum because the conversion belongs in the shim, where it is
// written once, rather than in every caller.
export const AUDIO_F32: int = 0;

// Device kinds for audio_devices().
export const AUDIO_PLAYBACK: int = 0;
export const AUDIO_CAPTURE: int = 1;

// ---- devices ----------------------------------------------------------------

// One enumerated device. `id` is the backend's opaque identifier and is what
// audio_open_* takes; the empty string means "the system default", which is
// what a caller should use unless a human has picked something else.
//
// channels and defaultRate are the device's first native format, or 0 when the
// backend could not say (a device another program holds open, typically).
export class AudioDevice {
    id: string;
    name: string;
    kind: int;          // AUDIO_PLAYBACK or AUDIO_CAPTURE
    channels: int;
    defaultRate: int;

    fn init() {
        this.id = "";
        this.name = "";
        this.kind = AUDIO_PLAYBACK;
        this.channels = 0;
        this.defaultRate = 0;
    }
}

// Every device the backend can see, both directions. An empty array means no
// audio backend initialised, which is normal on a headless box and must not be
// treated as an error.
export fn audio_devices(): AudioDevice[] {
    let out: AudioDevice[] = [];
    let n = vaud_dev_refresh() as int;
    for (let i in 0..n) {
        let d = new AudioDevice();
        d.kind = vaud_dev_kind(i as i32) as int;
        d.name = str(vaud_dev_name(i as i32));
        d.id = str(vaud_dev_id(i as i32));
        d.channels = vaud_dev_channels(i as i32) as int;
        d.defaultRate = vaud_dev_rate(i as i32) as int;
        out.push(d);
    }
    return out;
}

// ---- playback ---------------------------------------------------------------

// An open output stream. The C side owns the device and the ring buffer; this
// object owns the C side, and deinit stops the stream and frees it — so a
// stream that goes out of scope stops making noise, deterministically.
//
// The ring holds half a second. That caps how far ahead write() can get; it is
// not latency, which is however much the caller chooses to queue.
export class AudioPlayback {
    handle: rawptr;
    rate: int;
    channels: int;

    fn init(handle: rawptr, rate: int, channels: int) {
        this.handle = handle;
        this.rate = rate;
        this.channels = channels;
    }

    deinit { vaud_close(this.handle); }

    // Begin pulling from the ring. Idempotent.
    fn start(): bool { return vaud_start(this.handle) != 0; }

    // Stop pulling. The ring keeps its contents, so start() resumes rather than
    // restarts.
    fn stop(): bool { return vaud_stop(this.handle) != 0; }

    // Queue interleaved f32 samples. Returns how many were accepted — fewer
    // than offered when the ring is full, which is backpressure and not an
    // error. A caller that ignores the return value will drop audio. Whole
    // frames only: a trailing partial frame is never taken.
    fn write(samples: f32[]): int {
        if (samples.len == 0) { return 0; }
        return vaud_write(this.handle, samples as rawptr, samples.len as i64) as int;
    }

    // Room left in the ring, in samples. Write this many and the call cannot
    // partially succeed.
    fn writable(): int { return vaud_writable(this.handle) as int; }

    // How many times the callback found the ring short and filled the rest of
    // its buffer with silence. Monotonic, and it counts while the stream is
    // idle too: a started stream with nothing queued underruns every period.
    // A count that rises *while audio is being fed* means the producer is too
    // slow or the ring too small; it is the only symptom of either that is
    // visible in software.
    fn underruns(): int { return vaud_xruns(this.handle) as int; }

    // Frames the device has taken from the ring. The clock to synchronise
    // against — wall time drifts against an audio device, which is what makes
    // video sync to audio rather than the other way round. Silence emitted on
    // an underrun is not counted, so this is "how much of what you wrote has
    // been played".
    fn framesPlayed(): int { return vaud_frames(this.handle) as int; }
}

// Open the default output, or a device id from audio_devices(). `rate` is in
// Hz, `channels` is 1 or 2. Returns null if no device could be opened, which is
// the ordinary case on a machine with no sound card.
export fn audio_open_playback(rate: int, channels: int): AudioPlayback {
    return audio_open_playback_device("", rate, channels);
}

export fn audio_open_playback_device(id: string, rate: int, channels: int): AudioPlayback {
    let h = vaud_open(AUDIO_PLAYBACK as i32, id.cstr(), rate as i32, channels as i32);
    if (h == null) { return null; }
    return new AudioPlayback(h, rate, channels);
}

// ---- capture ----------------------------------------------------------------

// An open input stream. Same ownership and same ring, in the other direction.
export class AudioCapture {
    handle: rawptr;
    rate: int;
    channels: int;

    fn init(handle: rawptr, rate: int, channels: int) {
        this.handle = handle;
        this.rate = rate;
        this.channels = channels;
    }

    deinit { vaud_close(this.handle); }

    fn start(): bool { return vaud_start(this.handle) != 0; }

    fn stop(): bool { return vaud_stop(this.handle) != 0; }

    // Drain up to `max` interleaved samples. Returns what was available, which
    // may be an empty array — that is a normal poll, not a failure. Rounded
    // down to whole frames.
    fn read(max: int): f32[] {
        let n = vaud_readable(this.handle) as int;
        if (n > max) { n = max; }
        n = n - n % this.channels;
        let out: f32[] = [];
        if (n <= 0) { return out; }
        out.reserve(n);
        for (let i in 0..n) { out.push(0 as f32); }
        let got = vaud_read(this.handle, out as rawptr, n as i64) as int;
        if (got < n) { return out.slice(0, got); }
        return out;
    }

    // Samples waiting to be read.
    fn readable(): int { return vaud_readable(this.handle) as int; }

    // How many times the callback found the ring full and discarded input.
    // The capture-side counterpart of underruns().
    fn overruns(): int { return vaud_xruns(this.handle) as int; }
}

export fn audio_open_capture(rate: int, channels: int): AudioCapture {
    return audio_open_capture_device("", rate, channels);
}

export fn audio_open_capture_device(id: string, rate: int, channels: int): AudioCapture {
    let h = vaud_open(AUDIO_CAPTURE as i32, id.cstr(), rate as i32, channels as i32);
    if (h == null) { return null; }
    return new AudioCapture(h, rate, channels);
}

// ---- library ----------------------------------------------------------------

// Whether an audio backend initialised. False on a headless machine, in a
// container without a sound device, and on a freestanding build. Check this
// rather than treating a null stream as an error.
export fn audio_available(): bool { return vaud_available() != 0; }

// The backend that initialised — "PulseAudio", "WASAPI", "ALSA", "Null" — or
// "" when none did. For diagnostics and logs, not for branching on.
export fn audio_backend(): string { return str(vaud_backend()); }
