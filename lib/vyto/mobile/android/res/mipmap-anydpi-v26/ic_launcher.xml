<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). Android masks the foreground layer into whatever
     shape the launcher uses — circle, squircle, teardrop — so a single square
     PNG looks wrong on most modern launchers: it gets cropped, or letterboxed
     inside a white blob.

     Both layers are package defaults an app overrides by defining the same
     name in its own res dir (aapt2 takes the app's copy). The foreground art
     must live inside the middle 72 of the 108dp canvas; the outer ring is what
     the mask eats and what parallax shifts.

     Devices below API 26 fall back to the app's plain @mipmap/ic_launcher PNG,
     which is why that still has to exist. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/vyto_icon_bg" />
    <foreground android:drawable="@drawable/vyto_icon_fg" />
</adaptive-icon>
