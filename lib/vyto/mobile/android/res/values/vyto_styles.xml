<?xml version="1.0" encoding="utf-8"?>
<!-- vyto/mobile/android/res — resources the package ships so an app does not
     have to hand-write them. Compiled alongside the app's own res dir and
     linked after it, so a name the app defines wins; see step 7 of
     apps/hn_android/build-apk.sh for the two compile lines.

     The splash theme is why this exists. A Vyto app draws nothing until its
     thread is up and the first frame is blitted, and until then the window
     shows whatever the theme's windowBackground is. That is white by default,
     and a white window that sits there reads as a hang. This makes the first
     frame deliberate.

     Pre-31 windowBackground rather than the API 31 SplashScreen API, and
     rather than androidx.core.splashscreen: that is an AAR, which is Maven,
     which is Gradle, and this build path has none. API 31+ devices layer their
     own icon animation over this and both look correct. -->
<resources>

    <!-- The launch theme. Referenced by manifest.vt's splash().
         NoActionBar because Vyto draws its own chrome, and a system action bar
         over a Vyto Window is a double header. -->
    <style name="Vyto.Splash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/vyto_splash</item>
        <!-- Edge to edge from the first frame, so the splash does not jump
             when the Activity goes decor-fits-false in onCreate. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
