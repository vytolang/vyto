<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults an app is expected to override in its own res/values. Both names
     are referenced from vyto_styles.xml and ic_launcher.xml, so they must
     exist even when an app is happy with plain colours. -->
<resources>
    <!-- Behind the launch splash. Material 3's surface, so the first frame
         matches a default-themed app rather than flashing white. -->
    <color name="vyto_splash_bg">#FFFBFE</color>
    <!-- Behind the adaptive launcher icon's foreground layer. -->
    <color name="vyto_icon_bg">#6750A4</color>
</resources>
