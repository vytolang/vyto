<?xml version="1.0" encoding="utf-8"?>
<!-- Default adaptive-icon foreground: a "V" on the 108dp canvas, drawn inside
     the safe middle 72dp so no launcher mask clips it. A placeholder with a
     shape rather than a blank layer, so an app that has not made an icon yet
     still ships something identifiable — and one an app replaces by defining
     @drawable/vyto_icon_fg itself. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,38 L54,68 L70,38 L78,38 L54,80 L30,38 Z" />
</vector>
