// vyto/mobile/android/ui — Android-shaped widgets that vyto/ui does not carry,
// because they are mobile navigation patterns with no desktop equivalent:
// the bottom nav bar, the bottom sheet, the navigation drawer, the FAB.
//
//     import { FloatingActionButton, BottomNavigationBar } from "vyto/mobile/android/ui";
//
// AndroidWidget is the base class the touch-shaped ones share, and the one an
// app subclasses for its own screens: taps on release, long-press to context
// or to a text selection, 48dp minimum targets, dp(), ripple, and no hover or
// press state left behind by a finger. See its comment for what it replaces.
//
// Scaffold is the screen: it holds the TopBar, the content, the bottom bar and
// the FAB, and it is what makes a FAB actually float — pinned to the screen
// rect rather than scrolling away inside the content.
//
// STATUS: complete and mouse-testable on X11 today, except for the one
// gesture noted on PullToRefresh. The overlay widgets (BottomSheet,
// NavigationDrawer) were unblocked by Track C item 1 — Window.on_mouse_ev now
// captures the press for overlay content, so an overlay receives drag,
// long-press, double-click and release like any other widget.
// Design of record: local/docs/ANDROID.md.
//
// These live outside vyto/ui deliberately. vyto/ui is platform-neutral and
// must stay so — an X11 app should not pull in a bottom sheet, and vyto/ui
// carries desktop widgets (MenuBar, Breadcrumb, StatusBar) that are dead
// weight here. Same boundary role vyto/gfx/painter plays for blend2d.
//
// Widgets only. System actions — camera, document picker, share sheet, and the
// runtime-permission flow — are asynchronous platform calls with a different
// shape entirely, and live in vyto/mobile/android/actions.
//
// Widgets here are drawn, not delegated to android.widget.*. Native *look*
// comes from vyto/ui/skins/material.vt; native *widgets* are the thing
// PORTABILITY.md says never to bind, and Compose Multiplatform agrees —
// Material3 there is drawn with Compose primitives, not platform views.

import { Widget, Painter, Theme, Size, Window, BoxConstraints, bcLoose,
         EASE, WEIGHT_REG, WEIGHT_MED, WEIGHT_BOLD } from "vyto/ui";
import { Rect, contains, rgb, with_alpha, mix, MOD_CTRL,
         KEY_LEFT, KEY_RIGHT, KEY_UP, KEY_DOWN, KEY_ENTER } from "vyto/surface";
import { Tween } from "vyto/ui/anim";
import { tick } from "vyto/mobile/android/haptics";
import { SelectionModel, SelectionAction, select_word,
         open_selection_toolbar } from "vyto/ui/selection";
import { sin, cos, sqrt, atan2, PI, TAU } from "vyto/math";

// Material metrics, in dp. Every one of these is multiplied by ui_scale()
// before it reaches a Rect — see there for why that is not optional.
export const DP_FAB: float = 56.0;          // standard FAB diameter
export const DP_FAB_MINI: float = 40.0;
export const DP_BOTTOM_NAV_H: float = 80.0; // M3 nav bar height
export const DP_TOUCH_MIN: float = 48.0;    // minimum tappable target
export const DP_SHEET_HANDLE_W: float = 32.0;
export const DP_SHEET_HANDLE_H: float = 24.0; // grab strip above sheet content
export const DP_DRAWER_W: float = 320.0;

// Which edge a NavigationDrawer slides in from.
export const DRAWER_LEFT: int = 0;
export const DRAWER_RIGHT: int = 1;
export const DP_ROW_H: float = 48.0;        // drawer destination row

// Enter/exit durations. M3 puts a sheet slightly faster than a drawer because
// it travels less.
const SHEET_MS: int = 220;
const DRAWER_MS: int = 250;

// Scrim opacity behind an open overlay, at full open (0-255).
const SCRIM_ALPHA: float = 100.0;

// Drag past this fraction of the widget's travel and the release dismisses
// rather than snapping back; a flick faster than FLING_PX per move event
// dismisses regardless of how far it got.
const DISMISS_FRAC: float = 0.4;
const FLING_PX: float = 12.0;

// A non-looping Tween has no completion callback, so the end of a slide is
// read off the animated value. Every EASE_* lands exactly on its target at
// t=1, so this only guards float comparison, not easing overshoot.
const ANIM_EPS: float = 0.001;

// Device-pixel factor for a widget's window, or 1.0 before it is mounted.
//
// Theme.apply_scale multiplies the theme's own metrics (text sizes, spacing,
// radii) by the display density, but it cannot reach a constant written in
// this file. Leaving these unscaled is not a cosmetic bug: on a 2.75-density
// phone a 48dp touch target became 48 *pixels*, i.e. 17dp — barely a third of
// the Material minimum — and every hit target in this module was equally
// undersized. It also produced scaled text inside unscaled boxes, which is
// what made the date grid look cramped while its month title looked right.
//
// Read off the window rather than passed as an argument, because half the
// geometry helpers here (row_rect, cell_rect) have no Theme in scope and
// threading one through all of them would be noise. scale_applied is 0.0 until
// Window.run applies it, hence the guard.
fn ui_scale(w: Widget): float {
    let win = w.win;
    if (win == null) { return 1.0; }
    let f = win.theme.scale_applied;
    if (f > 0.0) { return f; }
    return 1.0;
}

fn clampf(v: float, lo: float, hi: float): float {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// Zero-padded two-digit number, for clock and calendar text.
fn pad2(n: int): string {
    if (n < 10) { return "0" + str(n); }
    return str(n);
}

// ------------------------------------------------------- AndroidWidget

// Ripple timings. The expansion is what says "that registered"; the fade is
// what gets it out of the way again.
const RIPPLE_MS: int = 260;
const RIPPLE_FADE_MS: int = 160;
const RIPPLE_ALPHA: float = 46.0;   // peak overlay alpha, 0-255

// The base class for a widget that will be touched rather than clicked.
//
// vyto/ui is a desktop toolkit: it fires clicks on press, keeps hover state a
// finger cannot produce, and measures hit targets in raw pixels. Each of those
// is wrong on a phone in the same way for every widget, so they are fixed once
// here rather than per widget. Subclass this instead of Widget and the touch
// behaviour comes with it:
//
//   * a tap fires on RELEASE (on_tap), not on touch-down
//   * a long-press reaches on_context, or starts a text selection
//   * hover and press state are cleared when the finger lifts
//   * anything measured is at least min_touch dp
//   * a press ripples, on painters that can clip
//
// Three hooks replace the Widget ones, because Vyto's `super` cannot be reached
// from a grandchild's override of a method this class already overrides:
//
//   Widget.measure  ->  content_size(s, th)   (this class clamps the result)
//   Widget.render   ->  paint(s, th)          (this class draws the ripple after)
//   on_click        ->  on_tap(x, y)          (fires on release)
//
// Override measure/render/on_click directly and you opt out of exactly the
// thing this class exists for, so don't.
export class AndroidWidget extends Widget {
    // Minimum tappable size in dp, applied to whatever content_size returns.
    // 48dp is the Material floor; 0 disables the clamp for a widget that is
    // deliberately small and not itself a target.
    min_touch: float;
    ripple: bool;
    rip_x: float;         // press origin, in absolute px
    rip_y: float;
    rip_t: float;         // expansion 0..1
    rip_a: float;         // opacity 0..1
    rip_r: Rect;          // area it is clipped to, captured at press
    rip_tw: Tween;
    // A long-press already acted on this press, so the release must not also
    // fire a tap. Window resets its own long_press_fired *before* dispatching
    // the release (core.vt), so the widget has to remember this itself.
    lp_fired: bool;
    // Buzz on a long-press. On by default; a widget whose long-press is not an
    // affordance (or an app that wants silence) turns it off.
    haptics: bool;
    // Text selection, off unless enable_selection() was called. The model, the
    // word expansion, the toolbar and the Copy/Select-All actions are all
    // vyto/ui/selection — this class only supplies the touch gestures that
    // drive them, the way Text supplies the mouse ones.
    selectable: bool;
    sel: SelectionModel;
    selectionActions: SelectionAction[];  // extra toolbar buttons, app-supplied
    sel_dragging: bool;   // a long-press started a selection this drag extends

    fn init() {
        super.init();
        this.min_touch = DP_TOUCH_MIN;
        this.ripple = true;
        this.rip_t = 0.0;
        this.rip_a = 0.0;
        this.lp_fired = false;
        this.haptics = true;
        this.selectable = false;
        this.sel_dragging = false;
        this.selectionActions = [];
        // Mobile default. Harmless on a widget with nothing to scroll —
        // bounce_pull refuses when there is no overflow.
        this.bounce = true;
    }

    // dp() itself now lives on Widget (core.vt) — every widget needs it, not
    // only the mobile ones. Inherited here unchanged.

    // ---------------------------------------------------------- sizing

    // The widget's natural size, before the touch-target clamp. This is the
    // one to override — measure() applies the minimum on top of it.
    virtual fn content_size(s: Painter, th: Theme): Size { return Size(0.0, 0.0); }

    override fn measure(s: Painter, th: Theme): Size {
        let sz = this.content_size(s, th);
        let m = this.dp(this.min_touch);
        if (m <= 0.0) { return sz; }
        let w = sz.w;
        let h = sz.h;
        // Only a positive dimension is clamped: 0.0 means "fill this axis"
        // to every container in the toolkit, and raising it to 48 would turn a
        // full-width bar into a 48px stub.
        if (w > 0.0 && w < m) { w = m; }
        if (h > 0.0 && h < m) { h = m; }
        return Size(w, h);
    }

    // Grown at measure time rather than in hit(): Window gates on_release on
    // contains(press_w.bounds, ...), so a hit area wider than the widget would
    // take presses whose release then fires nothing at all — a dead margin
    // around every control, which is worse than the small target.

    // ---------------------------------------------------------- painting

    // The widget's own drawing. Default is Widget.render (children, then any
    // exiting ones); the ripple is composited over whatever this leaves.
    virtual fn paint(s: Painter, th: Theme) { super.render(s, th); }

    override fn render(s: Painter, th: Theme) {
        this.paint(s, th);
        this.draw_ripple(s, th);
    }

    // Ripple needs a clip (to stay inside the widget) and alpha (to not bury
    // what it covers). can_clip() reports both — it is the rich tier's flag —
    // so on the lean tier the ripple is simply absent rather than a solid disc.
    fn ripple_ok(): bool {
        if (!this.ripple) { return false; }
        let w = this.win;
        if (w == null) { return false; }
        return w.painter.can_clip();
    }

    // The area the ripple is confined to, and the corner radius it is clipped
    // with. Default is the whole widget, which is right for a control that IS
    // the target; a widget holding several targets (a nav bar's segments, a
    // calendar's cells) returns the one under rip_x/rip_y instead, or a ripple
    // reads as the whole strip lighting up.
    virtual fn ripple_bounds(): Rect { return this.bounds; }
    virtual fn ripple_radius(): float { return 0.0; }

    fn start_ripple(x: int, y: int) {
        if (!this.ripple_ok()) { return; }
        if (this.rip_tw != null) { this.rip_tw.cancel(); this.rip_tw = null; }
        this.rip_x = x as float;
        this.rip_y = y as float;
        this.rip_r = this.ripple_bounds();
        this.rip_a = 1.0;
        let w = this;
        this.rip_tw = this.animate_value(0.0, 1.0, RIPPLE_MS, false, EASE.OUT_CUBIC, (v) => {
            w.rip_t = v;
            w.invalidate();
        });
    }

    // Fade out from wherever the expansion got to. A short press should not
    // hold the ripple at 10% until it finishes growing, so the radius freezes
    // and only the alpha runs — which is also what the platform does.
    fn fade_ripple() {
        if (this.rip_t <= 0.0 && this.rip_a <= 0.0) { return; }
        if (this.rip_tw != null) { this.rip_tw.cancel(); this.rip_tw = null; }
        let w = this;
        this.rip_tw = this.animate_value(this.rip_a, 0.0, RIPPLE_FADE_MS, false,
                                         EASE.OUT_CUBIC, (v) => {
            w.rip_a = v;
            if (v <= 0.0) { w.rip_t = 0.0; }
            w.invalidate();
        });
    }

    // Distance from the press origin to the furthest corner — the radius at
    // which the ripple has covered the whole widget.
    fn ripple_reach(): float {
        let r = this.rip_r;
        let dx = this.rip_x - r.x;
        let ox = r.right() - this.rip_x;
        if (ox > dx) { dx = ox; }
        let dy = this.rip_y - r.y;
        let oy = r.bottom() - this.rip_y;
        if (oy > dy) { dy = oy; }
        return sqrt(dx * dx + dy * dy);
    }

    fn draw_ripple(s: Painter, th: Theme) {
        if (this.rip_t <= 0.0 || this.rip_a <= 0.0) { return; }
        // A widget whose ripple_bounds() found no target under the press
        // returns an empty rect: the press was on chrome, and chrome does not
        // ripple.
        if (this.rip_r.w <= 0.0 || this.rip_r.h <= 0.0) { return; }
        if (!s.can_clip()) { return; }
        let a = (RIPPLE_ALPHA * this.rip_a) as int;
        if (a <= 0) { return; }
        s.clip_push(this.rip_r, this.ripple_radius());
        s.circle(this.rip_x, this.rip_y, this.rip_t * this.ripple_reach(),
                 with_alpha(th.on_surface, a));
        s.clip_pop();
    }

    // ---------------------------------------------------------- touch

    // A tap: the finger landed on this widget and lifted on it without
    // dragging. This is where an action goes — NOT on_click, which now fires
    // on touch-down and does nothing but arm the press.
    virtual fn on_tap(x: int, y: int): bool { return false; }

    // Touch-down / touch-up affordances (a lift, a colour change). Not where
    // actions go: a press that turns into a scroll still calls both.
    virtual fn on_press_begin(x: int, y: int) { }
    virtual fn on_press_end() { }

    override fn on_click(x: int, y: int): bool {
        this.start_ripple(x, y);
        this.on_press_begin(x, y);
        // Deliberately false. Window calls set_press *before* on_click
        // (core.vt), so the capture — and therefore drag, long-press and
        // release — is already ours; returning true would only force a
        // full-window redraw on every touch-down.
        return false;
    }

    override fn on_release(x: int, y: int): bool {
        let changed = super.on_release(x, y);   // scrollbar_release
        this.fade_ripple();
        this.on_press_end();
        this.clear_touch_state();
        // A long-press already acted; the lift that ends it is not a tap.
        if (this.lp_fired) { this.lp_fired = false; return true; }
        // A tap with a live selection dismisses it, as the platform does, and
        // does not also fire the widget's action.
        if (this.selectable && this.sel != null && !this.sel.empty()) {
            this.clear_selection();
            return true;
        }
        if (this.on_tap(x, y)) { return true; }
        return changed;
    }

    override fn on_long_press(x: int, y: int): bool {
        this.lp_fired = true;
        // The platform always buzzes here, and its absence is felt: a
        // long-press has no visual "it armed" moment of its own, so the tick
        // *is* the confirmation. Nothing else in the toolkit buzzes on its own
        // — stock Android does not buzz on an ordinary tap.
        if (this.haptics) { tick(); }
        if (this.selectable && this.sel != null) {
            select_word(this.sel, this.offset_at(x, y));
            this.sel_dragging = true;
            this.invalidate();
            this.show_selection(x as float);
            return true;
        }
        // The bridge Track C item 7 asks for: on a phone the long-press *is*
        // the right click, so ContextMenu and the DataTable header menu become
        // reachable without every widget wiring it.
        return this.on_context(x, y);
    }

    override fn on_drag(dx: int, dy: int): bool {
        if (this.selecting()) {
            let w = this.win;
            if (w != null) {
                this.sel.focus = this.offset_at(w.drag_x, w.drag_y);
                this.sel.active = true;
                this.invalidate();
                return true;
            }
        }
        // Not selecting, so this is a scroll. super walks the parent chain —
        // scrollable ancestor first, then overscroll bounce — and that order is
        // what keeps pull-to-refresh alive. Re-implementing the walk here is
        // how it gets broken.
        return super.on_drag(dx, dy);
    }

    override fn on_drag_end(x: int, y: int): bool {
        this.fade_ripple();
        this.on_press_end();
        this.clear_touch_state();
        this.lp_fired = false;
        if (this.selecting()) {
            this.sel_dragging = false;
            if (!this.sel.empty()) { this.show_selection(x as float); }
            return true;
        }
        return super.on_drag_end(x, y);
    }

    // A finger leaves no cursor behind. Window clears `pressed` on release but
    // nothing retargets the press spring, and hover was set by the press and
    // never moves away — so a tapped widget stays lit until something else is
    // touched. AndroidWindow sets Window.touch_mode, which does the hover half
    // for every plain vyto/ui widget too; this covers the case where an
    // AndroidWidget is used under a desktop Window (every golden in tests/ui).
    fn clear_touch_state() {
        if (this.anim_press != null) { this.drive_press(0.0); }
        let w = this.win;
        if (w != null && w.hover_w == this) { w.set_hover(null); }
    }

    // ---------------------------------------------------------- selection

    // Turn on text selection. `text_fn` supplies the current display text —
    // what the user sees and would copy — so a copy always reflects live
    // content. The widget also supplies geometry via offset_at().
    //
    //     let self = this;
    //     this.enable_selection(() => { return self.label; });
    //
    // Known limit: the Android clipboard is process-local today
    // (surface/native/src/vsurf_android.c), so Copy works inside the app and a
    // paste into another app gets nothing.
    fn enable_selection(text_fn: fn(): string) {
        if (this.sel == null) { this.sel = new SelectionModel(this); }
        this.sel.text_fn = text_fn;
        this.selectable = true;
        this.focusable = true;   // so Ctrl+C / Ctrl+A reach it on a desktop
    }

    // Byte offset into the display text under an absolute point. A one-line
    // widget answers with col_at_x(win.painter, line, x - line_x); the default
    // makes selection a no-op rather than a wrong-offset mess.
    virtual fn offset_at(x: int, y: int): int { return 0; }

    // Top edge of the line holding `off`, for placing the toolbar above the
    // selection. Single-line widgets keep the default.
    virtual fn selection_line_top(off: int): float { return this.bounds.y; }

    fn selecting(): bool {
        return this.selectable && this.sel != null && this.sel_dragging;
    }

    fn show_selection(px: float) {
        if (this.sel == null || this.sel.empty()) { return; }
        open_selection_toolbar(this, this.sel, px,
                               this.selection_line_top(this.sel.lo()),
                               this.selectionActions);
    }

    fn clear_selection() {
        if (this.sel == null) { return; }
        this.sel.clear();
        this.sel_dragging = false;
        this.invalidate();
    }

    override fn on_key(k: int, ch: string): bool {
        if (!this.selectable || this.sel == null || this.win == null) { return false; }
        if ((this.win.mods & MOD_CTRL) != 0) {
            if (k == 99) {   // Ctrl+C
                let t = this.sel.selected_text();
                if (t.len > 0) { this.win.surf.set_clipboard(t); }
                return true;
            }
            if (k == 97) {   // Ctrl+A
                this.sel.select_all();
                this.invalidate();
                return true;
            }
        }
        return false;
    }

    // Subclasses that override this MUST call super.drop_handlers(): the
    // ripple tween and the selection model's text_fn closure both capture the
    // widget, and a missed call is a leak nothing reports.
    override fn drop_handlers() {
        if (this.rip_tw != null) { this.rip_tw.cancel(); this.rip_tw = null; }
        if (this.sel != null) { this.sel.drop(); }
        this.selectionActions = [];
    }
}

// ---------------------------------------------------------------- TopBar

export const NAV_NONE: int = 0;
export const NAV_BACK: int = 1;   // drawn ‹— chevron, "go back"
export const NAV_MENU: int = 2;   // drawn hamburger, "open the drawer"

const DP_TOPBAR_H: float = 56.0;  // M3 small top app bar

// One trailing action. Short label or glyph — this bar draws text, not icons,
// for the same reason the rest of the package does: an icon set is a
// dependency and a glyph is not.
export class TopBarAction {
    label: string;
    run: fn();

    fn init(label: string, run: fn()) {
        this.label = label;
        this.run = run;
    }
}

// The app bar. `vyto/ui` has none — MenuBar and Toolbar are desktop shapes —
// so every Android app has been hand-rolling this one (apps/hn_android does,
// at hnrows.vt:450).
//
// Three slots and a stack of extra rows, each of which takes either the cheap
// built-in form or any widget:
//
//     let bar = new TopBar("Inbox")
//         .with_nav(NAV_MENU, () => { sc.open_drawer(); })
//         .with_actions([new TopBarAction("⌕", () => { search(); })]);
//
//     let bar = new TopBar("")
//         .leading(new Avatar("EM"))
//         .middle(new SearchField())      // any widget
//         .row(new TabView([...]));       // grows the bar by the row's height
//
// A widget in a slot is an ordinary child: it lays out, draws, hit-tests and
// takes its own taps, so nothing here routes events into it.
export class TopBar extends AndroidWidget {
    title: string;
    centered: bool;       // M3 centre-aligned variant
    nav: int;             // NAV_* — the drawn leading glyph, when no lead widget
    onNav: fn();
    actions: TopBarAction[];
    // Raise a shadow instead of a divider once the content below has scrolled.
    // Scaffold drives `scrolled` off the content's scroll listener; without a
    // Scaffold it stays false and the bar is flat, which is the M3 resting
    // state anyway.
    elevate_on_scroll: bool;
    scrolled: bool;

    lead: Widget;         // slot widgets; null = use the built-in form
    mid: Widget;
    trail: Widget;
    rows: Widget[];       // extra full-width rows under the bar row

    // Geometry cached from the last arrange, because on_tap gets no Painter
    // and no Theme and still has to know where the targets are.
    band_w: float;        // width of the leading nav band
    bar_px: float;        // height of the bar row itself
    total_px: float;      // bar row + every extra row
    act_x: float[];       // per-action left edge / width, right to left
    act_w: float[];

    fn init(title: string) {
        super.init();
        this.title = title;
        this.centered = false;
        this.nav = NAV_NONE;
        this.actions = [];
        this.rows = [];
        this.elevate_on_scroll = true;
        this.scrolled = false;
        this.band_w = 0.0;
        this.bar_px = 0.0;
        this.total_px = 0.0;
        this.act_x = [];
        this.act_w = [];
        // The bar is chrome, not a target: only the nav band and the action
        // cells ripple (see ripple_bounds), and the 48dp clamp would be
        // meaningless on something that spans the screen.
        this.min_touch = 0.0;
    }

    builder fn with_nav(kind: int, on: fn()) { this.nav = kind; this.onNav = on; return this; }
    builder fn with_actions(a: TopBarAction[]) { this.actions = a; return this; }
    builder fn center(on: bool) { this.centered = on; return this; }
    builder fn elevate(on: bool) { this.elevate_on_scroll = on; return this; }
    builder fn leading(w: Widget) { this.lead = w; this.add(w); return this; }
    builder fn middle(w: Widget) { this.mid = w; this.add(w); return this; }
    builder fn trailing(w: Widget) { this.trail = w; this.add(w); return this; }
    builder fn row(w: Widget) { this.rows.push(w); this.add(w); return this; }

    // Told by Scaffold. Repaints only on a change: this is called on every
    // scroll event, and the bar's look only has two states.
    fn set_scrolled(on: bool) {
        if (on == this.scrolled) { return; }
        this.scrolled = on;
        this.invalidate();
    }

    // Raise this bar whenever `content` is scrolled off its top. The closure
    // captures the bar, not the Scaffold — a Scaffold reachable from its own
    // content's listener would be a reference cycle, and this bar is not
    // reachable from the content.
    fn watch_scroll(content: Widget) {
        if (content == null) { return; }
        let b = this;
        content.on_scrolled = (y) => { b.set_scrolled(y > 0.0); };
    }

    // 48dp minimum, and wider if the theme's own metrics are: the band is the
    // target, the glyph inside it is only paint.
    fn nav_band(th: Theme): float {
        if (this.nav == NAV_NONE) { return 0.0; }
        let b = th.space_4 * 2.0 + th.text_lg;
        let min = this.dp(DP_TOUCH_MIN);
        if (b < min) { b = min; }
        return b;
    }

    fn bar_height(s: Painter, th: Theme): float {
        let h = this.dp(DP_TOPBAR_H);
        let pad = th.space_4;
        if (this.lead != null) {
            let sz = this.lead.measure(s, th);
            if (sz.h + pad > h) { h = sz.h + pad; }
        }
        if (this.mid != null) {
            let sz = this.mid.measure(s, th);
            if (sz.h + pad > h) { h = sz.h + pad; }
        }
        if (this.trail != null) {
            let sz = this.trail.measure(s, th);
            if (sz.h + pad > h) { h = sz.h + pad; }
        }
        return h;
    }

    override fn content_size(s: Painter, th: Theme): Size {
        // 0 width = "fill the axis", the convention every container here uses.
        return Size(0.0, this.bar_height(s, th));
    }

    // The bar fills the width it is offered and reports the height it needs,
    // which a natural-size measure cannot express.
    override fn layout(s: Painter, th: Theme, bc: BoxConstraints): Size {
        let h = this.bar_height(s, th);
        for (let r in this.rows) {
            h = h + r.layout(s, th, bcLoose(bc.maxW, bc.maxH)).h;
        }
        return Size(bc.maxW, h);
    }

    override fn arrange(s: Painter, th: Theme, r: Rect) {
        this.layout_to(r);
        let pad = th.space_4;
        let bh = this.bar_height(s, th);
        this.bar_px = bh;
        this.band_w = this.nav_band(th);
        let bar = Rect(r.x, r.y, r.w, bh);

        // --- leading ---
        let left = r.x + this.band_w;
        if (this.lead != null) {
            let sz = this.lead.measure(s, th);
            let lw = sz.w;
            if (lw < this.dp(DP_TOUCH_MIN)) { lw = this.dp(DP_TOUCH_MIN); }
            this.lead.arrange(s, th, Rect(r.x + pad, bar.center_y(sz.h), lw, sz.h));
            left = r.x + pad + lw + pad;
        } else if (this.band_w == 0.0) {
            left = r.x + pad;
        }

        // --- trailing: a widget, or the action cells laid right to left ---
        let right = r.right() - pad;
        this.act_x = [];
        this.act_w = [];
        if (this.trail != null) {
            let sz = this.trail.measure(s, th);
            this.trail.arrange(s, th, Rect(right - sz.w, bar.center_y(sz.h), sz.w, sz.h));
            right = right - sz.w - pad;
        } else {
            let n = this.actions.len;
            for (let i in 0..n) {
                // laid from the right edge inwards, so index 0 is outermost
                let a = this.actions[n - 1 - i];
                let aw = s.text_width(a.label) + 2.0 * pad;
                let min = this.dp(DP_TOUCH_MIN);
                if (aw < min) { aw = min; }
                right = right - aw;
                this.act_x.push(right);
                this.act_w.push(aw);
            }
            // act_x/act_w were filled right to left; flip so index i matches
            // actions[i] and the hit test needs no arithmetic.
            let xs: float[] = [];
            let ws: float[] = [];
            for (let i in 0..this.act_x.len) {
                xs.push(this.act_x[this.act_x.len - 1 - i]);
                ws.push(this.act_w[this.act_w.len - 1 - i]);
            }
            this.act_x = xs;
            this.act_w = ws;
        }

        // --- middle ---
        if (this.mid != null) {
            let sz = this.mid.measure(s, th);
            let mw = right - left;
            if (mw < 0.0) { mw = 0.0; }
            let mx = left;
            if (this.centered && sz.w < mw) { mx = bar.center_x(sz.w); }
            let use_w = sz.w;
            if (use_w > mw || sz.w == 0.0) { use_w = mw; }
            this.mid.arrange(s, th, Rect(mx, bar.center_y(sz.h), use_w, sz.h));
        }

        // --- extra rows, stacked full width ---
        let y = r.y + bh;
        for (let rw in this.rows) {
            let h = rw.layout(s, th, bcLoose(r.w, r.h)).h;
            rw.arrange(s, th, Rect(r.x, y, r.w, h));
            y = y + h;
        }
        this.total_px = y - r.y;
    }

    fn action_rect(i: int): Rect {
        if (i < 0 || i >= this.act_x.len) { return Rect(0.0, 0.0, 0.0, 0.0); }
        return Rect(this.act_x[i], this.bounds.y, this.act_w[i], this.bar_px);
    }

    fn band_rect(): Rect {
        return Rect(this.bounds.x, this.bounds.y, this.band_w, this.bar_px);
    }

    // Only the two kinds of target ripple. A press on the title is a press on
    // chrome and must not light the whole bar up.
    override fn ripple_bounds(): Rect {
        if (this.lead == null && this.band_w > 0.0
            && this.rip_x < this.bounds.x + this.band_w) {
            return this.band_rect();
        }
        for (let i in 0..this.act_x.len) {
            let ar = this.action_rect(i);
            if (this.rip_x >= ar.x && this.rip_x < ar.right()) { return ar; }
        }
        return Rect(0.0, 0.0, 0.0, 0.0);
    }

    override fn paint(s: Painter, th: Theme) {
        let r = this.bounds;
        if (this.elevate_on_scroll && this.scrolled) {
            s.shadow(r, 0.0, this.dp(6.0), this.dp(2.0), th.shadow_color);
        }
        s.fill(r, th.surface_raised);
        let bar = Rect(r.x, r.y, r.w, this.bar_px);

        if (this.lead == null) { this.draw_nav(s, th, bar); }

        if (this.mid == null && this.title.len > 0) {
            let pad = th.space_4;
            s.push_font(th.text_lg, WEIGHT_BOLD);
            if (this.centered) {
                s.text_center(bar, this.title, th.type_color_title);
            } else {
                let x = r.x + pad;
                if (this.band_w > 0.0) { x = r.x + this.band_w; }
                s.text(x, s.baseline_in(bar), this.title, th.type_color_title);
            }
            s.pop_font();
        }

        if (this.trail == null) {
            for (let i in 0..this.actions.len) {
                s.text_center(this.action_rect(i), this.actions[i].label, th.on_surface);
            }
        }

        // slot widgets and extra rows are ordinary children
        for (let c in this.children) { c.draw(s, th); }

        // Flat bars carry a hairline; a raised one carries the shadow instead,
        // and drawing both reads as a double edge.
        if (!(this.elevate_on_scroll && this.scrolled)) {
            s.line(r.x, r.bottom() - 0.5, r.right(), r.bottom() - 0.5, th.divider);
        }
    }

    // Drawn from strokes, not typed. A font's "‹" is a thin glyph at body
    // size where Android's back affordance is a 24dp arrow with a shaft, and
    // the hamburger has no glyph at all. Three lines each, scaled with the
    // display — the same shape apps/hn_android arrived at (hnrows.vt:501).
    fn draw_nav(s: Painter, th: Theme, bar: Rect) {
        if (this.nav == NAV_NONE) { return; }
        let k = ui_scale(this);
        let g = 24.0 * k;
        let lw = 2.0 * k;
        let cx = bar.x + this.band_w / 2.0;
        let cy = bar.center_y(0.0);
        let ink = th.type_color_title;
        if (this.nav == NAV_BACK) {
            let tip = cx - g / 2.0;
            let head = g * 0.34;
            s.line_w(tip, cy, cx + g / 2.0, cy, lw, ink);
            s.line_w(tip, cy, tip + head, cy - head, lw, ink);
            s.line_w(tip, cy, tip + head, cy + head, lw, ink);
            return;
        }
        let half = g / 2.0;
        let gap = g * 0.3;
        s.line_w(cx - half, cy - gap, cx + half, cy - gap, lw, ink);
        s.line_w(cx - half, cy, cx + half, cy, lw, ink);
        s.line_w(cx - half, cy + gap, cx + half, cy + gap, lw, ink);
    }

    override fn on_tap(x: int, y: int): bool {
        // Below the bar row is an extra row's business, and those are children
        // that took their own press.
        if ((y as float) > this.bounds.y + this.bar_px) { return false; }
        if (this.lead == null && this.onNav != null && contains(this.band_rect(), x, y)) {
            this.onNav();
            return true;
        }
        for (let i in 0..this.actions.len) {
            if (contains(this.action_rect(i), x, y)) {
                let a = this.actions[i];
                if (a.run != null) { a.run(); }
                return true;
            }
        }
        // A tap on the title is not a gesture. Consuming it would make the
        // whole bar feel like a button.
        return false;
    }

    override fn drop_handlers() {
        this.onNav = null;
        for (let a in this.actions) { a.run = null; }
        this.actions = [];
        super.drop_handlers();
    }
}

// ---------------------------------------------------------------- FAB

// Circular elevated action button. The one control an Android user reads as
// "the main thing this screen does".
//
// Ripple comes from AndroidWidget, clipped to the circle (ripple_bounds +
// ripple_radius below) rather than to the square layout box.
export class FloatingActionButton extends AndroidWidget {
    label: string;        // short glyph or 1-2 chars; M3 FABs are icon-only
    onClick: fn(FloatingActionButton);
    mini: bool;
    lift: float;          // 0..1 press-lift, animated
    lift_tw: Tween;

    fn init(label: string) {
        super.init();
        this.label = label;
        this.mini = false;
        this.focusable = true;
        this.lift = 0.0;
    }

    fn with_mini(m: bool): FloatingActionButton {
        this.mini = m;
        return this;
    }

    fn diameter(): float {
        let k = ui_scale(this);
        if (this.mini) { return DP_FAB_MINI * k; }
        return DP_FAB * k;
    }

    fn fire() {
        if (this.onClick != null) { this.onClick(this); }
    }

    override fn content_size(s: Painter, th: Theme): Size {
        let d = this.diameter();
        return Size(d, d);
    }

    // The circle inside the layout box. A mini FAB is 40dp, under the 48dp
    // touch minimum, so measure() hands it a larger box — the button must then
    // draw centred in it rather than pinned to the corner.
    fn circle_rect(): Rect {
        let d = this.diameter();
        let r = this.bounds;
        return Rect(r.cx() - d / 2.0, r.cy() - d / 2.0, d, d);
    }

    override fn ripple_bounds(): Rect { return this.circle_rect(); }
    override fn ripple_radius(): float { return this.diameter() / 2.0; }

    override fn paint(s: Painter, th: Theme) {
        let cr = this.circle_rect();
        let d = cr.w;
        // elevation rises on press, matching M3's 6dp -> 12dp
        let k = ui_scale(this);
        let blur = (6.0 + this.lift * 6.0) * k;
        let dy = (3.0 + this.lift * 3.0) * k;
        s.shadow(cr, d / 2.0, blur, dy, th.shadow_color);
        s.circle(cr.cx(), cr.cy(), d / 2.0, th.primary);
        s.push_font(th.text_lg, WEIGHT_MED);
        s.text_center(cr, this.glyph(), th.on_primary);
        s.pop_font();
    }

    // What the button draws right now. A plain FAB draws its label forever;
    // ActionsFab swaps it while its menu is open, and derives that from the
    // Window rather than caching it, so an Escape-dismissed menu cannot leave
    // the wrong glyph behind.
    virtual fn glyph(): string { return this.label; }

    fn animate_lift(target: float) {
        let b = this;
        if (this.lift_tw != null) { this.lift_tw.cancel(); }
        this.lift_tw = this.animate_value(this.lift, target, 150, false,
                                          EASE.OUT_CUBIC, (v) => { b.lift = v; });
    }

    // The lift follows the finger, not a cursor: a touch UI never gets a hover
    // enter, so driving it from hover left the FAB flat on a phone and lit on a
    // desktop for as long as the pointer merely passed over it.
    override fn on_press_begin(x: int, y: int) { this.animate_lift(1.0); }
    override fn on_press_end() { this.animate_lift(0.0); }

    override fn on_tap(x: int, y: int): bool {
        this.fire();
        return true;
    }

    override fn on_key(k: int, ch: string): bool {
        if (k == 32) { this.fire(); return true; }
        return super.on_key(k, ch);
    }

    override fn drop_handlers() {
        this.onClick = null;
        if (this.lift_tw != null) { this.lift_tw.cancel(); this.lift_tw = null; }
        super.drop_handlers();
    }
}

// ------------------------------------------------------------- ActionsFab

// Which way the revealed actions stack.
export const FAB_MENU_AUTO: int = 0;   // up when the FAB is in the lower half
export const FAB_MENU_UP: int = 1;
export const FAB_MENU_DOWN: int = 2;

const FAB_MENU_MS: int = 200;
const DP_FAB_GAP: float = 12.0;        // between stacked mini FABs
const DP_FAB_LABEL_GAP: float = 12.0;  // between a mini FAB and its label pill
const DP_FAB_LABEL_H: float = 28.0;
// Each action starts this much later than the one before it, as a fraction of
// the whole reveal — the stagger that makes the stack read as unfolding.
const FAB_STAGGER: float = 0.14;

// One action in a speed dial: the glyph drawn in its mini FAB, the label
// beside it, and what it does.
export class FabAction {
    glyph: string;
    label: string;
    run: fn();

    fn init(glyph: string, label: string, run: fn()) {
        this.glyph = glyph;
        this.label = label;
        this.run = run;
    }
}

// A FAB that reveals more FABs — Material's speed dial, and the standard way
// a screen offers two to four primary actions.
//
//     let fab = new ActionsFab("+");
//     fab.actions = [new FabAction("✎", "Post", () => { compose(); }),
//                    new FabAction("⌾", "Photo", () => { pick(); })];
//     sc.with_fab(fab);
//
// The revealed FABs live in a Window overlay, not inside this widget. Two
// reasons, both hard: a widget may not draw outside its own bounds and stay
// tappable (hit-testing is bounds-based), and inside a Scaffold this widget's
// slot is exactly one FAB tall. The overlay also brings the scrim, the
// outside-tap dismissal and Back-to-close for free — AndroidWindow.back_depth
// already counts an open overlay.
export class ActionsFab extends FloatingActionButton {
    actions: FabAction[];
    dir: int;
    open_label: string;    // glyph while the menu is open
    // Weak: the Window owns the open overlay. An Escape dismisses it without
    // telling anyone, so this must be allowed to go null on its own rather
    // than pinning a menu that is no longer on screen.
    menu: weak FabMenu;

    fn init(label: string) {
        super.init(label);
        this.actions = [];
        this.dir = FAB_MENU_AUTO;
        this.open_label = "×";
    }

    builder fn with_actions(a: FabAction[]) { this.actions = a; return this; }
    builder fn stack(d: int) { this.dir = d; return this; }

    // Derived, never cached: the menu is open exactly while it is the
    // Window's overlay.
    fn is_open(): bool {
        let w = this.win;
        if (w == null || this.menu == null) { return false; }
        return w.overlay == this.menu;
    }

    override fn glyph(): string {
        if (this.is_open()) { return this.open_label; }
        return this.label;
    }

    fn open_menu() {
        let w = this.win;
        if (w == null || this.actions.len == 0) { return; }
        let m = new FabMenu(this);
        this.menu = m;
        w.open_overlay(m);
        m.open();
    }

    fn close_menu() {
        if (this.menu != null) { this.menu.close(); }
    }

    override fn on_tap(x: int, y: int): bool {
        if (this.actions.len == 0) { return super.on_tap(x, y); }
        if (this.is_open()) { this.close_menu(); } else { this.open_menu(); }
        this.invalidate();
        return true;
    }

    override fn drop_handlers() {
        for (let a in this.actions) { a.run = null; }
        this.actions = [];
        super.drop_handlers();
    }
}

// The revealed stack. Full-window bounds and its own click routing, the same
// shape BottomSheet uses — see that class for why an overlay that paints its
// own content needs custom_paint.
//
// The mini FABs are drawn, not child widgets. An overlay dispatches on_click
// to its root, so children would each need routing back to here anyway to
// close the menu after running — and a drawn circle costs one op where a
// widget costs a subtree.
export class FabMenu extends Widget {
    owner: weak ActionsFab;
    actions: FabAction[];
    anchor: Rect;         // the FAB this unfolded from
    up: bool;             // stack upwards
    left_labels: bool;    // labels on the left of the mini FABs
    t: float;             // reveal 0..1
    anim: Tween;
    closing: bool;

    fn init(owner: ActionsFab) {
        super.init();
        this.owner = owner;
        this.actions = owner.actions;
        this.anchor = owner.bounds;
        this.t = 0.0;
        this.closing = false;
        this.up = true;
        this.left_labels = true;
        this.modal = true;        // exits through close(), which animates
        this.custom_paint = true; // draws its own content, not just children
    }

    override fn place(s: Painter, th: Theme) {
        this.bounds = Rect(0.0, 0.0, s.width(), s.height());
        // Whichever direction has room. A FAB is nearly always bottom-anchored,
        // so this is nearly always "up".
        this.up = this.anchor.cy() > s.height() / 2.0;
        if (this.owner != null && this.owner.dir == FAB_MENU_UP) { this.up = true; }
        if (this.owner != null && this.owner.dir == FAB_MENU_DOWN) { this.up = false; }
        // Labels go on the roomier side of the column.
        this.left_labels = this.anchor.cx() > s.width() / 2.0;
    }

    fn relayout() {
        let w = this.win;
        if (w == null) { return; }
        this.place(w.painter, w.theme);
    }

    fn mini_d(): float { return DP_FAB_MINI * ui_scale(this); }

    // How far action i has unfolded. The stagger is what makes the stack read
    // as opening rather than appearing.
    fn item_t(i: int): float {
        let span = 1.0 - FAB_STAGGER * ((this.actions.len - 1) as float);
        if (span < 0.2) { span = 0.2; }
        return clampf((this.t - FAB_STAGGER * (i as float)) / span, 0.0, 1.0);
    }

    // Resting position of action i, fully open.
    fn item_center_y(i: int): float {
        let k = ui_scale(this);
        let step = this.mini_d() + DP_FAB_GAP * k;
        let first = this.anchor.y - DP_FAB_GAP * k - this.mini_d() / 2.0;
        if (!this.up) { first = this.anchor.bottom() + DP_FAB_GAP * k + this.mini_d() / 2.0; }
        if (this.up) { return first - (i as float) * step; }
        return first + (i as float) * step;
    }

    // Where it is right now: it travels out of the anchor as it unfolds.
    fn item_rect(i: int): Rect {
        let p = this.item_t(i);
        let d = this.mini_d() * p;
        let cx = this.anchor.cx();
        let cy = this.anchor.cy() + (this.item_center_y(i) - this.anchor.cy()) * p;
        return Rect(cx - d / 2.0, cy - d / 2.0, d, d);
    }

    fn open() {
        this.closing = false;
        this.slide_to(1.0);
    }

    fn close() {
        if (this.closing) { return; }
        this.closing = true;
        this.slide_to(0.0);
    }

    fn slide_to(target: float) {
        if (this.anim != null) { this.anim.cancel(); }
        let m = this;
        this.anim = this.animate_value(this.t, target, FAB_MENU_MS, false,
                                       EASE.OUT_CUBIC, (v) => {
            m.t = v;
            m.invalidate();
            if (m.closing && v <= ANIM_EPS) { m.finish_close(); }
        });
    }

    // Same shape as BottomSheet.finish_close: the tick closure holds its own
    // reference, so dropping the Window's overlay here cannot free this
    // mid-callback.
    fn finish_close() {
        this.closing = false;
        let w = this.win;
        if (w != null) { w.dismiss_overlay(); }
        let o = this.owner;
        if (o != null) { o.invalidate(); }
    }

    override fn render(s: Painter, th: Theme) {
        let a = (this.t * SCRIM_ALPHA) as int;
        if (a > 0) { s.fill(this.bounds, with_alpha(rgb(0, 0, 0), a)); }
        let k = ui_scale(this);
        for (let i in 0..this.actions.len) {
            let p = this.item_t(i);
            if (p <= 0.0) { continue; }
            let r = this.item_rect(i);
            let act = this.actions[i];
            s.shadow(r, r.w / 2.0, 6.0 * k, 3.0 * k, th.shadow_color);
            s.circle(r.cx(), r.cy(), r.w / 2.0, th.surface_raised);
            s.text_center(r, act.glyph, th.on_surface);
            if (act.label.len == 0) { continue; }
            // Label pill, on the side with room, fading in with its FAB.
            let lh = DP_FAB_LABEL_H * k;
            let lw = s.text_width(act.label) + 16.0 * k;
            let gap = DP_FAB_LABEL_GAP * k;
            let lx = r.right() + gap;
            if (this.left_labels) { lx = r.x - gap - lw; }
            let pill = Rect(lx, r.cy() - lh / 2.0, lw, lh);
            let av = (255.0 * p) as int;
            s.fill_round(pill, lh / 2.0, with_alpha(th.surface_raised, av));
            s.text_center(pill, act.label, with_alpha(th.on_surface, av));
        }
    }

    override fn on_click(x: int, y: int): bool {
        for (let i in 0..this.actions.len) {
            if (contains(this.item_rect(i), x, y)) {
                let a = this.actions[i];
                // Close first: the action may push a screen or open another
                // overlay, and dismissing afterwards would drop that one.
                this.close();
                if (a.run != null) { a.run(); }
                return true;
            }
        }
        // The anchor and the scrim both mean "put these away".
        this.close();
        return true;
    }

    override fn drop_handlers() {
        this.actions = [];
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
    }
}

// -------------------------------------------------- BottomNavigationBar

// 3-5 destinations pinned to the bottom edge. The dominant Android nav
// pattern, and the reason NavRail (a tablet/desktop side rail) is not a
// substitute.
export class BottomNavigationBar extends AndroidWidget {
    items: string[];
    selected: int;
    onSelect: fn(int);

    fn init(items: string[]) {
        super.init();
        this.items = items;
        this.selected = 0;
        this.focusable = true;
    }

    override fn content_size(s: Painter, th: Theme): Size {
        return Size(0.0, DP_BOTTOM_NAV_H * ui_scale(this));
    }

    // One destination, not the whole bar: a ripple spreading across all five
    // segments is what a shared `bounds` would give.
    override fn ripple_bounds(): Rect {
        let i = this.index_at(this.rip_x);
        if (i < 0) { return this.bounds; }
        let seg = this.bounds.w / (this.items.len as float);
        return Rect(this.bounds.x + (i as float) * seg, this.bounds.y, seg, this.bounds.h);
    }

    // Index under a device-pixel x, or -1. Items divide the width evenly, so
    // each target is width/n wide — comfortably above DP_TOUCH_MIN on any
    // phone with <= 5 destinations, which is the M3 maximum anyway.
    fn index_at(px: float): int {
        if (this.items.len == 0) { return -1; }
        let seg = this.bounds.w / (this.items.len as float);
        let i = ((px - this.bounds.x) / seg) as int;
        if (i < 0 || i >= this.items.len) { return -1; }
        return i;
    }

    override fn paint(s: Painter, th: Theme) {
        let r = this.bounds;
        s.fill(r, th.surface_raised);
        s.line(r.x, r.y, r.x + r.w, r.y, th.divider);
        if (this.items.len == 0) { return; }
        let seg = r.w / (this.items.len as float);
        for (let i in 0..this.items.len) {
            let ir = Rect(r.x + (i as float) * seg, r.y, seg, r.h);
            let fg = th.on_surface_muted;
            if (i == this.selected) {
                fg = th.primary;
                // M3 active indicator: a filled pill behind the active item.
                //
                // Centred on the label, not offset from the top of the bar. M3
                // puts the pill behind an *icon* with the label below it; this
                // bar draws the label alone and centres it vertically, so a
                // 12dp top offset left the pill floating above the word it was
                // supposed to be highlighting.
                //
                // Width follows the text too. At six destinations a fixed
                // fraction of the segment is narrower than "show" on some
                // scales, which crops the pill to the middle of the word.
                let k = ui_scale(this);
                let ph = 32.0 * k;
                let pw = s.text_width(this.items[i]) + 24.0 * k;
                let cap = seg - 8.0 * k;
                if (pw > cap) { pw = cap; }
                let pr = Rect(ir.center_x(pw), ir.center_y(ph), pw, ph);
                // Mixed rather than alpha-filled: the lean tier cannot blend
                // and would paint this the full primary colour, burying the
                // label it sits behind.
                s.fill_round(pr, ph / 2.0, mix(th.surface_raised, th.primary, 0.16));
            }
            s.text_center(ir, this.items[i], fg);
        }
    }

    override fn on_tap(x: int, y: int): bool {
        let i = this.index_at(x as float);
        if (i < 0 || i == this.selected) { return false; }
        this.selected = i;
        if (this.onSelect != null) { this.onSelect(i); }
        this.invalidate();
        return true;
    }

    override fn drop_handlers() {
        this.onSelect = null;
        super.drop_handlers();
    }
}

// ------------------------------------------------------------ BottomSheet

// A panel that rises from the bottom edge, dismissed by dragging it back down
// or tapping the scrim. Open it as an overlay, then slide it in:
//
//     let sheet = new BottomSheet(280.0);
//     sheet.add(new Column([...]));
//     win.open_overlay(sheet);
//     sheet.open();
//
// `bounds` is the whole window, not the sheet — the scrim belongs to this
// widget, so a tap on it must arrive as on_click. Window's own outside-click
// branch dismisses immediately and cannot animate, which is the wrong exit for
// a sheet. The sheet itself is `panel`.
export class BottomSheet extends Widget {
    peek_h: float;        // collapsed height; 0 = open fully
    expanded: bool;
    onDismiss: fn();
    // Fraction of the sheet that is off-screen, 0 = fully open, 1 = hidden.
    // Animated by open/close and driven directly by drag in between.
    offset: float;
    panel: Rect;          // the sheet; `bounds` is the whole window
    anim: Tween;
    last_dy: float;       // last drag delta — the fling-direction proxy
    closing: bool;        // a close animation is running

    fn init(peek_h: float) {
        super.init();
        this.peek_h = peek_h;
        this.expanded = false;
        this.offset = 1.0;
        this.panel = Rect(0.0, 0.0, 0.0, 0.0);
        this.last_dy = 0.0;
        this.closing = false;
        // This widget holds children AND paints its own content (scrim, panel,
        // handle) in render(). The default partial-repaint path draws a
        // container's chrome and then recurses into children — it never calls
        // render() — so without this the scrim and the panel vanish on every
        // partial repaint and come back on the next full redraw.
        //
        // On a device that reads as the whole screen strobing: measured off a
        // screen recording as mean frame brightness alternating between 123
        // (scrim drawn) and 190 (scrim missing) on consecutive frames, for as
        // long as any animation kept partial repaints coming.
        this.custom_paint = true;
        // Redundant while bounds covers the window (nothing is ever "outside"),
        // but it states the intent: this sheet exits through close(), never
        // through Window's undecorated dismiss.
        this.modal = true;
    }

    fn sheet_h(s: Painter): float {
        if (this.expanded || this.peek_h <= 0.0) { return s.height() * 0.6; }
        return this.peek_h;
    }

    override fn place(s: Painter, th: Theme) {
        this.bounds = Rect(0.0, 0.0, s.width(), s.height());
        let sh = this.sheet_h(s);
        this.panel = Rect(0.0, s.height() - sh + this.offset * sh, s.width(), sh);
        let strip = DP_SHEET_HANDLE_H * ui_scale(this);
        let cy = this.panel.y + strip;
        let content = Rect(this.panel.x, cy, this.panel.w, this.panel.h - strip);
        // Stack semantics: every child gets the whole content rect. Pass a
        // single Column when the sheet holds more than one widget — reusing the
        // layout containers beats growing a second stacking rule here.
        for (let c in this.children) { c.arrange(s, th, content); }
    }

    // Window.layout() calls place() on open, resize and dismiss — not per
    // frame — so an animating sheet re-places its own subtree each tick rather
    // than re-laying out the whole window.
    fn relayout() {
        let w = this.win;
        if (w == null) { return; }
        this.place(w.painter, w.theme);
    }

    override fn render(s: Painter, th: Theme) {
        let a = ((1.0 - this.offset) * SCRIM_ALPHA) as int;
        if (a > 0) { s.fill(this.bounds, with_alpha(rgb(0, 0, 0), a)); }
        let r = this.panel;
        s.shadow(r, th.radius_lg, 16.0, -2.0, th.shadow_color);
        s.fill_round(r, th.radius_lg, th.surface_raised);
        // drag handle
        let k = ui_scale(this);
        let hw = DP_SHEET_HANDLE_W * k;
        s.fill_round(Rect(r.x + (r.w - hw) / 2.0, r.y + 8.0 * k, hw, 4.0 * k),
                     2.0 * k, th.on_surface_subtle);
        for (let c in this.children) { c.draw(s, th); }
    }

    // Slide in. Call after win.open_overlay(sheet).
    fn open() {
        this.closing = false;
        this.slide_to(0.0);
    }

    // Slide out, then drop the overlay and fire onDismiss.
    fn close() {
        if (this.closing) { return; }
        this.closing = true;
        this.slide_to(1.0);
    }

    fn slide_to(target: float) {
        if (this.anim != null) { this.anim.cancel(); }
        let sheet = this;
        this.anim = this.animate_value(this.offset, target, SHEET_MS, false,
                                       EASE.OUT_CUBIC, (v) => {
            sheet.offset = v;
            sheet.relayout();
            if (sheet.closing && v >= 1.0 - ANIM_EPS) { sheet.finish_close(); }
        });
    }

    // Safe to run from inside the tween: the on_tick closure holds its own
    // reference to the sheet, so dropping the Window's overlay reference here
    // cannot free it mid-callback. Window.tick releases the closure afterwards.
    fn finish_close() {
        this.closing = false;
        let w = this.win;
        let cb = this.onDismiss;
        if (w != null) { w.dismiss_overlay(); }
        if (cb != null) { cb(); }
    }

    override fn on_click(x: int, y: int): bool {
        if (!contains(this.panel, x, y)) { this.close(); return true; }
        // Window dispatches on_click to the overlay root so each overlay can
        // route its own; a sheet holds caller-supplied content, so the routing
        // is the generic one.
        let t = this.hit(x, y);
        if (t != null && t != this) { return t.on_click(x, y); }
        return false;
    }

    override fn on_drag_start(x: int, y: int): bool {
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
        this.closing = false;
        this.last_dy = 0.0;
        return true;
    }

    override fn on_drag(dx: int, dy: int): bool {
        let w = this.win;
        if (w == null) { return false; }
        let sh = this.sheet_h(w.painter);
        if (sh <= 0.0) { return false; }
        this.last_dy = dy as float;
        this.offset = clampf(this.offset + (dy as float) / sh, 0.0, 1.0);
        this.relayout();
        this.invalidate();
        return true;
    }

    override fn on_drag_end(x: int, y: int): bool {
        // A downward flick dismisses however far it travelled; otherwise the
        // sheet settles to whichever end it is nearer.
        if (this.last_dy >= FLING_PX || this.offset >= DISMISS_FRAC) { this.close(); }
        else { this.open(); }
        return true;
    }

    override fn drop_handlers() {
        this.onDismiss = null;
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
    }
}

// -------------------------------------------------------- NavigationDrawer

// The modal navigation drawer: a scrim plus a panel sliding in from an edge,
// opened by a button and closed by a tap on the scrim or a drag back out.
//
//     let drawer = new NavigationDrawer(["Inbox", "Starred", "Sent"]);
//     drawer.onSelect = (i) => { ...; drawer.close(); };
//     win.open_overlay(drawer);
//     drawer.open();
//
// Either edge — an end drawer (filters, a cart, a profile) is the standard
// right-hand counterpart to the navigation one:
//
//     new NavigationDrawer([]).from_side(DRAWER_RIGHT).add(my_panel_content)
//
// and either content: with children, the panel lays the first one out and the
// string rows are not drawn at all. `items` stays the default because the row
// list is what a navigation drawer usually is.
//
// Same full-window `bounds` as BottomSheet, for the same reason: the scrim is
// part of the widget so its taps arrive as on_click.
//
// Opening by an edge swipe is deliberately not here. It is a gesture that
// begins outside the widget that would handle it, and the surface event model
// carries no notion of that — adding one is a toolkit-wide decision, not a
// drawer feature. Button-opened is the common case and is complete.
export class NavigationDrawer extends Widget {
    items: string[];
    selected: int;
    onSelect: fn(int);
    onDismiss: fn();
    open_frac: float;     // 0 = closed, 1 = open; animated
    panel: Rect;          // the drawer; `bounds` is the whole window
    anim: Tween;
    last_dx: float;
    closing: bool;
    // DRAWER_LEFT or DRAWER_RIGHT. Everything else about the drawer is
    // symmetric; three places branch on it — where the panel sits, which drag
    // direction opens it, and which one dismisses it.
    side: int;

    fn init(items: string[]) {
        super.init();
        this.items = items;
        this.selected = 0;
        this.open_frac = 0.0;
        this.panel = Rect(0.0, 0.0, 0.0, 0.0);
        this.last_dx = 0.0;
        this.closing = false;
        this.side = DRAWER_LEFT;
        this.modal = true;
    }

    builder fn from_side(s: int) { this.side = s; return this; }

    // +1 when a rightward drag opens the drawer (left edge), -1 for the right
    // edge. The whole mirror is this number.
    fn drag_sign(): float {
        if (this.side == DRAWER_RIGHT) { return -1.0; }
        return 1.0;
    }

    fn content(): Widget {
        if (this.children.len == 0) { return null; }
        return this.children[0];
    }

    fn drawer_w(s: Painter): float {
        let w = DP_DRAWER_W * ui_scale(this);
        // never let the panel swallow the whole screen — the scrim has to stay
        // tappable, since it is the way out
        if (w > s.width() * 0.85) { w = s.width() * 0.85; }
        return w;
    }

    override fn place(s: Painter, th: Theme) {
        this.bounds = Rect(0.0, 0.0, s.width(), s.height());
        let w = this.drawer_w(s);
        // Closed is one panel-width off its own edge; open is flush with it.
        let x = (this.open_frac - 1.0) * w;
        if (this.side == DRAWER_RIGHT) { x = s.width() - this.open_frac * w; }
        this.panel = Rect(x, 0.0, w, s.height());
        let c = this.content();
        if (c != null) { c.arrange(s, th, this.panel); }
    }

    fn relayout() {
        let w = this.win;
        if (w == null) { return; }
        this.place(w.painter, w.theme);
    }

    // Row rect for destination i, in absolute coordinates.
    fn row_rect(i: int): Rect {
        let k = ui_scale(this);
        let pad = 12.0 * k;
        let rh = DP_ROW_H * k;
        return Rect(this.panel.x + pad, this.panel.y + pad + (i as float) * rh,
                    this.panel.w - 2.0 * pad, rh);
    }

    // Destination index under an absolute point, or -1.
    fn index_at(x: int, y: int): int {
        for (let i in 0..this.items.len) {
            if (contains(this.row_rect(i), x, y)) { return i; }
        }
        return -1;
    }

    override fn render(s: Painter, th: Theme) {
        let a = (this.open_frac * SCRIM_ALPHA) as int;
        if (a > 0) { s.fill(this.bounds, with_alpha(rgb(0, 0, 0), a)); }
        let r = this.panel;
        s.shadow(r, 0.0, 16.0, 0.0, th.shadow_color);
        s.fill(r, th.surface_raised);
        let c = this.content();
        if (c != null) {
            // Content mode: the panel is whatever was added, and the row list
            // is not drawn even if `items` was also given.
            c.draw(s, th);
            return;
        }
        for (let i in 0..this.items.len) {
            let rr = this.row_rect(i);
            let fg = th.on_surface;
            if (i == this.selected) {
                fg = th.primary;
                // M3 active indicator: a full-width pill behind the row
                s.fill_round(rr, rr.h / 2.0, with_alpha(th.primary, 40));
            }
            s.text_in(rr, 16.0 * ui_scale(this), this.items[i], fg);
        }
    }

    // Slide in. Call after win.open_overlay(drawer).
    fn open() {
        this.closing = false;
        this.slide_to(1.0);
    }

    // Slide out, then drop the overlay and fire onDismiss.
    fn close() {
        if (this.closing) { return; }
        this.closing = true;
        this.slide_to(0.0);
    }

    fn slide_to(target: float) {
        if (this.anim != null) { this.anim.cancel(); }
        let d = this;
        this.anim = this.animate_value(this.open_frac, target, DRAWER_MS, false,
                                       EASE.OUT_CUBIC, (v) => {
            d.open_frac = v;
            d.relayout();
            if (d.closing && v <= ANIM_EPS) { d.finish_close(); }
        });
    }

    fn finish_close() {
        this.closing = false;
        let w = this.win;
        let cb = this.onDismiss;
        if (w != null) { w.dismiss_overlay(); }
        if (cb != null) { cb(); }
    }

    override fn on_click(x: int, y: int): bool {
        if (!contains(this.panel, x, y)) { this.close(); return true; }
        // In content mode the panel's own widgets took the press and route
        // their own clicks; there are no rows to select.
        if (this.content() != null) { return false; }
        let i = this.index_at(x, y);
        if (i < 0) { return false; }
        this.selected = i;
        if (this.onSelect != null) { this.onSelect(i); }
        this.invalidate();
        return true;
    }

    override fn on_drag_start(x: int, y: int): bool {
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
        this.closing = false;
        this.last_dx = 0.0;
        return true;
    }

    // Reached when the press landed on the panel's own content rather than on
    // the drawer: Widget.on_drag walks up the parent chain looking for someone
    // who wants the gesture, and in content mode that is this drawer. Without
    // it, a drawer holding widgets cannot be dragged shut at all — the child
    // holds the capture and the drag dies in the walk.
    //
    // A scrollable widget inside the panel is reached first by that same walk,
    // so a list in a drawer still scrolls vertically.
    override fn drag_scroll(dx: int, dy: int): bool {
        return this.on_drag(dx, dy);
    }
    override fn drag_scroll_end(): bool {
        return this.on_drag_end(0, 0);
    }

    override fn on_drag(dx: int, dy: int): bool {
        let w = this.win;
        if (w == null) { return false; }
        let dw = this.drawer_w(w.painter);
        if (dw <= 0.0) { return false; }
        // The press may have been taken by a child, so the drag can begin
        // without on_drag_start ever reaching this widget. Pinning a running
        // slide here rather than there costs one null check.
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
        this.last_dx = dx as float;
        this.open_frac = clampf(this.open_frac + (dx as float) * this.drag_sign() / dw,
                                0.0, 1.0);
        this.relayout();
        this.invalidate();
        return true;
    }

    override fn on_drag_end(x: int, y: int): bool {
        // A flick back towards the drawer's own edge dismisses it, whichever
        // edge that is; otherwise it settles to the nearer end.
        let flick = this.last_dx * this.drag_sign();
        if (flick <= 0.0 - FLING_PX || this.open_frac <= 1.0 - DISMISS_FRAC) { this.close(); }
        else { this.open(); }
        return true;
    }

    override fn drop_handlers() {
        this.onSelect = null;
        this.onDismiss = null;
        if (this.anim != null) { this.anim.cancel(); this.anim = null; }
    }
}

// ---------------------------------------------------------------- Scaffold

// Where a Scaffold pins its FAB.
export const FAB_BOTTOM_RIGHT: int = 0;
export const FAB_BOTTOM_LEFT: int = 1;
export const FAB_BOTTOM_CENTER: int = 2;

const DP_FAB_MARGIN: float = 16.0;

// Screen structure: fixed chrome, scrolling content, a floating FAB.
//
//     let sc = new Scaffold(new ScrollView(feed))
//         .top(new TopBar("Feed").with_nav(NAV_MENU, () => { sc.open_drawer(); }))
//         .bottom(new BottomNavigationBar(["Home", "Search", "Me"]))
//         .with_fab(fab)
//         .with_drawer(drawer);
//     win.set_content(sc);
//
// The FAB is the reason this exists. A `FloatingActionButton` placed in a
// Column inside a ScrollView is not floating — it scrolls away, which is what
// the demo app did. Here it is positioned against the **Scaffold's own rect**,
// and the Scaffold is the root child (inside AndroidWindow's SafeArea), so
// that rect is the screen minus the system bars. It also sits above the bottom
// bar without the app computing anything.
//
// A plain Widget, not an AndroidWidget: a full-screen container has no gesture
// of its own, and a ripple or a 48dp minimum on it would be meaningless.
export class Scaffold extends Widget {
    top_bar: Widget;      // whatever fills the top slot
    tbar: weak TopBar;    // the same object when it is a TopBar (elevation)
    content: Widget;
    bottom_bar: Widget;
    fab: Widget;
    // Held, not added: an open drawer lives in the Window's overlay slot, so it
    // is not part of this subtree.
    drawer: NavigationDrawer;
    fab_corner: int;
    fab_margin: float;    // dp
    wired: bool;          // the content's scroll listener is hooked up

    fn init(content: Widget) {
        super.init();
        this.fab_corner = FAB_BOTTOM_RIGHT;
        this.fab_margin = DP_FAB_MARGIN;
        this.wired = false;
        if (content != null) {
            this.content = content;
            this.add(content);
        }
    }

    // Slot order matters for hit-testing, not for painting: Widget.hit walks
    // later siblings first, so bars and the FAB win over the content beneath
    // them — which is why `content` is added first, in init.
    builder fn top(b: TopBar) {
        this.top_bar = b;
        this.tbar = b;
        this.add(b);
        return this;
    }
    // Any other widget as the top slot. No scroll-elevation wiring, because
    // that is a TopBar feature.
    builder fn top_widget(w: Widget) { this.top_bar = w; this.add(w); return this; }
    builder fn bottom(w: Widget) { this.bottom_bar = w; this.add(w); return this; }
    builder fn with_fab(w: Widget) { this.fab = w; this.add(w); return this; }
    builder fn fab_at(corner: int) { this.fab_corner = corner; return this; }
    builder fn fab_inset(dp: float) { this.fab_margin = dp; return this; }
    builder fn with_drawer(d: NavigationDrawer) { this.drawer = d; return this; }

    fn open_drawer() {
        let w = this.win;
        if (w == null || this.drawer == null) { return; }
        w.open_overlay(this.drawer);
        this.drawer.open();
    }

    fn close_drawer() {
        if (this.drawer != null) { this.drawer.close(); }
    }

    // Fills whatever it is given. The natural size is meaningless for a screen.
    override fn layout(s: Painter, th: Theme, bc: BoxConstraints): Size {
        return Size(bc.maxW, bc.maxH);
    }

    override fn arrange(s: Painter, th: Theme, r: Rect) {
        this.layout_to(r);
        if (!this.wired && this.tbar != null) {
            this.tbar.watch_scroll(this.content);
            this.wired = true;
        }

        let top_h = 0.0;
        if (this.top_bar != null) {
            top_h = this.top_bar.layout(s, th, bcLoose(r.w, r.h)).h;
            this.top_bar.arrange(s, th, Rect(r.x, r.y, r.w, top_h));
        }
        let bot_h = 0.0;
        if (this.bottom_bar != null) {
            bot_h = this.bottom_bar.layout(s, th, bcLoose(r.w, r.h)).h;
            this.bottom_bar.arrange(s, th, Rect(r.x, r.bottom() - bot_h, r.w, bot_h));
        }
        if (this.content != null) {
            let ch = r.h - top_h - bot_h;
            if (ch < 0.0) { ch = 0.0; }
            this.content.arrange(s, th, Rect(r.x, r.y + top_h, r.w, ch));
        }
        if (this.fab != null) {
            let fs = this.fab.measure(s, th);
            let m = this.fab_margin * ui_scale(this);
            let fx = r.right() - m - fs.w;
            if (this.fab_corner == FAB_BOTTOM_LEFT) { fx = r.x + m; }
            else if (this.fab_corner == FAB_BOTTOM_CENTER) { fx = r.center_x(fs.w); }
            // Above the bottom bar, not behind it.
            let fy = r.bottom() - bot_h - m - fs.h;
            this.fab.arrange(s, th, Rect(fx, fy, fs.w, fs.h));
        }
    }
}

// ---------------------------------------------------------- PullToRefresh

// Wraps scrollable content with an overscroll spinner at the top edge.
//
// The indicator, the threshold and the refresh lifecycle are complete and
// driven through set_pull/release_pull:
//
//     let ptr = new PullToRefresh();
//     ptr.add(list);
//     ptr.onRefresh = () => { reload(); ptr.end_refresh(); };
//
// The gesture composes out of Track C item 2 rather than being coded here.
// Widget.on_drag walks up the parent chain, and a scrollable widget refuses a
// drag it cannot act on — so a downward drag on a list that is already at its
// top falls through the ScrollView to this widget. That refusal *is* the
// definition of overscroll, so the wrapping order is the whole wiring:
//
//     let ptr = new PullToRefresh();
//     ptr.add(new ScrollView(list));
//     ptr.onRefresh = () => { reload(); ptr.end_refresh(); };
//
// begin_refresh() still works with no gesture at all, which is what a button or
// a timer needs.
const PTR_THRESHOLD: float = 64.0;   // pull distance that arms a refresh
const PTR_RADIUS: float = 14.0;      // indicator radius
const PTR_DOTS: int = 8;
const PTR_TICK_MS: int = 16;
const PTR_REV_MS: float = 900.0;     // one spinner revolution
// The indicator follows the finger at less than 1:1, so the content cannot be
// hauled arbitrarily far off its own top and the pull reads as elastic.
const PTR_DRAG_RATE: float = 0.5;

export class PullToRefresh extends Widget {
    onRefresh: fn();
    refreshing: bool;
    pull: float;          // current overscroll distance in px
    spin_angle: float;    // indeterminate rotation while refreshing
    spin: Tween;

    fn init() {
        super.init();
        this.refreshing = false;
        this.pull = 0.0;
        this.spin_angle = 0.0;
        // Same reason as BottomSheet: children plus own content (the spinner)
        // in render(), which the partial-repaint path would skip.
        this.custom_paint = true;
    }

    override fn measure(s: Painter, th: Theme): Size {
        if (this.children.len == 0) { return Size(0.0, 0.0); }
        return this.children[0].measure(s, th);
    }

    override fn arrange(s: Painter, th: Theme, r: Rect) {
        this.layout_to(r);
        // single-child container: the content fills it, and the indicator is
        // drawn over the top edge rather than taking layout space
        for (let c in this.children) { c.arrange(s, th, r); }
    }

    // Report the current overscroll distance in px. Values past the threshold
    // are kept (the indicator rubber-bands) but do not arm anything further.
    fn set_pull(px: float) {
        let p = px;
        if (p < 0.0) { p = 0.0; }
        if (p == this.pull) { return; }
        this.pull = p;
        this.invalidate();
    }

    // The pull gesture ended: past the threshold this starts a refresh,
    // otherwise the indicator snaps away.
    fn release_pull() {
        if (this.pull >= PTR_THRESHOLD * ui_scale(this) && !this.refreshing) { this.begin_refresh(); }
        else if (!this.refreshing) { this.set_pull(0.0); }
    }

    // Reached only when every scrollable widget below has refused the drag —
    // i.e. the content is already at its top. See the note above the class.
    override fn drag_scroll(dx: int, dy: int): bool {
        if (this.refreshing) { return false; }
        // Dragging up with nothing pulled is not this widget's gesture. Letting
        // it fall through matters: the walk resumes at the next move event and
        // the list scrolls normally again.
        if (dy <= 0 && this.pull <= 0.0) { return false; }
        this.set_pull(this.pull + (dy as float) * PTR_DRAG_RATE);
        return true;
    }

    override fn drag_scroll_end(): bool {
        if (this.pull <= 0.0) { return false; }
        this.release_pull();
        return true;
    }

    // Start the indeterminate spin and fire onRefresh. The callback owns the
    // end of it — nothing here times out.
    fn begin_refresh() {
        if (this.refreshing) { return; }
        this.refreshing = true;
        this.pull = PTR_THRESHOLD * ui_scale(this);
        let p = this;
        // A ticker, not a looping animate(): a looping Tween ping-pongs, which
        // would spin the indicator forwards then backwards, and it repaints the
        // widget unconditionally. This advances one angle and invalidates, which
        // is the documented shape for a tick that does change pixels.
        if (this.spin == null) {
            this.spin = this.ticker(PTR_TICK_MS, () => {
                p.spin_angle = p.spin_angle + TAU * (PTR_TICK_MS as float) / PTR_REV_MS;
                if (p.spin_angle > TAU) { p.spin_angle = p.spin_angle - TAU; }
                p.invalidate();
            });
        }
        if (this.onRefresh != null) { this.onRefresh(); }
    }

    // Stop the spin and retract the indicator.
    fn end_refresh() {
        if (!this.refreshing) { return; }
        this.refreshing = false;
        if (this.spin != null) { this.spin.cancel(); this.spin = null; }
        this.pull = 0.0;
        this.invalidate();
    }

    override fn render(s: Painter, th: Theme) {
        for (let c in this.children) { c.draw(s, th); }
        if (this.pull <= 0.0 && !this.refreshing) { return; }
        // The indicator follows the finger to the threshold and then stops,
        // so an overlong pull reads as "already armed" rather than as travel.
        let k = ui_scale(this);
        let thr = PTR_THRESHOLD * k;
        let rad = PTR_RADIUS * k;
        let travel = this.pull;
        if (travel > thr) { travel = thr; }
        let cx = this.bounds.cx();
        let cy = this.bounds.y + travel;
        s.circle(cx, cy, rad + 2.0 * k, th.surface_raised);
        // Before the threshold the ring fills in proportion to the pull, which
        // is the whole affordance; after it, the filled ring rotates. Dots
        // rather than an arc because a stroked arc needs a Path, and dots are
        // one base-tier primitive that degrades on every painter.
        let frac = travel / thr;
        let base = this.spin_angle - PI / 2.0;
        for (let i in 0..PTR_DOTS) {
            let f = (i as float) / (PTR_DOTS as float);
            if (!this.refreshing && f > frac) { break; }
            let a = base + f * TAU;
            let dx = cx + cos(a) * rad;
            let dy = cy + sin(a) * rad;
            // trailing dots fade, which is what gives the ring a direction
            let c = mix(th.surface_raised, th.primary, 0.25 + 0.75 * f);
            s.circle(dx, dy, 2.5 * k, c);
        }
    }

    override fn drop_handlers() {
        this.onRefresh = null;
        // The spin ticker loops forever, so unlike a finite Tween it never
        // releases its own on_tick — and that closure captures this widget.
        // Widget.release_all cancels only *pending* animations (ones declared
        // before mount); a registered one has to be cancelled here or the
        // widget stays alive on the Window clock.
        if (this.spin != null) { this.spin.cancel(); this.spin = null; }
    }
}

// --------------------------------------------------------------- pickers

// No date/time widget exists anywhere in vyto/ui, so these are new rather than
// adapted. Both are ordinary widgets — no overlay, no platform call — and work
// wherever a Widget works, including inside a Dialog.
//
// The calendar arithmetic is done here rather than through vyto/util/date on
// purpose: that package is an FFI shim over the C library, so importing it
// would make a date picker depend on a native build, and on Android on a shim
// arm that does not exist. Two dependency-free functions cost less.

const DPK_CELL: float = 40.0;
const DPK_HEADER_H: float = 48.0;
const DPK_WEEK_H: float = 24.0;
const DPK_PAD: float = 8.0;
const DPK_ARROW_W: float = 44.0;

fn is_leap(y: int): bool {
    if (y % 4 != 0) { return false; }
    if (y % 100 != 0) { return true; }
    return y % 400 == 0;
}

fn days_in_month(y: int, m: int): int {
    if (m == 2) {
        if (is_leap(y)) { return 29; }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
    return 31;
}

// Sakamoto's method: 0 = Sunday. Valid for any year >= 1, which is every year
// a date picker will be asked about.
fn day_of_week(y: int, m: int, d: int): int {
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    let yy = y;
    if (m < 3) { yy = yy - 1; }
    return (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7;
}

// A month grid with a year/month header. `onSelect(y, m, d)` fires on every
// pick; `day` is 0 until one is made.
//
//     let dp = new DatePicker(2026, 8);
//     dp.onSelect = (y, m, d) => { ... };
//
// There is no "today" ring by default, because nothing in this package knows
// the date. Set today_y/today_m/today_d if the app does — that keeps the clock
// dependency in the app, where it already exists.
export class DatePicker extends AndroidWidget {
    year: int;            // selected year; 0 until a day is picked
    month: int;           // selected month, 1-12
    day: int;             // selected day, 0 = none
    view_year: int;       // month currently on screen
    view_month: int;
    min_year: int;
    max_year: int;
    today_y: int;
    today_m: int;
    today_d: int;
    onSelect: fn(int, int, int);
    month_names: string[];
    weekday_names: string[];

    fn init(year: int, month: int) {
        super.init();
        this.view_year = year;
        this.view_month = month;
        this.year = 0;
        this.month = 0;
        this.day = 0;
        this.min_year = 1;
        this.max_year = 9999;
        this.today_y = 0;
        this.today_m = 0;
        this.today_d = 0;
        this.focusable = true;
        // The grid is a field of small targets, and the selection ring already
        // answers "did that register?" per cell. A ripple over the whole panel
        // would say nothing about which day was hit.
        this.ripple = false;
        // The panel is far above the touch minimum; individual cells are DPK_CELL
        // and sized by the grid, not by measure().
        this.min_touch = 0.0;
        this.month_names = ["January", "February", "March", "April", "May", "June",
                            "July", "August", "September", "October", "November",
                            "December"];
        this.weekday_names = ["S", "M", "T", "W", "T", "F", "S"];
    }

    builder fn range(lo: int, hi: int) { this.min_year = lo; this.max_year = hi; return this; }
    builder fn today(y: int, m: int, d: int) {
        this.today_y = y; this.today_m = m; this.today_d = d; return this;
    }

    fn cell(): float { return DPK_CELL * ui_scale(this); }

    override fn content_size(s: Painter, th: Theme): Size {
        let k = ui_scale(this);
        return Size(7.0 * DPK_CELL * k + 2.0 * DPK_PAD * k,
                    (DPK_HEADER_H + DPK_WEEK_H + 6.0 * DPK_CELL + 2.0 * DPK_PAD) * k);
    }

    fn header_rect(): Rect {
        let pad = DPK_PAD * ui_scale(this);
        return Rect(this.bounds.x + pad, this.bounds.y + pad,
                    this.bounds.w - 2.0 * pad, DPK_HEADER_H * ui_scale(this));
    }
    fn prev_rect(): Rect {
        let h = this.header_rect();
        return Rect(h.x, h.y, DPK_ARROW_W * ui_scale(this), h.h);
    }
    fn next_rect(): Rect {
        let h = this.header_rect();
        let aw = DPK_ARROW_W * ui_scale(this);
        return Rect(h.right() - aw, h.y, aw, h.h);
    }
    fn grid_rect(): Rect {
        let h = this.header_rect();
        let k = ui_scale(this);
        let c = this.cell();
        return Rect(h.x, h.y + (DPK_HEADER_H + DPK_WEEK_H) * k, 7.0 * c, 6.0 * c);
    }
    fn cell_rect(col: int, row: int): Rect {
        let g = this.grid_rect();
        let c = this.cell();
        return Rect(g.x + (col as float) * c, g.y + (row as float) * c, c, c);
    }

    // Grid slot of the 1st, i.e. how far the month is indented.
    fn lead(): int { return day_of_week(this.view_year, this.view_month, 1); }

    fn step_month(delta: int) {
        let m = this.view_month + delta;
        let y = this.view_year;
        if (m < 1) { m = 12; y = y - 1; }
        if (m > 12) { m = 1; y = y + 1; }
        if (y < this.min_year || y > this.max_year) { return; }
        this.view_month = m;
        this.view_year = y;
        this.invalidate();
    }

    fn pick(d: int) {
        let n = days_in_month(this.view_year, this.view_month);
        if (d < 1 || d > n) { return; }
        this.year = this.view_year;
        this.month = this.view_month;
        this.day = d;
        if (this.onSelect != null) { this.onSelect(this.year, this.month, this.day); }
        this.invalidate();
    }

    // Move the selection by whole days, rolling into the neighbouring month and
    // bringing the view with it.
    fn move_selection(delta: int) {
        let d = this.day;
        if (d == 0) { d = 1; this.pick(1); return; }
        let nd = d + delta;
        let n = days_in_month(this.view_year, this.view_month);
        if (nd < 1) {
            this.step_month(-1);
            nd = days_in_month(this.view_year, this.view_month) + nd;
        } else if (nd > n) {
            nd = nd - n;
            this.step_month(1);
        }
        this.pick(nd);
    }

    override fn paint(s: Painter, th: Theme) {
        let h = this.header_rect();
        s.push_font(th.text_lg, WEIGHT_MED);
        s.text_center(h, this.month_names[this.view_month - 1] + " " + str(this.view_year),
                      th.on_surface);
        s.pop_font();
        s.text_center(this.prev_rect(), "<", th.on_surface_muted);
        s.text_center(this.next_rect(), ">", th.on_surface_muted);

        let g = this.grid_rect();
        let k = ui_scale(this);
        let c = this.cell();
        s.push_font(th.text_sm, WEIGHT_MED);
        for (let i in 0..7) {
            let wr = Rect(g.x + (i as float) * c, g.y - DPK_WEEK_H * k, c, DPK_WEEK_H * k);
            s.text_center(wr, this.weekday_names[i], th.on_surface_muted);
        }
        s.pop_font();

        let lead = this.lead();
        let n = days_in_month(this.view_year, this.view_month);
        for (let d in 1..n + 1) {
            let idx = lead + d - 1;
            let cr = this.cell_rect(idx % 7, idx / 7);
            let fg = th.on_surface;
            if (this.day == d && this.month == this.view_month && this.year == this.view_year) {
                s.circle(cr.cx(), cr.cy(), c / 2.0 - 4.0 * k, th.primary);
                fg = th.on_primary;
            } else if (this.today_d == d && this.today_m == this.view_month
                       && this.today_y == this.view_year) {
                s.stroke_circle(cr.cx(), cr.cy(), c / 2.0 - 4.0 * k, 1.0, th.primary);
                fg = th.primary;
            }
            s.text_center(cr, str(d), fg);
        }
    }

    override fn on_tap(x: int, y: int): bool {
        if (contains(this.prev_rect(), x, y)) { this.step_month(-1); return true; }
        if (contains(this.next_rect(), x, y)) { this.step_month(1); return true; }
        let g = this.grid_rect();
        if (!contains(g, x, y)) { return false; }
        let c = this.cell();
        let col = ((x as float - g.x) / c) as int;
        let row = ((y as float - g.y) / c) as int;
        let d = row * 7 + col - this.lead() + 1;
        this.pick(d);
        return true;
    }

    override fn on_key(k: int, ch: string): bool {
        if (k == KEY_LEFT) { this.move_selection(-1); return true; }
        if (k == KEY_RIGHT) { this.move_selection(1); return true; }
        if (k == KEY_UP) { this.move_selection(-7); return true; }
        if (k == KEY_DOWN) { this.move_selection(7); return true; }
        if (k == KEY_ENTER && this.day > 0) {
            if (this.onSelect != null) { this.onSelect(this.year, this.month, this.day); }
            return true;
        }
        return super.on_key(k, ch);
    }

    override fn drop_handlers() {
        this.onSelect = null;
        super.drop_handlers();
    }
}

// ------------------------------------------------------------- TimePicker

const TPK_HEADER_H: float = 56.0;
const TPK_DIAL: float = 240.0;
const TPK_PAD: float = 8.0;
const TPK_TICK_R: float = 16.0;      // radius of a number's hit/draw circle
const TPK_INNER: float = 0.64;       // inner ring radius, as a fraction
const TPK_AMPM_W: float = 52.0;      // AM/PM strip, 12-hour mode only

const TP_HOURS: int = 0;
const TP_MINUTES: int = 1;

// The M3 dial. Tap or drag the face to set the value; the header switches
// between the hour and minute rings, and picking an hour advances to minutes
// the way the platform picker does.
//
//     let tp = new TimePicker(9, 30);
//     tp.onChange = (h, m) => { ... };
//
// Drag works because a non-overlay widget has always received it (Slider is
// the precedent) — and since Track C item 1 it works inside a Dialog too.
export class TimePicker extends AndroidWidget {
    hour: int;            // 0-23, always stored as 24-hour
    minute: int;          // 0-59
    mode: int;            // TP_HOURS or TP_MINUTES — which ring is live
    use_24h: bool;
    onChange: fn(int, int);

    fn init(hour: int, minute: int) {
        super.init();
        this.hour = hour;
        this.minute = minute;
        this.mode = TP_HOURS;
        this.use_24h = false;
        this.focusable = true;
        // Same reason as DatePicker: the hand and the highlighted number are
        // the feedback, per value. A ripple across the whole dial is not.
        this.ripple = false;
        this.min_touch = 0.0;
    }

    builder fn h24(on: bool) { this.use_24h = on; return this; }

    override fn content_size(s: Painter, th: Theme): Size {
        let k = ui_scale(this);
        return Size((TPK_DIAL + 2.0 * TPK_PAD) * k,
                    (TPK_HEADER_H + TPK_DIAL + 2.0 * TPK_PAD) * k);
    }

    fn header_rect(): Rect {
        let k = ui_scale(this);
        return Rect(this.bounds.x + TPK_PAD * k, this.bounds.y + TPK_PAD * k,
                    this.bounds.w - 2.0 * TPK_PAD * k, TPK_HEADER_H * k);
    }
    // AM/PM is a sibling of the clock, not an overlay on it — the three header
    // targets must not intersect, or the first hit test wins and the later ones
    // become unreachable. Only 12-hour mode reserves the strip.
    fn ampm_rect(): Rect {
        let h = this.header_rect();
        let aw = TPK_AMPM_W * ui_scale(this);
        return Rect(h.right() - aw, h.y, aw, h.h);
    }
    fn time_rect(): Rect {
        let h = this.header_rect();
        let w = h.w;
        if (!this.use_24h) { w = w - (TPK_AMPM_W + 8.0) * ui_scale(this); }
        return Rect(h.x, h.y, w, h.h);
    }
    fn hour_rect(): Rect {
        let t = this.time_rect();
        return Rect(t.x, t.y, t.w / 2.0 - 12.0, t.h);
    }
    fn minute_rect(): Rect {
        let t = this.time_rect();
        return Rect(t.cx() + 12.0, t.y, t.w / 2.0 - 12.0, t.h);
    }
    fn dial_rect(): Rect {
        let h = this.header_rect();
        let k = ui_scale(this);
        let d = this.bounds.h - (TPK_HEADER_H + 2.0 * TPK_PAD) * k;
        if (this.bounds.w - 2.0 * TPK_PAD * k < d) { d = this.bounds.w - 2.0 * TPK_PAD * k; }
        return Rect(this.bounds.cx() - d / 2.0, h.bottom(), d, d);
    }
    fn tick_r(): float { return TPK_TICK_R * ui_scale(this); }
    fn dial_r(): float { return this.dial_rect().w / 2.0 - this.tick_r(); }

    fn is_pm(): bool { return this.hour >= 12; }

    fn set_time(h: int, m: int) {
        if (h == this.hour && m == this.minute) { return; }
        this.hour = h;
        this.minute = m;
        if (this.onChange != null) { this.onChange(h, m); }
        this.invalidate();
    }

    // Where value `v` sits on a ring of `n` positions, 12 o'clock first.
    fn ring_xy(v: int, n: int, radius: float, out_x: bool): float {
        let d = this.dial_rect();
        let a = (v as float) / (n as float) * TAU - PI / 2.0;
        if (out_x) { return d.cx() + cos(a) * radius; }
        return d.cy() + sin(a) * radius;
    }

    // Clock position of an absolute point: value on a ring of `n`, plus
    // whether the point landed on the inner ring (24-hour hours only).
    fn value_at(x: int, y: int, n: int): int {
        let d = this.dial_rect();
        let a = atan2(y as float - d.cy(), x as float - d.cx()) + PI / 2.0;
        let frac = a / TAU;
        while (frac < 0.0) { frac = frac + 1.0; }
        while (frac >= 1.0) { frac = frac - 1.0; }
        return ((frac * (n as float)).round() as int) % n;
    }

    fn on_inner_ring(x: int, y: int): bool {
        let d = this.dial_rect();
        let dx = x as float - d.cx();
        let dy = y as float - d.cy();
        let dist = (dx * dx + dy * dy);
        let mid = this.dial_r() * (TPK_INNER + 1.0) / 2.0;
        return dist < mid * mid;
    }

    // Apply a tap or drag at an absolute point to whichever ring is live.
    fn apply_point(x: int, y: int) {
        if (this.mode == TP_MINUTES) {
            this.set_time(this.hour, this.value_at(x, y, 60));
            return;
        }
        let v = this.value_at(x, y, 12);
        if (this.use_24h) {
            // outer ring is 1-12, inner is 13-23 and 0
            if (this.on_inner_ring(x, y)) { this.set_time((v + 12) % 24, this.minute); }
            else { let h = v; if (h == 0) { h = 12; } this.set_time(h % 24, this.minute); }
            return;
        }
        let h = v;
        if (h == 0) { h = 12; }
        if (h == 12) { h = 0; }
        if (this.is_pm()) { h = h + 12; }
        this.set_time(h, this.minute);
    }

    // Hour as it is displayed: 1-12 in 12-hour mode, 0-23 otherwise.
    fn shown_hour(): int {
        if (this.use_24h) { return this.hour; }
        let h = this.hour % 12;
        if (h == 0) { return 12; }
        return h;
    }

    override fn paint(s: Painter, th: Theme) {
        // --- header: HH : MM, the live half highlighted ---
        let hr = this.hour_rect();
        let mr = this.minute_rect();
        s.push_font(th.text_2xl, WEIGHT_MED);
        let hc = th.on_surface_muted;
        let mc = th.on_surface_muted;
        if (this.mode == TP_HOURS) { hc = th.primary; } else { mc = th.primary; }
        s.text_right(hr, 0.0, pad2(this.shown_hour()), hc);
        s.text_center(Rect(hr.right(), hr.y, mr.x - hr.right(), hr.h), ":", th.on_surface_muted);
        s.text(mr.x, s.baseline_in(mr), pad2(this.minute), mc);
        s.pop_font();
        if (!this.use_24h) {
            let ar = this.ampm_rect();
            let label = "AM";
            if (this.is_pm()) { label = "PM"; }
            s.push_font(th.text_sm, WEIGHT_BOLD);
            s.text_center(ar, label, th.primary);
            s.pop_font();
        }

        // --- dial ---
        let d = this.dial_rect();
        let r = this.dial_r();
        s.circle(d.cx(), d.cy(), d.w / 2.0, th.surface_sunken);

        // the hand, drawn under the numbers so a selected number sits on top
        let sel = 0;
        let n = 12;
        let hand_r = r;
        if (this.mode == TP_MINUTES) {
            sel = this.minute;
            n = 60;
        } else {
            sel = this.shown_hour() % 12;
            if (this.use_24h) {
                sel = this.hour % 12;
                // 0 and 13-23 live on the inner ring, so the hand is shorter
                if (this.hour == 0 || this.hour > 12) { hand_r = r * TPK_INNER; }
            }
        }
        let hx = this.ring_xy(sel, n, hand_r, true);
        let hy = this.ring_xy(sel, n, hand_r, false);
        s.line_w(d.cx(), d.cy(), hx, hy, 2.0, th.primary);
        s.circle(d.cx(), d.cy(), 4.0, th.primary);
        s.circle(hx, hy, this.tick_r(), th.primary);

        // numbers
        s.push_font(th.text_md, WEIGHT_REG);
        if (this.mode == TP_MINUTES) {
            // every fifth minute is labelled; the rest are unlabelled positions
            for (let i in 0..12) {
                let v = i * 5;
                this.draw_tick(s, th, v, 60, r, str(v), v == this.minute);
            }
        } else {
            for (let i in 0..12) {
                let v = i;
                let label = str(i);
                if (i == 0) { label = "12"; }
                this.draw_tick(s, th, v, 12, r, label, this.shown_hour() % 12 == v
                                                      && !(this.use_24h && (this.hour == 0
                                                                            || this.hour > 12)));
            }
            if (this.use_24h) {
                for (let i in 0..12) {
                    let hv = i + 12;
                    let label = pad2(hv % 24);
                    let on = this.hour == hv % 24 && (this.hour == 0 || this.hour > 12);
                    this.draw_tick(s, th, i, 12, r * TPK_INNER, label, on);
                }
            }
        }
        s.pop_font();
    }

    fn draw_tick(s: Painter, th: Theme, v: int, n: int, radius: float,
                 label: string, selected: bool) {
        let x = this.ring_xy(v, n, radius, true);
        let y = this.ring_xy(v, n, radius, false);
        let fg = th.on_surface;
        if (selected) { fg = th.on_primary; }
        let tr = this.tick_r();
        s.text_center(Rect(x - tr, y - tr, tr * 2.0, tr * 2.0), label, fg);
    }

    // The dial is the exception to tap-on-release: dragging the hand IS the
    // gesture, so the value has to be under the finger from the first frame,
    // and a value the drag will overwrite is not the trap that a navigating
    // row is. Only the handover to minutes waits — that part is navigation.
    override fn on_click(x: int, y: int): bool {
        let base = super.on_click(x, y);
        if (contains(this.dial_rect(), x, y)) { this.apply_point(x, y); }
        return base;
    }

    override fn on_tap(x: int, y: int): bool {
        if (contains(this.hour_rect(), x, y)) { this.mode = TP_HOURS; this.invalidate(); return true; }
        if (contains(this.minute_rect(), x, y)) { this.mode = TP_MINUTES; this.invalidate(); return true; }
        if (!this.use_24h && contains(this.ampm_rect(), x, y)) {
            this.set_time((this.hour + 12) % 24, this.minute);
            return true;
        }
        if (!contains(this.dial_rect(), x, y)) { return false; }
        this.apply_point(x, y);
        // picking an hour hands over to minutes, as the platform picker does
        if (this.mode == TP_HOURS) { this.mode = TP_MINUTES; }
        return true;
    }

    override fn on_drag(dx: int, dy: int): bool {
        // The dial is absolute, not incremental: the finger's position is the
        // value. Window tracks the live point, so read it rather than
        // accumulating deltas that would drift over a long sweep.
        let w = this.win;
        if (w == null) { return false; }
        this.apply_point(w.drag_x, w.drag_y);
        return true;
    }

    // A swept hour hands over to minutes on release, exactly as a tapped one
    // does — the sweep sets hours the whole way now that the handover no
    // longer happens on the press that starts it.
    override fn on_drag_end(x: int, y: int): bool {
        let base = super.on_drag_end(x, y);
        if (this.mode == TP_HOURS) { this.mode = TP_MINUTES; this.invalidate(); return true; }
        return base;
    }

    override fn on_key(k: int, ch: string): bool {
        let step = 1;
        if (k == KEY_LEFT || k == KEY_DOWN) { step = -1; }
        else if (k != KEY_RIGHT && k != KEY_UP) { return super.on_key(k, ch); }
        if (this.mode == TP_MINUTES) {
            this.set_time(this.hour, (this.minute + step + 60) % 60);
        } else {
            this.set_time((this.hour + step + 24) % 24, this.minute);
        }
        return true;
    }

    override fn drop_handlers() {
        this.onChange = null;
        super.drop_handlers();
    }
}

// ---------------------------------------------------------------- safe area
//
// The platform insets, in px. Zero on every non-Android target — see
// native/src/ainsets.c for why both arms exist rather than this being
// android-only: this package's widget goldens run under X11.
extern "C" {
    fn vta_inset_left(): i32;
    fn vta_inset_top(): i32;
    fn vta_inset_right(): i32;
    fn vta_inset_bottom(): i32;
    fn vta_inset_ime(): i32;
    // How many things the system Back key could pop. Published by
    // AndroidWindow.nav_changed, read by Native.back() on the UI thread —
    // native/src/aback.c explains why an unsynchronised int is enough.
    fn vta_set_back_depth(n: i32);
    fn vta_back_depth(): i32;
    // Raise or hide the soft keyboard (native/src/aime.c). A no-op off
    // Android, which is what keeps this package linkable on the desktop.
    fn vta_ime_set(on: i32);
}

export fn safeInsetLeft(): float { return vta_inset_left() as float; }
export fn safeInsetTop(): float { return vta_inset_top() as float; }
export fn safeInsetRight(): float { return vta_inset_right() as float; }
export fn safeInsetBottom(): float { return vta_inset_bottom() as float; }
// Soft-keyboard height. Usually NOT wanted: the manifest sets adjustResize, so
// the window has already shrunk by this much and adding it again double-counts.
export fn imeHeight(): float { return vta_inset_ime() as float; }

// Keeps its child clear of the status bar, the notch and the gesture/nav bar.
//
// The Activity goes edge-to-edge (setDecorFitsSystemWindows(false)), which is
// what lets an app paint under the bars deliberately — but it also means
// nothing is inset for you, so the first widget in a Column renders *behind*
// the clock. This is the widget that opts back in.
//
// Insets are re-read on every arrange rather than cached, so a rotation, a
// gesture-mode change or an IME that resizes the window all land without any
// invalidation protocol: Window.layout() re-arranges, and the fresh values are
// read right there.
//
// Per-edge flags because the choice is per-design: a full-bleed image header
// wants apply_top false while still keeping its buttons off the gesture bar.
export class SafeArea extends Widget {
    apply_left: bool;
    apply_top: bool;
    apply_right: bool;
    apply_bottom: bool;
    // Off by default: adjustResize already shrank the window for the IME.
    // Turn it on only for a window that is NOT adjustResize.
    apply_ime: bool;

    fn init(child: Widget) {
        super.init();
        this.apply_left = true;
        this.apply_top = true;
        this.apply_right = true;
        this.apply_bottom = true;
        this.apply_ime = false;
        if (child != null) { this.add(child); }
    }

    fn kid(): Widget {
        if (this.children.len == 0) { return null; }
        return this.children[0];
    }

    fn ins_l(): float {
        if (!this.apply_left) { return 0.0; }
        return safeInsetLeft();
    }
    fn ins_t(): float {
        if (!this.apply_top) { return 0.0; }
        return safeInsetTop();
    }
    fn ins_r(): float {
        if (!this.apply_right) { return 0.0; }
        return safeInsetRight();
    }
    fn ins_b(): float {
        let b = 0.0;
        if (this.apply_bottom) { b = safeInsetBottom(); }
        if (this.apply_ime) {
            let k = imeHeight();
            if (k > b) { b = k; }
        }
        return b;
    }

    override fn measure(s: Painter, th: Theme): Size {
        let c = this.kid();
        let iw = this.ins_l() + this.ins_r();
        let ih = this.ins_t() + this.ins_b();
        if (c == null) { return Size(iw, ih); }
        let cs = c.measure(s, th);
        return Size(cs.w + iw, cs.h + ih);
    }

    override fn arrange(s: Painter, th: Theme, r: Rect) {
        this.layout_to(r);
        let c = this.kid();
        if (c == null) { return; }
        let l = this.ins_l();
        let t = this.ins_t();
        let w = r.w - l - this.ins_r();
        let h = r.h - t - this.ins_b();
        if (w < 0.0) { w = 0.0; }
        if (h < 0.0) { h = 0.0; }
        c.arrange(s, th, Rect(r.x + l, r.y + t, w, h));
    }
}

// ------------------------------------------------------------ AndroidWindow
//
// A Window that already knows it is on a phone.
//
// Plain `Window` is correct but bare here: an Android app has to remember to
// keep its content out from under the system bars, and forgetting is silent —
// the top label simply renders behind the clock. `set_content` wraps the tree
// in a SafeArea so that is the default rather than something to remember.
//
// It deliberately does NOT construct the painter. `AndroidPainter` lives in
// vyto/mobile/android/painter, whose shim is android-only, and this package
// still has to link on the desktop for its widget goldens — so app code keeps
// calling `win.use_painter(new AndroidPainter(win.surface(), 15.0))` and this
// class stays platform-neutral at link time.
//
//     let win = new AndroidWindow("Demo", 1080, 2160);
//     win.use_painter(new AndroidPainter(win.surface(), 15.0));
//     win.set_content(new Column([...]));
//     win.run();
//
// It also owns the screen stack, which is what makes the system Back key work:
//
//     win.push_screen(story_screen);   // back returns to the feed
//     win.push_screen(...);            // back at the base screen exits the app
//
// The stack and the depth published to Native.back() have to agree, so they
// live in one class rather than being a convention every app re-honours.
export class AndroidWindow extends Window {
    // The wrapper installed by set_content; reach for it to switch an edge off.
    safe: SafeArea;

    // Whether the soft keyboard is currently asked for (1) or not (0). Kept so
    // a focus change between two non-text widgets — which is most of them —
    // does not cross the JNI boundary at all.
    ime_on: int;

    // The screen stack, base first. Strong: this class owns the screens that
    // are off-tree, and a popped-to screen keeps its scroll position and its
    // widget state because it was never torn down. `root`/`safe` are the
    // tree's own links to whichever one is showing.
    screens: Widget[];

    fn init(title: string, w: int, h: int) {
        super.init(title, w, h);
        // Touch UIs have no scrollbars: the content is the scroll handle, and a
        // 6px track is not a finger target. Hiding also drops the hit test, so
        // touches near the right edge reach the content instead of a bar nobody
        // can see. Set it back on the theme if a screen really wants them.
        this.theme.scrollbars_visible = false;
        // The pointer is a finger: a release has to clear hover, or every
        // hover-tinted widget stays lit after being tapped. Reaches plain
        // vyto/ui widgets too, which is most of what an app's tree holds.
        this.touch_mode = true;
        this.screens = [];
        // Escape must never close the window here, because Escape is the wire
        // the system Back key rides on (jni_boot.c) and the depth Native.back()
        // reads can be one frame stale. That race is only benign while a
        // spurious Escape is a no-op — with close_on_esc left true it would be
        // an unexplained app exit instead. Exiting is Native.back() answering
        // false and the Activity finishing, and nothing else.
        this.close_on_esc = false;
        this.ime_on = 0;
        vta_set_back_depth(0);
    }

    // Set the base screen, inset out of the system bars. Resets the stack, so
    // calling it again is "go home". Assign `root` directly instead when a
    // screen genuinely wants to paint edge to edge.
    fn set_content(content: Widget) {
        this.screens = [content];
        this.install(content);
        this.nav_changed();
    }

    // Push a screen over the current one. The one underneath stays alive
    // off-tree, so popping back to it costs nothing and restores it exactly.
    fn push_screen(content: Widget) {
        this.screens.push(content);
        this.install(content);
        // set_content only assigns root; after run() has started, re-measuring
        // and repainting are ours to do.
        this.layout();
        this.redraw();
        this.nav_changed();
    }

    // Pop back one screen. False at the base — which is what tells the system
    // Back key to stop consuming presses and let the Activity finish.
    fn pop_screen(): bool {
        if (this.screens.len <= 1) { return false; }
        this.screens.pop();
        this.install(this.screens[this.screens.len - 1]);
        this.layout();
        this.redraw();
        this.nav_changed();
        return true;
    }

    fn install(content: Widget) {
        let sa = new SafeArea(content);
        this.safe = sa;
        this.root = sa;
    }

    // Everything Back could pop: the screens above the base, plus an open
    // overlay. Toasts are deliberately not counted — no platform pops a
    // snackbar with Back.
    fn back_depth(): int {
        let d = this.screens.len - 1;
        if (d < 0) { d = 0; }
        if (this.overlay != null) { d = d + 1; }
        return d;
    }

    override fn nav_changed() {
        vta_set_back_depth(this.back_depth() as i32);
    }

    // Reached only once Window.on_key_ev has offered the Escape to an open
    // overlay and found none, so by here "back" really does mean "pop".
    override fn on_back(): bool { return this.pop_screen(); }

    // The soft keyboard follows the focus, because on a touch platform nothing
    // else can raise it: there is no physical keyboard to start typing on, so
    // the IME appears only when it is asked for, and only the focused widget
    // knows whether it wants text.
    //
    // Window.set_focus calls this on every focus change (and layout() calls it
    // when a rebuild drops the focus, which is the case that matters —
    // otherwise pushing a screen over a focused TextField leaves the keyboard
    // up over a screen with no field on it).
    //
    // Hiding on "focus moved to something that is not a text widget" is
    // deliberate rather than leaving it up: a tap on a list behind the keyboard
    // reads as "I am done typing", and that tap moves the focus.
    //
    // The Java half (VytoView/VytoSurfaceView.setTextInputActive, the
    // InputConnection under it) was written long before this and had no caller
    // at all — TextField, TextArea and SearchField were decorative on a device.
    override fn focus_changed() {
        let w = this.focused_widget();
        let want = 0;
        if (w != null && w.wants_text()) { want = 1; }
        if (want == this.ime_on) { return; }
        this.ime_on = want;
        vta_ime_set(want as i32);
    }
}
