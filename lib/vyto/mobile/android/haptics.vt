// vyto/mobile/android/haptics — the vibrator, as the four things a UI actually
// asks it for.
//
//     import { tick, click, heavy, vibrate } from "vyto/mobile/android/haptics";
//
//     tick();          // a selection moved, a row was long-pressed
//     click();         // a control was activated
//     heavy();         // a destructive or terminal action landed
//     vibrate(200);    // a plain buzz, in ms — an alarm, a failure
//
// The three named ones are Android's own predefined effects
// (VibrationEffect.EFFECT_TICK / CLICK / HEAVY_CLICK), which is what makes a
// buzz feel like the rest of the device instead of a generic rumble. They need
// API 29; below that, and on a device whose vendor rejects them, the shim
// falls back to a one-shot of the length given here. minSdk is 24, so that
// fallback is a real path and not a formality.
//
// Silent, not an error, when the device has no vibrator — which includes most
// tablets — and a no-op off Android, so a program that also runs on the
// desktop needs no conditionals.
//
// Requires android.permission.VIBRATE, an install-time permission with no
// runtime prompt. `manifest.vt` adds it from `uses(ACT_HAPTICS)`.
//
// AndroidWidget calls tick() on a long-press by default (its `haptics` flag).
// Nothing else in the toolkit buzzes on its own: stock Android does not buzz
// on an ordinary tap, and a toolkit that did would feel like an OEM skin.

extern "C" {
    fn vta_haptic(ms: i32, kind: i32);
}

// Effect kinds, matching Actions.java's HAPTIC_* constants. Mapped to
// VibrationEffect on the Java side rather than here, so the platform's own
// numbering stays where the platform is.
const HAPTIC_MS: int = 0;
const HAPTIC_TICK: int = 1;
const HAPTIC_CLICK: int = 2;
const HAPTIC_HEAVY: int = 3;

// A light tap: a selection changing, a long-press arming, a picker snapping to
// a value. The one most UIs want and the one Android uses most.
export fn tick() { vta_haptic(10 as i32, HAPTIC_TICK as i32); }

// A control was activated — a confirm, a toggle committing.
export fn click() { vta_haptic(20 as i32, HAPTIC_CLICK as i32); }

// Something final or destructive happened. Deliberately distinct from click():
// a haptic vocabulary of one is no vocabulary.
export fn heavy() { vta_haptic(40 as i32, HAPTIC_HEAVY as i32); }

// A plain buzz of `ms` milliseconds, for anything the three effects do not
// describe — an alarm, a failed unlock, a timer expiring.
export fn vibrate(ms: int) { vta_haptic(ms as i32, HAPTIC_MS as i32); }
