// vyto/db/mysql — a MySQL / MariaDB driver, speaking the client-server
// protocol directly.
//
//     import { Db, select, dbText } from "vyto/db";
//     import { mysql } from "vyto/db/mysql";
//
//     let db = new Db(mysql("mysql://ada@localhost/app"));
//     if (!db.ok()) { print(db.error()); return; }
//
// ── READ THIS FIRST IF YOU ARE ON MySQL 8 ───────────────────────────────────
// MySQL 8.0's default authentication plugin is caching_sha2_password, and only
// its FAST PATH works here — the one the server accepts when it already holds
// that credential in memory. On a cache miss it demands the full exchange,
// which sends the password itself and so requires TLS or an RSA key transfer,
// and this driver has neither.
//
// The practical consequence is nasty: the FIRST login for a user fails, and so
// does the first after any server restart or cache flush. It fails
// INTERMITTENTLY, which looks like a network fault rather than a configuration
// one. The driver detects the demand and says all of this in the error rather
// than hanging, but it cannot satisfy it.
//
// Three ways out: `ALTER USER ... IDENTIFIED WITH mysql_native_password`, use
// MariaDB (whose default is mysql_native_password), or wait for
// lib/vyto/crypto/openssl to stop being a stub.
//
// ── NO libmysqlclient, AND WHY THAT MATTERS HERE ────────────────────────────
// This package contains no native/ directory and links no library: it speaks
// the protocol over vyto/net/socket.
//
// That is not only a build convenience. libmysqlclient is GPL and MariaDB
// Connector/C is LGPL, so binding either would have made the licence of every
// program that used this package a decision someone had to make. Implementing
// the protocol makes the question disappear rather than answering it — there is
// nothing to link. The same is true of provisioning: nothing has to be fetched,
// so the tests cannot silently skip on a fresh clone.
//
// ── EVERY VALUE IS A BOUND PARAMETER ────────────────────────────────────────
// Statements go through COM_STMT_PREPARE and the binary protocol, never through
// COM_QUERY with client-side escaping. dialect.vt:19-26 states the package's
// central invariant — there is no quoteValue, and every value reaches the
// database as a bound parameter, "which is what makes SQL injection
// structurally impossible rather than a matter of remembering to escape".
// Escaping on the client would trade that for a function nobody can forget to
// call correctly. This is the one place MySQL costs materially more work than
// PostgreSQL, and the reason is not negotiable.
//
// ── WHAT IT SHARES WITH THE POSTGRES DRIVER ─────────────────────────────────
// Every query parks the worker and no connection pool is possible (no threads,
// pre-fork reactor); one streaming cursor per connection, with a second
// statement draining the first; and TLS at the cost of a linked libssl. See
// vyto/db/pgsql's header — the reasoning is identical.
//
// TLS is worth more here than it is there, because two of MySQL's own
// authentication plugins are only answerable over an encrypted transport:
// caching_sha2_password's full exchange (the one MySQL 8 demands on a cache
// miss, which is every first login and every restart) and
// mysql_clear_password. Both work with ssl-mode=REQUIRED or better and fail
// with a diagnosis without it. The default is DISABLED, which is NOT mysql(1)'s
// default — see the driver's init for why the app decides this, not the driver.
//
// ── AND WHERE IT DIFFERS ────────────────────────────────────────────────────
//
//   * lastInsertId() and changes() are exactly right here. The OK packet
//     carries both as length-encoded integers, so unlike PostgreSQL — where
//     lastInsertId is always 0 and RETURNING is the answer — this is the
//     engine's own number. MysqlDialect.supportsReturning() is false, which
//     matches: MySQL has no RETURNING (MariaDB 10.5+ does, for INSERT only).
//
//   * An error does NOT abort the transaction. MySQL carries on after a
//     statement error inside a transaction, like SQLite and unlike PostgreSQL.
//     Portable code still has to assume the stricter PostgreSQL rule.
//
//   * DECIMAL comes back as text, for the same reason numeric does there: it
//     is used precisely because a double cannot represent it.

import { Driver, Conn, Stmt, STEP_ROW, STEP_DONE, STEP_ERR,
         DBERR_NONE, DBERR_OPEN, DBERR_SQL, DBERR_CLOSED, DBERR_MISUSE,
         DBERR_UNSUPPORTED } from "vyto/db/driver";
import { Dialect, MysqlDialect, mysqlDialect } from "vyto/db/dialect";
import { Value, dbNull, DB_NULL } from "vyto/db/value";
import { WireIo, SockIo, dialTcp, dialTcpEx } from "vyto/db/wire/io";
import { Dsn, parseDsn } from "vyto/db/wire";
import { MySession, MyRowBuffer, MyPrepared } from "vyto/db/mysql/session";
import { MyColumn, MyParam, MyReader, decodeBinaryRow, decodeError, decodeOk,
         decodeColumnDef } from "vyto/db/mysql/proto";
import { decodeBinary, encodeParam } from "vyto/db/mysql/mytype";

const DEFAULT_PORT: int = 3306;

// The ssl-mode a DSN that says nothing gets. NOT mysql(1)'s PREFERRED,
// deliberately: PREFERRED negotiates TLS against every local development server
// that happens to have it on. Whether a given server speaks TLS is something the
// app knows and this driver does not, so the app asks for it per connection with
// ?ssl-mode= or .sslMode(...).
//
// Both MysqlDriver and MyOverDriver read this ONE name, because they assign
// their fields directly rather than through super — without it the two defaults
// would drift and the replay tests in examples/106_mywire.vt would go on
// proving something the real driver no longer does.
const DEFAULT_SSLMODE: string = "DISABLED";

// ---------------------------------------------------------------------------
// Statement
// ---------------------------------------------------------------------------

export class MyStmt extends Stmt {
    sess: MySession;      // strong — the SAME object MyConn holds. NOT a MyConn.
    id: int;              // our serial, for wire ownership
    stmtId: int;          // the server's statement handle
    cols: MyColumn[];
    nparams: int;
    params: Value[];
    sink: MyRowBuffer;
    cur: byte[][];        // the current row, already split into fields
    started: bool;
    finished: bool;
    localCode: int;
    localMsg: string;

    fn init(sess: MySession, id: int, stmtId: int, sql: string,
            cols: MyColumn[], nparams: int) {
        this.sql = sql;
        this.busy = false;
        this.sess = sess;
        this.id = id;
        this.stmtId = stmtId;
        this.cols = cols;
        this.nparams = nparams;
        this.params = [];
        this.sink = new MyRowBuffer();
        this.cur = null;
        this.started = false;
        this.finished = false;
        this.localCode = DBERR_NONE;
        this.localMsg = "";
    }

    fn alive(): bool { return this.sess != null && this.sess.open && this.stmtId != 0; }

    fn misuse(msg: string): bool {
        this.localCode = DBERR_MISUSE;
        this.localMsg = msg;
        return false;
    }

    override fn bind(i: int, v: Value): bool {
        if (!this.alive()) { return this.misuse("the statement is not prepared"); }
        if (i < 1) { return this.misuse("bind index " + str(i) + " is below 1"); }
        if (i > this.nparams) {
            return this.misuse("bind index " + str(i) + " but the statement takes "
                               + str(this.nparams) + " parameters");
        }
        while (this.params.len < i) { this.params.push(dbNull()); }
        this.params[i - 1] = v;
        this.localCode = DBERR_NONE;
        this.localMsg = "";
        return true;
    }

    override fn columnCount(): int { return this.cols.len; }

    override fn columnName(i: int): string {
        if (i < 0 || i >= this.cols.len) { return ""; }
        return this.cols[i].name;
    }

    override fn columnValue(i: int): Value {
        if (this.cur == null || i < 0 || i >= this.cols.len || i >= this.cur.len) {
            return dbNull();
        }
        // decodeBinary copies out of the row body, which is replaced by the next
        // step() — vyto/db requires a Row to own its cells (value.vt:18-24).
        return decodeBinary(this.cols[i], this.cur[i]);
    }

    override fn step(): int {
        if (this.finished) { return STEP_DONE; }
        if (!this.alive()) { return STEP_ERR; }

        if (!this.started) {
            if (!this.beginExecute()) { return STEP_ERR; }
            this.started = true;
            // The execute reply opens with either an error, an OK (no result
            // set), or a column count. Consume that before any row can arrive.
            let opened = this.openResult();
            if (opened != 0) { return opened; }
        }

        if (this.sink.pending() > 0) {
            this.cur = decodeBinaryRow(this.sink.take(), this.cols);
            return STEP_ROW;
        }
        if (this.sink.complete) {
            this.finished = true;
            this.cur = null;
            if (this.sess.errCode != DBERR_NONE) { return STEP_ERR; }
            return STEP_DONE;
        }
        return this.pump();
    }

    fn beginExecute(): bool {
        if (!this.sess.acquire(this.id, this.sink, this.cols)) { return false; }
        let ps: MyParam[] = [];
        let i = 0;
        while (i < this.nparams) {
            let v = dbNull();
            if (i < this.params.len) { v = this.params[i]; }
            ps.push(encodeParam(v));
            i += 1;
        }
        return this.sess.execute(this.stmtId, ps);
    }

    // Read the result-set header. Returns 0 to carry on, or a STEP_* to return.
    fn openResult(): int {
        let first = this.sess.readPayload();
        if (first == null) { this.finished = true; return STEP_ERR; }

        if (this.sess.isErr(first)) {
            this.sess.recordError(decodeError(first));
            this.sess.releaseWire(this.id);
            this.finished = true;
            return STEP_ERR;
        }
        if (this.sess.isOk(first)) {
            // No result set at all — an INSERT, UPDATE or DDL. columnCount() is
            // 0 and there is nothing to step over.
            this.sess.noteOk(decodeOk(first));
            this.sess.releaseWire(this.id);
            this.finished = true;
            return STEP_DONE;
        }

        // A column count followed by that many definitions. They repeat the
        // shape prepare() already gave us, so they are consumed and dropped —
        // except that a column whose type the server re-reports differently
        // would matter, so the fresh set wins.
        let r = new MyReader(first);
        let ncols = r.lenEncInt();
        if (ncols <= 0) {
            this.sess.fail(DBERR_SQL, "malformed result header");
            this.finished = true;
            return STEP_ERR;
        }
        let fresh: MyColumn[] = [];
        let i = 0;
        while (i < ncols) {
            let d = this.sess.readPayload();
            if (d == null) { this.finished = true; return STEP_ERR; }
            if (!this.sess.isEof(d)) { fresh.push(decodeColumnDef(d)); }
            i += 1;
        }
        if (!this.sess.deprecateEof()) {
            let d = this.sess.readPayload();
            if (d == null) { this.finished = true; return STEP_ERR; }
        }
        if (fresh.len > 0) {
            this.cols = fresh;
            this.sess.activeCols = fresh;
        }
        return 0;
    }

    fn pump(): int {
        while (true) {
            let p = this.sess.readPayload();
            if (p == null) { this.finished = true; return STEP_ERR; }

            if (this.sess.isErr(p)) {
                this.sess.recordError(decodeError(p));
                this.sess.releaseWire(this.id);
                this.finished = true;
                this.cur = null;
                return STEP_ERR;
            }
            if (this.sess.isResultEnd(p)) {
                this.sess.noteOk(decodeOk(p));
                this.sess.releaseWire(this.id);
                this.finished = true;
                this.cur = null;
                if (this.sess.errCode != DBERR_NONE) { return STEP_ERR; }
                return STEP_DONE;
            }
            this.cur = decodeBinaryRow(p, this.cols);
            return STEP_ROW;
        }
        return STEP_ERR;
    }

    // Bindings are cleared, per driver.vt:80-83.
    override fn reset() {
        if (this.sess != null && this.sess.activeId == this.id) {
            this.sess.drainActive();
        }
        this.params = [];
        this.sink.reset();
        this.cur = null;
        this.started = false;
        this.finished = false;
        this.localCode = DBERR_NONE;
        this.localMsg = "";
    }

    override fn finalize() {
        if (this.stmtId == 0) { return; }
        let id = this.stmtId;
        this.stmtId = 0;
        if (this.sess != null && this.sess.open) {
            this.sess.releaseWire(this.id);
            this.sess.closeStatement(id);
        }
        this.cur = null;
        this.sink.reset();
    }

    override fn errorCode(): int {
        if (this.localCode != DBERR_NONE) { return this.localCode; }
        if (this.sess == null) { return DBERR_CLOSED; }
        return this.sess.errCode;
    }

    override fn errorMessage(): string {
        if (this.localCode != DBERR_NONE) { return this.localMsg; }
        if (this.sess == null) { return "statement is finalized"; }
        if (this.sess.errMsg != "") { return this.sess.errMsg; }
        if (!this.sess.open) { return "the connection is closed"; }
        return "";
    }

    deinit { this.finalize(); }
}

// ---------------------------------------------------------------------------
// Connection
// ---------------------------------------------------------------------------

export class MyConn extends Conn {
    sess: MySession;
    dial: MysqlDialect;
    openErr: string;
    openCode: int;

    cacheSql: string[];
    cacheStmt: MyStmt[];
    cacheCap: int;
    nextId: int;

    fn init(sess: MySession, openErr: string, openCode: int) {
        this.sess = sess;
        this.dial = mysqlDialect();
        this.openErr = openErr;
        this.openCode = openCode;
        this.cacheSql = [];
        this.cacheStmt = [];
        this.cacheCap = 64;
        this.nextId = 0;
    }

    override fn dialect(): Dialect { return this.dial; }
    override fn isOpen(): bool { return this.sess != null && this.sess.open; }

    override fn errorCode(): int {
        if (this.sess == null) { return this.openCode; }
        if (!this.sess.open && this.sess.errCode == DBERR_NONE) { return this.openCode; }
        return this.sess.errCode;
    }

    override fn errorMessage(): string {
        if (this.sess == null) { return this.openErr; }
        if (this.sess.errMsg != "") { return this.sess.errMsg; }
        if (!this.sess.open) { return this.openErr; }
        return "";
    }

    // MySQL's own error number. More specific and more stable than its
    // SQLSTATE, several of which are the catch-all HY000 — 1062 versus 1452 is
    // a routing decision an application genuinely makes.
    fn errno(): int {
        if (this.sess == null) { return 0; }
        return this.sess.errNo;
    }

    fn sqlstate(): string {
        if (this.sess == null) { return ""; }
        return this.sess.errState;
    }

    fn serverVersion(): string {
        if (this.sess == null) { return ""; }
        return this.sess.serverVersion;
    }

    fn connectionId(): int {
        if (this.sess == null) { return 0; }
        return this.sess.connectionId;
    }

    fn io(): WireIo {
        if (this.sess == null) { return null; }
        return this.sess.io;
    }

    override fn prepare(sql: string): Stmt {
        if (!this.isOpen()) { return null; }

        let hit = this.fromCache(sql);
        if (hit != null) { return hit; }

        let p = this.sess.prepare(sql);
        if (!p.ok) { return null; }

        this.nextId += 1;
        let st = new MyStmt(this.sess, this.nextId, p.stmtId, sql, p.cols, p.params.len);
        st.busy = true;
        return st;
    }

    fn fromCache(sql: string): MyStmt {
        let i = 0;
        while (i < this.cacheSql.len) {
            if (this.cacheSql[i] == sql) {
                let st = this.cacheStmt[i];
                if (!st.busy && st.alive()) {
                    st.busy = true;
                    st.reset();
                    return st;
                }
                return null;
            }
            i += 1;
        }
        return null;
    }

    override fn release(st: Stmt) {
        if (st == null) { return; }
        let ms = st as MyStmt;
        if (ms == null) { return; }
        ms.busy = false;
        ms.reset();
        if (!ms.alive()) { return; }

        let i = 0;
        while (i < this.cacheStmt.len) {
            if (this.cacheStmt[i] == ms) { return; }
            i += 1;
        }
        if (this.cacheCap <= 0 || this.cacheStmt.len >= this.cacheCap) {
            ms.finalize();
            return;
        }
        this.cacheSql.push(ms.sql);
        this.cacheStmt.push(ms);
    }

    override fn execRaw(sql: string): bool {
        if (!this.isOpen()) { return false; }
        let ok = this.sess.simpleQuery(sql);
        // A statement that changed the default schema invalidates every cached
        // prepared statement. See changesSchema below — this is not a tidiness
        // measure, it is a correctness one.
        if (ok && changesSchema(sql)) { this.flushCache(); }
        return ok;
    }

    // Finalize and forget every cached statement.
    fn flushCache() {
        let i = 0;
        while (i < this.cacheStmt.len) {
            this.cacheStmt[i].finalize();
            i += 1;
        }
        this.cacheSql = [];
        this.cacheStmt = [];
    }

    override fn changes(): int {
        if (this.sess == null) { return 0; }
        return this.sess.lastRows;
    }

    // Real, unlike PostgreSQL's: the OK packet carries it directly.
    override fn lastInsertId(): int {
        if (this.sess == null) { return 0; }
        return this.sess.lastInsertId;
    }

    override fn inTx(): bool {
        if (this.sess == null) { return false; }
        return this.sess.inTransaction();
    }
    override fn setInTx(v: bool) { }      // the server's status flag is the authority

    override fn close() {
        if (this.sess == null) { return; }
        let i = 0;
        while (i < this.cacheStmt.len) {
            this.cacheStmt[i].finalize();
            i += 1;
        }
        this.cacheSql = [];
        this.cacheStmt = [];
        this.sess.close();
    }

    deinit { this.close(); }
}

// ---------------------------------------------------------------------------
// Driver
// ---------------------------------------------------------------------------

// Canonical ssl-mode spelling, or "" when the value means nothing.
//
// Accepts the libpq words as well as MySQL's own, because a DSN gets copied
// from whatever was last working and "disable" against a MySQL driver should
// not be a silent plaintext connection under a name the driver did not
// recognise. Anything unrecognised is refused, not guessed.
fn normalizeSslMode(m: string): string {
    if (m == "" || m == "DISABLED" || m == "disable" || m == "disabled") { return "DISABLED"; }
    if (m == "PREFERRED" || m == "prefer" || m == "preferred") { return "PREFERRED"; }
    if (m == "REQUIRED" || m == "require" || m == "required") { return "REQUIRED"; }
    if (m == "VERIFY_CA" || m == "verify-ca" || m == "verify_ca") { return "VERIFY_CA"; }
    if (m == "VERIFY_IDENTITY" || m == "verify-full" || m == "verify_identity"
        || m == "verify-identity") { return "VERIFY_IDENTITY"; }
    return "";
}

export class MysqlDriver extends Driver {
    dsn: string;
    timeoutMs: int;
    connTimeoutMs: int;
    cacheCap: int;
    drainCap: int;
    ssl: string;
    sslCa: string;

    fn init(dsn: string) {
        this.dsn = dsn;
        this.timeoutMs = 30000;
        // 0 means "follow timeoutMs" — what this did before the two were
        // separable. See connectTimeout().
        this.connTimeoutMs = 0;
        this.cacheCap = 64;
        this.drainCap = 100000;
        this.ssl = DEFAULT_SSLMODE;
        this.sslCa = "";
    }

    override fn name(): string { return "mysql"; }

    // How long to wait for a REPLY. 0 waits forever, which is the right setting
    // for a caller that can cancel: a query may legitimately run for an hour,
    // and a read deadline that fires on it does not "time out the query" — it
    // tears down the connection, losing the session, its transaction and its
    // temporary tables, and reports it as a server that stopped answering.
    builder fn timeout(ms: int) { this.timeoutMs = ms; return this; }

    // How long to wait for the TCP CONNECT. 0 follows timeout(). Separate
    // because the two answer different questions: a connect that has not
    // completed in seconds never will, while a slow reply may just be work in
    // progress.
    builder fn connectTimeout(ms: int) { this.connTimeoutMs = ms; return this; }

    fn connectDeadline(): int {
        if (this.connTimeoutMs > 0) { return this.connTimeoutMs; }
        return this.timeoutMs;
    }

    builder fn stmtCache(n: int) { this.cacheCap = n; return this; }
    builder fn drainLimit(n: int) { this.drainCap = n; return this; }

    // The MySQL spellings, with the MySQL meanings. Lowercase and the libpq-ish
    // aliases are accepted too, because a DSN gets copied from wherever it was
    // last working:
    //
    //   DISABLED          plaintext, and never ask
    //   PREFERRED         TLS if the server offers it, plaintext if not. NOT verified
    //   REQUIRED          TLS or fail. NOT verified — stops an eavesdropper,
    //                     not an impostor
    //   VERIFY_CA         TLS or fail, and the chain must verify
    //   VERIFY_IDENTITY   TLS or fail, chain verified, and the certificate must
    //                     name the host that was dialled. Use this one.
    builder fn sslMode(m: string) { this.ssl = m; return this; }

    // A PEM bundle of roots to trust IN ADDITION to the system store. Also
    // settable per DSN as ?ssl-ca=, matching mysql(1).
    builder fn sslCaFile(path: string) { this.sslCa = path; return this; }

    override fn connect(): Conn {
        let d = parseDsn(this.dsn, "127.0.0.1", DEFAULT_PORT);
        if (!d.isValid()) {
            return deadConn("vyto/db/mysql: " + d.error(), DBERR_OPEN);
        }

        let mode = normalizeSslMode(d.opt("ssl-mode", d.opt("sslmode", this.ssl)));
        if (mode == "") {
            return deadConn(
                "vyto/db/mysql: ssl-mode=" + d.opt("ssl-mode", d.opt("sslmode", this.ssl))
                + " is not a mode this driver knows. Use DISABLED, PREFERRED, REQUIRED, "
                + "VERIFY_CA or VERIFY_IDENTITY.",
                DBERR_UNSUPPORTED);
        }

        let io = dialTcpEx(d.host, d.port, this.connectDeadline(), this.timeoutMs);
        if (io == null) {
            return deadConn("vyto/db/mysql: could not connect to " + d.host + ":" + str(d.port),
                            DBERR_OPEN);
        }

        let sess = new MySession(io);
        sess.drainCap = this.drainCap;
        sess.sslMode = mode;
        sess.sslCaFile = d.opt("ssl-ca", this.sslCa);
        // The name the certificate has to carry is the one the DSN dialled.
        sess.sslHost = d.host;

        let user = d.user;
        if (user == "") { user = d.opt("user", ""); }
        if (user == "") {
            return deadConn("vyto/db/mysql: the connection string names no user", DBERR_OPEN);
        }
        let pass = d.pass;
        if (pass == "") { pass = d.opt("password", ""); }

        if (!sess.connect(user, pass, d.database)) {
            let msg = sess.errMsg;
            if (msg == "") { msg = "vyto/db/mysql: the connection failed"; }
            let code = sess.errCode;
            if (code == DBERR_NONE) { code = DBERR_OPEN; }
            sess.close();
            return deadConn(msg, code);
        }

        let cn = new MyConn(sess, "", DBERR_NONE);
        cn.cacheCap = this.cacheCap;
        return cn;
    }
}

fn deadConn(msg: string, code: int): Conn {
    return new MyConn(null, msg, code);
}

// Whether a statement changes the connection's default schema.
//
// ── WHY THIS EXISTS, AND WHY IT IS NOT PARANOIA ─────────────────────────────
// MySQL binds DATABASE() at PREPARE time, not at execute time. A cached
// prepared statement containing DATABASE() therefore keeps answering for
// whichever schema was current when it was prepared — measured against 8.0.46:
//
//     USE mivida;  SELECT DATABASE(), COUNT(*) ... WHERE TABLE_SCHEMA=DATABASE()
//         -> mivida, 61
//     USE sys;     (the SAME sql, served from the statement cache)
//         -> mivida, 61      <- wrong schema, no error, no warning
//         (the same sql text with a comment appended, so freshly prepared)
//         -> sys, 101        <- correct
//
// Every one of MysqlDialect's six introspection queries is scoped with
// DATABASE(), so without this the statement cache silently reports the previous
// schema's tables after a USE. It is invisible: the rows are real, well-formed
// and entirely wrong.
//
// The check is deliberately loose — a false positive only costs re-preparing —
// but it does skip leading whitespace and both comment forms, because `USE` is
// usually the first token but need not be the first byte.
fn changesSchema(sql: string): bool {
    let i = skipLeading(sql);
    if (i + 3 > sql.len) { return false; }
    let c0 = upperByte(sql[i]);
    let c1 = upperByte(sql[i + 1]);
    let c2 = upperByte(sql[i + 2]);
    if (c0 != 85 || c1 != 83 || c2 != 69) { return false; }        // U S E
    // Must be the whole keyword: "USER" and "USE_X" are not this.
    if (i + 3 >= sql.len) { return true; }
    let n = sql[i + 3];
    return n == 32 || n == 9 || n == 10 || n == 13 || n == 96;     // space/tab/nl/cr/backtick
}

// Past leading whitespace, `-- ...` line comments and `/* ... */ block comments.
fn skipLeading(s: string): int {
    let i = 0;
    while (i < s.len) {
        let c = s[i];
        if (c == 32 || c == 9 || c == 10 || c == 13) { i += 1; continue; }
        if (c == 45 && i + 1 < s.len && s[i + 1] == 45) {          // "--"
            while (i < s.len && s[i] != 10) { i += 1; }
            continue;
        }
        if (c == 47 && i + 1 < s.len && s[i + 1] == 42) {          // "/*"
            i += 2;
            while (i + 1 < s.len && !(s[i] == 42 && s[i + 1] == 47)) { i += 1; }
            i += 2;
            continue;
        }
        break;
    }
    return i;
}

fn upperByte(c: int): int {
    if (c >= 97 && c <= 122) { return c - 32; }
    return c;
}

export fn mysql(dsn: string): MysqlDriver { return new MysqlDriver(dsn); }

// Speak the protocol over a transport that is already built — a MemIo carrying
// a recorded transcript, for testing without a server, or a TLS transport once
// one exists. See vyto/db/pgsql's pgsqlOver for the reasoning.
export fn mysqlOver(io: WireIo, dsn: string): MyOverDriver { return new MyOverDriver(io, dsn); }

export class MyOverDriver extends MysqlDriver {
    io: WireIo;

    fn init(io: WireIo, dsn: string) {
        this.dsn = dsn;
        this.timeoutMs = 30000;
        this.cacheCap = 64;
        this.drainCap = 100000;
        // The SAME constant MysqlDriver uses — see pgsqlOver's init. A replay
        // with no ssl-mode in its DSN is a test OF the default.
        this.ssl = DEFAULT_SSLMODE;
        this.sslCa = "";
        this.io = io;
    }

    override fn connect(): Conn {
        if (this.io == null) { return deadConn("vyto/db/mysql: no transport", DBERR_OPEN); }
        let d = parseDsn(this.dsn, "127.0.0.1", DEFAULT_PORT);
        let user = d.user;
        if (user == "") { user = "vyto"; }

        let sess = new MySession(this.io);
        sess.drainCap = this.drainCap;
        // Honoured so the CLIENT half of the SSL negotiation is testable: a
        // recorded server can advertise CLIENT_SSL and the 32-byte SSLRequest
        // packet the driver emits can be asserted byte for byte.
        sess.sslMode = normalizeSslMode(d.opt("ssl-mode", d.opt("sslmode", this.ssl)));
        sess.sslHost = d.host;
        if (!sess.connect(user, d.pass, d.database)) {
            let msg = sess.errMsg;
            if (msg == "") { msg = "vyto/db/mysql: the connection failed"; }
            let code = sess.errCode;
            if (code == DBERR_NONE) { code = DBERR_OPEN; }
            return deadConn(msg, code);
        }
        let cn = new MyConn(sess, "", DBERR_NONE);
        cn.cacheCap = this.cacheCap;
        return cn;
    }
}

// Stop the statement running on another connection, identified by the id its
// MyConn.connectionId() reported. Returns "" on success, or why it failed.
//
// Same shape as PostgreSQL's cancel and for the same reason: the connection
// running the query is blocked inside it and the server is not reading that
// socket, so the only way in is a SECOND connection. Unlike PostgreSQL this one
// is an ordinary authenticated session running an ordinary statement, so it
// needs credentials — hence the DSN — and it does report failure.
//
// KILL QUERY, never KILL: QUERY ends the statement and leaves the session, its
// transaction and its temporary tables alive. Plain KILL ends the connection,
// which is the thing cancellation exists to avoid.
//
// It goes over execRaw (COM_QUERY), not Db.raw. `raw` prepares everything, and
// MySQL rejects a number of statements over the prepared-statement protocol —
// the same trap that makes db.raw("begin") silently not start a transaction.
export fn myKill(dsn: string, connectionId: int, timeoutMs: int): string {
    if (connectionId == 0) {
        return "vyto/db/mysql: no connection id — nothing to cancel";
    }
    let d = mysql(dsn);
    d.timeout(timeoutMs);
    let cn = d.connect();
    if (cn == null) { return "vyto/db/mysql: could not open a connection to cancel on"; }
    if (!cn.isOpen()) {
        let why = cn.errorMessage();
        return "vyto/db/mysql: could not open a connection to cancel on: " + why;
    }
    // The id is an int, so it cannot carry SQL — no quoting question here.
    let ok = cn.execRaw("KILL QUERY " + str(connectionId));
    let err = "";
    if (!ok) { err = cn.errorMessage(); }
    cn.close();
    return err;
}

// The dialect is real without the driver: query and schema rendering for MySQL
// works from a program that links no driver at all.
export fn mysqlDialectOf(): Dialect { return mysqlDialect(); }
