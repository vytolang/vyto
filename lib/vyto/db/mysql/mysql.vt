// vyto/db/mysql — MySQL / MariaDB driver. DECLARED, NOT IMPLEMENTED.
//
// Every entry point panics. See vyto/db/pgsql for the full rationale — it is
// the same one, and the same two costs dominate: a synchronous query parks the
// whole pre-fork worker, and shared-nothing workers make a connection pool
// impossible (one connection per worker, for the worker's life).
//
//     let db = new Db(mysql("mysql://localhost/app"));      // panics
//
// It is its own package directory so that a future `#link "mysqlclient"`
// reaches only programs that import this file. `vyto/db` imports no driver.
//
// Two things specific to this engine, worth recording before someone starts:
//
//   * libmysqlclient is GPL, and MariaDB Connector/C is LGPL. That is a
//     licensing decision about the shipped binary, not a technical one, and it
//     should be made before the binding is written rather than after.
//   * MysqlDialect already handles the syntax that differs — backtick
//     identifiers, VARCHAR(255) over TEXT so a column can be indexed,
//     TINYINT(1) for booleans, no RETURNING, and no IF NOT EXISTS on
//     CREATE INDEX. Rendering and testing MySQL SQL works today without this
//     package; only the transport is missing.

import { Driver, Conn } from "vyto/db/driver";
import { Dialect, mysqlDialect } from "vyto/db/dialect";

export class MysqlDriver extends Driver {
    dsn: string;

    fn init(dsn: string) { this.dsn = dsn; }

    override fn name(): string { return "mysql"; }

    override fn connect(): Conn {
        panic("vyto/db/mysql: not implemented — no MySQL driver in this build");
    }
}

export fn mysqlDialectOf(): Dialect { return mysqlDialect(); }

export fn mysql(dsn: string): MysqlDriver { return new MysqlDriver(dsn); }
