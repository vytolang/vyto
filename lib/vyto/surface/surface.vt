// vyto/surface — Layer 0 of the bundled UI stack: a pixel canvas plus a
// classified event queue. Backend today: X11 (see native/src/vsurf.c),
// with a headless test backend (VS_HEADLESS=1 + VS_EVENTS script file).
//
// This is a supported public layer: consume it directly for games, custom
// renderers, or visualization tools, or let vyto/ui sit on top of it.

import { vs_open, vs_close, vs_width, vs_height, vs_set_title,
          vs_fill_rect, vs_draw_rect, vs_draw_line, vs_draw_text, vs_blit, vs_present,
          vs_text_width, vs_font_ascent, vs_font_height,
          vs_wait, vs_poll, vs_wait_timeout, vs_key, vs_text, vs_x, vs_y, vs_wheel,
          vs_mods, vs_now_ms, vs_scale_pct, vs_set_vsync, vs_blit_rect, vs_present_rect,
          vs_clip_set, vs_clip_clear, vs_clipboard_get, vs_clipboard_set,
          vs_event_fd, vs_events_pending, vs_wait_timeout_fds, vs_can_wait_fds,
          vs_native_display, vs_native_window, vs_native_gc } from "vsurf";

// Event classes returned by Surface.wait(). Values mirror VS_EV_* in
// vsurf.h (const initializers must be literals, so they are restated here).
export const EV_NONE: int = 0;
export const EV_EXPOSE: int = 1;
export const EV_KEY: int = 2;
export const EV_MOUSE_DOWN: int = 3;
export const EV_MOUSE_UP: int = 4;
export const EV_RESIZE: int = 5;
export const EV_CLOSE: int = 6;
export const EV_MOUSE_MOVE: int = 7;  // cursor moved over the surface (hover source)
export const EV_TIMER: int = 8;   // vs_wait_timeout elapsed with no input
export const EV_KEY_UP: int = 9;  // a key was released; key() gives the code
export const EV_MOUSE_WHEEL: int = 10; // mouse wheel scrolled; wheel() gives the delta
export const EV_MOUSE_RDOWN: int = 11; // right button pressed; mouse_x()/mouse_y() give position
export const EV_VSYNC: int = 12;  // the display is about to scan out; present now (see set_vsync)

// The same 13 classes as a type, for code that would rather switch than chain
// ifs. wait()/poll()/wait_timeout() still return an int, so this is additive:
// cast at the boundary and the switch is checked for exhaustiveness.
//
//     switch (s.wait() as EVENT) {
//     case EVENT.VSYNC: { ... }
//     ...                          // a 14th class is a compile error here
//     }
//
// Values are pinned to the EV_* above, which mirror VS_EV_* in vsurf.h. The
// cast is range-checked in debug builds, so a value outside 0..12 arriving
// from C panics rather than falling silently through an if-chain.
export enum EVENT {
    NONE = 0,
    EXPOSE = 1,
    KEY = 2,
    MOUSE_DOWN = 3,
    MOUSE_UP = 4,
    RESIZE = 5,
    CLOSE = 6,
    MOUSE_MOVE = 7,
    TIMER = 8,
    KEY_UP = 9,
    MOUSE_WHEEL = 10,
    MOUSE_RDOWN = 11,
    VSYNC = 12,
}

// Key codes from Surface.key(): printable ASCII, or one of these
// (mirrors VS_KEY_* in vsurf.h). KEY_SPACE is plain ASCII 32, named for
// readability. Modifier keys also arrive as their own KEY/KEY_UP events
// (for held-key game input); for "was ctrl held during this event" use
// Surface.mods() / Window.mods with the MOD_* masks below.
//
// These stay consts and get no enum twin, unlike EVENT above: the set is
// open. key() returns any printable character too, and apps compare against
// raw codes (apps/planets3d tests 43, 61, 45, 91). An enum is a closed set,
// so it could not describe what key() returns.
export const KEY_SPACE: int = 32;
export const KEY_ENTER: int = 1000;
export const KEY_BACKSPACE: int = 1001;
export const KEY_ESC: int = 1002;
export const KEY_UP: int = 1003;
export const KEY_DOWN: int = 1004;
export const KEY_LEFT: int = 1005;
export const KEY_RIGHT: int = 1006;
export const KEY_DELETE: int = 1007;
export const KEY_TAB: int = 1008;
export const KEY_HOME: int = 1009;
export const KEY_END: int = 1010;
export const KEY_PAGEUP: int = 1011;
export const KEY_PAGEDOWN: int = 1012;
export const KEY_INSERT: int = 1013;
export const KEY_SHIFT: int = 1014;
export const KEY_CTRL: int = 1015;
export const KEY_ALT: int = 1016;
export const KEY_SUPER: int = 1017;
export const KEY_F1: int = 1021;
export const KEY_F2: int = 1022;
export const KEY_F3: int = 1023;
export const KEY_F4: int = 1024;
export const KEY_F5: int = 1025;
export const KEY_F6: int = 1026;
export const KEY_F7: int = 1027;
export const KEY_F8: int = 1028;
export const KEY_F9: int = 1029;
export const KEY_F10: int = 1030;
export const KEY_F11: int = 1031;
export const KEY_F12: int = 1032;

// ---- printable ASCII, named ------------------------------------------------
//
// key() identity-maps printable keysyms to ASCII (vsurf.c:2047), so these are
// the character codes themselves, not a separate numbering. They exist so a
// shortcut reads as the key it is rather than as a number with a comment:
// `k == KEY_PLUS` over `k == 43  // +`.
//
// Letters are the *lowercase* code, which is what an unshifted press and a
// Ctrl-chord both deliver. KEY_A_UPPER..KEY_Z_UPPER cover the shifted half,
// for the apps that accept either case for one action.

export const KEY_PLUS: int = 43;        // +
export const KEY_COMMA: int = 44;       // ,
export const KEY_MINUS: int = 45;       // -
export const KEY_PERIOD: int = 46;      // .
export const KEY_SLASH: int = 47;       // /
export const KEY_EQUALS: int = 61;      // =
export const KEY_LBRACKET: int = 91;    // [
export const KEY_BACKSLASH: int = 92;   // backslash
export const KEY_RBRACKET: int = 93;    // ]

export const KEY_0: int = 48;
export const KEY_1: int = 49;
export const KEY_2: int = 50;
export const KEY_3: int = 51;
export const KEY_4: int = 52;
export const KEY_5: int = 53;
export const KEY_6: int = 54;
export const KEY_7: int = 55;
export const KEY_8: int = 56;
export const KEY_9: int = 57;

export const KEY_A: int = 97;        // 'a'
export const KEY_B: int = 98;        // 'b'
export const KEY_C: int = 99;        // 'c'
export const KEY_D: int = 100;        // 'd'
export const KEY_E: int = 101;        // 'e'
export const KEY_F: int = 102;        // 'f'
export const KEY_G: int = 103;        // 'g'
export const KEY_H: int = 104;        // 'h'
export const KEY_I: int = 105;        // 'i'
export const KEY_J: int = 106;        // 'j'
export const KEY_K: int = 107;        // 'k'
export const KEY_L: int = 108;        // 'l'
export const KEY_M: int = 109;        // 'm'
export const KEY_N: int = 110;        // 'n'
export const KEY_O: int = 111;        // 'o'
export const KEY_P: int = 112;        // 'p'
export const KEY_Q: int = 113;        // 'q'
export const KEY_R: int = 114;        // 'r'
export const KEY_S: int = 115;        // 's'
export const KEY_T: int = 116;        // 't'
export const KEY_U: int = 117;        // 'u'
export const KEY_V: int = 118;        // 'v'
export const KEY_W: int = 119;        // 'w'
export const KEY_X: int = 120;        // 'x'
export const KEY_Y: int = 121;        // 'y'
export const KEY_Z: int = 122;        // 'z'

export const KEY_A_UPPER: int = 65;  // 'A'
export const KEY_B_UPPER: int = 66;  // 'B'
export const KEY_C_UPPER: int = 67;  // 'C'
export const KEY_D_UPPER: int = 68;  // 'D'
export const KEY_E_UPPER: int = 69;  // 'E'
export const KEY_F_UPPER: int = 70;  // 'F'
export const KEY_G_UPPER: int = 71;  // 'G'
export const KEY_H_UPPER: int = 72;  // 'H'
export const KEY_I_UPPER: int = 73;  // 'I'
export const KEY_J_UPPER: int = 74;  // 'J'
export const KEY_K_UPPER: int = 75;  // 'K'
export const KEY_L_UPPER: int = 76;  // 'L'
export const KEY_M_UPPER: int = 77;  // 'M'
export const KEY_N_UPPER: int = 78;  // 'N'
export const KEY_O_UPPER: int = 79;  // 'O'
export const KEY_P_UPPER: int = 80;  // 'P'
export const KEY_Q_UPPER: int = 81;  // 'Q'
export const KEY_R_UPPER: int = 82;  // 'R'
