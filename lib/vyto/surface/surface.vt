export const KEY_Y_UPPER: int = 89;  // 'Y'
export const KEY_Z_UPPER: int = 90;  // 'Z'

// Modifier bitmask from Surface.mods(): state at the last delivered event.
//
// Also no enum twin: these are combined with `|` and tested with `&`, and
// enums reject both. A MOD enum would need `(mods & (MOD.CTRL as int)) != 0`
// at every site — noisier than the const it replaced.
export const MOD_SHIFT: int = 1;
export const MOD_CTRL: int = 2;
export const MOD_ALT: int = 4;
export const MOD_SUPER: int = 8;

fn imin2(a: int, b: int): int { if (a < b) { return a; } return b; }
fn imax2(a: int, b: int): int { if (a > b) { return a; } return b; }

export struct Rect {
    x: float;
    y: float;
    w: float;
    h: float;

    // --- edges & center (read-only queries) ---
    fn right(): float { return this.x + this.w; }
    fn bottom(): float { return this.y + this.h; }
    fn cx(): float { return this.x + this.w / 2.0; }
    fn cy(): float { return this.y + this.h / 2.0; }
    fn is_empty(): bool { return this.w <= 0.0 || this.h <= 0.0; }
    // Hit-testing takes integer device pixels: mouse events arrive from the
    // window system as whole pixels, so the ~70 call sites keep passing ints
    // and the promotion happens here rather than at each of them.
    fn has(px: int, py: int): bool {
        let fx = px as float;
        let fy = py as float;
        return fx >= this.x && fx < this.right() && fy >= this.y && fy < this.bottom();
    }

    // --- transforms (return a new Rect; `this` is by value) ---
    fn inset(d: float): Rect { return Rect(this.x + d, this.y + d, this.w - 2.0 * d, this.h - 2.0 * d); }
    fn inset_xy(dx: float, dy: float): Rect {
        return Rect(this.x + dx, this.y + dy, this.w - 2.0 * dx, this.h - 2.0 * dy);
    }
    fn outset(d: float): Rect { return Rect(this.x - d, this.y - d, this.w + 2.0 * d, this.h + 2.0 * d); }
    fn offset(dx: float, dy: float): Rect { return Rect(this.x + dx, this.y + dy, this.w, this.h); }
    fn move_to(nx: float, ny: float): Rect { return Rect(nx, ny, this.w, this.h); }
    fn resize(nw: float, nh: float): Rect { return Rect(this.x, this.y, nw, nh); }

    // Snap outward to whole device pixels. The paint stack is sub-pixel, but a
    // few places must hand the window system integer pixels — the present rect
    // and the X11 clip scissor. Rounding outward (floor origin, ceil extent)
    // guarantees the snapped rect covers everything the float rect touched, so
    // a partial repaint can never leave a sliver of the old frame behind.
    fn round_out(): Rect {
        let x0 = this.x.floor();
        let y0 = this.y.floor();
        return Rect(x0, y0, this.right().ceil() - x0, this.bottom().ceil() - y0);
    }

    // --- slicing: take a band off one edge, leaving `this` conceptually shrunk ---
    fn take_top(n: float): Rect { return Rect(this.x, this.y, this.w, n); }
    fn take_bottom(n: float): Rect { return Rect(this.x, this.bottom() - n, this.w, n); }
    fn take_left(n: float): Rect { return Rect(this.x, this.y, n, this.h); }
    fn take_right(n: float): Rect { return Rect(this.right() - n, this.y, n, this.h); }
    fn drop_top(n: float): Rect { return Rect(this.x, this.y + n, this.w, this.h - n); }
    fn drop_bottom(n: float): Rect { return Rect(this.x, this.y, this.w, this.h - n); }
    fn drop_left(n: float): Rect { return Rect(this.x + n, this.y, this.w - n, this.h); }
    fn drop_right(n: float): Rect { return Rect(this.x, this.y, this.w - n, this.h); }

    // --- centering a w×h box inside this rect ---
    fn center_box(bw: float, bh: float): Rect {
        return Rect(this.center_x(bw), this.center_y(bh), bw, bh);
    }
    // Single-axis centering: the offset at which a span of length `bw`/`bh` sits
    // centred inside this rect. By far the most common geometry expression in
    // the widget code (icon next to a label, knob in a track, glyph in a row),
    // and the reason it is a helper rather than open-coded arithmetic: the
    // halving is a rounding decision, and it belongs in one place.
    fn center_x(bw: float): float { return this.x + (this.w - bw) / 2.0; }
    fn center_y(bh: float): float { return this.y + (this.h - bh) / 2.0; }

    // --- set ops ---
    fn union(o: Rect): Rect {
        let nx = this.x.min(o.x);
        let ny = this.y.min(o.y);
        let rr = this.right().max(o.right());
        let bb = this.bottom().max(o.bottom());
        return Rect(nx, ny, rr - nx, bb - ny);
    }
    fn intersect(o: Rect): Rect {
        let nx = this.x.max(o.x);
        let ny = this.y.max(o.y);
        let rr = this.right().min(o.right());
        let bb = this.bottom().min(o.bottom());
        if (rr <= nx || bb <= ny) { return Rect(0, 0, 0, 0); }
        return Rect(nx, ny, rr - nx, bb - ny);
    }
    fn overlaps(o: Rect): bool {
        return this.x < o.x + o.w && o.x < this.x + this.w &&
               this.y < o.y + o.h && o.y < this.y + this.h;
    }
}

export fn contains(r: Rect, px: int, py: int): bool { return r.has(px, py); }

// ---- alpha/RGBA color model --------------------------------------------
// Colors are packed 0xAARRGGBB, with alpha meaning what it says: 0 is fully
// transparent, 255 is opaque.
//
// This used to be inverted — alpha 0 was treated as OPAQUE so that bare
// 0xRRGGBB literals kept working — which made full transparency impossible to
// express and forced a 0-to-255 fixup into four separate functions here plus
// the blend2d shim. A bare 0xRRGGBB literal is now transparent, so write
// rgb()/rgba() (or an explicit 0xFFRRGGBB) for an opaque color.
//
// The rich tier (blend2d) composites translucent colors properly; the lean
// tier can't alpha-blend, so it approximates by `mix`ing against the known
// background instead.

export fn rgb(r: int, g: int, b: int): int {
    return 0xFF000000 | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
}

// a in 0..255; 0 is fully transparent.
export fn rgba(r: int, g: int, b: int, a: int): int {
    return ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
}

// overlay a fresh alpha on any color. a in 0..255.
export fn with_alpha(color: int, a: int): int {
    return ((a & 0xFF) << 24) | (color & 0xFFFFFF);
}

// the alpha byte of a packed color (0..255).
export fn alpha_of(color: int): int {
    return (color >> 24) & 0xFF;
}

// opaque RGB triple of a color.
export fn red_of(c: int): int   { return (c >> 16) & 0xFF; }
export fn green_of(c: int): int { return (c >> 8) & 0xFF; }
export fn blue_of(c: int): int { return c & 0xFF; }

// linearly interpolate two colors at t in 0.0..1.0; works on opaque or
// packed-alpha colors (the alpha bytes are interpolated too).
export fn mix(c0: int, c1: int, t: float): int {
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    let a0 = alpha_of(c0);
    let a1 = alpha_of(c1);
    let r0 = red_of(c0);  let g0 = green_of(c0);  let b0 = blue_of(c0);
    let r1 = red_of(c1);  let g1 = green_of(c1);  let b1 = blue_of(c1);
    // rounded, not truncated — truncation dark-biases every gradient/tint
    let r = ((r0 as float) + (r1 - r0) as float * t + 0.5) as int;
    let g = ((g0 as float) + (g1 - g0) as float * t + 0.5) as int;
    let b = ((b0 as float) + (b1 - b0) as float * t + 0.5) as int;
    let a = ((a0 as float) + (a1 - a0) as float * t + 0.5) as int;
    return ((a & 0xFF) << 24) | ((r & 0xFF) << 16) | ((g & 0xFF) << 8) | (b & 0xFF);
}

export class Surface {
    h: rawptr;

    fn init(title: string, w: int, h: int) {
        this.h = vs_open(title.cstr(), w as i32, h as i32);
        if (this.h == null) {
            panic("cannot open a surface (no display?)");
        }
    }

    fn width(): int { return vs_width(this.h); }
    fn height(): int { return vs_height(this.h); }
    fn set_title(t: string) { vs_set_title(this.h, t.cstr()); }

    // The X11 backend is integer-only, so every Rect snaps here rather than at
    // the ~560 call sites above. round_out (not truncation) so a fill still
    // covers every pixel the float rect touched.
    fn fill(r: Rect, color: int) {
        let d = r.round_out();
        vs_fill_rect(this.h, d.x as i32, d.y as i32, d.w as i32, d.h as i32, color as i32);
    }
    fn frame(r: Rect, color: int) {
        let d = r.round_out();
        vs_draw_rect(this.h, d.x as i32, d.y as i32, d.w as i32, d.h as i32, color as i32);
    }
    fn line(x0: int, y0: int, x1: int, y1: int, color: int) {
        vs_draw_line(this.h, x0 as i32, y0 as i32, x1 as i32, y1 as i32, color as i32);
    }
    fn text(x: int, y: int, s: string, color: int) {
        vs_draw_text(this.h, x as i32, y as i32, s.cstr(), color as i32);
    }
    // vertically centered inside r with a left padding
    fn text_in(r: Rect, pad: int, s: string, color: int) {
        let baseline = r.y + (r.h + this.font_ascent() as float) / 2.0 - 1.0;
        this.text((r.x + pad as float) as int, baseline as int, s, color);
    }

    fn text_width(s: string): int { return vs_text_width(this.h, s.cstr()); }
    fn font_ascent(): int { return vs_font_ascent(this.h); }
    fn font_height(): int { return vs_font_height(this.h); }

    // Blit a raw framebuffer: pixels is a srcw*srch row-major array of
    // 0xRRGGBB values, nearest-neighbor scaled to fill dst. For emulators,
    // pixel art, ray tracers — anything the vector draw calls can't express.
    fn blit(pixels: i32[], srcw: int, srch: int, dst: Rect) {
        vs_blit(this.h, pixels as rawptr, srcw as i32, srch as i32,
                dst.x as i32, dst.y as i32, dst.w as i32, dst.h as i32);
    }
    // Blit from a C-owned 0xRRGGBB buffer (e.g. a vyto/gfx Canvas). The buffer
    // must be tightly packed (stride == srcw*4); for stride-aware or partial
    // blits use blitRect instead.
    fn blitPtr(p: rawptr, srcw: int, srch: int, dst: Rect) {
        vs_blit(this.h, p, srcw as i32, srch as i32,
                dst.x as i32, dst.y as i32, dst.w as i32, dst.h as i32);
    }

    // Unscaled sub-rect blit with an explicit row stride (in pixels): copies
    // src (x,y,w,h) out of the buffer to (dstx,dsty). The dirty-region path
    // out of a full-frame canvas, and the correct call for any stride.
    fn blitRect(p: rawptr, stridePx: int, srcx: int, srcy: int,
                w: int, h: int, dstx: int, dsty: int) {
        vs_blit_rect(this.h, p, stridePx as i32, srcx as i32, srcy as i32,
                     w as i32, h as i32, dstx as i32, dsty as i32);
    }

    fn present() { vs_present(this.h); }
    // present only this backbuffer rect — cheaper for dirty-region repaints
    fn present_rect(r: Rect) {
        let d = r.round_out();
        vs_present_rect(this.h, d.x as i32, d.y as i32, d.w as i32, d.h as i32);
    }

    // Rectangular clip for the draw calls (fill/frame/line/text); replaces
    // any previous clip. blit/present ignore it. clip_clear removes it.
    fn clip_set(r: Rect) {
        let d = r.round_out();
        vs_clip_set(this.h, d.x as i32, d.y as i32, d.w as i32, d.h as i32);
    }
    fn clip_clear() { vs_clip_clear(this.h); }

    fn wait(): int { return vs_wait(this.h); }
    // Non-blocking: returns the next event or EV_NONE if none is queued.
    fn poll(): int { return vs_poll(this.h); }
    // Blocks up to ms; returns EV_TIMER if it elapses with no input. The tick
    // source for game loops: draw, present, then wait_timeout(frame_ms).
    fn wait_timeout(ms: int): int { return vs_wait_timeout(this.h, ms as i32); }

    // The descriptor this surface's events arrive on, or **-1 where there is
    // none**. Only X11 has one: the display connection is a socket, so an
    // external event loop (vyto/os/reactor) can wait on it beside its own fds
    // and drive a window and a set of sockets from ONE blocking call.
    //
    // Win32 blocks on a thread message queue and Android on a pthread condvar.
    // Neither is a descriptor, and -1 says so rather than faking one — the
    // caller falls back to a bounded wait_timeout, which is what
    // Window.add_poll_source already does on every backend.
    //
    // **Readable does not mean an event is ready.** Xlib buffers: bytes on the
    // socket may be a partial message, and events can sit decoded in Xlib's
    // queue with nothing readable on the socket at all. Always drain with
    // eventsPending()/poll() before blocking, never only after the fd fires.
    fn eventFd(): int { return vs_event_fd(this.h) as int; }

    // Events already decoded and waiting, independent of the descriptor. The
    // companion eventFd() needs: a loop that blocked purely on the fd would
    // sleep with events in hand.
    fn eventsPending(): int { return vs_events_pending(this.h) as int; }

    // Block up to `ms` for a window event OR readability on any of `fds`.
    // Returns an EV_* exactly as wait_timeout does — and EV_TIMER covers both
    // "the timeout elapsed" and "one of your fds is ready", so **check your own
    // descriptors on every return**, not only on EV_TIMER.
    //
    // This is what lets a window waiting on work that finishes elsewhere — a
    // forked worker, a socket — block properly instead of waking on a timer to
    // ask. Where the backend cannot do it (see canWaitFds) it degrades to a
    // plain bounded wait, which is exactly the polling the caller would have
    // written by hand, so the call is always correct and sometimes cheaper.
    //
    // Takes plain descriptors rather than a PollSet so that vyto/ui can use it
    // without importing vyto/net: a fd is just a number, and the toolkit must
    // not depend on the networking tree.
    fn waitTimeoutFds(ms: int, fds: int[]): int {
        if (fds.len == 0) { return this.wait_timeout(ms); }
        return vs_wait_timeout_fds(this.h, ms as i32, fds as rawptr,
                                   fds.len as i32) as int;
    }

    // Whether waitTimeoutFds really waits on the given descriptors, or falls
    // back to a bounded poll. True on X11; false on Win32, Android, fbdev and
    // headless. A caller that wants to block indefinitely when idle must check
    // this first — where it is false, it still needs a timer ceiling.
    fn canWaitFds(): bool { return vs_can_wait_fds(this.h) as int != 0; }
    // Ask the backend for an EV_VSYNC once per display refresh while `on`.
    //
    // Returns whether the backend really drives a vsync clock. **A caller that
    // gates presentation on EV_VSYNC must present eagerly when this returns
    // false, or it will never present at all** — only Android has a frame
    // clock (Choreographer); X11, Win32, fbdev and headless all return false.
    //
    // Enable it only while something is animating. The clock is a wakeup per
    // refresh, so leaving it on turns an idle event-driven loop into a 60Hz
    // spin.
    fn set_vsync(on: bool): bool {
        let flag = 0;
        if (on) { flag = 1; }
        return vs_set_vsync(this.h, flag as i32) != 0;
    }
    fn key(): int { return vs_key(); }
    fn text_ev(): string { return str(vs_text()); }
    fn mouse_x(): int { return vs_x(); }
    fn mouse_y(): int { return vs_y(); }
    fn wheel(): int { return vs_wheel(); }
    // MOD_* bitmask captured with the last delivered event
    fn mods(): int { return vs_mods(); }
    // monotonic milliseconds — the animation/game clock (not wall time)
    fn now_ms(): int { return vs_now_ms() as int; }
    // UI scale factor: 1.0 = 96dpi baseline, 2.0 = HiDPI. From $VYTO_SCALE,
    // else Xft.dpi / the Windows DPI. Headless is always 1.0.
    fn scale(): float { return (vs_scale_pct() as float) / 100.0; }

    // System clipboard, UTF-8 text. clipboard() returns "" when empty or
    // unavailable. X11 speaks the CLIPBOARD selection; headless/framebuffer
    // keep a process-local buffer (seed it in event scripts with "clip ...").
    fn clipboard(): string { return str(vs_clipboard_get(this.h)); }
    fn set_clipboard(t: string) { vs_clipboard_set(this.h, t.cstr()); }

    // escape hatches: reach the backend for the 5% case
    fn raw_handle(): rawptr { return this.h; }
    fn native_display(): rawptr { return vs_native_display(this.h); }
    fn native_window(): culong { return vs_native_window(this.h); }
    fn native_gc(): rawptr { return vs_native_gc(this.h); }

    deinit {
        vs_close(this.h);
    }
}
