// vyto/win/manifest — a Windows app's identity, described in Vyto.
//
// The Windows twin of vyto/mobile/android/manifest, and used the same way: an
// app keeps a small program that builds a WinManifest, refuses to emit a bad
// one, and prints it. That program runs on the build host — vytoc runs it when
// given `--manifest` — and what it prints becomes the exe's resources:
//
//   - the application manifest (supported Windows versions, no UAC prompt,
//     UTF-8 code page, DPI awareness)
//   - the icon Explorer, the title bar and the taskbar show
//   - the version info on the Properties → Details tab
//
//     // win_manifest.vt
//     import { WinManifest } from "vyto/win/manifest";
//
//     fn main() {
//         let m = new WinManifest("Vyto Files")
//             .version("1.2.0")
//             .icon("assets/icon.png")
//             .company("Vyto");
//         m.emit();
//     }
//
//     vytoc build app.vt --target windows-x64 --manifest win_manifest.vt
//
// These must be fixed when the exe is built, not when it runs: Explorer reads
// the icon and version without starting the program, and Windows reads the
// manifest before the program's first instruction. That is why this is a
// build-time program and not a property on Window. (A window's icon can still
// change while running: Window.set_icon.)
//
// The icon path is relative to this program's own directory. It may be a PNG
// (vytoc wraps it into an .ico, up to 256x256) or a ready-made .ico.

// The text vytoc reads. The first line names the format so an older vytoc
// reading a newer manifest fails clearly instead of guessing.
export const WIN_MANIFEST_FORMAT: string = "vyto-win-manifest 1";

export class WinManifest {
    app_name: string;
    app_version: string;
    app_icon: string;
    app_company: string;
    app_description: string;
    app_copyright: string;
    app_dpi: string;
    svc_name: string;
    svc_display: string;
    svc_desc: string;
    svc_start: string;
    // more programs in the same install folder, and services for them
    prog_ids: string[];
    prog_paths: string[];
    svcs: SuiteService[];
    main_deps: string[];
    dep_requests: string[];

    fn init(name: string) {
        this.app_name = name;
        this.app_version = "";
        this.app_icon = "";
        this.app_company = "";
        this.app_description = "";
        this.app_copyright = "";
        this.app_dpi = "system";
        this.svc_name = "";
        this.svc_display = "";
        this.svc_desc = "";
        this.svc_start = "";
        this.prog_ids = [];
        this.prog_paths = [];
        this.svcs = [];
        this.main_deps = [];
        this.dep_requests = [];
    }

    // "1.2" to "1.2.3.4": up to four numbers, each 0..65535, which is what the
    // Windows version resource can hold.
    builder fn version(v: string) { this.app_version = v; return this; }
    // A .png (up to 256x256) or an .ico, relative to this program's directory.
    builder fn icon(path: string) { this.app_icon = path; return this; }
    builder fn company(v: string) { this.app_company = v; return this; }
    // Shown as the file description in Explorer and Task Manager.
    builder fn description(v: string) { this.app_description = v; return this; }
    builder fn copyright(v: string) { this.app_copyright = v; return this; }
    // "system" (the default): crisp at the display's scale on the main
    // monitor. "unaware": Windows stretches the window instead, for an app
    // that does not scale its own drawing yet.
    builder fn dpi(mode: string) { this.app_dpi = mode; return this; }

    // The app's exe runs as a Windows service too: the installer
    // (`vytoc build --installer`, per-machine) registers it with the Service
    // Control Manager and the uninstaller removes it. The exe uses
    // vyto/desktop/service's Service.run(). `start` is "manual", "auto" or
    // "delayed" (automatic, after boot settles).
    // Another program of the suite: `entry` (a .vt file, relative to this
    // manifest program) is built too and installed beside the main exe as
    // <id>.exe — all of a suite's exes live in one folder.
    builder fn program(id: string, entry: string) {
        this.prog_ids.push(id);
        this.prog_paths.push(entry);
        return this;
    }

    // Run program `id` as a Windows service (it uses vyto/desktop/service's
    // Service.run). `start` is "manual", "auto" or "delayed".
    builder fn serviceFor(id: string, name: string, display: string, description: string, start: string) {
        this.svcs.push(new SuiteService(id, name, display, description, start));
        return this;
    }

    // Service `name` needs service `on` running first. Windows starts `on`
    // before it and will not stop `on` while it runs; the installer stops and
    // starts the suite's services in that order.
    builder fn dependsOn(name: string, on: string) {
        for (let v in this.svcs) { if (v.name == name) { v.deps.push(on); } }
        if (this.svc_name == name) { this.main_deps.push(on); }
        this.dep_requests.push(name + "\t" + on);
        return this;
    }

    builder fn service(name: string, display: string, description: string, start: string) {
        this.svc_name = name;
        this.svc_display = display;
        this.svc_desc = description;
        this.svc_start = start;
        return this;
    }

    // -- validation ----------------------------------------------------------
    // Problems that would produce a broken resource or a confusing exe.
    // Empty means clean. emit() refuses to print while any remain.
    fn validate(): string[] {
        let probs: string[] = [];
        if (this.app_name.len == 0) { probs.push("name is empty"); }
        if (this.app_version.len > 0 && !version_ok(this.app_version)) {
            probs.push("version \"" + this.app_version +
                       "\" is not 1 to 4 numbers separated by dots, each 0..65535");
        }
        if (this.app_dpi != "system" && this.app_dpi != "unaware") {
            probs.push("dpi \"" + this.app_dpi + "\" must be \"system\" or \"unaware\"");
        }
        if (this.app_icon.len > 0) {
            let low = this.app_icon.to_lower();
            if (!low.ends_with(".png") && !low.ends_with(".ico")) {
                probs.push("icon \"" + this.app_icon + "\" must be a .png or an .ico");
            }
        }
        if (this.svc_name.len > 0) {
            if (!service_name_ok(this.svc_name)) {
                probs.push("service name \"" + this.svc_name +
                           "\" may only use letters, digits, '-', '_' and '.'");
            }
            if (this.svc_start != "manual" && this.svc_start != "auto" && this.svc_start != "delayed") {
                probs.push("service start \"" + this.svc_start + "\" must be manual, auto or delayed");
            }
        }
        this.validate_suite(probs);
        let fields = ["name", "version", "icon", "company", "description", "copyright", "dpi",
                      "service name", "service display name", "service description"];
        let values = [this.app_name, this.app_version, this.app_icon, this.app_company,
                      this.app_description, this.app_copyright, this.app_dpi,
                      this.svc_name, this.svc_display, this.svc_desc];
        for (let i in 0..fields.len) {
            if (has_control(values[i])) {
                probs.push(fields[i] + " contains a control character or line break");
            }
        }
        return probs;
    }

    fn validate_suite(probs: string[]) {
        let seen = new Map<string, bool>();
        for (let i in 0..this.prog_ids.len) {
            let id = this.prog_ids[i];
            if (!program_id_ok(id)) {
                probs.push("program id \"" + id + "\" may only use a-z, 0-9, '-' and '_'");
            } else if (seen.has(id)) {
                probs.push("program \"" + id + "\" is declared twice");
            }
            seen.set(id, true);
            let pth = this.prog_paths[i];
            if (!pth.ends_with(".vt") || has_control(pth)) {
                probs.push("program \"" + id + "\": \"" + pth + "\" is not a .vt file");
            }
        }
        let names = new Map<string, bool>();
        if (this.svc_name.len > 0) { names.set(this.svc_name, true); }
        for (let v in this.svcs) {
            if (!seen.has(v.prog)) {
                probs.push("serviceFor names program \"" + v.prog + "\", which no .program() declares");
            }
            if (!service_name_ok(v.name)) {
                probs.push("service name \"" + v.name + "\" may only use letters, digits, '-', '_' and '.'");
            } else if (names.has(v.name)) {
                probs.push("service \"" + v.name + "\" is declared twice");
            }
            names.set(v.name, true);
            if (v.start != "manual" && v.start != "auto" && v.start != "delayed") {
                probs.push("service start \"" + v.start + "\" must be manual, auto or delayed");
            }
            if (has_control(v.display) || has_control(v.desc)) {
                probs.push("service \"" + v.name + "\" has a control character in its texts");
            }
        }
        for (let r in this.dep_requests) {
            let t = r.index_of("\t");
            let a = r.slice(0, t);
            let b = r.slice(t + 1, r.len);
            if (!names.has(a)) { probs.push("dependsOn: no service \"" + a + "\""); }
            if (!names.has(b)) { probs.push("dependsOn: no service \"" + b + "\""); }
            if (a == b) { probs.push("service \"" + a + "\" cannot depend on itself"); }
        }
        if (this.dep_cycle()) { probs.push("the services' dependsOn form a cycle"); }
    }

    // Walk the dependency graph from each service; seeing it again is a cycle.
    fn dep_cycle(): bool {
        for (let start in this.svcs) {
            let stack: string[] = [];
            for (let d in start.deps) { stack.push(d); }
            let steps = 0;
            while (stack.len > 0 && steps < 1000) {
                let cur = stack.pop();
                steps += 1;
                if (cur == start.name) { return true; }
                for (let v in this.svcs) {
                    if (v.name == cur) { for (let d in v.deps) { stack.push(d); } }
                }
            }
        }
        return false;
    }

    // The text vytoc reads: the format line, then one key=value per set field.
    fn render(): string {
        let out = WIN_MANIFEST_FORMAT + "\n";
        out = out + "name=" + this.app_name + "\n";
        if (this.app_version.len > 0) { out = out + "version=" + this.app_version + "\n"; }
        if (this.app_icon.len > 0) { out = out + "icon=" + this.app_icon + "\n"; }
        if (this.app_company.len > 0) { out = out + "company=" + this.app_company + "\n"; }
        if (this.app_description.len > 0) {
            out = out + "description=" + this.app_description + "\n";
        }
        if (this.app_copyright.len > 0) { out = out + "copyright=" + this.app_copyright + "\n"; }
        out = out + "dpi=" + this.app_dpi;
        if (this.svc_name.len > 0) {
            out = out + "\nservice_name=" + this.svc_name + "\nservice_display=" + this.svc_display +
                  "\nservice_desc=" + this.svc_desc + "\nservice_start=" + this.svc_start;
            if (this.main_deps.len > 0) { out = out + "\nservice_deps=" + this.main_deps.join(","); }
        }
        for (let i in 0..this.prog_ids.len) {
            out = out + "\nprogram=" + this.prog_ids[i] + "\t" + this.prog_paths[i];
        }
        for (let v in this.svcs) {
            out = out + "\nsvc=" + v.prog + "\t" + v.name + "\t" + v.display + "\t" + v.start + "\t" +
                  v.deps.join(",") + "\t" + v.desc;
        }
        return out;
    }

    // Print the manifest for vytoc, or panic listing every problem. A panic is
    // a non-zero exit, which fails the build with the list on stderr, rather
    // than an exe built from a manifest that was quietly wrong.
    fn emit() {
        let probs = this.validate();
        if (probs.len > 0) {
            let msg = "Windows manifest is invalid:";
            for (let p in probs) { msg = msg + "\n  - " + p; }
            panic(msg);
        }
        print(this.render());
    }
}

fn version_ok(v: string): bool {
    let parts = v.split(".");
    if (parts.len < 1 || parts.len > 4) { return false; }
    for (let p in parts) {
        if (p.len == 0 || p.len > 5) { return false; }
        let n = 0;
        for (let i in 0..p.len) {
            let c = p[i];
            if (c < 48 || c > 57) { return false; }
            n = n * 10 + (c - 48);
        }
        if (n > 65535) { return false; }
    }
    return true;
}

fn has_control(s: string): bool {
    for (let i in 0..s.len) {
        let c = s[i];
        if (c < 32 || c == 127) { return true; }
    }
    return false;
}

fn service_name_ok(s: string): bool {
    if (s.len == 0 || s.len > 200) { return false; }
    for (let i in 0..s.len) {
        let c = s[i];
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
                 c == 45 || c == 95 || c == 46;
        if (!ok) { return false; }
    }
    return true;
}

// One .serviceFor() declaration.
class SuiteService {
    prog: string;
    name: string;
    display: string;
    desc: string;
    start: string;
    deps: string[];
    fn init(prog: string, name: string, display: string, desc: string, start: string) {
        this.prog = prog;
        this.name = name;
        this.display = display;
        this.desc = desc;
        this.start = start;
        this.deps = [];
    }
}

fn program_id_ok(s: string): bool {
    if (s.len == 0 || s.len > 40) { return false; }
    for (let i in 0..s.len) {
        let c = s[i];
        if (!((c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 45 || c == 95)) { return false; }
    }
    return true;
}
