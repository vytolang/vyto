// vyto/desktop/secret — keep a small secret (an API key, a passkey, a
// password the app must send somewhere) in a file of the app's own, readable
// only by the user who saved it. See README.md.
//
//     import { secret_save, secret_load, secret_found } from "vyto/desktop/secret";
//
//     secret_save(dataDir("myapp") + "/api.sec", key);
//     let k = secret_load(dataDir("myapp") + "/api.sec");
//     if (!secret_found()) { ... ask for it again ... }
//
// Windows: DPAPI (CryptProtectData, user scope). The file is useless to
// another Windows account or on another PC, so a copied backup or disk image
// does not give the secret away. Linux and macOS: no keyring; the file is
// created mode 0600 and secret_private() says whether it still is.
//
// Keep secrets out of databases, settings tables, logs and anything a backup
// copies: a file beside them, chosen by the app, is the point of this module.

extern "C" {
    fn vsec_protected(): i32;
    fn vsec_save(path: cstring, data: cstring, len: i32): i32;
    fn vsec_load(path: cstring): cstring;
    fn vsec_loaded_ok(): i32;
    fn vsec_private(path: cstring): i32;
    fn vsec_remove(path: cstring): i32;
}

// True where the file's contents are encrypted for this user (Windows
// DPAPI); false where the protection is the file's permissions only.
export fn secret_encrypted(): bool { return vsec_protected() != 0; }

// Save `value` at `path`, replacing what was there. The old secret survives a
// crash mid-write. False when it could not be written (no folder, read-only,
// DPAPI refused).
export fn secret_save(path: string, value: string): bool {
    return vsec_save(path.cstr(), value.cstr(), value.len as i32) != 0;
}

// The secret saved at `path`, or "" — missing, damaged, saved by another
// Windows account, or saved on another OS. secret_found() tells "" saved
// apart from nothing found.
export fn secret_load(path: string): string { return str(vsec_load(path.cstr())); }

// Whether the last secret_load found a secret.
export fn secret_found(): bool { return vsec_loaded_ok() != 0; }

// POSIX: the file exists and no one but its owner can read or write it.
// Windows: the file exists (DPAPI is the protection).
export fn secret_private(path: string): bool { return vsec_private(path.cstr()) != 0; }

// Delete the secret's file. False when there was none.
export fn secret_remove(path: string): bool { return vsec_remove(path.cstr()) != 0; }
