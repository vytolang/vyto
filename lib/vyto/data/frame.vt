// vyto/data/frame — a native columnar data engine (DataFrame) built for
// Excel-scale data: millions of rows, thousands of columns, with sort, filter,
// search, and aggregation that stay sub-second and memory-lean.
//
// Storage is struct-of-arrays: each column is one contiguous typed buffer
// (int / float / bool / string-into-a-shared-arena) held in C (coltable.c). A
// cell read is a single indexed load with no boxing. Sort and filter never move
// column data — they reorder/compact an index permutation naming the visible
// rows — so a 1M-row sort is a permutation of one int64 array and a filter is a
// single compacting pass.
//
//     let df = new DataFrame(1000000);
//     let id = df.addColumn("id", CK_I64);
//     let val = df.addColumn("value", CK_F64);
//     df.reserve(1000000);
//     for (let i in 0..1000000) { df.beginRow().setInt(id, i).setFloat(val, i * 2.0).endRow(); }
//     df.sort(val, false);              // descending, native, sub-1s
//     df.resetView(); df.filterInt(id, OP_GE, 500000);
//     let total = df.agg(val, AGG_SUM);
//
// Memory contract (dense): bytes ~= nrow * (sum of column widths) + 8*nrow.
// int/float col = 8B/row, bool = 1B/row, string = 12B/row + arena bytes. Dense
// thousands-of-columns scale as nrow*ncol*8, so size accordingly. The DataFrame
// owns the native store; ARC deinit frees it once (same pattern as File).

import { bufReader, file_size } from "vyto/io/file";
import { json_parse, json_each, JsonValue } from "vyto/util/json";
import { csv_each_file_with, csv_dialect, Dialect } from "vyto/util/csv";

extern "C" {
    fn ct_new(ncap: i64): rawptr;
    fn ct_reserve(h: rawptr, nrow: i64);
    fn ct_add_col(h: rawptr, name: cstring, kind: i32): i32;
    fn ct_begin_row(h: rawptr);
    fn ct_set_i64(h: rawptr, col: i32, v: i64);
    fn ct_set_f64(h: rawptr, col: i32, v: f64);
    fn ct_set_bool(h: rawptr, col: i32, v: i32);
    fn ct_set_str(h: rawptr, col: i32, s: cstring, n: i64);
    fn ct_end_row(h: rawptr);
    fn ct_nrow(h: rawptr): i64;
    fn ct_ncol(h: rawptr): i64;
    fn ct_view_len(h: rawptr): i64;
    fn ct_src_row(h: rawptr, vrow: i64): i64;
    fn ct_col_kind(h: rawptr, col: i32): i32;
    fn ct_cell_str(h: rawptr, vrow: i64, col: i32, buf: cstring, cap: i64): i64;
    fn ct_cell_len(h: rawptr, vrow: i64, col: i32): i64;
    fn ct_cell_i64(h: rawptr, vrow: i64, col: i32): i64;
    fn ct_cell_f64(h: rawptr, vrow: i64, col: i32): f64;
    fn ct_set_cell_i64(h: rawptr, vrow: i64, col: i32, v: i64);
    fn ct_set_cell_f64(h: rawptr, vrow: i64, col: i32, v: f64);
    fn ct_set_cell_str(h: rawptr, vrow: i64, col: i32, s: cstring, n: i64);
    fn ct_sort(h: rawptr, col: i32, dir: i32);
    fn ct_sort_keys(h: rawptr, cols: rawptr, dirs: rawptr, nk: i32);
    fn ct_reset_view(h: rawptr);
    fn ct_filter_i64(h: rawptr, col: i32, op: i32, operand: i64);
    fn ct_filter_f64(h: rawptr, col: i32, op: i32, operand: f64);
    fn ct_filter_str(h: rawptr, col: i32, op: i32, needle: cstring);
    fn ct_search(h: rawptr, needle: cstring);
    fn ct_agg(h: rawptr, col: i32, kind: i32): f64;
    fn ct_percentile(h: rawptr, col: i32, p: f64): f64;
    fn ct_derive(h: rawptr, name: cstring, op: i32, a: i32, b: i32): i32;
    fn ct_group_by(h: rawptr, keycols: rawptr, nkeys: i32,
                    aggcols: rawptr, aggkinds: rawptr, aggargs: rawptr, nagg: i32): rawptr;
    fn ct_join(h: rawptr, other: rawptr, leftkey: i32, rightkey: i32, kind: i32): rawptr;
    fn ct_col_name(h: rawptr, col: i32, buf: cstring, cap: i64): i64;
    fn ct_set_null(h: rawptr, col: i32);
    fn ct_is_null(h: rawptr, vrow: i64, col: i32): i32;
    fn ct_set_cell_null(h: rawptr, vrow: i64, col: i32, isnull: i32);
    fn ct_free(h: rawptr);
}

// Column kinds.
export const CK_I64: int = 0;
export const CK_F64: int = 1;
export const CK_BOOL: int = 2;
export const CK_STR: int = 3;
// Dictionary-encoded (categorical) text: each row stores a 4-byte code into a
// shared dictionary of the distinct values. For low-cardinality columns
// (regions, statuses, repeated labels) this is a large memory win over CK_STR —
// one copy of each value instead of one string per row — while sort / filter /
// search behave identically. Not for high-cardinality free text (use CK_STR).
export const CK_CAT: int = 4;
// Narrow numeric columns — same value semantics as CK_I64/CK_F64 but fewer bytes
// per row (i32 = 4B, i16 = 2B, f32 = 4B). Use when the value range fits: ids and
// counts in i32/i16, approximate measures in f32. setInt/setFloat coerce to the
// column's kind (integer kinds truncate; narrow kinds wrap on overflow).
export const CK_I32: int = 5;
export const CK_I16: int = 6;
export const CK_F32: int = 7;
// Self-describing column: pick the most efficient kind automatically. The column
// starts narrow (i16) and the engine widens it only as far as the data forces —
// i16 → i32 → i64, → f32 → f64 when a fractional value appears, and → dictionary
// (categorical), then plain text if the distinct count gets large. Feed it via
// setInt/setFloat/setStr, or a loader (which feeds raw strings and lets the
// engine classify). colKind() reports the resolved concrete kind afterward. Best
// default for ingest when the schema isn't known up front.
export const CK_AUTO: int = 8;

// Filter comparison ops (numeric); string filter uses OP_EQ / OP_CONTAINS.
export const OP_EQ: int = 0;
export const OP_NE: int = 1;
export const OP_LT: int = 2;
export const OP_LE: int = 3;
export const OP_GT: int = 4;
export const OP_GE: int = 5;
export const OP_CONTAINS: int = 6;

// Aggregate kinds.
export const AGG_SUM: int = 0;
export const AGG_MIN: int = 1;
export const AGG_MAX: int = 2;
export const AGG_AVG: int = 3;
export const AGG_COUNT: int = 4;             // COUNT(*) — row count, nulls included
// Population (n) vs sample (n-1, Bessel-corrected) — named explicitly rather
// than defaulting to one, matching the explicitness FFI calls already require.
export const AGG_VAR_POP: int = 5;
export const AGG_VAR_SAMP: int = 6;
export const AGG_STD_POP: int = 7;
export const AGG_STD_SAMP: int = 8;
// Only valid through percentile()/median() below, not agg() — needs an extra
// p argument that agg()'s single-int-kind signature has no room for.
export const AGG_PERCENTILE: int = 9;
export const AGG_COUNT_DISTINCT: int = 10;

// Derive (computed-column) arithmetic ops.
export const DV_ADD: int = 0;
export const DV_SUB: int = 1;
export const DV_MUL: int = 2;
export const DV_DIV: int = 3;

// Join kinds.
export const JOIN_INNER: int = 0;    // unmatched left rows dropped
export const JOIN_LEFT: int = 1;     // every left row kept; unmatched right columns are null

export class DataFrame {
    h: rawptr;
    names: string[];   // column titles, parallel to the native columns
    kinds: int[];      // CK_* per column
    scratch: byte[];   // reused cell-format buffer (lazily allocated)

    // `cap` is an initial row-capacity hint (0 = grow on demand).
    fn init(cap: int) {
        this.h = ct_new(cap as i64);
        if (this.h == null) { panic("vyto/data: DataFrame allocation failed"); }
        this.names = [];
        this.kinds = [];
    }

    // ---- schema & build ---------------------------------------------------

    // Add a column; returns its index. Call before appending rows.
    fn addColumn(name: string, kind: int): int {
        let c = ct_add_col(this.h, name.cstr(), kind as i32) as int;
        this.names.push(name);
        this.kinds.push(kind);
        return c;
    }

    // Pre-size all columns to `n` rows (one alloc each) so a bulk load below is
    // realloc-free.
    fn reserve(n: int) { ct_reserve(this.h, n as i64); }

    // Row builder — fluent: beginRow().setInt(..).setFloat(..).endRow().
    fn beginRow(): DataFrame { ct_begin_row(this.h); return this; }
    fn setInt(col: int, v: int): DataFrame { ct_set_i64(this.h, col as i32, v as i64); return this; }
    fn setFloat(col: int, v: float): DataFrame { ct_set_f64(this.h, col as i32, v); return this; }
    fn setBool(col: int, v: bool): DataFrame { let b = 0; if (v) { b = 1; } ct_set_bool(this.h, col as i32, b as i32); return this; }
    fn setStr(col: int, s: string): DataFrame { ct_set_str(this.h, col as i32, s.cstr(), s.len as i64); return this; }
    // Mark the row currently being built as missing in `col`, instead of
    // setInt/setFloat/setStr. A later set* on the same column overwrites it.
    fn setNull(col: int): DataFrame { ct_set_null(this.h, col as i32); return this; }
    fn endRow(): DataFrame { ct_end_row(this.h); return this; }

    // ---- shape ------------------------------------------------------------

    fn nrow(): int { return ct_nrow(this.h) as int; }
    fn ncol(): int { return ct_ncol(this.h) as int; }
    // Rows currently visible (after any filter); equals nrow() with no filter.
    fn viewLen(): int { return ct_view_len(this.h) as int; }
    // The absolute source-row index backing visible row `vrow`. Stable across
    // sort/filter (unlike the visible index), so a caller can remember a row's
    // identity and re-find it after the view changes. -1 if out of range.
    fn srcRow(vrow: int): int { return ct_src_row(this.h, vrow as i64) as int; }
    fn colName(i: int): string { return this.names[i]; }
    // The column's resolved concrete kind (a CK_AUTO column reports whatever it
    // settled on — i16/i32/i64/f32/f64/cat/str — not CK_AUTO).
    fn colKind(i: int): int { return ct_col_kind(this.h, i as i32) as int; }

    // ---- cell read (by VISIBLE row, post filter+sort) ---------------------

    // Formatted text of a visible cell — the only string a rendered cell costs.
    //
    // **Truncated at 255 bytes**, deliberately: this is the draw path, a cell is
    // clipped to its column, and a 4 KB value shaped once per frame per visible
    // row is the cost the columnar model exists to avoid. Anything that needs
    // the value itself — a viewer, an export, the clipboard — must use
    // cellStrFull, which is bounded by the value and not by the buffer.
    fn cellStr(vrow: int, col: int): string {
        if (this.scratch == null) { this.scratch = bytes(256); }
        let n = ct_cell_str(this.h, vrow as i64, col as i32, this.scratch as cstring, 256) as int;
        if (n <= 0) { return ""; }
        return str(this.scratch as cstring);
    }

    // The full byte length of a visible cell's formatted text. 0 for a null.
    fn cellLen(vrow: int, col: int): int {
        return ct_cell_len(this.h, vrow as i64, col as i32) as int;
    }

    // The whole cell, however long. One length query, then one read into a
    // buffer sized to the answer — the string lives in the arena already, so
    // this copies it once and does not materialise anything else.
    //
    // Short cells still take the cached 256-byte scratch, so the common case
    // costs exactly what cellStr costs.
    fn cellStrFull(vrow: int, col: int): string {
        let n = this.cellLen(vrow, col);
        if (n <= 0) { return ""; }
        if (n < 256) { return this.cellStr(vrow, col); }
        let buf = bytes(n + 1);
        let got = ct_cell_str(this.h, vrow as i64, col as i32, buf as cstring, (n + 1) as i64) as int;
        if (got <= 0) { return ""; }
        return str(buf as cstring);
    }
    fn cellInt(vrow: int, col: int): int { return ct_cell_i64(this.h, vrow as i64, col as i32) as int; }
    fn cellFloat(vrow: int, col: int): float { return ct_cell_f64(this.h, vrow as i64, col as i32); }
    // Whether the visible cell is missing (distinct from a real 0/""/false —
    // cellInt/cellFloat/cellStr still return their zero value for a null cell).
    fn isNull(vrow: int, col: int): bool { return ct_is_null(this.h, vrow as i64, col as i32) != 0; }

    // ---- cell write (random access, by VISIBLE row) ----------------------
    // Edit a cell in place. The value is written to the row `vrow` currently
    // maps to; the active sort/filter view is left unchanged (re-apply if the
    // edit should re-sort/re-filter). String writes append to the arena.
    fn setCellInt(vrow: int, col: int, v: int) { ct_set_cell_i64(this.h, vrow as i64, col as i32, v as i64); }
    fn setCellFloat(vrow: int, col: int, v: float) { ct_set_cell_f64(this.h, vrow as i64, col as i32, v); }
    fn setCellStr(vrow: int, col: int, s: string) { ct_set_cell_str(this.h, vrow as i64, col as i32, s.cstr(), s.len as i64); }
    // Toggle a visible cell's null flag without touching its stored value.
    fn setCellNull(vrow: int, col: int, isNull: bool) {
        let n = 0; if (isNull) { n = 1; }
        ct_set_cell_null(this.h, vrow as i64, col as i32, n as i32);
    }

    // ---- sort -------------------------------------------------------------

    // Sort the visible view by one column (asc=true → ascending). Stable.
    fn sort(col: int, asc: bool) { let d = -1; if (asc) { d = 1; } ct_sort(this.h, col as i32, d as i32); }

    // Multi-column sort: cols[0] is the primary key. `dirs[k]` >= 0 ascending,
    // < 0 descending. Successive stable passes, least-significant key last.
    fn sortBy(cols: int[], dirs: int[]) {
        if (cols.len == 0) { return; }
        ct_sort_keys(this.h, cols as rawptr, dirs as rawptr, cols.len as i32);
    }

    // ---- filter / search --------------------------------------------------

    // Clear any filter: all rows visible again (keeps sort order lost — call
    // sort afterward if you need it).
    fn resetView() { ct_reset_view(this.h); }

    // Narrow the view to rows where `col` <op> operand. Filters compose (AND).
    fn filterInt(col: int, op: int, operand: int) { ct_filter_i64(this.h, col as i32, op as i32, operand as i64); }
    fn filterFloat(col: int, op: int, operand: float) { ct_filter_f64(this.h, col as i32, op as i32, operand); }
    // op OP_EQ (exact) or OP_CONTAINS (substring).
    fn filterStr(col: int, op: int, needle: string) { ct_filter_str(this.h, col as i32, op as i32, needle.cstr()); }

    // Global text search: keep rows where `q` occurs in any column's text.
    fn search(q: string) { ct_search(this.h, q.cstr()); }

    // ---- aggregate / derive ----------------------------------------------

    // Aggregate a numeric column over the visible rows (AGG_*), skipping nulls
    // (except AGG_COUNT, which is COUNT(*)).
    fn agg(col: int, kind: int): float { return ct_agg(this.h, col as i32, kind as i32); }

    // Percentile p (0..1, linear interpolation) of `col` over the visible
    // rows, skipping nulls.
    fn percentile(col: int, p: float): float { return ct_percentile(this.h, col as i32, p); }
    fn median(col: int): float { return this.percentile(col, 0.5); }

    // Add a computed float column `name` = (col a) <op> (col b) over all rows;
    // returns the new column index.
    fn derive(name: string, op: int, a: int, b: int): int {
        let c = ct_derive(this.h, name.cstr(), op as i32, a as i32, b as i32) as int;
        this.names.push(name);
        this.kinds.push(CK_F64);
        return c;
    }

    // Group the visible rows by one or more key columns and compute one or
    // more aggregates per group (AGG_*). aggArgs[i] is read only for
    // AGG_PERCENTILE (p in 0..1) — pass 0.0 for every other kind. Returns a
    // NEW DataFrame: the key columns, then one CK_F64 result column per
    // aggregate, one row per distinct key combination. Operates over the
    // current view, so a prior sort/filter narrows what gets grouped.
    fn groupBy(keyCols: int[], aggCols: int[], aggKinds: int[], aggArgs: float[]): DataFrame {
        let df = new DataFrame(0);
        df.adopt(ct_group_by(this.h, keyCols as rawptr, keyCols.len as i32,
                              aggCols as rawptr, aggKinds as rawptr, aggArgs as rawptr, aggCols.len as i32));
        return df;
    }

    // Single-key, single-aggregate convenience over groupBy — same split as
    // sort()/sortBy().
    fn groupByOne(keyCol: int, aggCol: int, aggKind: int): DataFrame {
        return this.groupBy([keyCol], [aggCol], [aggKind], [0.0]);
    }

    // Hash-join this table (left) against `other` (right) on one key column
    // each. JOIN_INNER drops left rows with no match; JOIN_LEFT keeps every
    // visible left row, with every right-side column null where there is no
    // match. A CK_CAT key is compared by its string bytes, never by
    // dictionary code — the two tables' dictionaries are independent.
    // Mismatched key classes (numeric vs. text) return an empty result rather
    // than erroring. Operates on the current view of both tables. Result
    // columns are every left column followed by every right column (right's
    // key included); a CK_CAT source column materializes as CK_STR.
    fn join(other: DataFrame, leftKey: int, rightKey: int, kind: int): DataFrame {
        let df = new DataFrame(0);
        df.adopt(ct_join(this.h, other.h, leftKey as i32, rightKey as i32, kind as i32));
        return df;
    }

    // Replace this DataFrame's native handle with an already-built one (from
    // ct_group_by/ct_join, both of which return a fully-formed table) and
    // resync names[]/kinds[] from it via the native reflection accessors.
    // Used only by groupBy()/join(), which construct a throwaway
    // `new DataFrame(0)` — ct_new(0) allocates nothing beyond an empty native
    // struct — purely so they have a `this` to call adopt() on.
    fn adopt(h2: rawptr) {
        ct_free(this.h);
        this.h = h2;
        this.names = [];
        this.kinds = [];
        if (this.scratch == null) { this.scratch = bytes(256); }
        let n = ct_ncol(h2) as int;
        for (let i in 0..n) {
            let len = ct_col_name(h2, i as i32, this.scratch as cstring, 256) as int;
            let nm = "";
            if (len > 0) { nm = str(this.scratch as cstring); }
            this.names.push(nm);
            this.kinds.push(ct_col_kind(h2, i as i32) as int);
        }
    }

    deinit { ct_free(this.h); }
}

export fn dataFrame(cap: int): DataFrame { return new DataFrame(cap); }

// ---- CSV ingest -----------------------------------------------------------

// Load a comma-separated file. Every column is CK_AUTO, so the native engine
// infers and narrows each column's kind from the actual data — int width, float
// precision, or dictionary-encoded text — as rows stream in. With `hasHeader`
// the first line names the columns; otherwise they are col0, col1, … . Bounded
// memory.
//
// Records come from vyto/util/csv rather than line.split(","), so a quoted
// field containing a comma, a doubled quote or a newline loads correctly — the
// three things the old split-based reader got wrong on any file a spreadsheet
// produced.
export fn loadCsv(path: string, hasHeader: bool): DataFrame {
    return loadCsvWith(path, hasHeader, csv_dialect());
}

// loadCsv for a non-comma flavour: pass csv_tsv(), csv_semicolon(), or a
// Dialect from csv_sniff().
export fn loadCsvWith(path: string, hasHeader: bool, d: Dialect): DataFrame {
    let df = new DataFrame(0);
    let names: string[] = [];
    // Closures capture by value, so the two pieces of mutable state ride in
    // 1-element arrays (the json_each idiom); `df` and `names` are reference
    // types, so mutating through them is visible without one.
    let wantHeader = [hasHeader];
    let sized = [false];
    csv_each_file_with(path, d, (row) => {
        if (wantHeader[0]) {
            wantHeader[0] = false;
            for (let i in 0..row.len) { names.push(row[i].trim()); }
        } else {
            if (df.ncol() == 0) {
                for (let i in 0..row.len) {
                    let nm = "col" + str(i);
                    if (i < names.len) { nm = names[i]; }
                    df.addColumn(nm, CK_AUTO);   // engine infers + narrows from the data
                }
            }
            if (!sized[0]) {
                sized[0] = true;
                // Reserve from file size / first-row byte length — a rough row
                // count, so the column buffers grow once rather than log n times.
                let rowLen = row.len;    // one delimiter per field, plus the newline
                for (let i in 0..row.len) { rowLen += row[i].len; }
                let sz = file_size(path);
                if (sz > 0 && rowLen > 0) { df.reserve(sz / rowLen + 16); }
            }
            append_csv_row(df, row);
        }
    });
    return df;
}

fn append_csv_row(df: DataFrame, fields: string[]) {
    df.beginRow();
    let n = df.ncol();
    for (let i in 0..n) {
        if (i < fields.len) { df.setStr(i, fields[i]); }   // CK_AUTO classifies the field
        else { df.setNull(i); }   // a genuinely short row -- not the same as a present-but-empty field
    }
    df.endRow();
}

// ---- JSON ingest ----------------------------------------------------------

// Seed one CK_AUTO column per key of a sample object; the engine settles each
// column's kind from the values fed in.
fn seed_schema(df: DataFrame, o: JsonValue) {
    let keys = o.objKeys();
    for (let i in 0..keys.len) { df.addColumn(keys[i], CK_AUTO); }
}

// Append one object as a row, feeding each value by its JSON type so CK_AUTO
// picks the tightest kind (integral numbers stay ints; text/mixed → categorical).
fn append_json_obj(df: DataFrame, o: JsonValue) {
    df.beginRow();
    let n = df.ncol();
    for (let i in 0..n) {
        let jv = o.get(df.colName(i));
        if (jv.isNum()) {
            let f = jv.asFloat();
            if (f == (f as int) as float) { df.setInt(i, jv.asInt()); }
            else { df.setFloat(i, f); }
        } else if (jv.isStr()) { df.setStr(i, jv.asString()); }
        else if (jv.isBool()) { let b = "false"; if (jv.asBool()) { b = "true"; } df.setStr(i, b); }
        else if (jv.isObj() || jv.isArr()) { df.setStr(i, jv.stringify()); }
        else { df.setNull(i); }   // JSON null, or key absent from this object
    }
    df.endRow();
}

// Load newline-delimited JSON (one object per line). Schema seeded from the
// first object. Streamed in bounded memory.
export fn loadNdjson(path: string): DataFrame {
    let df = new DataFrame(0);
    let r = bufReader(path);
    if (r == null) { return df; }
    let seeded = false;
    while (!r.eof()) {
        let line = r.readLine();
        if (line == "" && r.eof()) { break; }
        if (line.trim() == "") { continue; }
        let o = json_parse(line);
        if (!o.isObj()) { continue; }
        if (!seeded) { seed_schema(df, o); seeded = true; }
        append_json_obj(df, o);
    }
    r.close();
    return df;
}

// Load a single big JSON array of objects via the streaming parser (O(1) DOM
// memory — each element is parsed, appended, and freed before the next).
export fn loadJsonArray(path: string): DataFrame {
    let df = new DataFrame(0);
    let text = readfile(path);
    let seeded = [false];   // closure captures by value; use a ref container
    json_each(text, (o) => {
        if (o.isObj()) {
            if (!seeded[0]) { seed_schema(df, o); seeded[0] = true; }
            append_json_obj(df, o);
        }
    });
    return df;
}
