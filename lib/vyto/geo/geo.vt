// vyto/geo — geodesy and spatial primitives.
//
//   import { LatLon, distanceM, initialBearing } from "vyto/geo";
//
// The core is projection-independent on purpose. Coordinates, datums, 3D
// Cartesian conversion and spherical measures come first; Web Mercator and
// slippy tiles are one layer built on top (vyto/geo/project, vyto/geo/tiles),
// not the foundation. A 3D globe, a planetarium or a non-Mercator map uses
// this module directly and never touches the tile maths.
//
// Dependencies: vyto/math and vyto/geom only — no libc, allocator or JSON.
// It does need libm, since vyto/math is an extern "C" binding to it.
//
// Angles are degrees at the API surface (that is what data files carry) and
// radians internally. Longitude comes before latitude in every constructor,
// matching GeoJSON's x,y order.

import { PI, sin, cos, asin, acos, atan2, sqrt, hypot, fabs,
         fmin, fmax, fmod } from "vyto/math";
import { Vec3 } from "vyto/geom";

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

export const DEG2RAD: float = 0.017453292519943295;
export const RAD2DEG: float = 57.29577951308232;

// Two Earth radii, deliberately. The semi-major axis is the one Mercator and
// tile scale are defined against — it is what makes zoom 0 land on the
// universal 156543.034 m/px that every scale bar agrees on. The IUGG mean
// radius is the one distances and areas want; using the semi-major axis for
// those biases them by +0.11%.
export const EARTH_RADIUS_M: float = 6378137.0;
export const EARTH_MEAN_RADIUS_M: float = 6371008.8;
export const EARTH_CIRCUMFERENCE_M: float = 40075016.685578488;

// The latitude where a square Web Mercator world runs out. Beyond it tan()
// heads for infinity; see clampMercatorLat.
export const MAX_MERCATOR_LAT: float = 85.05112877980659;

// ---------------------------------------------------------------------------
// Coordinates
// ---------------------------------------------------------------------------

// A 2D geographic position. Value struct: passing one costs two doubles and
// the RC never sees it.
export struct LatLon {
    lon: float;
    lat: float;

    fn equals(o: LatLon): bool { return this.lon == o.lon && this.lat == o.lat; }
    fn withAlt(alt: float): LatLonAlt { return LatLonAlt(this.lon, this.lat, alt); }
}

// A 3D geographic position. `alt` is metres above the ellipsoid (not above
// mean sea level — that needs a geoid model this module does not carry).
export struct LatLonAlt {
    lon: float;
    lat: float;
    alt: float;

    fn flat(): LatLon { return LatLon(this.lon, this.lat); }
}

// ---------------------------------------------------------------------------
// Datums
// ---------------------------------------------------------------------------

// A reference ellipsoid: semi-major axis in metres and flattening. Keeping
// this a parameter rather than baking WGS84 in is what lets the module serve a
// planetarium (Mars), a game (unit sphere) or a globe renderer without
// forking. f == 0.0 is a sphere and every formula below degrades correctly.
export struct Datum {
    a: float;   // semi-major axis, metres
    f: float;   // flattening, (a - b) / a

    // Semi-minor axis.
    fn b(): float { return this.a * (1.0 - this.f); }
    // First eccentricity squared.
    fn e2(): float { return this.f * (2.0 - this.f); }
    // Mean radius R1 = (2a + b) / 3.
    fn meanRadius(): float { return (2.0 * this.a + this.b()) / 3.0; }
    fn isSphere(): bool { return this.f == 0.0; }
}

// Datums are functions, not consts: a const initializer cannot be a struct.
export fn datumWgs84(): Datum { return Datum(EARTH_RADIUS_M, 1.0 / 298.257223563); }
export fn datumSphere(radius: float): Datum { return Datum(radius, 0.0); }
export fn datumUnitSphere(): Datum { return Datum(1.0, 0.0); }
export fn datumEarthSphere(): Datum { return Datum(EARTH_MEAN_RADIUS_M, 0.0); }

// ---------------------------------------------------------------------------
// Angle housekeeping
// ---------------------------------------------------------------------------

// Wrap longitude into [-180, 180). Opt-in, never automatic: a map that pans
// past the antimeridian needs unwrapped longitude to keep world-pixel x
// monotonic, so normalizing inside the projection would break world wrapping.
export fn normalizeLon(lon: float): float {
    let l = fmod(lon + 180.0, 360.0);
    if (l < 0.0) { l = l + 360.0; }
    return l - 180.0;
}

// Wrap an angle in degrees into [0, 360).
export fn normalizeBearing(deg: float): float {
    let d = fmod(deg, 360.0);
    if (d < 0.0) { d = d + 360.0; }
    return d;
}

// Signed shortest difference b - a in degrees, in [-180, 180). Exactly
// half a turn is reported as -180, matching normalizeLon's half-open range;
// the sign is arbitrary there since both ways round are the same length.
export fn lonDelta(a: float, b: float): float {
    let d = fmod(b - a + 180.0, 360.0);
    if (d < 0.0) { d = d + 360.0; }
    return d - 180.0;
}

// Clamp latitude to the Mercator limit. Applied inside the projection rather
// than at call sites: tan(PI/2) is infinite, and an `as int` on an infinite
// float is undefined behaviour in C.
export fn clampMercatorLat(lat: float): float {
    return fmax(-MAX_MERCATOR_LAT, fmin(MAX_MERCATOR_LAT, lat));
}

export fn clampLat(lat: float): float {
    return fmax(-90.0, fmin(90.0, lat));
}

// ---------------------------------------------------------------------------
// Spherical measures
//
// These treat the body as a sphere. That is ~0.5% off from a true ellipsoidal
// geodesic, which needs an iterative solver (Vincenty) that fails to converge
// near-antipodal. The trade is deliberate: coordinate *conversion* uses the
// ellipsoid, where a closed form is exact; measurement uses the sphere, where
// the closed form is fast and the error is below what map data carries.
// ---------------------------------------------------------------------------

// Central angle between two positions, in radians. The radius-free primitive —
// multiply by any body's radius for a distance, or use it directly as an
// astronomical angular separation.
//
// Haversine in its atan2 form rather than the asin form, which loses precision
// for near-antipodal pairs.
export fn angularSeparation(a: LatLon, b: LatLon): float {
    let lat1 = a.lat * DEG2RAD;
    let lat2 = b.lat * DEG2RAD;
    let dLat = (b.lat - a.lat) * DEG2RAD;
    // No wrapping needed: sin(x/2)^2 is symmetric under x -> x - 360 degrees,
    // so a pair straddling the antimeridian already gives the short way round.
    // Do not "fix" this.
    let dLon = (b.lon - a.lon) * DEG2RAD;
    let sdLat = sin(dLat * 0.5);
    let sdLon = sin(dLon * 0.5);
    let h = sdLat * sdLat + cos(lat1) * cos(lat2) * sdLon * sdLon;
    if (h <= 0.0) { return 0.0; }
    if (h >= 1.0) { return PI; }
    return 2.0 * atan2(sqrt(h), sqrt(1.0 - h));
}

// Great-circle distance on a sphere of the given radius.
export fn distanceOnM(a: LatLon, b: LatLon, radius: float): float {
    return angularSeparation(a, b) * radius;
}

// Great-circle distance on Earth, metres.
export fn distanceM(a: LatLon, b: LatLon): float {
    return angularSeparation(a, b) * EARTH_MEAN_RADIUS_M;
}

// Equirectangular approximation: one cos and one hypot instead of the full
// haversine's four trig calls. Off by ~0.002% over 150 km at mid latitudes,
// and by more as the pair grows or moves poleward, so it is for sorting,
// hit-testing and clustering — not for anything the user reads.
export fn distanceEquirectM(a: LatLon, b: LatLon): float {
    let x = lonDelta(a.lon, b.lon) * DEG2RAD * cos((a.lat + b.lat) * 0.5 * DEG2RAD);
    let y = (b.lat - a.lat) * DEG2RAD;
    return hypot(x, y) * EARTH_MEAN_RADIUS_M;
}

// Bearing at `a` along the great circle to `b`, degrees clockwise from north,
// in [0, 360). It is the *initial* bearing: on a great circle other than a
// meridian or the equator, the bearing changes along the way.
export fn initialBearing(a: LatLon, b: LatLon): float {
    let lat1 = a.lat * DEG2RAD;
    let lat2 = b.lat * DEG2RAD;
    let dLon = lonDelta(a.lon, b.lon) * DEG2RAD;
    let y = sin(dLon) * cos(lat2);
    let x = cos(lat1) * sin(lat2) - sin(lat1) * cos(lat2) * cos(dLon);
    return normalizeBearing(atan2(y, x) * RAD2DEG);
}

// Bearing on arrival at `b`, degrees. The back-bearing of the return leg.
export fn finalBearing(a: LatLon, b: LatLon): float {
    return normalizeBearing(initialBearing(b, a) + 180.0);
}

// Walk `distM` from `origin` along a great circle on a sphere of `radius`.
//
// Landing exactly on a pole leaves longitude undefined — there is no meridian
// there — and the returned value is whatever the atan2 of two near-zero terms
// produced. Latitude is still exact. Callers that care must special-case it.
export fn destinationOn(origin: LatLon, bearingDeg: float, distM: float,
                        radius: float): LatLon {
    let d = distM / radius;                 // angular distance
    let br = bearingDeg * DEG2RAD;
    let lat1 = origin.lat * DEG2RAD;
    let lon1 = origin.lon * DEG2RAD;
    let sinLat = sin(lat1) * cos(d) + cos(lat1) * sin(d) * cos(br);
    let lat2 = asin(fmax(-1.0, fmin(1.0, sinLat)));
    let y = sin(br) * sin(d) * cos(lat1);
    let x = cos(d) - sin(lat1) * sinLat;
    let lon2 = lon1 + atan2(y, x);
    return LatLon(normalizeLon(lon2 * RAD2DEG), lat2 * RAD2DEG);
}

// Walk `distM` from `origin` along a great circle on Earth.
export fn destination(origin: LatLon, bearingDeg: float, distM: float): LatLon {
    return destinationOn(origin, bearingDeg, distM, EARTH_MEAN_RADIUS_M);
}

// Point a fraction `t` of the way along the great circle from `a` to `b`.
// Spherical interpolation, not linear in lon/lat: the path is the one a plane
// actually flies, and it crosses the antimeridian correctly.
export fn interpolateLonLat(a: LatLon, b: LatLon, t: float): LatLon {
    let d = angularSeparation(a, b);
    if (d == 0.0) { return a; }
    let sd = sin(d);
    // Antipodal: the great circle is not unique. Fall back to the linear path
    // rather than dividing by zero.
    if (fabs(sd) < 1e-12) {
        return LatLon(a.lon + lonDelta(a.lon, b.lon) * t, a.lat + (b.lat - a.lat) * t);
    }
    let ka = sin((1.0 - t) * d) / sd;
    let kb = sin(t * d) / sd;
    let lat1 = a.lat * DEG2RAD;
    let lat2 = b.lat * DEG2RAD;
    let lon1 = a.lon * DEG2RAD;
    let lon2 = b.lon * DEG2RAD;
    let x = ka * cos(lat1) * cos(lon1) + kb * cos(lat2) * cos(lon2);
    let y = ka * cos(lat1) * sin(lon1) + kb * cos(lat2) * sin(lon2);
    let z = ka * sin(lat1) + kb * sin(lat2);
    return LatLon(atan2(y, x) * RAD2DEG, atan2(z, hypot(x, y)) * RAD2DEG);
}

export fn midpoint(a: LatLon, b: LatLon): LatLon {
    return interpolateLonLat(a, b, 0.5);
}

// ---------------------------------------------------------------------------
// 3D — Cartesian space
//
// The axes are the standard Earth-centred, Earth-fixed frame: +x through
// (0, 0), +y through (90E, 0), +z through the north pole. Every function below
// uses that frame, so a unit vector and an ECEF position agree on orientation
// and a renderer can mix them freely.
//
// Conversion uses the ellipsoid, where the closed form is exact — the opposite
// of the choice made for measurement above, and for the same reason: here
// there is no cost to being exact.
// ---------------------------------------------------------------------------

// A geographic position as a point on the unit sphere.
//
// For geodetic latitude this vector is also the surface normal — geodetic
// "up" — on any ellipsoid, since geodetic latitude is *defined* by the normal's
// inclination. That makes it the vector a lighting pass and an orientation
// calculation both want, and it is why no datum is needed here.
export fn toUnitVector(ll: LatLon): Vec3 {
    let lat = ll.lat * DEG2RAD;
    let lon = ll.lon * DEG2RAD;
    let c = cos(lat);
    return Vec3(c * cos(lon), c * sin(lon), sin(lat));
}

// Inverse of toUnitVector. The vector need not be normalized: only its
// direction is read. A zero vector yields (0, 0).
export fn fromUnitVector(v: Vec3): LatLon {
    let p = hypot(v.x, v.y);
    if (p == 0.0 && v.z == 0.0) { return LatLon(0.0, 0.0); }
    return LatLon(atan2(v.y, v.x) * RAD2DEG, atan2(v.z, p) * RAD2DEG);
}

// Geodetic up at a position. Identical to toUnitVector — see the note there.
// It exists under this name because that is what a renderer looks for.
export fn surfaceNormal(ll: LatLon): Vec3 { return toUnitVector(ll); }

// Geodetic position to Earth-centred, Earth-fixed Cartesian, in metres.
// Exact, no iteration.
export fn toEcef(p: LatLonAlt, d: Datum): Vec3 {
    let lat = p.lat * DEG2RAD;
    let lon = p.lon * DEG2RAD;
    let sLat = sin(lat);
    let cLat = cos(lat);
    let e2 = d.e2();
    // Radius of curvature in the prime vertical.
    let n = d.a / sqrt(1.0 - e2 * sLat * sLat);
    return Vec3((n + p.alt) * cLat * cos(lon),
                (n + p.alt) * cLat * sin(lon),
                (n * (1.0 - e2) + p.alt) * sLat);
}

// ECEF back to geodetic, by Bowring's closed form.
//
// Exact on the ellipsoid and degrading slowly with altitude: measured error is
// 9 nm at 1 km, 1.3 mm at low orbit, 0.26 m at geostationary and 0.35 m at
// lunar distance. Anything needing better than that at orbital altitude wants
// an iterative refinement — but the closed form terminates in fixed time,
// while the iterative one is the usual source of a hang on a degenerate input.
export fn fromEcef(v: Vec3, d: Datum): LatLonAlt {
    let e2 = d.e2();
    let b = d.b();
    let p = hypot(v.x, v.y);

    // On the polar axis longitude is undefined and the general form divides by
    // zero. Report longitude 0, which is what every other library does.
    if (p == 0.0) {
        if (v.z >= 0.0) { return LatLonAlt(0.0, 90.0, v.z - b); }
        return LatLonAlt(0.0, -90.0, -v.z - b);
    }

    let lon = atan2(v.y, v.x);
    // Second eccentricity squared, guarded for a sphere (e2 == 0).
    let ep2 = e2 / (1.0 - e2);
    let theta = atan2(v.z * d.a, p * b);
    let sT = sin(theta);
    let cT = cos(theta);
    let lat = atan2(v.z + ep2 * b * sT * sT * sT,
                    p - e2 * d.a * cT * cT * cT);
    let sLat = sin(lat);
    let n = d.a / sqrt(1.0 - e2 * sLat * sLat);

    // Two altitude forms, picked by latitude. p / cos(lat) loses all precision
    // near the poles and n / sin(lat) loses it near the equator.
    let alt = 0.0;
    if (fabs(lat) > 0.7853981633974483) {          // 45 degrees
        alt = v.z / sLat - n * (1.0 - e2);
    } else {
        alt = p / cos(lat) - n;
    }
    return LatLonAlt(lon * RAD2DEG, lat * RAD2DEG, alt);
}

// The local east/north/up basis at a position, as [east, north, up].
//
// This is what places an object on a globe: a heading rotates in the
// east/north plane, and an altitude offset runs along up. All three are unit
// vectors in the ECEF frame. At a pole east and north are arbitrary but still
// orthogonal, so a renderer does not degenerate.
export fn enuBasis(ll: LatLon): Vec3[] {
    let lat = ll.lat * DEG2RAD;
    let lon = ll.lon * DEG2RAD;
    let sLat = sin(lat);
    let cLat = cos(lat);
    let sLon = sin(lon);
    let cLon = cos(lon);
    return [Vec3(-sLon, cLon, 0.0),
            Vec3(-sLat * cLon, -sLat * sLon, cLat),
            Vec3(cLat * cLon, cLat * sLon, sLat)];
}

// A local east/north/up offset in metres, as a displacement in the ECEF frame.
// Add it to a toEcef() position to place something relative to a ground point.
export fn enuOffsetToEcef(ll: LatLon, east: float, north: float, up: float): Vec3 {
    let basis = enuBasis(ll);
    return basis[0].scale(east).add(basis[1].scale(north)).add(basis[2].scale(up));
}

// Great-circle interpolation between two directions. Inputs are normalized, so
// the result is always a unit vector; `t` outside [0, 1] extrapolates along the
// same great circle.
//
// This is the 3D counterpart of interpolateLonLat and the one a globe wants: it
// composes with a camera without a round trip through degrees.
export fn slerp(a: Vec3, b: Vec3, t: float): Vec3 {
    let u = a.normalized();
    let v = b.normalized();
    let d = fmax(-1.0, fmin(1.0, u.dot(v)));
    let omega = acos(d);
    let s = sin(omega);
    // Coincident, or antipodal where the great circle is not unique: fall back
    // to a straight line rather than dividing by zero.
    if (fabs(s) < 1e-12) {
        let lin = u.add(v.sub(u).scale(t));
        if (lin.len() == 0.0) { return u; }
        return lin.normalized();
    }
    return u.scale(sin((1.0 - t) * omega) / s).add(v.scale(sin(t * omega) / s));
}

// Where a ray first meets a sphere centred on the origin. Returns the ray
// parameter t, or -1.0 on a miss. If `dir` is normalized, t is a distance.
//
// This is the globe's click handler: a camera ray through a pixel, then
// fromUnitVector or fromEcef on the hit point. Without it every globe app
// rewrites it, usually wrong at the silhouette.
export fn rayHitsSphere(origin: Vec3, dir: Vec3, radius: float): float {
    let a = dir.dot(dir);
    if (a == 0.0) { return -1.0; }
    let b = 2.0 * origin.dot(dir);
    let c = origin.dot(origin) - radius * radius;
    let disc = b * b - 4.0 * a * c;
    if (disc < 0.0) { return -1.0; }
    let sq = sqrt(disc);
    let t0 = (-b - sq) / (2.0 * a);
    if (t0 >= 0.0) { return t0; }
    let t1 = (-b + sq) / (2.0 * a);
    if (t1 >= 0.0) { return t1; }
    return -1.0;                    // sphere is entirely behind the ray
}

// The same, against an ellipsoid. Scaling each axis by its own radius turns the
// ellipsoid into a unit sphere, and since that scaling is linear the ray
// parameter t survives it unchanged — so the hit point is still
// origin + dir * t in the original frame.
export fn rayHitsEllipsoid(origin: Vec3, dir: Vec3, d: Datum): float {
    let b = d.b();
    return rayHitsSphere(Vec3(origin.x / d.a, origin.y / d.a, origin.z / b),
                         Vec3(dir.x / d.a, dir.y / d.a, dir.z / b),
                         1.0);
}

// Geodetic latitude to geocentric: the angle at the centre, not the angle of
// the surface normal. They differ by up to 0.19 degrees on WGS84 and agree on
// a sphere. Anything reasoning about the centre of the body — orbits, ray
// directions from the origin — wants this one.
export fn geodeticToGeocentricLat(latDeg: float, d: Datum): float {
    return atan2((1.0 - d.e2()) * sin(latDeg * DEG2RAD), cos(latDeg * DEG2RAD)) * RAD2DEG;
}

export fn geocentricToGeodeticLat(latDeg: float, d: Datum): float {
    return atan2(sin(latDeg * DEG2RAD), (1.0 - d.e2()) * cos(latDeg * DEG2RAD)) * RAD2DEG;
}

// ---------------------------------------------------------------------------
// BBox
// ---------------------------------------------------------------------------

// An axis-aligned geographic extent, in GeoJSON field order.
//
// `west > east` means the box crosses the antimeridian — a real extent, not an
// error, and `contains`/`intersects` handle it. Emptiness is therefore keyed on
// latitude alone: `south > north`.
export struct BBox {
    west: float;
    south: float;
    east: float;
    north: float;

    fn isEmpty(): bool { return this.south > this.north; }
    fn crossesAntimeridian(): bool { return this.west > this.east; }

    fn lonSpan(): float {
        if (this.crossesAntimeridian()) { return (360.0 - this.west) + this.east; }
        return this.east - this.west;
    }
    fn latSpan(): float { return this.north - this.south; }

    fn center(): LatLon {
        let lat = (this.south + this.north) * 0.5;
        if (this.crossesAntimeridian()) {
            return LatLon(normalizeLon(this.west + this.lonSpan() * 0.5), lat);
        }
        return LatLon((this.west + this.east) * 0.5, lat);
    }

    fn southWest(): LatLon { return LatLon(this.west, this.south); }
    fn northEast(): LatLon { return LatLon(this.east, this.north); }

    fn containsLonLat(lon: float, lat: float): bool {
        if (this.isEmpty()) { return false; }
        if (lat < this.south || lat > this.north) { return false; }
        let x = normalizeLon(lon);
        if (this.crossesAntimeridian()) { return x >= this.west || x <= this.east; }
        return x >= this.west && x <= this.east;
    }

    fn containsPoint(p: LatLon): bool { return this.containsLonLat(p.lon, p.lat); }

    // True when `o` lies wholly inside this box.
    fn contains(o: BBox): bool {
        if (this.isEmpty() || o.isEmpty()) { return false; }
        if (o.south < this.south || o.north > this.north) { return false; }
        if (!this.crossesAntimeridian()) {
            if (o.crossesAntimeridian()) { return false; }
            return o.west >= this.west && o.east <= this.east;
        }
        // This box wraps: `o` must sit inside one of the two spans, or wrap
        // itself and be inside on both sides.
        if (o.crossesAntimeridian()) {
            return o.west >= this.west && o.east <= this.east;
        }
        return o.west >= this.west || o.east <= this.east;
    }

    fn intersects(o: BBox): bool {
        if (this.isEmpty() || o.isEmpty()) { return false; }
        if (o.south > this.north || o.north < this.south) { return false; }
        let aw = this.crossesAntimeridian();
        let bw = o.crossesAntimeridian();
        if (aw && bw) { return true; }   // both span 180, so both cover it
        if (!aw && !bw) { return o.west <= this.east && o.east >= this.west; }
        if (aw) { return o.west <= this.east || o.east >= this.west; }
        return this.west <= o.east || this.east >= o.west;
    }

    // Smallest box holding both. Assumes neither crosses the antimeridian —
    // there is no well-defined answer when they do (two candidate hulls, and
    // the smaller one is not always the wanted one), so a wrapping input is
    // normalized to its full-width span instead of guessing.
    fn union(o: BBox): BBox {
        if (this.isEmpty()) { return o; }
        if (o.isEmpty()) { return this; }
        let s = fmin(this.south, o.south);
        let n = fmax(this.north, o.north);
        if (this.crossesAntimeridian() || o.crossesAntimeridian()) {
            return BBox(-180.0, s, 180.0, n);
        }
        return BBox(fmin(this.west, o.west), s, fmax(this.east, o.east), n);
    }

    // Expand by a fixed number of degrees on each side, clamping latitude.
    fn grow(lonDeg: float, latDeg: float): BBox {
        if (this.isEmpty()) { return this; }
        return BBox(this.west - lonDeg, clampLat(this.south - latDeg),
                    this.east + lonDeg, clampLat(this.north + latDeg));
    }
}

// The identity for union: empty, and absorbing. A const cannot hold a struct,
// hence a function.
export fn bboxEmpty(): BBox { return BBox(180.0, 90.0, -180.0, -90.0); }

export fn bboxWorld(): BBox { return BBox(-180.0, -90.0, 180.0, 90.0); }

export fn bboxOfPoint(p: LatLon): BBox { return BBox(p.lon, p.lat, p.lon, p.lat); }

// Extent of a coordinate run held as parallel arrays. Takes (start, count) so
// one part of a multi-part geometry needs no slice allocation. Does not handle
// the antimeridian: a run that crosses it yields a box spanning the long way,
// which is the same thing every other flat-coordinate library does.
export fn bboxOfCoords(lons: float[], lats: float[], start: int, count: int): BBox {
    if (count <= 0) { return bboxEmpty(); }
    let w = lons[start];
    let e = w;
    let s = lats[start];
    let n = s;
    let i = start + 1;
    let end = start + count;
    while (i < end) {
        let x = lons[i];
        let y = lats[i];
        if (x < w) { w = x; }
        if (x > e) { e = x; }
        if (y < s) { s = y; }
        if (y > n) { n = y; }
        i = i + 1;
    }
    return BBox(w, s, e, n);
}

// ---------------------------------------------------------------------------
// Geometry
//
// Coordinates are held flat, in parallel arrays, with a separate table of part
// offsets. Nested arrays are awkward in Vyto, a draw loop wants a flat run, and
// this way one ring of a multi-part shape can be measured or tested without
// allocating a slice for it. Every bulk function below therefore takes
// (lons, lats, start, count) rather than an array of rings.
// ---------------------------------------------------------------------------

export const GEOM_POINT: int = 0;
export const GEOM_LINE: int = 1;
export const GEOM_POLYGON: int = 2;

// A class rather than a struct: it holds arrays, and a Vyto struct cannot.
export class Geometry {
    kind: int;
    lons: float[];
    lats: float[];
    // Altitude per point, metres above the ellipsoid, and always the same
    // length as lons/lats. GeoJSON's optional third position element lands
    // here; where a source has no altitude it is 0.0. Terrain, flight paths
    // and satellite tracks are the obvious spatial apps and altitude is the
    // whole point of them, so it is not discarded on the way in.
    alts: float[];

    partStart: int[];
    partLen: int[];
    // Whether each part is an exterior ring rather than a hole. Start/length
    // alone cannot distinguish a MultiPolygon's second *exterior* ring from a
    // *hole* in its first, which is exactly how holes end up drawn as
    // outlines. Meaningless for points and lines, where it stays true.
    partOuter: bool[];

    fn init(kind: int) {
        this.kind = kind;
        this.lons = [];
        this.lats = [];
        this.alts = [];
        this.partStart = [];
        this.partLen = [];
        this.partOuter = [];
    }

    fn partCount(): int { return this.partStart.len; }
    fn pointCount(): int { return this.lons.len; }
    fn isEmpty(): bool { return this.lons.len == 0; }

    // Append a part. Altitudes default to zero; addPart3 carries them.
    fn addPart(lons: float[], lats: float[], outer: bool) {
        let zeros: float[] = [];
        let i = 0;
        while (i < lons.len) { zeros.push(0.0); i = i + 1; }
        this.addPart3(lons, lats, zeros, outer);
    }

    fn addPart3(lons: float[], lats: float[], alts: float[], outer: bool) {
        let n = lons.len;
        if (lats.len < n) { n = lats.len; }
        if (alts.len < n) { n = alts.len; }
        this.partStart.push(this.lons.len);
        this.partLen.push(n);
        this.partOuter.push(outer);
        let i = 0;
        while (i < n) {
            this.lons.push(lons[i]);
            this.lats.push(lats[i]);
            this.alts.push(alts[i]);
            i = i + 1;
        }
    }

    fn partPoint(part: int, i: int): LatLon {
        let at = this.partStart[part] + i;
        return LatLon(this.lons[at], this.lats[at]);
    }

    fn partPointAlt(part: int, i: int): LatLonAlt {
        let at = this.partStart[part] + i;
        return LatLonAlt(this.lons[at], this.lats[at], this.alts[at]);
    }

    fn partBBox(part: int): BBox {
        return bboxOfCoords(this.lons, this.lats, this.partStart[part], this.partLen[part]);
    }

    fn partLengthM(part: int): float {
        return polylineLengthM(this.lons, this.lats, this.partStart[part], this.partLen[part]);
    }

    fn partAreaM2(part: int): float {
        return polygonAreaM2(this.lons, this.lats, this.partStart[part], this.partLen[part]);
    }

    fn bbox(): BBox {
        let b = bboxEmpty();
        let i = 0;
        while (i < this.partCount()) { b = b.union(this.partBBox(i)); i = i + 1; }
        return b;
    }

    // Total length of every part. For a polygon this is the perimeter.
    fn lengthM(): float {
        let total = 0.0;
        let i = 0;
        while (i < this.partCount()) { total = total + this.partLengthM(i); i = i + 1; }
        return total;
    }

    // Area of the exterior rings less the area of the holes.
    fn areaM2(): float {
        let total = 0.0;
        let i = 0;
        while (i < this.partCount()) {
            if (this.partOuter[i]) { total = total + this.partAreaM2(i); }
            else { total = total - this.partAreaM2(i); }
            i = i + 1;
        }
        if (total < 0.0) { return 0.0; }
        return total;
    }
}

// ---------------------------------------------------------------------------
// Bulk algorithms
// ---------------------------------------------------------------------------

// Great-circle length of a coordinate run, metres. An open path: no closing
// edge is added, so a ring must repeat its first point to be measured whole.
export fn polylineLengthM(lons: float[], lats: float[], start: int, count: int): float {
    if (count < 2) { return 0.0; }
    let total = 0.0;
    let i = start + 1;
    let end = start + count;
    while (i < end) {
        total = total + distanceM(LatLon(lons[i - 1], lats[i - 1]), LatLon(lons[i], lats[i]));
        i = i + 1;
    }
    return total;
}

// Area of a ring on the sphere, square metres, always positive. The ring is
// closed implicitly, so a repeated final point is allowed but not required.
//
// Spherical excess, not a planar shoelace: a planar formula in degrees is
// wrong by whatever cos(latitude) does across the shape. Each longitude step
// is wrapped into [-PI, PI] first — without that a ring crossing the
// antimeridian accumulates a ~360 degree step and reports a near-whole-earth
// area. distanceM needs no such wrap, but this does; the two are not the same
// situation.
export fn polygonAreaM2(lons: float[], lats: float[], start: int, count: int): float {
    if (count < 3) { return 0.0; }
    let total = 0.0;
    let end = start + count;
    let j = end - 1;
    let i = start;
    while (i < end) {
        let dLon = (lons[i] - lons[j]) * DEG2RAD;
        // wrap into [-PI, PI]
        if (dLon > PI) { dLon = dLon - 2.0 * PI; }
        if (dLon < -PI) { dLon = dLon + 2.0 * PI; }
        total = total + dLon * (2.0 + sin(lats[j] * DEG2RAD) + sin(lats[i] * DEG2RAD));
        j = i;
        i = i + 1;
    }
    total = total * EARTH_MEAN_RADIUS_M * EARTH_MEAN_RADIUS_M * 0.5;
    return fabs(total);
}

// Winding direction of a ring, by the planar shoelace sign. GeoJSON's
// right-hand rule wants exterior rings counter-clockwise and holes clockwise,
// and renderers that fill by winding care which way a ring runs.
//
// Planar, so it is wrong for a ring that crosses the antimeridian — see the
// note on pointInRing.
export fn ringIsClockwise(lons: float[], lats: float[], start: int, count: int): bool {
    if (count < 3) { return false; }
    let sum = 0.0;
    let end = start + count;
    let j = end - 1;
    let i = start;
    while (i < end) {
        sum = sum + (lons[i] - lons[j]) * (lats[i] + lats[j]);
        j = i;
        i = i + 1;
    }
    return sum > 0.0;
}

// Crossing-number point-in-polygon against a single ring. The ring is closed
// implicitly. A point exactly on an edge may land either way — that is
// inherent to the test, not a bug to file.
//
// This is a planar ray cast, so it breaks for a ring crossing the
// antimeridian. Callers with such data pre-shift the ring and the query point
// by +360 degrees; the fix does not belong in here, because only the caller
// knows which side of the world the query is meant to be on.
export fn pointInRing(lon: float, lat: float, lons: float[], lats: float[],
                      start: int, count: int): bool {
    if (count < 3) { return false; }
    let inside = false;
    let end = start + count;
    let j = end - 1;
    let i = start;
    while (i < end) {
        let yi = lats[i];
        let yj = lats[j];
        if ((yi > lat) != (yj > lat)) {
            let x = (lons[j] - lons[i]) * (lat - yi) / (yj - yi) + lons[i];
            if (lon < x) { inside = !inside; }
        }
        j = i;
        i = i + 1;
    }
    return inside;
}

// Point-in-polygon across every part of a geometry, honouring holes.
//
// Inside means: within at least one exterior ring, and within no hole. That is
// exact for well-formed data, where holes lie inside their own polygon and
// polygons do not overlap. It is not a general boolean over arbitrary
// overlapping rings, which needs ring-to-polygon grouping GeoJSON does not
// carry. Non-polygon geometries are always outside.
export fn pointInGeometry(g: Geometry, lon: float, lat: float): bool {
    if (g.kind != GEOM_POLYGON) { return false; }
    let inOuter = false;
    let i = 0;
    while (i < g.partCount()) {
        if (pointInRing(lon, lat, g.lons, g.lats, g.partStart[i], g.partLen[i])) {
            if (g.partOuter[i]) { inOuter = true; } else { return false; }
        }
        i = i + 1;
    }
    return inOuter;
}

// Ramer-Douglas-Peucker, with the tolerance in **metres**.
//
// A tolerance in degrees is unpickable: it means a different distance at every
// latitude. Longitude is scaled by cos(midLat) so the working plane is locally
// metric, which is accurate over the span any single simplified feature covers.
//
// Returns absolute indices into lons/lats, ascending, always including the
// first and last point of the run. The recursion is an explicit stack: the
// worst case is O(n) deep and Vyto has no tail calls.
export fn simplifyIndicesM(lons: float[], lats: float[], start: int, count: int,
                           toleranceM: float): int[] {
    let out: int[] = [];
    if (count <= 0) { return out; }
    if (count < 3 || toleranceM <= 0.0) {
        let k = 0;
        while (k < count) { out.push(start + k); k = k + 1; }
        return out;
    }

    // Local metric frame: degrees to metres, longitude foreshortened by the
    // latitude at the middle of the run.
    let b = bboxOfCoords(lons, lats, start, count);
    let mx = DEG2RAD * EARTH_MEAN_RADIUS_M * cos(b.center().lat * DEG2RAD);
    let my = DEG2RAD * EARTH_MEAN_RADIUS_M;
    let tol2 = toleranceM * toleranceM;

    let keep: bool[] = [];
    let k = 0;
    while (k < count) { keep.push(false); k = k + 1; }
    keep[0] = true;
    keep[count - 1] = true;

    let stack: int[] = [];
    stack.push(0);
    stack.push(count - 1);

    while (stack.len >= 2) {
        let last = stack.pop();
        let first = stack.pop();
        if (last <= first + 1) { continue; }

        let ax = lons[start + first] * mx;
        let ay = lats[start + first] * my;
        let bx = lons[start + last] * mx;
        let by = lats[start + last] * my;
        let dx = bx - ax;
        let dy = by - ay;
        let seg2 = dx * dx + dy * dy;

        let bestI = -1;
        let best2 = tol2;
        let i = first + 1;
        while (i < last) {
            let px = lons[start + i] * mx;
            let py = lats[start + i] * my;
            // Squared distance from the point to the segment. A degenerate
            // segment (both endpoints equal) falls back to point distance.
            let d2 = 0.0;
            if (seg2 == 0.0) {
                let ex = px - ax;
                let ey = py - ay;
                d2 = ex * ex + ey * ey;
            } else {
                let t = ((px - ax) * dx + (py - ay) * dy) / seg2;
                if (t < 0.0) { t = 0.0; }
                if (t > 1.0) { t = 1.0; }
                let ex = px - (ax + t * dx);
                let ey = py - (ay + t * dy);
                d2 = ex * ex + ey * ey;
            }
            if (d2 > best2) { best2 = d2; bestI = i; }
            i = i + 1;
        }

        if (bestI >= 0) {
            keep[bestI] = true;
            stack.push(first);
            stack.push(bestI);
            stack.push(bestI);
            stack.push(last);
        }
    }

    let j = 0;
    while (j < count) {
        if (keep[j]) { out.push(start + j); }
        j = j + 1;
    }
    return out;
}
