// vyto/ui/data — data widgets: TreeView (hierarchical expand/collapse) and
// Table (a string-cell DataGrid with a search box, sortable columns,
// pagination, row selection, and per-row actions). Generics are shelved, so
// the model is string cells (rows: string[][]); a Table owns its data so it can
// filter/sort/paginate it directly.

import { Widget, Painter, Theme, Size, BoxConstraints,
         WEIGHT } from "vyto/ui/core";
import { SearchField, Button } from "vyto/ui/form";
import { SIDE } from "vyto/ui/scrollbar";
import { ALIGN } from "vyto/ui/display";
import { Rect, contains, mix, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT,
         KEY_ENTER, KEY_SPACE, MOD_SHIFT } from "vyto/surface";

// ---- string helpers (no generics / stdlib string compare) ----------------

fn lc_byte(b: int): int {
    if (b >= 65 && b <= 90) { return b + 32; }
    return b;
}

// case-insensitive substring test
fn contains_ci(hay: string, needle: string): bool {
    if (needle.len == 0) { return true; }
    if (needle.len > hay.len) { return false; }
    for (let i in 0..hay.len - needle.len + 1) {
        let ok = true;
        for (let j in 0..needle.len) {
            if (lc_byte(hay[i + j]) != lc_byte(needle[j])) { ok = false; break; }
        }
        if (ok) { return true; }
    }
    return false;
}

// byte-wise compare: -1 / 0 / 1
fn str_cmp(a: string, b: string): int {
    let n = a.len;
    if (b.len < n) { n = b.len; }
    for (let i in 0..n) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) { return -1; }
            return 1;
        }
    }
    if (a.len < b.len) { return -1; }
    if (a.len > b.len) { return 1; }
    return 0;
}

// ------------------------------------------------------- TreeNode / TreeView

// Emphasis for a tree row, read only when TreeView.typed_levels is on. It is
// the node's IMPORTANCE, not its depth: a tree can hold a connection nested
// under a folder and still want the connection to read as the strong thing.
export enum TN {
    NORMAL,   // body weight, on_surface
    STRONG,   // bold — a root, a connection
    MEDIUM,   // medium — a container one level in
    MUTED,    // muted ink — a leaf among many
    GROUP,    // small caption — a "TABLES (5)" divider row
}

// A tree node the app builds and hands to a TreeView. `data` is a free app key.
export class TreeNode {
    label: string;
    children: TreeNode[];
    expanded: bool;
    data: int;
    // TN — how this row is weighted when the view has typed_levels on.
    // TN.NORMAL (the default) reproduces the old uniform look exactly.
    emphasis: TN;
    // A status dot drawn at the row's right edge, 0 = none. An ARGB colour
    // rather than a state enum: what a dot means is the app's business, and a
    // tree in a DB client, a file browser and a device list would each want a
    // different vocabulary.
    dot: int;

    fn init(label: string) {
        this.label = label;
        this.children = [];
        this.expanded = false;
        this.data = 0;
        this.emphasis = TN.NORMAL;
        this.dot = 0;
    }

    // new TreeNode("local").weight(TN.STRONG).status(th.success)
    builder fn weight(e: TN) { this.emphasis = e; return this; }
    builder fn status(color: int) { this.dot = color; return this; }

    fn add(child: TreeNode): TreeNode {
        this.children.push(child);
        return this;
    }

    fn leaf(): bool { return this.children.len == 0; }
}

const TREE_ROW_H: float = 24.0;

// A scrollable hierarchical list. Visible nodes are flattened each frame (depth
// = indent). Click a chevron to expand/collapse, a row to select; keyboard
// Up/Down move, Right/Left expand/collapse, Enter/Space activate.
export class TreeView extends Widget {
    roots: TreeNode[];
    flat: TreeNode[];   // visible nodes, rebuilt each layout/draw
    depth: int[];
    selected: int;      // index into flat (-1 none)
    hover: int;         // index into flat under the cursor (-1 none)
    scroll: float;      // pixel scroll
    onSelect: fn(TreeNode);
    // Fired when a node is expanded by its chevron or by Right. onSelect does
    // NOT fire on a chevron — expanding and selecting are different acts — so
    // an app that fills a level lazily has no other way to hear about it, and
    // the chevron silently opens a node it never got to populate.
    onExpand: fn(TreeNode);
    // Right-click on a row: (node, absolute x, absolute y). The row under the
    // cursor is selected first, because a context menu that acts on something
    // other than what it is pointing at is how people delete the wrong thing.
    onContext: fn(TreeNode, int, int);
    // ---- presentation ------------------------------------------------------
    //
    // All four default to the look this widget has always had, so an existing
    // caller sees no change. Turning them on together gives the flat sidebar
    // an editor uses — the difference is structural, not chromatic, which is
    // why none of it was reachable from a Theme or a Skin.
    //
    // `card` off: no rounded fill and no border. The tree becomes the panel it
    // sits in rather than a box floating inside it.
    card: bool;
    // `bleed_selection` on: the selection and hover bands span the full widget
    // width with no radius and no inset, so a selected row reads as a row
    // rather than as a button someone left switched on.
    bleed_selection: bool;
    // `typed_levels` on: each row is drawn at the weight and colour its
    // TreeNode.emphasis asks for, so depth is scannable without reading.
    typed_levels: bool;
    // `quiet_chevrons` on: a filled triangle at on_surface_subtle instead of
    // two full-strength strokes. At a schema's row count the loud version is a
    // column of black arrows down the left edge.
    quiet_chevrons: bool;
    // Row height and per-level indent. Defaults are the historical 24/16; an
    // editor-style sidebar is tighter.
    row_h: float;
    indent_w: float;

    view_w: float;
    view_h: float;
    // Widest row drawn, in content pixels (indent + label). Measured during
    // render, because measuring every label needs a Painter and a tree holding
    // a schema is thousands of nodes — only the visible ones are ever measured.
    content_w: float;

    fn init() {
        super.init();
        this.roots = [];
        this.flat = [];
        this.depth = [];
        this.selected = -1;
        this.hover = -1;
        this.scroll = 0;
        this.focusable = true;
        this.card = true;
        this.bleed_selection = false;
        this.typed_levels = false;
        this.quiet_chevrons = false;
        this.row_h = TREE_ROW_H;
        this.indent_w = 16.0;
        this.view_w = 240;
        this.view_h = 240;
        this.content_w = 0;
        // Horizontal only. A deep tree of long identifiers — a schema qualified
        // database name, a 60-character table — runs off the right edge of a
        // fixed-width dock, and the alternative to scrolling it is eliding the
        // end of every name, which is the half a DBA needs.
        this.add_scrollbar(SIDE.BOTTOM);
    }

    // The horizontal bar reads this; vertical scrolling stays on `scroll`,
    // which predates the base-widget offsets and is what row_at() works in.
    override fn scroll_content_w(): float {
        if (this.content_w < this.bounds.w) { return this.bounds.w; }
        return this.content_w;
    }

    fn add_root(n: TreeNode) { this.roots.push(n); }

    fn flatten(n: TreeNode, d: int) {
        this.flat.push(n);
        this.depth.push(d);
        if (n.expanded) {
            for (let c in n.children) { this.flatten(c, d + 1); }
        }
    }

    fn rebuild() {
        this.flat = [];
        this.depth = [];
        for (let r in this.roots) { this.flatten(r, 0); }
        if (this.selected >= this.flat.len) { this.selected = this.flat.len - 1; }
    }

    fn cur(): TreeNode {
        if (this.selected >= 0 && this.selected < this.flat.len) { return this.flat[this.selected]; }
        return null;
    }

    override fn measure(s: Painter, th: Theme): Size {
        this.rebuild();
        return Size(this.view_w, this.view_h);
    }

    fn clamp_scroll() {
        let content = this.row_h * this.flat.len as float + 4;
        let maxs = content - this.bounds.h;
        if (maxs < 0) { maxs = 0; }
        if (this.scroll > maxs) { this.scroll = maxs; }
        if (this.scroll < 0) { this.scroll = 0; }
    }

    // Ink and weight for one row. Split out because the emphasis table is
    // worth reading as a table, and because render() is long enough already.
    fn row_ink(th: Theme, n: TreeNode, selected: bool): int {
        if (!this.typed_levels) { return th.on_surface; }
        // A selected row always takes full ink: it is the thing being looked
        // at, and a muted leaf that stays muted under the selection band reads
        // as disabled rather than as chosen.
        if (selected) { return th.on_surface; }
        if (n.emphasis == TN.MUTED) { return th.on_surface_muted; }
        if (n.emphasis == TN.GROUP) { return th.on_surface_subtle; }
        return th.on_surface;
    }

    fn row_weight(n: TreeNode): WEIGHT {
        if (!this.typed_levels) { return WEIGHT.REG; }
        if (n.emphasis == TN.STRONG) { return WEIGHT.BOLD; }
        if (n.emphasis == TN.MEDIUM || n.emphasis == TN.GROUP) { return WEIGHT.MED; }
        return WEIGHT.REG;
    }

    override fn render(s: Painter, th: Theme) {
        let win = this.win;
        if (win == null) { return; }
        this.rebuild();
        this.clamp_scroll();

        // The card. Off means this widget paints no ground of its own and the
        // panel behind it shows through — which is the whole point: the tree
        // becomes the sidebar instead of a box inside it.
        let radius = 0.0;
        if (this.card) {
            radius = th.radius_md;
            s.fill_round(this.bounds, radius, th.surface_raised);
            s.stroke_round(this.bounds, radius, 1, th.border);
        }
        if (this.focused) { win.skin.focus.paint(s, th, this.bounds, radius); }
        s.clip_push(this.bounds, radius);

        let rh = this.row_h;
        // A bled row starts at the widget's top edge; a carded one is inset by
        // 2px so its rounded band clears the border.
        let y0 = this.bounds.y;
        if (!this.bleed_selection) { y0 += 2.0; }

        let widest = 0.0;
        for (let i in 0..this.flat.len) {
            let ry = y0 - this.scroll + (i as float) * rh;
            if (ry + rh < this.bounds.y || ry > this.bounds.bottom()) { continue; }
            let n = this.flat[i];
            let d = this.depth[i];
            let selected = i == this.selected;

            // Selection / hover band.
            let band = 0;
            if (selected) { band = th.selection; }
            else if (i == this.hover) {
                // Same weight as DataTable's hover row, so a tree and a grid
                // side by side track the cursor identically. Against a
                // borderless tree the ground is the panel, not surface_raised.
                let under = th.surface_raised;
                if (!this.card) { under = th.surface_sunken; }
                band = mix(under, th.on_surface, 0.04);
            }
            if (band != 0) {
                if (this.bleed_selection) {
                    s.fill(Rect(this.bounds.x, ry, this.bounds.w, rh), band);
                } else {
                    s.fill_round(Rect(this.bounds.x + 2, ry, this.bounds.w - 4, rh - 2),
                                 th.radius_sm, band);
                }
            }

            let ind = 10.0 + (d as float) * this.indent_w;
            let cx = this.bounds.x + ind - this.scroll_off_x;
            let cy = ry + rh / 2.0;
            if (!n.leaf()) {
                if (this.quiet_chevrons) {
                    // A filled triangle in the subtle ink. Quiet enough to
                    // ignore while reading names, present when looked for.
                    let cc = th.on_surface_subtle;
                    if (n.expanded) {
                        s.polygon([cx - 4.0, cx + 4.0, cx], [cy - 2.0, cy - 2.0, cy + 3.0], cc);
                    } else {
                        s.polygon([cx - 2.0, cx + 3.0, cx - 2.0], [cy - 4.0, cy, cy + 4.0], cc);
                    }
                } else {
                    let on = th.on_surface;
                    if (n.expanded) {
                        s.line_w(cx - 4, cy - 2, cx, cy + 2, 2, on);
                        s.line_w(cx, cy + 2, cx + 4, cy - 2, 2, on);
                    } else {
                        s.line_w(cx - 2, cy - 4, cx + 2, cy, 2, on);
                        s.line_w(cx + 2, cy, cx - 2, cy + 4, 2, on);
                    }
                }
            }

            let tx = this.bounds.x + ind + 14 - this.scroll_off_x;
            let ink = this.row_ink(th, n, selected);
            let weight = this.row_weight(n);

            // A group row is a caption, so it is set smaller as well as lighter.
            let small = this.typed_levels && n.emphasis == TN.GROUP;
            if (small) { s.push_font(th.text_xs, weight); }
            s.set_weight(weight);

            let tw = s.text_width(n.label);
            if (ind + 14 + tw + 8 > widest) { widest = ind + 14 + tw + 8; }
            // The rect is the row's own width from the text's left edge, not
            // the widget's: with a horizontal offset the text may start left of
            // the widget and text_in would otherwise clip it away.
            s.text_in(Rect(tx, ry, tw + 4, rh), 0, n.label, ink);

            s.set_weight(WEIGHT.REG);
            if (small) { s.pop_font(); }

            // Status dot at the right edge, inside any vertical scrollbar.
            if (n.dot != 0) { s.circle(this.bounds.right() - 12.0, cy, 3.5, n.dot); }
        }
        s.clip_pop();
        this.content_w = widest;
        this.scroll_clamp();
        this.paint_scrollbars(s, th);
    }

    fn row_at(py: int): int {
        // Must mirror render()'s y0 exactly — a bled row starts at the top
        // edge, a carded one 2px in — or a click lands on the wrong row.
        let y0 = this.bounds.y;
        if (!this.bleed_selection) { y0 += 2.0; }
        // back into row-index space, so the divide truncates here
        let r = ((py as float - y0 + this.scroll) / this.row_h) as int;
        if (r < 0 || r >= this.flat.len) { return -1; }
        return r;
    }

    // Hover tracking rides on hit-testing, the same way DataTable's does: the
    // window hit-tests on every motion event, so there is no second traversal.
    override fn hit(px: int, py: int): Widget {
        if (this.disabled || !contains(this.bounds, px, py)) { return null; }
        let h = this.row_at(py);
        // Don't leave a row highlighted while the cursor is over the scrollbar.
        if (this.scrollbar_hit(px, py)) { h = -1; }
        if (h != this.hover) { this.hover = h; this.invalidate(); }
        return this;
    }

    override fn on_hover_leave(): bool {
        if (this.hover != -1) { this.hover = -1; return true; }
        return false;
    }

    override fn on_context(x: int, y: int): bool {
        let i = this.row_at(y);
        if (i < 0) { return false; }
        this.selected = i;
        this.invalidate();
        if (this.onContext != null) { this.onContext(this.flat[i], x, y); }
        return true;
    }

    override fn on_click(x: int, y: int): bool {
        // The bar first, or a press on the thumb selects whatever row is behind
        // it. TreeView overrides on_click, so the base's scrollbar handling has
        // to be called explicitly.
        if (this.scrollbar_press(x, y)) { return true; }
        let i = this.row_at(y);
        if (i < 0) { return false; }
        this.selected = i;
        let n = this.flat[i];
        let d = this.depth[i];
        let chev = this.bounds.x + 10.0 + (d as float) * this.indent_w - this.scroll_off_x;
        if (!n.leaf() && x as float < chev + 12.0) {
            n.expanded = !n.expanded;
            if (n.expanded && this.onExpand != null) { this.onExpand(n); }
        } else if (this.onSelect != null) {
            this.onSelect(n);
        }
        return true;
    }

    override fn on_key(k: int, ch: string): bool {
        if (k == KEY_DOWN) {
            if (this.selected < this.flat.len - 1) { this.selected += 1; }
            return true;
        }
        if (k == KEY_UP) {
            if (this.selected > 0) { this.selected -= 1; }
            return true;
        }
        if (k == KEY_RIGHT) {
            let n = this.cur();
            if (n != null && !n.leaf() && !n.expanded) {
                n.expanded = true;
                if (this.onExpand != null) { this.onExpand(n); }
            }
            return true;
        }
        if (k == KEY_LEFT) {
            let n = this.cur();
            if (n != null && !n.leaf() && n.expanded) { n.expanded = false; }
            return true;
        }
        if (k == KEY_ENTER || k == KEY_SPACE) {
            let n = this.cur();
            if (n != null && this.onSelect != null) { this.onSelect(n); }
            return true;
        }
        return false;
    }

    override fn on_scroll(delta: int): bool {
        // Shift+wheel pans, the convention everywhere a horizontal axis exists.
        if (this.win != null && (this.win.mods & MOD_SHIFT) != 0) {
            this.scroll_off_x += (delta as float) * 24.0;
            this.scroll_clamp();
            return true;
        }
        this.scroll += (delta as float) * this.row_h;
        this.clamp_scroll();
        return true;
    }

    override fn drop_handlers() {
        this.onSelect = null;
        this.onExpand = null;
        this.onContext = null;
    }
}

// ------------------------------------------------------- Table (DataGrid)

// One column of a Table. `width` is fixed pixels.
export class TableColumn {
    title: string;
    width: float;
    align: ALIGN;
    sortable: bool;

    fn init(title: string, width: float) {
        this.title = title;
        this.width = width;
        this.align = ALIGN.LEFT;
        this.sortable = true;
    }
}

const TBL_HDR_H: float = 30.0;
const TBL_ROW_H: float = 28.0;
const TBL_FOOT_H: float = 36.0;

// A DataGrid over string rows with a built-in search box, sortable columns,
// pagination, single-row selection, and an optional trailing actions cell.
// The Table owns its data (rows), so search/sort/paginate operate on a `view`
// index list without the app re-supplying data.
export class Table extends Widget {
    columns: TableColumn[];
    rows: string[][];
    view: int[];            // filtered + sorted indices into rows
    query: string;
    sort_col: int;          // -1 = unsorted
    sort_asc: bool;
    page: int;
    page_size: int;
    selected: int;          // index into rows (full model), -1 none
    hover_row: int;         // view-relative visible row, -1
    onSelect: fn(int);
    actions: string[];      // per-row action labels (trailing cell)
    action_w: float;        // width of the actions cell (0 = none)
    onAction: fn(int, int); // (row index in full model, action index)
    search: SearchField;
    prev_btn: Button;
    next_btn: Button;

    fn init(columns: TableColumn[]) {
        super.init();
        this.columns = columns;
        this.rows = [];
        this.view = [];
        this.query = "";
        this.sort_col = -1;
        this.sort_asc = true;
        this.page = 0;
        this.page_size = 8;
        this.selected = -1;
        this.hover_row = -1;
        this.actions = [];
        this.action_w = 0;
        this.focusable = true;
        this.search = new SearchField("Search");
        this.prev_btn = new Button("Prev");
        this.next_btn = new Button("Next");
        this.add(this.search);
        this.add(this.prev_btn);
        this.add(this.next_btn);
        let self = this;
        this.search.onChange = (q) => { self.set_query(q); };
        this.prev_btn.onClick = (b) => { self.go_page(-1); };
        this.next_btn.onClick = (b) => { self.go_page(1); };
    }

    fn set_rows(rows: string[][]) {
        this.rows = rows;
        this.selected = -1;
        this.apply();
    }

    fn set_actions(labels: string[]) {
        this.actions = labels;
        this.action_w = (labels.len as float) * 64.0;
    }

    fn set_query(q: string) {
        this.query = q;
        this.page = 0;
        this.apply();
        this.invalidate();
    }

    // rebuild `view`: filter by query, then sort by sort_col.
    fn apply() {
        this.view = [];
        for (let i in 0..this.rows.len) {
            if (this.query.len == 0) { this.view.push(i); }
            else {
                let hit = false;
                for (let c in this.rows[i]) {
                    if (contains_ci(c, this.query)) { hit = true; break; }
                }
                if (hit) { this.view.push(i); }
            }
        }
        if (this.sort_col >= 0) { this.sort_view(); }
        let mp = this.max_page();
        if (this.page > mp) { this.page = mp; }
    }

    fn cell(row: int, col: int): string {
        if (col < this.rows[row].len) { return this.rows[row][col]; }
        return "";
    }

    // insertion sort of `view` by the active column (stable enough for a grid).
    fn sort_view() {
        let c = this.sort_col;
        for (let i in 1..this.view.len) {
            let v = this.view[i];
            let j = i - 1;
            while (j >= 0) {
                let cmp = str_cmp(this.cell(this.view[j], c), this.cell(v, c));
                if (!this.sort_asc) { cmp = -cmp; }
                if (cmp > 0) { this.view[j + 1] = this.view[j]; j -= 1; }
                else { break; }
            }
            this.view[j + 1] = v;
        }
    }

    fn max_page(): int {
        if (this.view.len == 0) { return 0; }
        let mp = (this.view.len - 1) / this.page_size;
        return mp;
    }

    fn go_page(delta: int) {
        this.page += delta;
        if (this.page < 0) { this.page = 0; }
        let mp = this.max_page();
        if (this.page > mp) { this.page = mp; }
        this.invalidate();
    }

    fn toggle_sort(c: int) {
        if (this.sort_col == c) { this.sort_asc = !this.sort_asc; }
        else { this.sort_col = c; this.sort_asc = true; }
        this.apply();
        this.invalidate();
    }

    fn grid_w(): float {
        let w = 0.0;
        for (let col in this.columns) { w += col.width; }
        return w + this.action_w;
    }

    fn search_h(): float { return 34.0; }

    override fn measure(s: Painter, th: Theme): Size {
        let w = this.grid_w();
        if (w < 240) { w = 240; }
        let h = this.search_h() + TBL_HDR_H + (this.page_size as float) * TBL_ROW_H + TBL_FOOT_H;
        return Size(w, h);
    }

    override fn arrange(s: Painter, th: Theme, r: Rect) {
        this.layout_to(r);
        let fh = s.font_height();
        // search box on the top-right
        let sw = 200.0;
        if (sw > r.w - 16) { sw = r.w - 16; }
        this.search.arrange(s, th, Rect(r.right() - sw - 8, r.y + 4, sw, fh + 12));
        // footer buttons on the bottom-right
        let by = r.bottom() - TBL_FOOT_H + 4;
        let bw = 64.0;
        this.next_btn.arrange(s, th, Rect(r.right() - bw - 8, by, bw, TBL_FOOT_H - 10));
        this.prev_btn.arrange(s, th, Rect(r.right() - 2 * bw - 16, by, bw, TBL_FOOT_H - 10));
    }

    fn col_x(i: int): float {
        let x = this.bounds.x;
        for (let k in 0..i) { x += this.columns[k].width; }
        return x;
    }

    fn body_top(): float { return this.bounds.y + this.search_h() + TBL_HDR_H; }
    fn footer_top(): float { return this.bounds.bottom() - TBL_FOOT_H; }

    fn draw_cell(s: Painter, col: TableColumn, cx: float, cw: float, y: float, h: float, text: string, color: int) {
        let tw = s.text_width(text);
        let pad = 8.0;
        if (col.align == ALIGN.CENTER) { pad = (cw - tw) / 2.0; }
        else if (col.align == ALIGN.RIGHT) { pad = cw - tw - 8.0; }
        if (pad < 4.0) { pad = 4.0; }
        s.text_in(Rect(cx, y, cw, h), pad, text, color);
    }

    override fn render(s: Painter, th: Theme) {
        s.fill_round(this.bounds, th.radius_md, th.surface_raised);
        s.stroke_round(this.bounds, th.radius_md, 1, th.border);
        // --- header ---
        let hy = this.bounds.y + this.search_h();
        s.fill(Rect(this.bounds.x, hy, this.bounds.w, TBL_HDR_H), th.surface_sunken);
        s.set_weight(WEIGHT.BOLD);
        for (let i in 0..this.columns.len) {
            let col = this.columns[i];
            let cx = this.col_x(i);
            let label = col.title;
            this.draw_cell(s, col, cx, col.width, hy, TBL_HDR_H, label, th.on_surface);
            if (this.sort_col == i) {
                let ax = cx + col.width - 14.0;
                let ay = hy + TBL_HDR_H / 2.0;
                if (this.sort_asc) {
                    s.line_w(ax - 3, ay + 2, ax, ay - 2, 2, th.primary);
                    s.line_w(ax, ay - 2, ax + 3, ay + 2, 2, th.primary);
                } else {
                    s.line_w(ax - 3, ay - 2, ax, ay + 2, 2, th.primary);
                    s.line_w(ax, ay + 2, ax + 3, ay - 2, 2, th.primary);
                }
            }
        }
        s.set_weight(WEIGHT.REG);
        s.line(this.bounds.x, hy + TBL_HDR_H, this.bounds.right(), hy + TBL_HDR_H, th.divider);
        // --- body (current page slice of view) ---
        let start = this.page * this.page_size;
        let by = this.body_top();
        s.clip_push(Rect(this.bounds.x, by, this.bounds.w, (this.page_size as float) * TBL_ROW_H), 0);
        let act_x = this.bounds.right() - this.action_w;
        for (let r in 0..this.page_size) {
            let vi = start + r;
            if (vi >= this.view.len) { break; }
            let ri = this.view[vi];
            let ry = by + (r as float) * TBL_ROW_H;
            if (ri == this.selected) {
                s.fill(Rect(this.bounds.x, ry, this.bounds.w, TBL_ROW_H), th.selection);
            } else if (r == this.hover_row) {
                s.fill(Rect(this.bounds.x, ry, this.bounds.w, TBL_ROW_H),
                       mix(th.surface_raised, th.on_surface, 0.04));
            }
            for (let i in 0..this.columns.len) {
                let col = this.columns[i];
                this.draw_cell(s, col, this.col_x(i), col.width, ry, TBL_ROW_H,
                               this.cell(ri, i), th.on_surface);
            }
            // trailing action cell
            if (this.action_w > 0.0) {
                let aw = this.action_w / this.actions.len as float;
                for (let a in 0..this.actions.len) {
                    let axr = Rect(act_x + (a as float) * aw, ry, aw, TBL_ROW_H);
                    s.text_in(axr, 6, this.actions[a], th.primary);
                }
            }
        }
        s.clip_pop();
        // --- footer ---
        let fy = this.footer_top();
        s.line(this.bounds.x, fy, this.bounds.right(), fy, th.divider);
        let mp = this.max_page();
        let label = "Page " + (this.page + 1) + " of " + (mp + 1)
                  + "  (" + this.view.len + " rows)";
        s.text_in(Rect(this.bounds.x + 8, fy, this.bounds.w / 2, TBL_FOOT_H), 0,
                  label, th.on_surface_muted);
        // children (search box + prev/next buttons)
        this.search.draw(s, th);
        this.prev_btn.draw(s, th);
        this.next_btn.draw(s, th);
    }

    // The Table paints its header/body/footer in draw() and also has child
    // widgets (search box, page buttons). On a dirty-region repaint the base
    // draw_within would clear the rect and redraw ONLY the children — erasing
    // the grid until the next full redraw (the "table vanishes on hover" bug).
    // Repaint the whole widget instead whenever the dirty rect touches it.
    override fn render_within(s: Painter, th: Theme, d: Rect) {
        let b = this.bounds;
        if (b.right() <= d.x || d.right() <= b.x ||
            b.bottom() <= d.y || d.bottom() <= b.y) { return; }
        this.draw(s, th);
    }

    override fn on_click(x: int, y: int): bool {
        let hy = this.bounds.y + this.search_h();
        // header → sort
        if (y as float >= hy && y as float < hy + TBL_HDR_H) {
            for (let i in 0..this.columns.len) {
                let cx = this.col_x(i);
                if (x as float >= cx && x as float < cx + this.columns[i].width && this.columns[i].sortable) {
                    this.toggle_sort(i);
                    return true;
                }
            }
            return true;
        }
        // body → select or action
        let by = this.body_top();
        if (y as float >= by && y as float < by + (this.page_size as float) * TBL_ROW_H) {
            let r = ((y as float - by) / TBL_ROW_H) as int;
            let vi = this.page * this.page_size + r;
            if (vi >= this.view.len) { return true; }
            let ri = this.view[vi];
            let act_x = this.bounds.right() - this.action_w;
            if (this.action_w > 0.0 && x as float >= act_x) {
                let aw = this.action_w / this.actions.len as float;
                let a = ((x as float - act_x) / aw) as int;
                if (a >= 0 && a < this.actions.len && this.onAction != null) {
                    this.onAction(ri, a);
                }
                return true;
            }
            this.selected = ri;
            if (this.onSelect != null) { this.onSelect(ri); }
            return true;
        }
        return true;
    }

    override fn on_key(k: int, ch: string): bool {
        if (k == KEY_DOWN) { this.move_sel(1); return true; }
        if (k == KEY_UP) { this.move_sel(-1); return true; }
        if (k == KEY_RIGHT) { this.go_page(1); return true; }
        if (k == KEY_LEFT) { this.go_page(-1); return true; }
        return false;
    }

    // move selection within the view, following pages.
    fn move_sel(delta: int) {
        // current view index of selection
        let vi = -1;
        for (let i in 0..this.view.len) { if (this.view[i] == this.selected) { vi = i; } }
        vi += delta;
        if (vi < 0) { vi = 0; }
        if (vi >= this.view.len) { vi = this.view.len - 1; }
        if (vi < 0) { return; }
        this.selected = this.view[vi];
        this.page = vi / this.page_size;
        if (this.onSelect != null) { this.onSelect(this.selected); }
        this.invalidate();
    }

    override fn hit(px: int, py: int): Widget {
        // let the child search box / buttons win, else this.
        let n = this.children.len;
        for (let i in 0..n) {
            let c = this.children[n - 1 - i];
            let f = c.hit(px, py);
            if (f != null) { return f; }
        }
        if (contains(this.bounds, px, py)) {
            let by = this.body_top();
            let hr = -1;
            if (py as float >= by && py as float < by + (this.page_size as float) * TBL_ROW_H) {
                hr = ((py as float - by) / TBL_ROW_H) as int;
            }
            if (hr != this.hover_row) { this.hover_row = hr; this.invalidate(); }
            return this;
        }
        return null;
    }

    override fn on_hover_leave(): bool {
        if (this.hover_row != -1) { this.hover_row = -1; return true; }
        return false;
    }

    override fn drop_handlers() {
        this.onSelect = null;
        this.onAction = null;
    }
}
