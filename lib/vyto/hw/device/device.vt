// vyto/hw/device — generic character-device byte I/O, the Vyto-way (docs/HARDWARE.md).
// The escape hatch: open ANY device node whose contract is read()/write() and move
// bytes, non-blocking, folding into a PollSet like every other streaming device.
// Covers hidraw, tty, /dev/random, /dev/cec*, pipes, and friends.
//
//     let d = device_open("/dev/urandom", READ, false);
//     let seed = d.read(16);                      // 16 random bytes
//
//     let hid = device_open("/dev/hidraw0", RDWR, true);   // non-blocking
//     let ps = new PollSet();
//     ps.addFd(hid.pollFd(), POLL_READ);
//     if (ps.wait(-1) > 0) { handle(hid.read(64)); }
//
// This does NOT understand ioctl-driven devices (V4L2 /dev/video*, gpiochip, i2c) —
// those need vyto/hw/ioctl or a typed package (vyto/hw/camera, vyto/hw/gpio, ...).
// The fd lives in Device and is closed by deinit.
//
// hid_devices() lists HID devices with the path device_open takes: /dev/hidrawN on
// Linux, the HID interface path on Windows ("\\?\hid#vid_046d&pid_c52b#..."). On
// Windows, keyboards and mice are held by the system and refuse to be opened for
// reading; vendor-defined collections (scanners, scales, custom boards) open fine.
//
// Windows takes any path CreateFile does, including "\\.\" device names and
// named pipes. A non-blocking open there gets a small C thread that reads the device
// into a loopback socket, which is what pollFd() returns (runtime/vyto_win_pump.h);
// a blocking open has no pollFd (-1) and seek() works only on it. Linux + macOS +
// Windows.

#link "ws2_32" if "windows"
#link "setupapi" if "windows"
#link "cfgmgr32" if "windows"

extern "C" {
    fn dev_open(path: cstring, mode: i32, nonblock: i32): i32;
    fn dev_read(fd: i32, buf: cstring, cap: i64): i64;
    fn dev_write(fd: i32, buf: cstring, n: i64): i64;
    fn dev_seek(fd: i32, off: i64, whence: i32): i64;
    fn dev_poll_fd(fd: i32): i32;
    fn dev_raw(fd: i32): i64;
    fn dev_close(fd: i32);

    fn hid_list(): rawptr;
    fn hid_count(h: rawptr): i32;
    fn hid_path(h: rawptr, i: i32): cstring;
    fn hid_name(h: rawptr, i: i32): cstring;
    fn hid_vid(h: rawptr, i: i32): i32;
    fn hid_pid(h: rawptr, i: i32): i32;
    fn hid_free(h: rawptr);
}

// Open modes.
export const READ:   int = 0;
export const WRITE:  int = 1;
export const RDWR:   int = 2;
export const CREATE: int = 3;   // write, creating/truncating the file (0644) — for sinks
// seek() whence values.
export const SEEK_SET: int = 0;
export const SEEK_CUR: int = 1;
export const SEEK_END: int = 2;

// Copy the first `n` bytes of `buf` into a right-sized array.
fn take(buf: byte[], n: int): byte[] {
    if (n <= 0) { return bytes(0); }
    if (n == buf.len) { return buf; }
    let out = bytes(n);
    let i = 0;
    while (i < n) { out[i] = buf[i]; i += 1; }
    return out;
}

// An open device node. Reads/writes are non-blocking when opened with nonblock=true
// (empty read means nothing ready). The fd is closed by deinit (RC: dropping the
// object releases the descriptor).
export class Device {
    fd: i32;
    ended: bool;   // a read hit end of file, or the device went away

    fn init(fd: i32) { this.fd = fd; this.ended = false; }

    fn ensure() { if ((this.fd as int) < 0) { panic("vyto/hw/device: operation on a closed device"); } }
    // False once closed, or once a read found the end (EOF, or the device was
    // removed). Stop polling then: an ended device stays readable for ever.
    fn isValid(): bool { return (this.fd as int) >= 0 && !this.ended; }

    // The fd to register in a PollSet (POLL_READ / POLL_WRITE). -1 for a blocking
    // open on Windows, which has nothing to poll.
    fn pollFd(): int { return dev_poll_fd(this.fd) as int; }
    // What vyto/hw/ioctl takes: the descriptor on POSIX, the HANDLE on Windows.
    fn rawFd(): int { return dev_raw(this.fd) as int; }

    // Read up to `n` bytes; result length is what was available (empty on would-block /
    // EOF / error). Read after a PollSet reports the fd readable for streaming nodes.
    fn read(n: int): byte[] {
        this.ensure();
        if (n <= 0 || this.ended) { return bytes(0); }
        let buf = bytes(n);
        let got = dev_read(this.fd, buf as cstring, n as i64) as int;
        if (got > 0) { return take(buf, got); }
        if (got != -1) { this.ended = true; }   // 0 = end, -2 = failed
        return bytes(0);
    }
    // strbytes, not str(... as cstring): read returns an exactly-sized buffer
    // with no NUL terminator (see vyto/net/socket recvText for the same fix).
    fn readText(n: int): string {
        let b = this.read(n);
        return strbytes(b, b.len);
    }

    // Write bytes; count written (>=0), or a negative encoded status (-1 would-block,
    // -2 error).
    fn write(data: byte[]): int {
        this.ensure();
        return dev_write(this.fd, data as cstring, data.len as i64) as int;
    }
    fn writeText(s: string): int {
        this.ensure();
        return dev_write(this.fd, s.cstr(), s.len as i64) as int;
    }

    // Reposition a seekable node (e.g. a sysfs/EDID file). New offset, or -1.
    fn seek(off: int, whence: int): int {
        this.ensure();
        return dev_seek(this.fd, off as i64, whence as i32) as int;
    }

    fn close() {
        if ((this.fd as int) >= 0) { dev_close(this.fd); this.fd = -1 as i32; }
    }
    deinit { this.close(); }
}

// Open a device node. `mode` is READ / WRITE / RDWR; `nonblock` opens O_NONBLOCK (for
// streaming nodes driven through a PollSet). Null on failure (missing node, no
// permission).
export fn device_open(path: string, mode: int, nonblock: bool): Device {
    let nb = 0;
    if (nonblock) { nb = 1; }
    let fd = dev_open(path.cstr(), mode as i32, nb as i32) as int;
    if (fd < 0) { return null; }
    return new Device(fd as i32);
}

// A HID device present on this machine (a snapshot).
export class HidInfo {
    path: string;   // what device_open takes
    name: string;   // the product name it reports
    vid: int;       // USB vendor id (0 when not USB)
    pid: int;       // USB product id

    fn init(path: string, name: string, vid: int, pid: int) {
        this.path = path;
        this.name = name;
        this.vid = vid;
        this.pid = pid;
    }

    // "vvvv:pppp" in lowercase hex.
    fn id(): string { return hex4(this.vid) + ":" + hex4(this.pid); }
}

// Every HID device present, sorted by path on Linux. Empty, never null, when
// there are none or the platform cannot list them (macOS).
export fn hid_devices(): HidInfo[] {
    let out: HidInfo[] = [];
    let h = hid_list();
    if (h == null) { return out; }
    let n = hid_count(h) as int;
    for (let k in 0..n) {
        let i = k as i32;
        out.push(new HidInfo(str(hid_path(h, i)), str(hid_name(h, i)), hid_vid(h, i) as int,
                             hid_pid(h, i) as int));
    }
    hid_free(h);
    return out;
}

// Lowercase 4-digit hex (USB ids are 16-bit).
fn hex4(v: int): string {
    let digits = "0123456789abcdef";
    let out = "";
    let shift = 12;
    while (shift >= 0) {
        let nib = (v >> shift) & 0xF;
        out = out + digits.slice(nib, nib + 1);
        shift -= 4;
    }
    return out;
}
