// The Windows exe's identity for `vytoc build --manifest` (see
// lib/vyto/win/manifest.vt): what Explorer shows on Properties → Details.
import { WinManifest } from "vyto/win/manifest";

fn main() {
    let m = new WinManifest("Vyto Café POS")
        .version("0.1.0")
        .company("Vyto")
        .description("Point of sale proof of concept");
    m.emit();
}
