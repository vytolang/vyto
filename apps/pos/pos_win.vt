// Vyto Café POS, Windows entry: Direct2D + DirectWrite (Segoe UI, ClearType),
// no blend2d. Build:
//
//   ./vytoc build apps/pos/pos_win.vt --target windows-x64 --release --audit \
//       --manifest apps/pos/pos_manifest.vt -o pos.exe
//
// The screen itself is apps/pos/posapp.vt, shared with the Linux entry.
import { Window } from "vyto/ui";
import { D2DPainter, d2d_usable } from "vyto/win/d2d";
import { buildPos } from "posapp";

fn main() {
    let win = new Window("Vyto Café — POS", 1280, 800);
    // A till must open even where Direct2D cannot draw (a broken graphics
    // driver, some remote sessions, Wine): fall back to the toolkit's built-in
    // lean painter — plainer, but every button still works.
    if (d2d_usable(win.surface())) {
        win.use_painter(new D2DPainter(win.surface(), 15.0));
    } else {
        print("Direct2D cannot draw here; using the basic renderer");
    }
    win.theme.apply_scale(win.scale);
    buildPos(win);
    win.run();
}
