// A desktop preview of the story screen, so its chrome can be looked at
// without a phone in hand.
//
//     ./vytoc run apps/hn_android/preview.vt
//
// It imports hnrows and hnfmt only — both are plain vyto/ui, no Android tier —
// and feeds them canned data. What it will NOT tell you is anything about
// AndroidPainter: this draws through the lean SurfacePainter, so weights and
// stroke widths are approximations of what the device does. Geometry, wrapping
// and hit rects are the same code.
//
// Not part of any suite: it opens a window and waits for a human.

import { Column, ScrollView, Padding, Window, skin_material, theme_material } from "vyto/ui";
import { TopBar, HeaderCard, CommentRow, MoreRow } from "hnrows";
import { to_text, meta_line } from "hnfmt";

fn main() {
    let win = new Window("HN story preview", 420, 860);
    win.skin = skin_material();
    win.theme = theme_material();

    let bar = new TopBar("Comments", "");
    bar.onBack = () => { print("back"); };

    let head = new HeaderCard(
        "Changes at Google DeepMind: Demis Hassabis from CEO to Chair, Jeff Dean departs",
        meta_line(true, 812, "colesantiago", 0, false, 0),
        "",
        "https://blog.google/technology/ai/changes-at-deepmind/");

    let col = new Column([]).pad(0.0).gap(0.0);
    col.add(head);
    col.add(new CommentRow(0, "tptacek · 3h",
        to_text("<p>This is the shape a top-level comment takes: long enough to wrap "
              + "several times at phone width, with an &amp; entity and an "
              + "<i>italic</i> run to prove the strip and unescape run in the right "
              + "order.</p><p>And a second paragraph, which only survives if &lt;p&gt; "
              + "became a blank line before the tags came out.</p>")));
    col.add(new CommentRow(1, "jacquesm · 2h", to_text("A reply, one level in.")));
    col.add(new CommentRow(2, "dang · 1h",
        to_text("Two levels in — the indent stops growing at six, so a deep thread "
              + "never runs out of width.")));
    col.add(new CommentRow(3, "pg · 44m", to_text("Three.")));
    let more = new MoreRow("thread truncated — read the rest on HN");
    more.onTap = () => { print("open on HN"); };
    col.add(more);

    let sv = new ScrollView(new Padding(0.0, col));
    sv.grow = 1;
    win.root = new Column([bar, sv]).pad(0.0).gap(0.0);
    win.run();
}
