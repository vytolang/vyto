// hnfmt — the small string and text-measurement helpers the HN screens need.
//
// Two of these exist only because the toolkit has no equivalent:
//
//   wrap()  — Text.wrap_lines is private to vyto/ui/display, and nothing in
//             the toolkit elides. A story title has to fit two lines and a
//             comment has to fill as many as it needs, both from the same
//             code, so the wrapper lives here and the row widgets call it.
//   to_text() — HN comment bodies are HTML fragments, not text.

import { StringBuilder, stringBuilder, left } from "vyto/util/text";
import { html_strip_tags, html_unescape } from "vyto/util/html";
import { unixSec } from "vyto/util/time";
import { Painter } from "vyto/ui";

// "4h", "2d" — the HN column, which is a width the phone cannot spare on
// "4 hours ago". Anything older than a week is dated by weeks, because a feed
// query only ever reaches back that far.
export fn rel_time(t: int): string {
    if (t <= 0) { return ""; }
    let d = (unixSec() as int) - t;
    if (d < 60) { return "now"; }
    if (d < 3600) { return str(d / 60) + "m"; }
    if (d < 86400) { return str(d / 3600) + "h"; }
    if (d < 604800) { return str(d / 86400) + "d"; }
    return str(d / 604800) + "w";
}

// "news.ycombinator.com" out of a full URL, minus a leading "www.". Empty for
// a text post, which is what the row uses to decide whether to draw the chip.
export fn host_of(url: string): string {
    if (url.len == 0) { return ""; }
    let i = url.index_of("://");
    if (i < 0) { return ""; }
    let rest = url.slice(i + 3, url.len);
    let j = rest.index_of("/");
    let h = rest;
    if (j >= 0) { h = rest.slice(0, j); }
    if (h.starts_with("www.")) { h = h.slice(4, h.len); }
    return h;
}

// Only http(s) reaches an intent. HN itself will not host a javascript: or a
// data: url, but the url field is user-supplied and this is the one place it
// leaves the app — see view.vt:76, which makes the same check for the same
// reason on the server side.
export fn safe_url(url: string): bool {
    return url.starts_with("http://") || url.starts_with("https://");
}

// An HTML fragment as plain text. HN comments arrive as HTML: <p> between
// paragraphs, <i>, <a href> for links, and entities throughout.
//
// The <p> substitution has to happen BEFORE the tags come out, or every
// paragraph break in the thread is lost and a long comment becomes one wall.
// The order is the whole point of the function.
export fn to_text(html: string): string {
    if (html.len == 0) { return ""; }
    let s = html.replace("<p>", "\n\n");
    s = s.replace("<p/>", "\n\n");
    s = s.replace("</p>", "");
    s = s.replace("<br>", "\n");
    s = s.replace("<br/>", "\n");
    return html_unescape(html_strip_tags(s)).trim();
}

// Wrap `text` to `max_w`, at most `max_lines` lines (0 = unlimited). The last
// line is elided with an ellipsis when the budget cuts the text short.
//
// Word wrap only, like Text.wrap_lines: a single unbroken token longer than
// the line is allowed to overflow rather than being chopped mid-word. The one
// place that bites in practice is a bare URL in a comment, and breaking those
// mid-token reads worse than letting them run.
export fn wrap(s: Painter, text: string, max_w: float, max_lines: int): string[] {
    let out: string[] = [];
    if (text.len == 0 || max_w <= 0.0) { return out; }

    for (let para in text.split("\n")) {
        if (max_lines > 0 && out.len >= max_lines) { break; }
        if (para.trim().len == 0) {
            // A blank line is a paragraph break and is kept — that is what the
            // <p> substitution in to_text() was for.
            out.push("");
            continue;
        }
        let line = "";
        for (let word in para.split(" ")) {
            if (word.len == 0) { continue; }
            let cand = word;
            if (line.len > 0) { cand = line + " " + word; }
            if (s.text_width(cand) <= max_w || line.len == 0) {
                line = cand;
                continue;
            }
            out.push(line);
            line = word;
            if (max_lines > 0 && out.len >= max_lines) { break; }
        }
        if (max_lines > 0 && out.len >= max_lines) {
            // Budget spent mid-paragraph: whatever is in `line` never lands,
            // so the ellipsis goes on the last line that did.
            elide_last(s, out, max_w);
            return out;
        }
        if (line.len > 0) { out.push(line); }
    }

    if (max_lines > 0 && out.len > max_lines) {
        while (out.len > max_lines) { out.pop(); }
        elide_last(s, out, max_w);
    }
    return out;
}

// Trim the final line until it plus "…" fits. Bytes, not characters — a
// multi-byte tail could be cut mid-sequence, so back up to a lead byte.
fn elide_last(s: Painter, lines: string[], max_w: float) {
    if (lines.len == 0) { return; }
    let line = lines[lines.len - 1];
    let n = line.len;
    while (n > 0 && s.text_width(left(line, n) + "…") > max_w) {
        n = n - 1;
        while (n > 0 && (line[n] & 0xC0) == 0x80) { n = n - 1; }
    }
    lines[lines.len - 1] = left(line, n).trim_end() + "…";
}

// "142 points · tomhow · 4h · 87 comments", with the pieces the API omitted
// left out rather than shown as zero — a job post has no score and no comment
// count, and printing "0 points" for one is a lie the server app already
// avoids.
export fn meta_line(has_score: bool, score: int, by: string, t: int,
                    has_comments: bool, comments: int): string {
    let sb = stringBuilder(64);
    if (has_score) {
        sb.append(str(score));
        sb.append(" points");
    }
    if (by.len > 0) {
        if (sb.len() > 0) { sb.append(" · "); }
        sb.append(by);
    }
    let age = rel_time(t);
    if (age.len > 0) {
        if (sb.len() > 0) { sb.append(" · "); }
        sb.append(age);
    }
    if (has_comments) {
        if (sb.len() > 0) { sb.append(" · "); }
        sb.append(str(comments));
        sb.append(" comments");
    }
    return sb.toString();
}
