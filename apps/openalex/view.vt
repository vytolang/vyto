// view — all HTML for apps/openalex.
//
// Unlike the hackernews reader, nothing here arrives pre-escaped: OpenAlex
// returns plain text for every title, name and abstract, so every interpolated
// value goes through html_escape / html_escape_attr without exception.
//
// Citation histories are drawn as inline SVG rather than pulled from a chart
// library — a bar chart is a handful of <rect>s, and it keeps the page
// self-contained and dependency-free.

import { Store, Work, Author, WorkList, Person, PER_PAGE } from "api";
import { JsonValue } from "vyto/util/json";
import { StringBuilder, stringBuilder } from "vyto/util/text";
import { html_escape, html_escape_attr } from "vyto/util/html";
import { url_encode } from "vyto/util/url";
import { fixed, commas } from "vyto/util/fmt";

const CHART_W: int = 560;
const CHART_H: int = 120;

export class Page {
    status: int;
    body: string;

    fn init(status: int, body: string) {
        this.status = status;
        this.body = body;
    }
}

// ── chrome ───────────────────────────────────────────────────────────────────

fn nav(sb: StringBuilder, current: string) {
    sb.append("<nav><a class=\"brand\" href=\"/\">OA</a>");
    sb.append("<a href=\"/works\"");
    if (current == "works") { sb.append(" class=\"on\""); }
    sb.append(">browse</a>");
    sb.append("<form action=\"/search\" method=\"get\">");
    sb.append("<input name=\"q\" placeholder=\"full-text search\" autocomplete=\"off\">");
    sb.append("<button>search</button></form></nav>");
}

// The footer is the instrument panel: what this process has spent against the
// $0.10/day anonymous budget, and how many bytes of JSON the last page parsed.
fn footer(sb: StringBuilder, store: Store, bytes: int, cost: float) {
    sb.append("<footer>");
    sb.append("parsed <b>").append(commas(bytes)).append("</b> bytes of JSON");
    if (cost > 0.0) { sb.append(" &middot; this call $").append(fixed(cost, 4)); }
    sb.append(" &middot; session $").append(fixed(store.spent, 4));
    sb.append(" of $0.10/day &middot; ").appendInt(store.calls).append(" upstream calls");
    sb.append(" &middot; served by <code>vyto/net/server</code>");
    sb.append("</footer>");
    sb.append("</body></html>\n");
}

fn head(sb: StringBuilder, title: string, current: string) {
    sb.append("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">");
    sb.append("<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">");
    sb.append("<title>").append(html_escape(title)).append("</title>");
    sb.append("<link rel=\"stylesheet\" href=\"/style.css\"></head><body>");
    nav(sb, current);
    sb.append("<main>");
}

export fn error_page(store: Store, status: int, title: string, detail: string): Page {
    let sb = stringBuilder(1024);
    head(sb, title, "");
    sb.append("<h1>").append(html_escape(title)).append("</h1>");
    sb.append("<p class=\"err\">").append(html_escape(detail)).append("</p>");
    sb.append("<p><a href=\"/works\">back to browsing</a></p></main>");
    footer(sb, store, 0, 0.0);
    return new Page(status, sb.toString());
}

// ── bits ─────────────────────────────────────────────────────────────────────

fn author_line(sb: StringBuilder, w: Work) {
    if (w.authors.len == 0) { return; }
    sb.append("<div class=\"authors\">");
    for (let i in 0..w.authors.len) {
        if (i > 0) { sb.append(", "); }
        let a = w.authors[i];
        sb.append("<a href=\"/author/").append(html_escape_attr(a.id)).append("\">");
        sb.append(html_escape(a.name)).append("</a>");
    }
    if (w.n_authors > w.authors.len) {
        sb.append(" <span class=\"dim\">+ ").appendInt(w.n_authors - w.authors.len);
        sb.append(" more</span>");
    }
    sb.append("</div>");
}

fn oa_badge(sb: StringBuilder, w: Work) {
    if (!w.is_oa) { return; }
    sb.append(" <span class=\"oa\">open access");
    if (w.oa_status.len > 0) { sb.append(" &middot; ").append(html_escape(w.oa_status)); }
    sb.append("</span>");
}

// A bar chart with no library: one <rect> per year, height scaled to the peak.
fn chart(sb: StringBuilder, years: int[], counts: int[]) {
    if (years.len == 0) { return; }
    let peak = 1;
    for (let c in counts) { if (c > peak) { peak = c; } }

    let n = years.len;
    let gap = 4;
    let bw = (CHART_W - (n - 1) * gap) / n;
    if (bw < 1) { bw = 1; }

    sb.append("<svg class=\"chart\" viewBox=\"0 0 ").appendInt(CHART_W);
    sb.append(" ").appendInt(CHART_H + 18).append("\" role=\"img\" aria-label=\"citations per year\">");
    for (let i in 0..n) {
        let h = counts[i] * CHART_H / peak;
        if (h < 1 && counts[i] > 0) { h = 1; }
        let x = i * (bw + gap);
        sb.append("<rect x=\"").appendInt(x).append("\" y=\"").appendInt(CHART_H - h);
        sb.append("\" width=\"").appendInt(bw).append("\" height=\"").appendInt(h).append("\">");
        sb.append("<title>").appendInt(years[i]).append(": ").appendInt(counts[i]);
        sb.append(" citations</title></rect>");
        if (n <= 16 || i % 2 == 0) {
            sb.append("<text x=\"").appendInt(x + bw / 2).append("\" y=\"").appendInt(CHART_H + 13);
            sb.append("\" text-anchor=\"middle\">").appendInt(years[i] % 100).append("</text>");
        }
    }
    sb.append("</svg>");
}

fn work_row(sb: StringBuilder, w: Work) {
    sb.append("<li class=\"work\"><div class=\"title\"><a href=\"/work/");
    sb.append(html_escape_attr(w.id)).append("\">").append(html_escape(w.title)).append("</a></div>");
    author_line(sb, w);
    sb.append("<div class=\"meta\">");
    if (w.year > 0) { sb.append("").appendInt(w.year).append(" &middot; "); }
    if (w.kind.len > 0) { sb.append(html_escape(w.kind)).append(" &middot; "); }
    sb.append(commas(w.cited)).append(" citations");
    if (w.venue.len > 0) { sb.append(" &middot; ").append(html_escape(w.venue)); }
    if (w.topic.len > 0) { sb.append(" &middot; <i>").append(html_escape(w.topic)).append("</i>"); }
    oa_badge(sb, w);
    sb.append("</div></li>");
}

fn pager(sb: StringBuilder, base: string, page: int, total: int, per: int) {
    let last = (total + per - 1) / per;
    // OpenAlex refuses page*per-page beyond 10,000 on the basic paging path.
    let cap = 10000 / per;
    if (last > cap) { last = cap; }
    if (last < 1) { last = 1; }

    sb.append("<div class=\"pager\">");
    if (page > 1) {
        sb.append("<a href=\"").append(base).append("p=").appendInt(page - 1).append("\">&larr; prev</a>");
    }
    sb.append("<span>page ").appendInt(page).append(" of ").appendInt(last);
    sb.append(" &middot; ").append(commas(total)).append(" works</span>");
    if (page < last) {
        sb.append("<a href=\"").append(base).append("p=").appendInt(page + 1).append("\">next &rarr;</a>");
    }
    sb.append("</div>");
}

// ── pages ────────────────────────────────────────────────────────────────────

// `filter` and `sort` are passed through to OpenAlex, so the browse page is a
// thin window onto the query language rather than a fixed feed.
export fn render_browse(store: Store, filter: string, sort: string, page: int,
                        per: int, lean: bool): Page {
    let wl = store.browse(filter, sort, page, per, lean);
    if (wl.err.len > 0) { return error_page(store, 502, "upstream unavailable", wl.err); }
    if (wl.works.len == 0) { return error_page(store, 404, "no works", "that query matched nothing"); }

    let sb = stringBuilder(65536);
    head(sb, "OpenAlex — browse", "works");

    sb.append("<form class=\"q\" action=\"/works\" method=\"get\">");
    sb.append("<label>filter <input name=\"filter\" value=\"").append(html_escape_attr(filter));
    sb.append("\" size=\"38\"></label>");
    sb.append("<label>sort <input name=\"sort\" value=\"").append(html_escape_attr(sort));
    sb.append("\" size=\"20\"></label>");
    sb.append("<label>per <input name=\"per\" value=\"").appendInt(per).append("\" size=\"4\"></label>");
    sb.append("<label><input type=\"checkbox\" name=\"lean\" value=\"1\"");
    if (lean) { sb.append(" checked"); }
    sb.append("> lean</label>");
    sb.append("<button>go</button></form>");

    sb.append("<ol class=\"list\" start=\"").appendInt((page - 1) * per + 1).append("\">");
    for (let w in wl.works) { work_row(sb, w); }
    sb.append("</ol>");

    let base = "/works?filter=" + url_encode(filter) + "&sort=" + url_encode(sort)
             + "&per=" + per;
    if (lean) { base = base + "&lean=1"; }
    base = base + "&";
    pager(sb, base, page, wl.total, per);

    sb.append("</main>");
    footer(sb, store, wl.bytes, wl.cost);
    return new Page(200, sb.toString());
}

export fn render_search(store: Store, q: string, page: int, per: int): Page {
    if (q.len == 0) {
        return error_page(store, 400, "empty search", "give me something to look for");
    }
    let wl = store.search(q, page, per);
    if (wl.err.len > 0) { return error_page(store, 502, "upstream unavailable", wl.err); }
    if (wl.works.len == 0) {
        return error_page(store, 404, "nothing found", "no work matches " + q);
    }

    let sb = stringBuilder(65536);
    head(sb, "OpenAlex — " + q, "");
    sb.append("<h1>").append(html_escape(q)).append("</h1>");
    sb.append("<p class=\"dim\">full-text search costs $0.001 a call &mdash; ten times a filter. ");
    sb.append("<a href=\"/works\">browse instead</a></p>");
    sb.append("<ol class=\"list\" start=\"").appendInt((page - 1) * per + 1).append("\">");
    for (let w in wl.works) { work_row(sb, w); }
    sb.append("</ol>");
    pager(sb, "/search?q=" + url_encode(q) + "&per=" + per + "&", page, wl.total, per);
    sb.append("</main>");
    footer(sb, store, wl.bytes, wl.cost);
    return new Page(200, sb.toString());
}

export fn render_work(store: Store, id: string): Page {
    let w = store.work(id);
    if (w == null) {
        if (store.last_status == 404) {
            return error_page(store, 404, "no such work", "OpenAlex has no work " + id);
        }
        return error_page(store, 502, "upstream unavailable",
                          "api.openalex.org did not answer (status " + store.last_status + ")");
    }

    let sb = stringBuilder(32768);
    head(sb, w.title, "");
    sb.append("<article><h1>").append(html_escape(w.title)).append("</h1>");
    author_line(sb, w);

    sb.append("<div class=\"meta\">");
    if (w.year > 0) { sb.append("").appendInt(w.year).append(" &middot; "); }
    if (w.kind.len > 0) { sb.append(html_escape(w.kind)).append(" &middot; "); }
    sb.append(commas(w.cited)).append(" citations &middot; ");
    sb.append(commas(w.n_refs)).append(" references");
    if (w.venue.len > 0) { sb.append(" &middot; ").append(html_escape(w.venue)); }
    if (w.lang.len > 0) { sb.append(" &middot; ").append(html_escape(w.lang)); }
    oa_badge(sb, w);
    sb.append("</div>");

    if (w.doi.len > 0) {
        sb.append("<p><a href=\"").append(html_escape_attr(w.doi)).append("\">");
        sb.append(html_escape(w.doi)).append("</a></p>");
    }

    if (w.abstract.len > 0) {
        sb.append("<h2>abstract</h2><div class=\"abstract\">");
        sb.append(html_escape(w.abstract)).append("</div>");
        sb.append("<p class=\"dim\">reconstructed from an inverted index &mdash; OpenAlex ");
        sb.append("stores abstracts as word&rarr;positions, never as text</p>");
    }

    if (w.years.len > 0) {
        sb.append("<h2>citations per year</h2>");
        chart(sb, w.years, w.counts);
    }

    if (w.topic.len > 0) {
        sb.append("<p class=\"dim\">topic: ").append(html_escape(w.topic)).append("</p>");
    }
    sb.append("<p><a href=\"https://openalex.org/").append(html_escape_attr(w.id));
    sb.append("\">on OpenAlex</a></p></article></main>");
    footer(sb, store, store.last_bytes, 0.0);
    return new Page(200, sb.toString());
}

export fn render_author(store: Store, id: string): Page {
    let p = store.person(id);
    if (p == null) {
        if (store.last_status == 404) {
            return error_page(store, 404, "no such author", "OpenAlex has no author " + id);
        }
        return error_page(store, 502, "upstream unavailable",
                          "api.openalex.org did not answer (status " + store.last_status + ")");
    }

    let sb = stringBuilder(16384);
    head(sb, p.name, "");
    sb.append("<h1>").append(html_escape(p.name)).append("</h1>");
    sb.append("<div class=\"meta\">");
    if (p.inst.len > 0) { sb.append(html_escape(p.inst)).append(" &middot; "); }
    sb.append(commas(p.works_count)).append(" works &middot; ");
    sb.append(commas(p.cited)).append(" citations &middot; ");
    sb.append("h-index ").appendInt(p.h_index).append(" &middot; i10 ").appendInt(p.i10);
    sb.append("</div>");
    if (p.orcid.len > 0) {
        sb.append("<p><a href=\"").append(html_escape_attr(p.orcid)).append("\">ORCID</a></p>");
    }

    if (p.years.len > 0) {
        sb.append("<h2>citations per year</h2>");
        chart(sb, p.years, p.counts);
    }

    // Their works, newest-cited first — a filter call, so a tenth the price of
    // a search.
    sb.append("<h2>works</h2><p><a href=\"/works?filter=");
    sb.append(url_encode("author.id:" + p.id));
    sb.append("&sort=cited_by_count:desc\">browse all ").append(commas(p.works_count));
    sb.append(" works by ").append(html_escape(p.name)).append("</a></p>");

    sb.append("</main>");
    footer(sb, store, store.last_bytes, 0.0);
    return new Page(200, sb.toString());
}

export fn render_institution(store: Store, id: string): Page {
    let v = store.institution(id);
    if (v == null) {
        if (store.last_status == 404) {
            return error_page(store, 404, "no such institution", "OpenAlex has no institution " + id);
        }
        return error_page(store, 502, "upstream unavailable",
                          "api.openalex.org did not answer (status " + store.last_status + ")");
    }

    let name = v.get("display_name").asString();
    let sb = stringBuilder(8192);
    head(sb, name, "");
    sb.append("<h1>").append(html_escape(name)).append("</h1>");
    sb.append("<div class=\"meta\">");
    let cc = v.get("country_code").asString();
    if (cc.len > 0) { sb.append(html_escape(cc)).append(" &middot; "); }
    sb.append(html_escape(v.get("type").asString())).append(" &middot; ");
    sb.append(commas(v.get("works_count").asInt())).append(" works &middot; ");
    sb.append(commas(v.get("cited_by_count").asInt())).append(" citations</div>");

    let hp = v.get("homepage_url").asString();
    if (hp.len > 0 && (hp.starts_with("http://") || hp.starts_with("https://"))) {
        sb.append("<p><a href=\"").append(html_escape_attr(hp)).append("\">");
        sb.append(html_escape(hp)).append("</a></p>");
    }

    sb.append("<p><a href=\"/works?filter=");
    sb.append(url_encode("authorships.institutions.lineage:" + short_key(v)));
    sb.append("&sort=cited_by_count:desc\">browse their works</a></p>");

    sb.append("</main>");
    footer(sb, store, store.last_bytes, 0.0);
    return new Page(200, sb.toString());
}

fn short_key(v: JsonValue): string {
    let u = v.get("id").asString();
    let i = u.index_of("openalex.org/");
    if (i < 0) { return u; }
    return u.slice(i + 13, u.len);
}

// ── style ────────────────────────────────────────────────────────────────────

export fn css(): string {
    return ":root{--bg:#fbfbfa;--fg:#1c1c1e;--dim:#6d6d72;--acc:#2a5db0;--line:#e3e3e0;--card:#fff;--bar:#2a5db0}\n"
         + "@media (prefers-color-scheme:dark){:root{--bg:#0f1117;--fg:#e8e8ea;--dim:#8b8f99;--acc:#7aa2f7;--line:#232631;--card:#161822;--bar:#7aa2f7}}\n"
         + "*{box-sizing:border-box}\n"
         + "body{margin:0;background:var(--bg);color:var(--fg);"
         + "font:15px/1.55 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}\n"
         + "nav{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;padding:.6rem 1rem;"
         + "background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2}\n"
         + "nav a{color:var(--fg);text-decoration:none;font-size:14px}\n"
         + "nav a:hover,nav a.on{color:var(--acc);text-decoration:underline}\n"
         + "nav a.brand{font-weight:700;color:#fff;background:var(--acc);padding:.1rem .45rem;border-radius:3px}\n"
         + "nav form{margin-left:auto;display:flex;gap:.4rem}\n"
         + "input,button{font:inherit;font-size:13px;padding:.25rem .5rem;border:1px solid var(--line);"
         + "border-radius:4px;background:var(--bg);color:var(--fg)}\n"
         + "button{cursor:pointer;background:var(--acc);color:#fff;border-color:var(--acc)}\n"
         + "main{max-width:56rem;margin:0 auto;padding:1.2rem 1rem 2rem}\n"
         + "form.q{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-bottom:1.2rem;"
         + "padding:.7rem;background:var(--card);border:1px solid var(--line);border-radius:6px;font-size:13px}\n"
         + "form.q label{display:flex;gap:.3rem;align-items:center;color:var(--dim)}\n"
         + "ol.list{list-style:decimal;padding-left:2.4rem;margin:0}\n"
         + "li.work{margin:0 0 1.1rem}\n"
         + "li.work::marker{color:var(--dim);font-size:12px}\n"
         + ".title a{color:var(--acc);text-decoration:none;font-size:16px;font-weight:500}\n"
         + ".title a:hover{text-decoration:underline}\n"
         + ".authors{font-size:13px;margin-top:.1rem}\n"
         + ".authors a{color:var(--fg);text-decoration:none}\n"
         + ".authors a:hover{text-decoration:underline}\n"
         + ".meta{color:var(--dim);font-size:12.5px;margin-top:.15rem}\n"
         + ".dim{color:var(--dim);font-size:13px}\n"
         + ".oa{color:#0a7d3f;font-weight:600}\n"
         + "@media (prefers-color-scheme:dark){.oa{color:#4ade80}}\n"
         + "h1{font-size:22px;line-height:1.3;margin:0 0 .35rem}\n"
         + "h2{font-size:14px;text-transform:uppercase;letter-spacing:.04em;color:var(--dim);"
         + "margin:1.6rem 0 .5rem}\n"
         + ".abstract{background:var(--card);border:1px solid var(--line);border-radius:6px;"
         + "padding:.8rem;font-size:14px;overflow-wrap:anywhere}\n"
         + "svg.chart{width:100%;max-width:36rem;height:auto;display:block}\n"
         + "svg.chart rect{fill:var(--bar)}\n"
         + "svg.chart text{fill:var(--dim);font-size:9px}\n"
         + ".pager{display:flex;gap:1rem;justify-content:center;align-items:center;"
         + "margin-top:1.6rem;font-size:13px;color:var(--dim)}\n"
         + ".err{color:#c0392b}\n"
         + "footer{max-width:56rem;margin:0 auto;padding:.9rem 1rem;border-top:1px solid var(--line);"
         + "color:var(--dim);font-size:12px}\n";
}
