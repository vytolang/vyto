// Process memory for the painter bench. A diagnostic local to apps/d2dbench.
//
//   private_ws  pages resident and not shared: Task Manager's default
//               "Memory (Private Working Set)" column on Windows 7
//   ws          the whole working set, shared DLL pages included
//   commit      private memory committed, resident or not
//
// On Linux the three are RssAnon, VmRSS and VmData.

extern "C" {
    fn mp_private_ws_kb(): i64;
    fn mp_ws_kb(): i64;
    fn mp_commit_kb(): i64;
    fn mp_breakdown(): cstring;
}

export fn memStage(label: string, stage: string) {
    print(`mem {label} {stage} private_ws={mp_private_ws_kb()}K ws={mp_ws_kb()}K commit={mp_commit_kb()}K`);
}

// The private working set split by owner (each DLL, mapped files, heaps).
export fn memBreakdown(label: string) {
    print(`mem {label} breakdown:`);
    print(str(mp_breakdown()));
}
