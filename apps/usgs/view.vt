// view — all HTML for apps/usgs.
//
// Two of the three visualisations here are the data telling on itself:
//
//   • the world map is a plain equirectangular scatter — lon/lat straight to
//     x/y with no projection maths — and the plate boundaries draw themselves
//   • the magnitude histogram is the Gutenberg–Richter law: earthquake counts
//     fall off log-linearly with magnitude, so a log-scaled bar chart of a
//     month of quakes comes out as a straight line
//
// Both are inline SVG built with StringBuilder. No chart library, no client
// JavaScript, nothing fetched.
//
// Everything USGS returns is plain text, so every interpolated value is escaped.

import { Store, Quake, Feed, order_by, feed_names,
         NO_MAG, SORT_TIME, SORT_MAG, SORT_DEPTH, SORT_SIG } from "api";
import { StringBuilder, stringBuilder } from "vyto/util/text";
import { html_escape, html_escape_attr } from "vyto/util/html";
import { url_encode } from "vyto/util/url";
import { fixed, commas } from "vyto/util/fmt";
import { date_from_unix, date_format } from "vyto/util/date";
import { unixSec } from "vyto/util/time";

const MAP_W: int = 720;
const MAP_H: int = 360;

const HIST_W: int = 720;
const HIST_H: int = 200;

export const PER_PAGE: int = 50;

export class Page {
    status: int;
    body: string;

    fn init(status: int, body: string) {
        this.status = status;
        this.body = body;
    }
}

// ── helpers ──────────────────────────────────────────────────────────────────

export fn when(ms: int): string {
    let dt = date_from_unix((ms / 1000) as i64);
    return date_format(dt, "%Y-%m-%d %H:%M") + "Z";
}

export fn ago(ms: int): string {
    let d = (unixSec() as int) - ms / 1000;
    if (d < 60) { return "just now"; }
    if (d < 3600) { return "" + (d / 60) + "m ago"; }
    if (d < 86400) { return "" + (d / 3600) + "h ago"; }
    return "" + (d / 86400) + "d ago";
}

fn mag_str(m: float): string {
    if (m <= NO_MAG) { return "—"; }
    return fixed(m, 1);
}

// Magnitude drives the colour, matching how USGS itself presents these.
fn mag_class(m: float): string {
    if (m <= NO_MAG) { return "m0"; }
    if (m >= 6.0) { return "m6"; }
    if (m >= 5.0) { return "m5"; }
    if (m >= 4.0) { return "m4"; }
    if (m >= 2.5) { return "m3"; }
    return "m0";
}

// ── chrome ───────────────────────────────────────────────────────────────────

fn nav(sb: StringBuilder, current: string) {
    sb.append("<nav><a class=\"brand\" href=\"/\">USGS</a>");
    for (let n in feed_names()) {
        // The full matrix is 16 feeds; the nav shows the useful spine.
        if (n == "all_hour" || n == "all_day" || n == "all_week" || n == "all_month"
            || n == "significant_month" || n == "4.5_week") {
            sb.append("<a href=\"/feed/").append(n).append("\"");
            if (n == current) { sb.append(" class=\"on\""); }
            sb.append(">").append(n).append("</a>");
        }
    }
    sb.append("</nav>");
}

fn head(sb: StringBuilder, title: string, current: string) {
    sb.append("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">");
    sb.append("<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">");
    sb.append("<title>").append(html_escape(title)).append("</title>");
    sb.append("<link rel=\"stylesheet\" href=\"/style.css\"></head><body>");
    nav(sb, current);
    sb.append("<main>");
}

fn footer(sb: StringBuilder, store: Store, bytes: int, note: string) {
    sb.append("<footer>");
    if (bytes > 0) { sb.append("parsed <b>").append(commas(bytes)).append("</b> bytes of GeoJSON &middot; "); }
    if (note.len > 0) { sb.append(note).append(" &middot; "); }
    sb.append("").appendInt(store.calls).append(" upstream calls &middot; ");
    sb.append("data <a href=\"https://earthquake.usgs.gov/earthquakes/feed/v1.0/\">USGS</a>");
    sb.append(" &middot; served by <code>vyto/net/server</code></footer></body></html>\n");
}

export fn error_page(store: Store, status: int, title: string, detail: string): Page {
    let sb = stringBuilder(1024);
    head(sb, title, "");
    sb.append("<h1>").append(html_escape(title)).append("</h1>");
    sb.append("<p class=\"err\">").append(html_escape(detail)).append("</p>");
    sb.append("<p><a href=\"/feed/all_day\">back to today's quakes</a></p></main>");
    footer(sb, store, 0, "");
    return new Page(status, sb.toString());
}

// ── the world map ────────────────────────────────────────────────────────────

// Equirectangular: longitude and latitude ARE the coordinates, scaled. No
// projection library, no basemap — with a month of quakes the ring of fire and
// the mid-Atlantic ridge appear on their own.
fn worldmap(sb: StringBuilder, qs: Quake[], idx: int[]) {
    sb.append("<svg class=\"map\" viewBox=\"0 0 ").appendInt(MAP_W).append(" ").appendInt(MAP_H);
    sb.append("\" role=\"img\" aria-label=\"world map of epicentres\">");
    sb.append("<rect class=\"sea\" x=\"0\" y=\"0\" width=\"").appendInt(MAP_W);
    sb.append("\" height=\"").appendInt(MAP_H).append("\"/>");

    // Graticule every 30°, so the shape is readable without a coastline.
    let g = 30;
    while (g < 360) {
        let x = g * MAP_W / 360;
        sb.append("<line class=\"grid\" x1=\"").appendInt(x).append("\" y1=\"0\" x2=\"");
        sb.appendInt(x).append("\" y2=\"").appendInt(MAP_H).append("\"/>");
        g += 30;
    }
    let h = 30;
    while (h < 180) {
        let y = h * MAP_H / 180;
        sb.append("<line class=\"grid\" x1=\"0\" y1=\"").appendInt(y).append("\" x2=\"");
        sb.appendInt(MAP_W).append("\" y2=\"").appendInt(y).append("\"/>");
        h += 30;
    }
    sb.append("<line class=\"eq\" x1=\"0\" y1=\"").appendInt(MAP_H / 2).append("\" x2=\"");
    sb.appendInt(MAP_W).append("\" y2=\"").appendInt(MAP_H / 2).append("\"/>");

    for (let k in 0..idx.len) {
        let q = qs[idx[k]];
        let x = ((q.lon + 180.0) * (MAP_W as float) / 360.0) as int;
        let y = ((90.0 - q.lat) * (MAP_H as float) / 180.0) as int;
        if (x < 0 || x > MAP_W || y < 0 || y > MAP_H) { continue; }

        let r = 1;
        if (q.mag > NO_MAG) {
            r = (q.mag as int) - 1;
            if (r < 1) { r = 1; }
            if (r > 9) { r = 9; }
        }
        sb.append("<circle class=\"q ").append(mag_class(q.mag)).append("\" cx=\"").appendInt(x);
        sb.append("\" cy=\"").appendInt(y).append("\" r=\"").appendInt(r).append("\">");
        sb.append("<title>").append(html_escape(q.title)).append("</title></circle>");
    }
    sb.append("</svg>");
}

// ── Gutenberg–Richter ────────────────────────────────────────────────────────

// Count quakes into 0.5-magnitude bins and draw the bars on a log scale. The
// law says log10(N) falls linearly with magnitude, so a month of data draws a
// straight downward line — which is the point of showing it.
fn histogram(sb: StringBuilder, qs: Quake[], idx: int[]) {
    let nbins = 24;                 // -1.0 .. 11.0 in half-magnitude steps
    let bins: int[] = [];
    for (let i in 0..nbins) { bins.push(0); }

    let counted = 0;
    for (let k in 0..idx.len) {
        let m = qs[idx[k]].mag;
        if (m <= NO_MAG) { continue; }
        let b = ((m + 1.0) * 2.0) as int;
        if (b < 0) { b = 0; }
        if (b >= nbins) { b = nbins - 1; }
        bins[b] += 1;
        counted += 1;
    }
    if (counted == 0) { return; }

    let peak = 1;
    for (let c in bins) { if (c > peak) { peak = c; } }

    // log10 by repeated division: the counts here are small integers, so a
    // 5-step table beats pulling in a maths dependency for one call.
    let bw = HIST_W / nbins;
    sb.append("<svg class=\"hist\" viewBox=\"0 0 ").appendInt(HIST_W).append(" ");
    sb.appendInt(HIST_H + 20).append("\" role=\"img\" aria-label=\"magnitude distribution\">");
    for (let i in 0..nbins) {
        if (bins[i] == 0) { continue; }
        let hgt = log_scaled(bins[i], peak, HIST_H);
        let x = i * bw;
        sb.append("<rect x=\"").appendInt(x + 1).append("\" y=\"").appendInt(HIST_H - hgt);
        sb.append("\" width=\"").appendInt(bw - 2).append("\" height=\"").appendInt(hgt).append("\">");
        sb.append("<title>M ").append(fixed((i as float) / 2.0 - 1.0, 1)).append("–");
        sb.append(fixed((i as float) / 2.0 - 0.5, 1)).append(": ").appendInt(bins[i]);
        sb.append(" quakes</title></rect>");
        if (i % 2 == 0) {
            sb.append("<text x=\"").appendInt(x + bw / 2).append("\" y=\"").appendInt(HIST_H + 14);
            sb.append("\" text-anchor=\"middle\">").appendInt((i / 2) - 1).append("</text>");
        }
    }
    sb.append("</svg>");
    sb.append("<p class=\"dim\">").append(commas(counted));
    sb.append(" quakes binned by half-magnitude, bar height log-scaled. ");
    sb.append("Gutenberg&ndash;Richter predicts a straight decline; that is what it is.</p>");
}

// Integer log scaling without a maths library: rank the count by how many
// powers of ten it clears, then interpolate within the decade.
fn log_scaled(v: int, peak: int, h: int): int {
    let decades = 0;
    let p = peak;
    while (p >= 10) { p = p / 10; decades += 1; }
    if (decades == 0) { return v * h / peak; }

    let d = 0;
    let x = v;
    while (x >= 10) { x = x / 10; d += 1; }
    // d decades in, plus the fractional position inside this decade.
    let per = h / (decades + 1);
    let base = d * per;
    let within = (v - pow10(d)) * per / (pow10(d) * 9);
    let out = base + within;
    if (out < 1) { out = 1; }
    if (out > h) { out = h; }
    return out;
}

fn pow10(n: int): int {
    let r = 1;
    for (let i in 0..n) { r = r * 10; }
    return r;
}

// ── the table ────────────────────────────────────────────────────────────────

fn sort_link(sb: StringBuilder, feed: string, label: string, key: int,
             cur_key: int, desc: bool, min_mag: float) {
    // Clicking the active column flips direction; a new column starts descending.
    let want_desc = true;
    if (key == cur_key && desc) { want_desc = false; }

    sb.append("<th><a href=\"/feed/").append(html_escape_attr(feed));
    sb.append("?sort=").appendInt(key);
    if (want_desc) { sb.append("&dir=desc"); } else { sb.append("&dir=asc"); }
    if (min_mag > NO_MAG) { sb.append("&min=").append(fixed(min_mag, 1)); }
    sb.append("\">").append(label);
    if (key == cur_key) {
        if (desc) { sb.append(" &darr;"); } else { sb.append(" &uarr;"); }
    }
    sb.append("</a></th>");
}

export fn render_feed(store: Store, name: string, key: int, desc: bool,
                      min_mag: float, page: int): Page {
    let f = store.feed(name);
    if (f.err.len > 0) {
        let code = 502;
        if (store.last_status == 404 || f.quakes.len == 0 && store.last_status == 0) { code = 404; }
        return error_page(store, code, "feed unavailable", f.err);
    }

    let idx = order_by(f.quakes, key, desc, min_mag);

    let sb = stringBuilder(262144);
    head(sb, f.title, name);
    sb.append("<h1>").append(html_escape(f.title)).append("</h1>");
    sb.append("<div class=\"meta\">").append(commas(f.quakes.len)).append(" quakes");
    if (idx.len != f.quakes.len) {
        sb.append(" &middot; ").append(commas(idx.len)).append(" shown");
    }
    sb.append(" &middot; generated ").append(when(f.generated)).append("</div>");

    worldmap(sb, f.quakes, idx);
    histogram(sb, f.quakes, idx);

    // Magnitude floor — a month feed is mostly M<2 noise near instruments.
    sb.append("<form class=\"q\" action=\"/feed/").append(html_escape_attr(name));
    sb.append("\" method=\"get\">");
    sb.append("<label>min magnitude <input name=\"min\" value=\"");
    if (min_mag > NO_MAG) { sb.append(fixed(min_mag, 1)); }
    sb.append("\" size=\"5\"></label>");
    sb.append("<input type=\"hidden\" name=\"sort\" value=\"").appendInt(key).append("\">");
    sb.append("<input type=\"hidden\" name=\"dir\" value=\"");
    if (desc) { sb.append("desc"); } else { sb.append("asc"); }
    sb.append("\"><button>filter</button></form>");

    let lo = (page - 1) * PER_PAGE;
    if (lo < 0) { lo = 0; }
    let hi = lo + PER_PAGE;
    if (hi > idx.len) { hi = idx.len; }

    sb.append("<table><thead><tr>");
    sort_link(sb, name, "mag", SORT_MAG, key, desc, min_mag);
    sb.append("<th>place</th>");
    sort_link(sb, name, "depth", SORT_DEPTH, key, desc, min_mag);
    sort_link(sb, name, "significance", SORT_SIG, key, desc, min_mag);
    sort_link(sb, name, "when", SORT_TIME, key, desc, min_mag);
    sb.append("</tr></thead><tbody>");

    for (let k in lo..hi) {
        let q = f.quakes[idx[k]];
        sb.append("<tr><td class=\"mag ").append(mag_class(q.mag)).append("\">");
        sb.append(mag_str(q.mag)).append("</td>");
        sb.append("<td><a href=\"/quake/").append(html_escape_attr(name)).append("/");
        sb.append(html_escape_attr(q.id)).append("\">");
        sb.append(html_escape(q.place)).append("</a>");
        if (q.tsunami == 1) { sb.append(" <span class=\"tsu\">tsunami</span>"); }
        sb.append("</td>");
        sb.append("<td class=\"n\">").append(fixed(q.depth, 1)).append(" km</td>");
        sb.append("<td class=\"n\">").appendInt(q.sig).append("</td>");
        sb.append("<td class=\"n\" title=\"").append(when(q.time)).append("\">");
        sb.append(ago(q.time)).append("</td></tr>");
    }
    sb.append("</tbody></table>");

    let base = "/feed/" + name + "?sort=" + key + "&dir=";
    if (desc) { base = base + "desc"; } else { base = base + "asc"; }
    if (min_mag > NO_MAG) { base = base + "&min=" + fixed(min_mag, 1); }
    base = base + "&p=";

    let last = (idx.len + PER_PAGE - 1) / PER_PAGE;
    if (last < 1) { last = 1; }
    sb.append("<div class=\"pager\">");
    if (page > 1) { sb.append("<a href=\"").append(base).appendInt(page - 1).append("\">&larr; prev</a>"); }
    sb.append("<span>page ").appendInt(page).append(" of ").appendInt(last).append("</span>");
    if (page < last) { sb.append("<a href=\"").append(base).appendInt(page + 1).append("\">next &rarr;</a>"); }
    sb.append("</div></main>");

    footer(sb, store, f.bytes, "sorted " + commas(idx.len) + " rows by index permutation");
    return new Page(200, sb.toString());
}

// ── one quake ────────────────────────────────────────────────────────────────

// No upstream call: the summary feed already carries every field a detail page
// shows, and it is already cached.
export fn render_quake(store: Store, name: string, id: string): Page {
    let f = store.feed(name);
    if (f.err.len > 0) { return error_page(store, 502, "feed unavailable", f.err); }

    let found = -1;
    for (let i in 0..f.quakes.len) {
        if (f.quakes[i].id == id) { found = i; }
    }
    if (found < 0) {
        return error_page(store, 404, "no such quake",
                          id + " is not in the " + name + " feed");
    }
    let q = f.quakes[found];

    let sb = stringBuilder(8192);
    head(sb, q.title, name);
    sb.append("<article><h1><span class=\"mag ").append(mag_class(q.mag)).append("\">");
    sb.append(mag_str(q.mag)).append("</span> ").append(html_escape(q.place)).append("</h1>");

    sb.append("<div class=\"meta\">").append(when(q.time)).append(" &middot; ");
    sb.append(ago(q.time)).append(" &middot; ").append(html_escape(q.kind));
    if (q.magType.len > 0) { sb.append(" &middot; ").append(html_escape(q.magType)); }
    if (q.alert.len > 0) { sb.append(" &middot; alert ").append(html_escape(q.alert)); }
    if (q.tsunami == 1) { sb.append(" &middot; <span class=\"tsu\">tsunami</span>"); }
    sb.append("</div>");

    sb.append("<dl>");
    sb.append("<dt>latitude</dt><dd>").append(fixed(q.lat, 4)).append("</dd>");
    sb.append("<dt>longitude</dt><dd>").append(fixed(q.lon, 4)).append("</dd>");
    sb.append("<dt>depth</dt><dd>").append(fixed(q.depth, 2)).append(" km</dd>");
    sb.append("<dt>significance</dt><dd>").appendInt(q.sig).append("</dd>");
    if (q.felt > 0) { sb.append("<dt>felt reports</dt><dd>").appendInt(q.felt).append("</dd>"); }
    sb.append("</dl>");

    // A one-quake map, same projection, so the location reads at a glance.
    let one: Quake[] = [q];
    let oneIdx: int[] = [0];
    worldmap(sb, one, oneIdx);

    if (q.url.len > 0 && q.url.starts_with("https://")) {
        sb.append("<p><a href=\"").append(html_escape_attr(q.url)).append("\">on USGS</a></p>");
    }
    sb.append("<p><a href=\"/feed/").append(html_escape_attr(name));
    sb.append("\">back to ").append(html_escape(name)).append("</a></p></article></main>");
    footer(sb, store, 0, "detail served from the cached feed, no upstream call");
    return new Page(200, sb.toString());
}

// ── style ────────────────────────────────────────────────────────────────────

export fn css(): string {
    return ":root{--bg:#f7f7f5;--fg:#1b1b1d;--dim:#6c6c72;--acc:#b3391b;--line:#e2e2dd;--card:#fff;"
         + "--sea:#dfe6ec;--grid:#c9d3dc}\n"
         + "@media (prefers-color-scheme:dark){:root{--bg:#0e1014;--fg:#e7e7ea;--dim:#8b909a;"
         + "--acc:#ff7043;--line:#22252c;--card:#15181e;--sea:#141b24;--grid:#1e2a36}}\n"
         + "*{box-sizing:border-box}\n"
         + "body{margin:0;background:var(--bg);color:var(--fg);"
         + "font:15px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}\n"
         + "nav{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;padding:.6rem 1rem;"
         + "background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2}\n"
         + "nav a{color:var(--fg);text-decoration:none;font-size:13px}\n"
         + "nav a:hover,nav a.on{color:var(--acc);text-decoration:underline}\n"
         + "nav a.brand{font-weight:700;color:#fff;background:var(--acc);padding:.1rem .45rem;border-radius:3px}\n"
         + "main{max-width:60rem;margin:0 auto;padding:1.1rem 1rem 2rem}\n"
         + "h1{font-size:21px;margin:0 0 .3rem}\n"
         + ".meta{color:var(--dim);font-size:12.5px;margin-bottom:1rem}\n"
         + ".dim{color:var(--dim);font-size:12.5px}\n"
         + "svg.map,svg.hist{width:100%;height:auto;display:block;margin:1rem 0;"
         + "border:1px solid var(--line);border-radius:6px}\n"
         + "svg.map .sea{fill:var(--sea)}\n"
         + "svg.map .grid{stroke:var(--grid);stroke-width:.5}\n"
         + "svg.map .eq{stroke:var(--grid);stroke-width:1}\n"
         + "svg.map circle.q{fill-opacity:.75}\n"
         + "svg.hist rect{fill:var(--acc);fill-opacity:.85}\n"
         + "svg.hist text{fill:var(--dim);font-size:9px}\n"
         + ".m0{fill:#8a8f98;color:#6c6c72}\n"
         + ".m3{fill:#e0a90c;color:#8a6a00}\n"
         + ".m4{fill:#e2701a;color:#a04a00}\n"
         + ".m5{fill:#d63b1f;color:#b3391b}\n"
         + ".m6{fill:#8e1cc4;color:#8e1cc4}\n"
         + "@media (prefers-color-scheme:dark){.m3{color:#ffd166}.m4{color:#ff9f5a}"
         + ".m5{color:#ff6b4a}.m6{color:#d08cff}}\n"
         + "form.q{display:flex;gap:.6rem;align-items:center;margin:1rem 0;padding:.6rem;"
         + "background:var(--card);border:1px solid var(--line);border-radius:6px;font-size:13px}\n"
         + "form.q label{display:flex;gap:.35rem;align-items:center;color:var(--dim)}\n"
         + "input,button{font:inherit;font-size:13px;padding:.22rem .45rem;border:1px solid var(--line);"
         + "border-radius:4px;background:var(--bg);color:var(--fg)}\n"
         + "button{cursor:pointer;background:var(--acc);color:#fff;border-color:var(--acc)}\n"
         + "table{width:100%;border-collapse:collapse;font-size:13.5px}\n"
         + "th{text-align:left;border-bottom:1px solid var(--line);padding:.4rem .5rem;"
         + "font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.03em}\n"
         + "th a{color:var(--dim);text-decoration:none}\n"
         + "th a:hover{color:var(--acc)}\n"
         + "td{padding:.35rem .5rem;border-bottom:1px solid var(--line)}\n"
         + "td a{color:var(--fg);text-decoration:none}\n"
         + "td a:hover{color:var(--acc);text-decoration:underline}\n"
         + "td.n{text-align:right;color:var(--dim);white-space:nowrap}\n"
         + "td.mag,span.mag{font-weight:700;text-align:right;white-space:nowrap}\n"
         + ".tsu{color:#fff;background:#0a7d8c;font-size:10px;padding:0 .3rem;border-radius:3px}\n"
         + "dl{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;font-size:14px;max-width:24rem}\n"
         + "dt{color:var(--dim)}\n"
         + ".pager{display:flex;gap:1rem;justify-content:center;align-items:center;"
         + "margin-top:1.3rem;font-size:13px;color:var(--dim)}\n"
         + ".err{color:#c0392b}\n"
         + "footer{max-width:60rem;margin:0 auto;padding:.9rem 1rem;border-top:1px solid var(--line);"
         + "color:var(--dim);font-size:12px}\n";
}
