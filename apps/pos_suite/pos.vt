// Vyto Café POS, Linux entry: the same screen through blend2d's GfxPainter
// with the stdlib's Inter, for developing on Linux. The Windows build is
// pos_win.vt.
//
//   ./vytoc run apps/pos/pos.vt
import { Window } from "vyto/ui";
import { GfxPainter } from "vyto/gfx/painter";
import { libDir } from "vyto/os";
import { buildPos } from "posapp";

fn main() {
    let win = new Window("Vyto Café — POS Suite", 1280, 800);
    // GfxPainter does not apply the display scale itself; D2DPainter does.
    win.use_painter(new GfxPainter(win.surface(), libDir() + "/vyto/gfx/assets/Inter-Regular.ttf",
                                   15.0 * win.scale));
    win.theme.apply_scale(win.scale);
    buildPos(win);
    win.run();
}
