// The Windows suite's identity and contents for `vytoc build --installer`:
// the till (pos_win.vt) plus two background services, all installed into one
// folder by one setup.exe. Payments needs Stock running first.
//
//   ./vytoc build apps/pos_suite/pos_win.vt --target windows-x64 --release --audit \
//       --manifest apps/pos_suite/pos_manifest.vt --installer -o pos.exe
import { WinManifest } from "vyto/win/manifest";

fn main() {
    new WinManifest("Vyto Café POS Suite")
        .version("0.2.0")
        .company("Vyto")
        .description("Point of sale with payments and stock services")
        .program("payments", "payments.vt")
        .program("stock", "stock.vt")
        .serviceFor("payments", "VytoCafePayments", "Vyto Café Payments",
                    "Simulated M-Pesa payments for the Vyto Café till", "auto")
        .serviceFor("stock", "VytoCafeStock", "Vyto Café Stock",
                    "Stock levels for the Vyto Café till", "auto")
        .dependsOn("VytoCafePayments", "VytoCafeStock")
        .emit();
}
