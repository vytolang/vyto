// The café's menu, shared by the till (posapp.vt) and the stock service
// (stock.vt) so both agree on every item. Prices are integer cents, VAT
// included.

export class Item {
    name: string;
    price: int;
    cat: int;
    fn init(name: string, price: int, cat: int) {
        this.name = name;
        this.price = price;
        this.cat = cat;
    }
}

export fn menuCategories(): string[] {
    return ["Coffee", "Tea & Hot", "Bakery", "Food", "Cold Drinks"];
}

export fn menuItems(): Item[] {
    return [
        new Item("Espresso", 18000, 0), new Item("Americano", 22000, 0),
        new Item("Cappuccino", 28000, 0), new Item("Café Latte", 30000, 0),
        new Item("Flat White", 30000, 0), new Item("Mocha", 33000, 0),
        new Item("Chai", 12000, 1), new Item("Masala Chai", 15000, 1),
        new Item("Dawa", 20000, 1), new Item("Hot Chocolate", 26000, 1),
        new Item("Croissant", 18000, 2), new Item("Blueberry Muffin", 16000, 2),
        new Item("Banana Bread", 20000, 2), new Item("Mandazi (3)", 9000, 2),
        new Item("Beef Samosa", 8000, 3), new Item("Chicken Wrap", 45000, 3),
        new Item("Club Sandwich", 52000, 3), new Item("Masala Fries", 25000, 3),
        new Item("Water 500ml", 8000, 4), new Item("Soda 300ml", 10000, 4),
        new Item("Passion Juice", 25000, 4), new Item("Iced Latte", 32000, 4),
    ];
}

// The suite's shared names: the channel suite, and the services.
export const SUITE: string = "vyto-cafe-suite";
export const PAYMENTS_SERVICE: string = "VytoCafePayments";
export const STOCK_SERVICE: string = "VytoCafeStock";
