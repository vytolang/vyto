// vyto/math/securerandom — real OS entropy (getrandom/BCryptGenRandom/
// /dev/urandom via vyto/util/uuid's shim), not a reproducible PRNG stream.
// Contrast with examples/101_random.vt: that module is deterministic by
// design; this one is deliberately not, so every check below is a property
// of the output (length, range, "two draws differ") rather than a specific
// value — the same reason this can still be a golden-diff test despite the
// underlying randomness being real.
import { secureBytes, secureInt, secureBelow, secureRange, secureFloat,
         secureBool, secureShuffle, secureChoice, secureToken } from "vyto/math/securerandom";

fn main() {
    print("secureBytes(16).len = " + str(secureBytes(16).len));
    print("secureInt >= 0 = " + str(secureInt() >= 0));

    let bel = secureBelow(100);
    print("secureBelow(100) in range = " + str(bel >= 0 && bel < 100));

    let r = secureRange(10, 20);
    print("secureRange(10,20) in range = " + str(r >= 10 && r < 20));

    let f = secureFloat();
    print("secureFloat in [0,1) = " + str(f >= 0.0 && f < 1.0));

    print("secureBool(1.0) = " + str(secureBool(1.0)));
    print("secureBool(0.0) = " + str(secureBool(0.0)));

    let arr = [1, 2, 3, 4, 5];
    secureShuffle(arr);
    let sum = 0;
    for (let x in arr) { sum += x; }
    print("shuffled sum unchanged = " + str(sum == 15));

    let c = secureChoice(arr);
    print("choice in range = " + str(c >= 1 && c <= 5));

    let t1 = secureToken(16);
    let t2 = secureToken(16);
    print("token len = " + str(t1.len));
    print("two tokens differ = " + str(t1 != t2));

    let a1 = secureBytes(8);
    let a2 = secureBytes(8);
    let same = true;
    for (let k in 0..8) { if (a1[k] != a2[k]) { same = false; } }
    print("two byte draws differ = " + str(!same));
}
