name    = vyto-service
debug   = false
host    = 0.0.0.0
motd    = [  keep my spaces  ]
data    = /var/lib/app
tag     = release#7
missing = []

port ok = true, value = 8080
name as int = false (a name is not a number)

as JSON: {"host":"0.0.0.0","port":"8080","motd":"  keep my spaces  "}

keys before any section stay at the root: {"a":"1","s":{"b":"2"}}
a reopened section merges:                {"s":{"a":"1","b":"2"},"t":{"x":"0"}}
a repeated key takes the last value:      {"a":"2"}
an empty value is an empty string:        {"a":""}
flat:   {"a.b":{"x":"1"}}
nested: {"a":{"b":{"x":"1"},"c":{"y":"2"}}}

not a pair       = line is not a key/value pair at line 2
open header      = unterminated section header at line 1
key vs section   = section 'a' collides with a key at line 2

encoded:
name = built-by-hand

[server]
host = localhost
motd = "  padded  "

round trip stable = true
