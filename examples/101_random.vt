// vyto/math/random — a seedable xorshift64 generator: same seed, same
// sequence, every run. Nothing here is a security boundary (see the file
// header in lib/vyto/math/random.vt for why that's the deliberate choice).
import { rng, shuffle, choice } from "vyto/math/random";

fn main() {
    let r = rng(1234567);

    print("nextBelow(100) = " + str(r.nextBelow(100)));
    print("nextRange(10,20) = " + str(r.nextRange(10, 20)));
    print("nextBool(1.0) = " + str(r.nextBool(1.0)));
    print("nextBool(0.0) = " + str(r.nextBool(0.0)));

    let deck = [1, 2, 3, 4, 5, 6, 7, 8];
    shuffle(deck, r);
    let sum = 0;
    for (let x in deck) { sum += x; }
    print("shuffled deck sum unchanged = " + str(sum == 36));
    print("shuffled deck = " + str(deck[0]) + "," + str(deck[1]) + "," + str(deck[2]) + ","
          + str(deck[3]) + "," + str(deck[4]) + "," + str(deck[5]) + "," + str(deck[6]) + "," + str(deck[7]));

    let picked = choice(deck, r);
    print("choice is from deck = " + str(picked >= 1 && picked <= 8));

    // Determinism: two Rng instances with the same seed produce the same
    // sequence — the property that makes a golden test of this file possible
    // at all.
    let a = rng(99);
    let b = rng(99);
    print("same seed same stream = " + str(a.nextU64() == b.nextU64() && a.nextInt() == b.nextInt()));

    // Reseeding restarts the stream from the top.
    let c = rng(7);
    let first = c.nextU64();
    c.reseed(7);
    print("reseed restarts stream = " + str(c.nextU64() == first));

    // Float draws land in the documented range.
    let f = rng(55).nextFloat();
    print("nextFloat in [0,1) = " + str(f >= 0.0 && f < 1.0));
    let g = rng(55).nextGaussian();
    print("nextGaussian is finite-ish = " + str(g > -20.0 && g < 20.0));
}
