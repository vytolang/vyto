// vyto/os machineId(): the OS install's identity (Windows MachineGuid, Linux
// /etc/machine-id). The value itself is never printed — it identifies the
// machine — only that it is there and stable between two reads.
import { machineId } from "vyto/os";

fn main() {
    let a = machineId();
    let b = machineId();
    if (a == "") {
        print("machine id: none on this platform");
        return;
    }
    print(`machine id: present={a.len >= 16} stable={a == b} one line={!a.contains("\n")}`);
}
