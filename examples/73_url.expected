scheme    = https
user      = ada
host      = example.com
port      = 8443
path      = /docs/intro.html
query     = q=hi+there&tag=a&tag=b
fragment  = install
hostPort  = example.com:8443
round     = https://ada:s3cret@example.com:8443/docs/intro.html?q=hi+there&tag=a&tag=b#install

no port   = 0, effective = 80
v6 host   = 2001:db8::1
v6 print  = http://[2001:db8::1]:8080/health

bad host  = example.com
bad error = invalid port

q         = hi there
tag first = a
tag all   = a,b
missing   = [] present=false
assembled = name=Grace+Hopper&lang=vyto&lang=c
reparsed  = Grace Hopper

built     = https://api.example.com:8443/v2/things?limit=10&tag=a&tag=b#results
safe      = https://h/files/..%2F..%2Fetc%2Fpasswd
edited    = https://x.dev/a?k=1&k2=2#f
swapped   = https://y.dev/a?k=9
as a Url  = h query=a=1 port=443

component = a%20b%2Fc%3Fd%3De%26f
path      = /dir%20name/a%2Bb.txt
form      = a+b%2Fc
decode    = café au lait
form back = a b/c
lenient   = 100% done

base      = http://example.com/a/b/page.html
  ../q    -> http://example.com/a/q
  /q      -> http://example.com/q
  q.html  -> http://example.com/a/b/q.html
  #sec    -> http://example.com/a/b/page.html#sec
  ?y=2    -> http://example.com/a/b/page.html?y=2
  //cdn.example.com/s.js -> http://cdn.example.com/s.js
  https://other/x        -> https://other/x

normalize = /etc/passwd
normalize = /a/c/
