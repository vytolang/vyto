// vyto/os spawnDetached / runArgs / pidAlive / waitPidExit: programs started
// by path with an argument list, no shell in between.
import { spawnDetached, runArgs, pidAlive, waitPidExit, pid } from "vyto/os";

fn main() {
    // exit codes come back
    print(`exit code: {runArgs("/bin/sh", ["-c", "exit 7"], 5000)}`);
    // each argument arrives as it was given: spaces and quotes intact
    let odd = "a b\"c 'd'";
    print(`argument intact: {runArgs("/bin/sh", ["-c", "test \"$1\" = \"$2\"", "sh", odd, odd], 5000) == 0}`);
    print(`no shell expansion: {runArgs("/bin/sh", ["-c", "test \"$1\" = '$HOME'", "sh", "$HOME"], 5000) == 0}`);
    // failures have their own sentinels
    print(`missing exe: {runArgs("/nonexistent/prog", [], 1000)}`);
    print(`timed out: {runArgs("/bin/sh", ["-c", "sleep 5"], 100)}`);

    // detached: a pid comes back, the process runs on its own, then is gone
    let p = spawnDetached("/bin/sh", ["-c", "sleep 0.4"]);
    print(`detached pid: {p > 0}`);
    print(`running: {pidAlive(p)}`);
    print(`still running after 50 ms: {!waitPidExit(p, 50)}`);
    print(`gone: {waitPidExit(p, 5000)}`);
    print(`alive after exit: {pidAlive(p)}`);
    print(`detached missing exe: {spawnDetached("/nonexistent/prog", [])}`);
    print(`self alive: {pidAlive(pid())}`);
    print(`pid 0: {pidAlive(0)}`);
}
