// vyto/os — env, cwd, host info, subprocess. Deterministic output only.
import { getenv, setenv, hasEnv, getenvOr, platform, cpuCount, cwd, run, capture } from "vyto/os/os";

fn main() {
    setenv("VYTO_OS_TEST", "hello");
    print("env=" + getenv("VYTO_OS_TEST"));
    print("has=" + hasEnv("VYTO_OS_TEST") + " missing=" + hasEnv("VYTO_NOPE_XYZ"));
    print("fallback=" + getenvOr("VYTO_NOPE_XYZ", "default"));

    print("platform=" + platform());
    print("cpu_positive=" + (cpuCount() > 0));
    print("cwd_nonempty=" + (cwd().len > 0));

    // Only shell builtins that sh and cmd.exe share, so the result does not
    // depend on which tools happen to be on PATH (a Windows box with MSYS
    // has `true` and `printf`; a bare one does not).
    print("run_exit0=" + run("exit 0"));
    print("run_exit3=" + run("exit 3"));

    // `&&` with no space before it: cmd.exe would otherwise echo the space.
    // _popen reads in text mode, so cmd's CRLF arrives as LF.
    let r = capture("echo line1&& echo line2");
    print("capture.code=" + r.code() + " ok=" + r.ok());
    print("capture.out=[" + r.out() + "]");
}
