-- tables --
SELECT n.nspname AS schema, c.relname AS name, CASE c.relkind WHEN 'r' THEN 'table' WHEN 'p' THEN 'table' WHEN 'f' THEN 'table' WHEN 'v' THEN 'view' WHEN 'm' THEN 'view' ELSE 'unknown' END AS kind, (SELECT count(*)::int FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped) AS ncol, 0 AS withoutrowid, 0 AS strict FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','p','v','m','f') AND n.nspname NOT IN ('pg_catalog','information_schema') AND pg_table_is_visible(c.oid) ORDER BY n.nspname, c.relname
-- columns --
SELECT (a.attnum - 1) AS cid, a.attname AS name, format_type(a.atttypid, a.atttypmod) AS decltype, CASE WHEN a.attnotnull THEN 1 ELSE 0 END AS notnull, pg_get_expr(d.adbin, d.adrelid) AS dflt, COALESCE(k.ord::int, 0) AS pkpos, CASE a.attgenerated WHEN 's' THEN 3 WHEN 'v' THEN 2 ELSE 0 END AS hidden FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum LEFT JOIN LATERAL (SELECT u.ord FROM pg_index x CROSS JOIN LATERAL unnest(x.indkey) WITH ORDINALITY AS u(attnum, ord) WHERE x.indrelid = a.attrelid AND x.indisprimary AND u.attnum = a.attnum) k ON true WHERE c.relname = $1 AND pg_table_is_visible(c.oid) AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum
-- indexes --
SELECT (row_number() OVER (ORDER BY ic.relname))::int - 1 AS seq, ic.relname AS name, CASE WHEN x.indisunique THEN 1 ELSE 0 END AS "unique", CASE WHEN x.indisprimary THEN 'pk' WHEN con.contype = 'u' THEN 'u' ELSE 'c' END AS origin, CASE WHEN x.indpred IS NULL THEN 0 ELSE 1 END AS partial FROM pg_index x JOIN pg_class ic ON ic.oid = x.indexrelid JOIN pg_class tc ON tc.oid = x.indrelid LEFT JOIN pg_constraint con ON con.conindid = x.indexrelid AND con.contype IN ('u','p') WHERE tc.relname = $1 AND pg_table_is_visible(tc.oid) ORDER BY ic.relname
-- index columns --
SELECT (u.ord::int - 1) AS seqno, (u.attnum::int - 1) AS cid, COALESCE(a.attname, '') AS name, CASE WHEN (x.indoption[u.ord - 1] & 1) = 1 THEN 1 ELSE 0 END AS "desc", COALESCE(NULLIF(cl.collname, 'default'), '') AS coll, CASE WHEN u.ord <= x.indnkeyatts THEN 1 ELSE 0 END AS key FROM pg_index x JOIN pg_class ic ON ic.oid = x.indexrelid CROSS JOIN LATERAL unnest(x.indkey) WITH ORDINALITY AS u(attnum, ord) LEFT JOIN pg_attribute a ON a.attrelid = x.indrelid AND a.attnum = u.attnum AND u.attnum > 0 LEFT JOIN pg_collation cl ON cl.oid = x.indcollation[u.ord - 1] WHERE ic.relname = $1 AND pg_table_is_visible(ic.oid) ORDER BY u.ord
-- foreign keys --
SELECT (dense_rank() OVER (ORDER BY con.oid))::int - 1 AS id, (u.ord::int - 1) AS seq, rc.relname AS reftable, fa.attname AS fromcol, COALESCE(ta.attname, '') AS tocol, CASE con.confupdtype WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET NULL' WHEN 'd' THEN 'SET DEFAULT' ELSE '' END AS onupdate, CASE con.confdeltype WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT' WHEN 'c' THEN 'CASCADE' WHEN 'n' THEN 'SET NULL' WHEN 'd' THEN 'SET DEFAULT' ELSE '' END AS ondelete FROM pg_constraint con JOIN pg_class c ON c.oid = con.conrelid JOIN pg_class rc ON rc.oid = con.confrelid CROSS JOIN LATERAL unnest(con.conkey) WITH ORDINALITY AS u(attnum, ord) JOIN pg_attribute fa ON fa.attrelid = con.conrelid AND fa.attnum = u.attnum LEFT JOIN pg_attribute ta ON ta.attrelid = con.confrelid AND ta.attnum = con.confkey[u.ord] WHERE con.contype = 'f' AND c.relname = $1 AND pg_table_is_visible(c.oid) ORDER BY con.oid, u.ord
-- objects --
SELECT 'table'::text AS type, c.relname AS name, c.relname AS tblname, ''::text AS sql FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r','p','f') AND n.nspname NOT IN ('pg_catalog','information_schema') AND pg_table_is_visible(c.oid) UNION ALL SELECT 'view', c.relname, c.relname, 'CREATE VIEW ' || quote_ident(c.relname) || ' AS ' || pg_get_viewdef(c.oid, true) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('v','m') AND n.nspname NOT IN ('pg_catalog','information_schema') AND pg_table_is_visible(c.oid) UNION ALL SELECT 'index', ic.relname, tc.relname, pg_get_indexdef(x.indexrelid) FROM pg_index x JOIN pg_class ic ON ic.oid = x.indexrelid JOIN pg_class tc ON tc.oid = x.indrelid JOIN pg_namespace n ON n.oid = ic.relnamespace WHERE n.nspname NOT IN ('pg_catalog','information_schema') AND pg_table_is_visible(ic.oid) UNION ALL SELECT 'trigger', t.tgname, tc.relname, pg_get_triggerdef(t.oid) FROM pg_trigger t JOIN pg_class tc ON tc.oid = t.tgrelid JOIN pg_namespace n ON n.oid = tc.relnamespace WHERE NOT t.tgisinternal AND n.nspname NOT IN ('pg_catalog','information_schema') AND pg_table_is_visible(tc.oid) ORDER BY 1, 2
---- TLS is refused, not silently downgraded ----
ok    sslmode=require does not connect
ok    and says so
ok    naming the stub that has to be implemented
---- done ----
