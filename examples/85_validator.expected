---- a signup form, all of it wrong ----
valid: false   failures: 5
  name: is required
  email: must be an email address
  password: must be at least 12 characters
  age: must be a whole number
  dob: must be a date as YYYY-MM-DD
---- the same form, filled in properly ----
valid: true   age=36 dob=1815-12-10
---- one error per field, not three ----
empty email -> 1 error: email: is required
---- config: text in, typed values out ----
port=8080 ratio=0.75 debug=true workers=4 (absent, defaulted) retries=3 (bad, defaulted)
config errors: 1
  retries: must be a whole number
---- checking a single literal ----
'ok' minChars(2): true
'x'  minChars(2): false code=3 (V_TOO_SHORT=3) msg=must be at least 2 characters
---- a custom rule ----
username with a space -> username: cannot contain spaces
without one -> true
---- characters, not bytes ----
'José' is 5 bytes but 4 characters: maxChars(4)=true maxBytes(4)=false
