// vyto/crypto/openssl — TLS and X.509, checked without a network.
//
// Everything below runs in one process against a loopback socket pair: the
// client and the server are both TlsConn objects here, driven by one pump loop.
// That is what lets a real TLS 1.3 handshake — certificate verification,
// hostname matching, ALPN, application data, close_notify — be part of
// `make test` on a machine with no server, no internet and no fixtures beyond
// the certificates in tests/fixtures/tls.
//
// ── THE HANDSHAKE IS A LOOP, NOT A CALL ─────────────────────────────────────
// Both sockets are non-blocking, so handshakeStep() returns OSSL_WANT_READ or
// OSSL_WANT_WRITE rather than blocking, and the caller runs both ends until
// each answers 1. This is not an artefact of testing in one process: it is
// exactly what vyto/db/wire/tls.vt does over a real socket, and the reason the
// shim reports which DIRECTION it wants instead of a bare "would block". An SSL
// read can need the socket to become WRITABLE and an SSL write can need it
// READABLE; polling the wrong one is a hang.
// ─────────────────────────────────────────────────────────────────────────────

import { ossl_version, ossl_available,
         cert_from_pem, cert_matches_host, cert_verify_chain, Cert,
         tls_client, tls_client_verify_chain_only,
         tls_client_insecure_no_verification, tls_server,
         tls_connect, tls_accept, TlsConn, TlsContext,
         OSSL_WANT_READ, OSSL_WANT_WRITE, OSSL_FAILED } from "vyto/crypto/openssl";
import { socket_listen_on, socket_connect, Socket } from "vyto/net/socket";
import { strBytes, hex_encode } from "vyto/crypto";

const DIR: string = "tests/fixtures/tls/";

// Prints "ok" or a loud failure with both values, matching 86_crypto.vt.
fn check(name: string, got: string, want: string) {
    if (got == want) {
        print("ok    " + name);
    } else {
        print("FAIL  " + name);
        print("        got  " + got);
        print("        want " + want);
    }
}

fn checkBool(name: string, got: bool, want: bool) {
    if (got == want) {
        print("ok    " + name);
    } else {
        print("FAIL  " + name + " (got " + str(got) + ", want " + str(want) + ")");
    }
}

fn load(name: string): Cert {
    let c = cert_from_pem(readfile(DIR + name));
    if (c == null) { print("FAIL  could not parse " + name); }
    return c;
}

fn main() {
    // ---- 1. the library is there and meets the floor ----------------------
    //
    // The version string is not goldened — it names whatever the distro
    // installed — but the major version is the whole point of the 3.0 floor,
    // so that part is.
    checkBool("available", ossl_available(), true);
    let v = ossl_version();
    checkBool("version is OpenSSL 3.x", v.index_of("OpenSSL 3.") == 0, true);

    // ---- 2. parsing a certificate -----------------------------------------

    let leaf = load("leaf.crt");
    let root = load("root.crt");
    let other = load("other-root.crt");
    let wild = load("wildcard.crt");
    let cnOnly = load("cn-only.crt");
    let expired = load("expired.crt");

    check("leaf subject", leaf.subject, "CN=localhost");
    check("leaf issuer", leaf.issuer, "CN=Vyto Test Root CA");
    check("root is self-issued", root.subject, root.issuer);
    checkBool("leaf has a serial", leaf.serial.len > 0, true);

    // Three SAN shapes in one certificate, in the order the extension lists
    // them. The IP is rendered rather than dropped: a certificate for an
    // address is how a database behind a load balancer is usually reached.
    check("leaf SAN count", str(leaf.sans.len), "3");
    check("leaf SAN 0", leaf.sans[0], "localhost");
    check("leaf SAN 1", leaf.sans[1], "db.example.com");
    check("leaf SAN 2", leaf.sans[2], "127.0.0.1");
    check("cn-only SAN count", str(cnOnly.sans.len), "0");

    // Dates. leaf.crt is regenerated by gen.sh so its window moves; expired.crt
    // is pinned to January 2020 on purpose and can be asserted exactly.
    checkBool("leaf validity is ordered", leaf.notAfter > leaf.notBefore, true);
    check("expired notBefore", str(expired.notBefore), "1577836800");   // 2020-01-01Z
    check("expired notAfter", str(expired.notAfter), "1580515200");     // 2020-02-01Z

    // A fingerprint is 32 bytes and is stable for a given certificate; the
    // value moves with gen.sh, so only its shape is goldened.
    check("fingerprint length", str(leaf.fingerprint().len), "32");

    // Garbage in, null out — not a panic and not an empty Cert that looks real.
    checkBool("garbage PEM is null", cert_from_pem("-----BEGIN NOTHING-----") == null, true);

    // ---- 3. hostname matching, RFC 6125 ------------------------------------
    //
    // Every one of these is a rule someone has got wrong in a shipped TLS
    // client, which is why they are asserted individually rather than as one
    // "the certificate is valid".
    checkBool("exact SAN match", cert_matches_host(leaf, "localhost"), true);
    checkBool("second SAN matches", cert_matches_host(leaf, "db.example.com"), true);
    checkBool("IP SAN matches", cert_matches_host(leaf, "127.0.0.1"), true);
    checkBool("wrong host rejected", cert_matches_host(leaf, "evil.example.com"), false);
    checkBool("wrong IP rejected", cert_matches_host(leaf, "10.0.0.1"), false);

    // The CN is consulted ONLY when there is no SAN at all. leaf.crt has a CN
    // of "localhost" and SANs, so a name in neither must still fail.
    checkBool("CN fallback with no SAN", cert_matches_host(cnOnly, "cn.example.com"), true);
    checkBool("CN ignored when a SAN exists",
              cert_matches_host(leaf, "localhost.localdomain"), false);

    // A wildcard covers exactly one label: not zero, not two, and never the
    // registrable part of the name.
    checkBool("wildcard matches one label", cert_matches_host(wild, "a.example.com"), true);
    checkBool("wildcard does not match two", cert_matches_host(wild, "a.b.example.com"), false);
    checkBool("wildcard does not match bare", cert_matches_host(wild, "example.com"), false);
    checkBool("wildcard does not cross domains", cert_matches_host(wild, "a.evil.com"), false);
    checkBool("empty host rejected", cert_matches_host(leaf, ""), false);

    // ---- 4. chain verification ---------------------------------------------

    let noInter: Cert[] = [];
    let roots: Cert[] = [root];
    let wrongRoots: Cert[] = [other];
    let noRoots: Cert[] = [];

    let ok = cert_verify_chain(leaf, noInter, roots);
    checkBool("leaf verifies against its root", ok.ok, true);

    let bad = cert_verify_chain(leaf, noInter, wrongRoots);
    checkBool("leaf fails against another root", bad.ok, false);
    check("  and says why", bad.err, "unable to get local issuer certificate");

    let none = cert_verify_chain(leaf, noInter, noRoots);
    checkBool("an empty trust store verifies nothing", none.ok, false);

    let old = cert_verify_chain(expired, noInter, roots);
    checkBool("an expired certificate fails", old.ok, false);
    check("  and says why", old.err, "certificate has expired");

    // ---- 5. a real handshake ------------------------------------------------

    liveHandshake(root);
}

// Read from a non-blocking TlsConn until something arrives. Bounded, so a
// failure is a printed diagnostic rather than a test suite that hangs.
fn pumpRead(c: TlsConn, max: int): string {
    let spins = 0;
    while (spins < 100000) {
        let r = c.read(max);
        if (r.ok) { return str(r.data as cstring); }
        if (r.err != "the read would block") { return "READ FAILED: " + r.err; }
        spins += 1;
    }
    return "READ TIMED OUT";
}

fn pumpWrite(c: TlsConn, data: byte[]): bool {
    let spins = 0;
    while (spins < 100000) {
        let r = c.write(data);
        if (r.ok) { return true; }
        if (r.err != "the write would block") { print("        write failed: " + r.err); return false; }
        spins += 1;
    }
    return false;
}

// One throwaway connection to the same server, driven to a verdict.
//
// Both ends are pumped: a client alone would sit in want-read forever waiting
// for a ServerHello nobody is sending. The SERVER's verdict is discarded — what
// is under test is whether the client accepts what it was shown, and a client
// that rejects makes the server fail too.
fn handshakeSucceeds(cctx: TlsContext, ln: Socket, port: int,
                     host: string, sctx: TlsContext): bool {
    if (cctx == null || !cctx.ok()) { return false; }

    let cs = socket_connect("127.0.0.1", port);
    if (cs == null) { return false; }
    let ss: Socket = null;
    let tries = 0;
    while (ss == null && tries < 100000) { ss = ln.tryAccept(); tries += 1; }
    if (ss == null) { cs.close(); return false; }

    cs.setNonBlocking(true);
    ss.setNonBlocking(true);

    let c = tls_connect(cctx, cs.fd as int, host);
    let sv = tls_accept(sctx, ss.fd as int);
    if (c == null || sv == null) { cs.close(); ss.close(); return false; }

    let cdone = false;
    let cfail = false;
    let sdone = false;
    let spins = 0;
    while (!cdone && !cfail && spins < 100000) {
        let r = c.handshakeStep();
        if (r == 1) { cdone = true; }
        else if (r != OSSL_WANT_READ && r != OSSL_WANT_WRITE) { cfail = true; }
        if (!sdone) {
            let sr = sv.handshakeStep();
            // A server failure here is expected whenever the client rejects,
            // so it only stops the server being stepped again.
            if (sr != OSSL_WANT_READ && sr != OSSL_WANT_WRITE) { sdone = true; }
        }
        spins += 1;
    }

    c.close();
    sv.close();
    cs.close();
    ss.close();
    return cdone;
}

fn liveHandshake(root: Cert) {
    // A listener on an ephemeral loopback port, and a client connected to it.
    // Both ends go non-blocking before any TLS exists, which is the state a
    // real driver's socket is already in (wire/io.vt puts it there).
    let ln = socket_listen_on("127.0.0.1", 0, 1);
    if (ln == null) { print("FAIL  could not listen on loopback"); return; }
    let port = ln.localPort();
    ln.setNonBlocking(true);

    let cs = socket_connect("127.0.0.1", port);
    if (cs == null) { print("FAIL  could not connect to loopback"); return; }

    let ss: Socket = null;
    let tries = 0;
    while (ss == null && tries < 100000) { ss = ln.tryAccept(); tries += 1; }
    if (ss == null) { print("FAIL  the listener never accepted"); return; }

    cs.setNonBlocking(true);
    ss.setNonBlocking(true);

    // The server presents leaf.crt; the client trusts root.crt IN ADDITION to
    // the system store and verifies the hostname, so this is the full
    // tls_client() path rather than a weakened one.
    let sctx = tls_server(readfile(DIR + "leaf.crt"), readfile(DIR + "leaf.key"));
    if (!sctx.ok()) { print("FAIL  server context: " + sctx.err); return; }
    checkBool("server ALPN configured", sctx.setAlpn(["vyto-test", "h2"]), true);

    let cctx = tls_client();
    if (!cctx.ok()) { print("FAIL  client context: " + cctx.err); return; }
    checkBool("client trusts the test root", cctx.trustFile(DIR + "root.crt"), true);
    checkBool("client ALPN configured", cctx.setAlpn(["h2", "vyto-test"]), true);
    checkBool("min version raised", cctx.setMinVersion("TLS1.3"), true);

    let c = tls_connect(cctx, cs.fd as int, "localhost");
    let s = tls_accept(sctx, ss.fd as int);
    if (c == null || s == null) { print("FAIL  could not create the TLS connections"); return; }

    // The pump. Each side is stepped until it reports 1; a step that wants the
    // socket makes progress on the next pass because the other side is being
    // stepped too. Bounded so a broken handshake fails the test instead of
    // spinning forever.
    let cdone = false;
    let sdone = false;
    let spins = 0;
    while ((!cdone || !sdone) && spins < 100000) {
        if (!cdone) {
            let r = c.handshakeStep();
            if (r == 1) { cdone = true; }
            else if (r == 0) { print("FAIL  client handshake: " + c.lastError()); return; }
        }
        if (!sdone) {
            let r = s.handshakeStep();
            if (r == 1) { sdone = true; }
            else if (r == 0) { print("FAIL  server handshake: " + s.lastError()); return; }
        }
        spins += 1;
    }
    checkBool("handshake completed", cdone && sdone, true);

    // TLS 1.3 because the client demanded it above, and the negotiated ALPN is
    // the SERVER's preference out of what the client offered — the client
    // listed h2 first and still gets vyto-test.
    check("negotiated protocol", c.protocolVersion(), "TLSv1.3");
    check("client ALPN", c.alpnSelected(), "vyto-test");
    check("server ALPN", s.alpnSelected(), "vyto-test");

    // The certificate the client actually saw, verified independently of the
    // handshake's own check.
    let peer = c.peerCert();
    if (peer == null) { print("FAIL  no peer certificate"); return; }
    check("peer subject", peer.subject, "CN=localhost");
    let roots: Cert[] = [root];
    let noInter: Cert[] = [];
    checkBool("peer chains to the test root", cert_verify_chain(peer, noInter, roots).ok, true);
    checkBool("peer matches the hostname", cert_matches_host(peer, "localhost"), true);

    // A server presents a certificate; a client here does not, so the server
    // sees nothing. Asserted so that changing to mutual TLS cannot pass silently.
    checkBool("server sees no client certificate", s.peerCert() == null, true);

    // Channel binding material — the input SCRAM-SHA-256-PLUS needs. It must be
    // the hash of the certificate the peer actually presented.
    let cb = c.channelBinding("tls-server-end-point");
    checkBool("channel binding available", cb.ok, true);
    check("channel binding is the peer certificate's hash",
          hex_encode(cb.data), hex_encode(peer.fingerprint()));
    checkBool("other bindings refused", c.channelBinding("tls-unique").ok, false);

    // ---- the three verification levels actually differ ---------------------
    //
    // Asserted by connecting three more times to the same server with the same
    // certificate. If these three all behaved alike, every DSN in vyto/db that
    // says verify-full would be getting `require`, and nothing else in the
    // suite would notice.
    checkBool("tls_client() rejects an untrusted root",
              handshakeSucceeds(tls_client(), ln, port, "localhost", sctx), false);
    checkBool("verify_chain_only also rejects it",
              handshakeSucceeds(tls_client_verify_chain_only(), ln, port, "localhost", sctx), false);
    checkBool("insecure_no_verification accepts it",
              handshakeSucceeds(tls_client_insecure_no_verification(), ln, port, "localhost", sctx),
              true);

    // And the difference between the two verifying levels: a chain that is fine
    // under a name the certificate does not claim. leaf.crt names localhost and
    // 127.0.0.1 but not "wrong.example.com".
    let trusting = tls_client();
    trusting.trustFile(DIR + "root.crt");
    checkBool("verify-full rejects the wrong hostname",
              handshakeSucceeds(trusting, ln, port, "wrong.example.com", sctx), false);
    let chainOnly = tls_client_verify_chain_only();
    chainOnly.trustFile(DIR + "root.crt");
    checkBool("verify-ca accepts the same connection",
              handshakeSucceeds(chainOnly, ln, port, "wrong.example.com", sctx), true);

    // ---- application data, both directions ---------------------------------

    if (pumpWrite(c, strBytes("select 1"))) {
        check("server received", pumpRead(s, 64), "select 1");
    }
    if (pumpWrite(s, strBytes("1 row"))) {
        check("client received", pumpRead(c, 64), "1 row");
    }

    // A clean close sends close_notify, which is what lets the other end tell a
    // finished conversation from a truncated one. Reading after it must report
    // the close rather than an error.
    c.close();
    let after = s.read(64);
    checkBool("read after close is not ok", after.ok, false);
    check("close is clean", after.err, "the peer closed the TLS connection");

    s.close();
    cs.close();
    ss.close();
    ln.close();
}
