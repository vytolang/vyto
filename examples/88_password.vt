// Storing passwords — Argon2id, and the mistakes around it.
//
// The threat is not someone guessing a password at your login form; rate
// limiting handles that. It is someone who already has your database and is
// guessing offline, on their own hardware, as fast as they can afford to. Every
// decision here is about making that second attack expensive.
//
// The rules, shortest form:
//
//   never store the password             store a hash
//   never store an unsalted hash          one fresh random salt per user
//   never use a fast hash                 SHA-256 is fast; that is the problem
//   never use ==                          compare with ct_equal
//   never leak whether the user exists    do the same work either way
//   store the parameters with the hash    or you can never raise them
//
// The last one is the one people forget, and it is why the encoded format
// below carries m, t and p. A hash you cannot identify the cost of is a hash
// you can never upgrade.

import { sha256, hex_encode, strBytes, ct_equal, sub_bytes, concat_bytes } from "vyto/crypto";
import { argon2id } from "vyto/crypto/argon2";
import { base64_encode, base64_decode } from "vyto/util/mime";
import { rand_bytes } from "vyto/util/uuid";
import { StringBuilder } from "vyto/util/text";

// Cost parameters. RFC 9106 §4 recommends t=1/m=2GiB or t=3/m=64MiB; in this
// tree t=3/m=64MiB measures at ~360 ms and m=256MiB at ~1.5 s. Deliberately
// small here so the test suite stays fast — do not copy these numbers into a
// real service. Pick them by measuring on your slowest machine, and raise
// memory before iterations.
const ARGON_TIME: int = 1;
const ARGON_MEMORY_KIB: int = 2048;     // 2 MiB — far too low for production
const ARGON_LANES: int = 1;
const ARGON_TAGLEN: int = 32;
const SALT_LEN: int = 16;

// ---- the encoded hash -------------------------------------------------------

// PHC string format, the same shape argon2 and libsodium emit:
//
//   $argon2id$v=19$m=<KiB>,t=<passes>,p=<lanes>$<b64 salt>$<b64 hash>
//
// Self-describing on purpose. The salt travels with the hash because it is not
// a secret — its job is to make one stolen database require one attack per
// user rather than one attack total. The parameters travel with it because
// otherwise raising them later would invalidate every stored hash at once.
fn encodeHash(salt: byte[], hash: byte[], m: int, t: int, p: int): string {
    let sb = new StringBuilder(128);
    sb.append("$argon2id$v=19$m=").appendInt(m);
    sb.append(",t=").appendInt(t);
    sb.append(",p=").appendInt(p);
    sb.append("$").append(b64NoPad(salt));
    sb.append("$").append(b64NoPad(hash));
    return sb.toString();
}

// PHC strips base64 padding.
fn b64NoPad(b: byte[]): string {
    let s = base64_encode(b);
    let end = s.len;
    while (end > 0 && s[end - 1] == 61) { end -= 1; }   // '='
    let sb = new StringBuilder(end + 1);
    let i = 0;
    while (i < end) { sb.appendByte(s[i]); i += 1; }
    return sb.toString();
}

// A parsed PHC string. `ok` false means the stored value was not something this
// code produced — treat that as a failed login, never as a match.
class StoredHash {
    ok: bool;
    m: int;
    t: int;
    p: int;
    salt: byte[];
    hash: byte[];

    fn init() {
        this.ok = false;
        this.m = 0; this.t = 0; this.p = 0;
    }
}

fn splitOn(s: string, sep: int): string[] {
    let out: string[] = [];
    let sb = new StringBuilder(32);
    let i = 0;
    while (i < s.len) {
        if (s[i] == sep) {
            out.push(sb.toString());
            sb.clear();
        } else {
            sb.appendByte(s[i]);
        }
        i += 1;
    }
    out.push(sb.toString());
    return out;
}

fn parseIntAfter(field: string, prefix: string): int {
    if (field.len <= prefix.len) { return -1; }
    let v = 0;
    let i = prefix.len;
    while (i < field.len) {
        let c = field[i];
        if (c < 48 || c > 57) { return -1; }
        v = v * 10 + (c - 48);
        i += 1;
    }
    return v;
}

fn decodeHash(encoded: string): StoredHash {
    let sh = new StoredHash();
    // "" / "argon2id" / "v=19" / "m=…,t=…,p=…" / salt / hash
    let parts = splitOn(encoded, 36);       // '$'
    if (parts.len != 6) { return sh; }
    if (parts[1] != "argon2id") { return sh; }
    if (parts[2] != "v=19") { return sh; }

    let costs = splitOn(parts[3], 44);      // ','
    if (costs.len != 3) { return sh; }
    sh.m = parseIntAfter(costs[0], "m=");
    sh.t = parseIntAfter(costs[1], "t=");
    sh.p = parseIntAfter(costs[2], "p=");
    if (sh.m <= 0 || sh.t <= 0 || sh.p <= 0) { return sh; }

    sh.salt = base64_decode(parts[4]);
    sh.hash = base64_decode(parts[5]);
    if (sh.salt.len == 0 || sh.hash.len == 0) { return sh; }
    sh.ok = true;
    return sh;
}

// ---- register and verify ----------------------------------------------------

// Hash a new password. One fresh salt per call, so two users who pick the same
// password get different hashes and an attacker cannot see that they matched.
fn hashPassword(password: string): string {
    let salt = rand_bytes(SALT_LEN);
    let h = argon2id(strBytes(password), salt, ARGON_TIME, ARGON_MEMORY_KIB, ARGON_LANES, ARGON_TAGLEN);
    return encodeHash(salt, h, ARGON_MEMORY_KIB, ARGON_TIME, ARGON_LANES);
}

// Check a password against a stored hash, using the parameters recorded IN that
// hash rather than today's constants — that is what lets old hashes keep
// working after the cost is raised.
fn verifyPassword(password: string, encoded: string): bool {
    let sh = decodeHash(encoded);
    if (!sh.ok) { return false; }
    let computed = argon2id(strBytes(password), sh.salt, sh.t, sh.m, sh.p, sh.hash.len);
    // ct_equal, not ==. A comparison that returns early on the first differing
    // byte tells an attacker how many leading bytes they have right, which
    // turns guessing a 32-byte value into guessing 32 one-byte values.
    return ct_equal(computed, sh.hash);
}

// True when a stored hash was made with weaker parameters than today's. Call it
// on every successful login: you have the plaintext password in hand at exactly
// that moment and nowhere else, so it is the only chance to re-hash without
// asking the user to do anything.
fn needsRehash(encoded: string): bool {
    let sh = decodeHash(encoded);
    if (!sh.ok) { return true; }
    return sh.m < ARGON_MEMORY_KIB || sh.t < ARGON_TIME || sh.p != ARGON_LANES;
}

fn main() {
    print("---- registration ----");
    // Fixed salt so this file's output is reproducible. Real code uses
    // rand_bytes, as hashPassword() above does.
    let salt = strBytes("0123456789abcdef");
    let stored = encodeHash(salt,
                            argon2id(strBytes("correct horse battery staple"), salt,
                                     ARGON_TIME, ARGON_MEMORY_KIB, ARGON_LANES, ARGON_TAGLEN),
                            ARGON_MEMORY_KIB, ARGON_TIME, ARGON_LANES);
    print("stored: " + stored);
    print("");
    print("everything needed to check a password is in that string, and none of");
    print("it is a secret — the salt and costs are public by design");

    print("");
    print("---- logging in ----");
    print("correct password      " + str(verifyPassword("correct horse battery staple", stored)) + " (want true)");
    print("wrong password        " + str(verifyPassword("correct horse battery stapl", stored)) + " (want false)");
    print("empty password        " + str(verifyPassword("", stored)) + " (want false)");
    print("case matters          " + str(verifyPassword("Correct horse battery staple", stored)) + " (want false)");

    print("");
    print("---- a tampered database row ----");
    // An attacker with write access to the database tries to weaken the record.
    let weakened = encodeHash(salt, sub_bytes(base64_decode(splitOn(stored, 36)[5]), 0, 32), 8, 1, 1);
    print("costs lowered to m=8  " + str(verifyPassword("correct horse battery staple", weakened)) + " (want false)");
    print("truncated encoding    " + str(verifyPassword("correct horse battery staple", "$argon2id$v=19$m=8192")) + " (want false)");
    print("empty stored value    " + str(verifyPassword("correct horse battery staple", "")) + " (want false)");
    print("bcrypt hash pasted in " + str(verifyPassword("correct horse battery staple", "$2y$10$abcdefghijklmnopqrstuv")) + " (want false)");
    print("");
    print("lowering the costs does not help an attacker: the parameters are");
    print("inputs to the hash, so changing them changes what the hash must be");

    print("");
    print("---- two users, one password ----");
    let saltA = strBytes("aaaaaaaaaaaaaaaa");
    let saltB = strBytes("bbbbbbbbbbbbbbbb");
    let hA = argon2id(strBytes("hunter2"), saltA, ARGON_TIME, ARGON_MEMORY_KIB, ARGON_LANES, ARGON_TAGLEN);
    let hB = argon2id(strBytes("hunter2"), saltB, ARGON_TIME, ARGON_MEMORY_KIB, ARGON_LANES, ARGON_TAGLEN);
    print("user A  " + hex_encode(sub_bytes(hA, 0, 16)) + "…");
    print("user B  " + hex_encode(sub_bytes(hB, 0, 16)) + "…");
    print("identical passwords, unrelated hashes: " + str(!ct_equal(hA, hB)) + " (want true)");
    print("");
    print("without per-user salts these two rows would be identical, and one");
    print("cracked password would unlock every account that shared it");

    print("");
    print("---- upgrading the cost later ----");
    let old = encodeHash(salt, argon2id(strBytes("hunter2"), salt, 1, 512, 1, 32), 512, 1, 1);
    print("old hash            " + old);
    print("still verifies      " + str(verifyPassword("hunter2", old)) + " (want true)");
    print("flagged for rehash  " + str(needsRehash(old)) + " (want true)");
    print("current is fine     " + str(needsRehash(stored)) + " (want false)");
    print("");
    print("on a successful login you hold the plaintext for the only moment you");
    print("ever will — re-hash there, or the upgrade never reaches existing users");

    print("");
    print("---- do not do this ----");
    // Shown so the output makes the difference concrete, not as a suggestion.
    let naive = sha256(strBytes("correct horse battery staple"));
    print("sha256 unsalted     " + hex_encode(sub_bytes(naive, 0, 16)) + "…");
    print("");
    print("that value is identical for every user with this password, on every");
    print("site that made the same mistake, and it is precomputed in rainbow");
    print("tables you can download. it is also fast: a GPU tries billions per");
    print("second, where Argon2id at 64 MiB is bounded by memory it must find");
    print("for each guess in parallel");

    print("");
    print("---- not leaking which usernames exist ----");
    // A login for an unknown user must cost the same as one for a known user.
    // Returning early makes the response measurably faster and hands an
    // attacker a list of valid accounts.
    let dummy = encodeHash(strBytes("dummydummydummy!"),
                           argon2id(strBytes("*"), strBytes("dummydummydummy!"),
                                    ARGON_TIME, ARGON_MEMORY_KIB, ARGON_LANES, ARGON_TAGLEN),
                           ARGON_MEMORY_KIB, ARGON_TIME, ARGON_LANES);
    print("known user, bad password   " + str(login("johndoe", "wrong", stored, dummy)) + " (want false)");
    print("unknown user               " + str(login("nobody", "wrong", "", dummy)) + " (want false)");
    print("");
    print("both paths run one full Argon2id, so the two answers take the same");
    print("time and the response cannot be used to enumerate accounts");
}

// `storedForUser` is empty when the user does not exist. The dummy hash exists
// so that case still does the work.
fn login(user: string, password: string, storedForUser: string, dummy: string): bool {
    if (storedForUser.len == 0) {
        verifyPassword(password, dummy);    // result discarded, cost paid
        return false;
    }
    return verifyPassword(password, storedForUser);
}
