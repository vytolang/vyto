// WiFi scan/connect — vyto/net/wifi over the wpa_supplicant control socket. The
// control plane (managing the radio), distinct from the data path in net/socket
// (docs/HARDWARE.md). This is the onboarding flow: scan, pick, connect.
//
//   vytoc run examples/67_wifi.vt                      # canned scan (no hardware)
//   vytoc run examples/67_wifi.vt -- scan wlan0        # live scan (needs wpa_supplicant)
//   vytoc run examples/67_wifi.vt -- monitor wlan0     # watch events as they happen
//   vytoc run examples/67_wifi.vt -- --help
//
// Argument handling is vyto/cli. The interface used to be a bare operand and
// "monitor" a magic first word, which meant `monitor` alone was silently read as
// an interface name; both are subcommands now. A subcommand is optional unless
// declared otherwise, so a bare run still reaches the canned demo below.
//
// (Live output varies and the canned path needs no device, so no golden .expected —
// the runner SKIPs it.)

import { PollSet, POLL_READ } from "vyto/net/socket";
import { wifi_open, wifi_monitor, parse_scan_results, parse_wifi_event, WifiNetwork } from "vyto/net/wifi";
import { Cli } from "vyto/cli";
import { exit } from "vyto/os";

fn show(nets: WifiNetwork[]) {
    for (let n in nets) {
        let sec = "open";
        if (n.isSecured()) { sec = "secured"; }
        let name = n.ssid;
        if (name == "") { name = "<hidden>"; }
        print("  " + n.signal + "dBm  " + n.freq + "MHz  " + sec + "  " + name + "  (" + n.bssid + ")");
    }
}

fn main() {
    let cli = new Cli("67_wifi", "scan and watch wireless interfaces");
    cli.command("scan", "one-shot scan of visible networks")
       .positional("iface", "interface to scan").need();
    cli.command("monitor", "watch connect/disconnect events live")
       .positional("iface", "interface to watch").need();
    if (!cli.parse(args())) { print(cli.report()); exit(cli.exitCode()); }

    // "monitor <iface>": watch for connect/disconnect events as they happen (push, not
    // poll) — the real answer to "how does my app know WiFi dropped".
    if (cli.chosen() == "monitor") {
        let iface = cli.sub().get("iface");
        let mon = wifi_monitor(iface);
        if (mon == null) { print("cannot attach monitor for " + iface); return; }
        print("watching " + iface + " for events (toggle WiFi to see them)...");
        let ps = new PollSet();
        ps.addFd(mon.pollFd(), POLL_READ);
        while (true) {
            if (ps.wait(-1) > 0) {
                let e = mon.next();
                if (e != null) {
                    let tag = "";
                    if (e.isDisconnect()) { tag = "  <-- DISCONNECTED"; }
                    if (e.isConnect()) { tag = "  <-- CONNECTED"; }
                    print("  " + e.name + tag);
                }
            }
        }
    }

    if (cli.chosen() == "scan") {
        let iface = cli.sub().get("iface");
        let w = wifi_open(iface);
        if (w == null) { print("no wpa_supplicant control socket for " + iface + " (need the netdev group / root?)"); return; }
        print("scanning " + iface + " ...");
        w.scan();
        show(w.scanResults());
        return;
    }

    // No interface given: prove the parser on a canned SCAN_RESULTS block (the exact
    // tab-separated format wpa_supplicant returns).
    let canned = "bssid / frequency / signal level / flags / ssid\n"
        + "00:11:22:33:44:55\t2412\t-42\t[WPA2-PSK-CCMP][ESS]\tHomeNet\n"
        + "66:77:88:99:aa:bb\t5180\t-67\t[WPA3-SAE-CCMP][ESS]\tCafe 5G\n"
        + "cc:dd:ee:ff:00:11\t2437\t-71\t[ESS]\tOpenGuest";
    print("parsed scan (sample):");
    show(parse_scan_results(canned));

    // Event parser check (the push-event format wpa_supplicant sends):
    let ev = parse_wifi_event("<3>CTRL-EVENT-DISCONNECTED bssid=00:11:22:33:44:55 reason=3");
    print("parsed event: " + ev.name + "  disconnect=" + ev.isDisconnect());
    print("(run with '-- monitor <iface>' to watch live connect/disconnect events)");
}
