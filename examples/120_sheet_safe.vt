// vyto/util/csv csv_sheet_safe: a cell a spreadsheet would run as a formula
// gets a leading apostrophe; text and plain numbers are left alone.
import { csv_sheet_safe, csv_write } from "vyto/util/csv";

fn show(v: string) { print("[" + v + "] -> [" + csv_sheet_safe(v) + "]"); }

fn main() {
    // formula starts
    show("=HYPERLINK(\"http://x\",\"Click\")");
    show("=1+1");
    show("+cmd|' /C calc'!A0");
    show("-2+3");
    show("@SUM(A1:A2)");
    show("\tTAB");
    show("- dash note");
    show("+");
    show("-");
    // plain numbers and ordinary text: unchanged
    show("-12.50");
    show("+254712345678");
    show("-1,234.50");
    show("1,234.50");
    show("Wanjiru = manager");
    show("");
    // through the writer, a formula cell is quoted only where CSV needs it
    print(csv_write([[csv_sheet_safe("=1+1"), csv_sheet_safe("-5")]]).trim());
}
