--- pull reader ---
  <rss> version=2.0
    <channel>
      <title>
      text: Vyto News
      <item>
        <title>
      text: First post
        <guid> isPermaLink=false
      text: a1
      <item>
        <title>
      text: Second post
        <guid> isPermaLink=false
      text: a2

--- DOM ---
root         = rss version=2.0
channel title= Vyto News
items        = 2
  a1: First post
  a2: Second post
every title  = 3
a miss       = []
attrOr       = (unset)

--- namespaces ---
feed  local=feed  prefix=[]  uri=http://www.w3.org/2005/Atom
entry  local=entry  prefix=[]  uri=http://www.w3.org/2005/Atom
title  local=title  prefix=[]  uri=http://www.w3.org/2005/Atom
dc:creator  local=creator  prefix=[dc]  uri=http://purl.org/dc/elements/1.1/
creator      = Ada

--- entities ---
decoded      = 5 < 6 && AB <raw> & unescaped
unescape     = <tag> é
unknown      = caf&eacute;

--- writing ---
built        = <note id="42" tag="a &amp; b">5 &lt; 6<br/></note>
empty        = <hr/>
escape       = a&lt;b&gt;&amp;c
escape attr  = say &quot;hi&quot;
round trip   = <a x="1"><b/>text</a>

--- errors ---
mismatched   = </a> closes <b> at line 1
unquoted     = attribute 'x' value is not quoted at line 1
unclosed     = unclosed element <a> at line 1
salvaged     = a
