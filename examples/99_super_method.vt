// super.method(...) — an override calling the implementation it overrides.
//
// The call is non-virtual by construction: it names the base's function
// directly, so a base method that calls another virtual still dispatches to
// the override, while super.f() itself never lands back in the caller.

class Shape {
    name: string;

    fn init(name: string) {
        this.name = name;
    }

    virtual fn describe(): string {
        return "shape " + this.name;
    }

    virtual fn scaled(w: int, h: int): int {
        return w * h;
    }

    virtual fn greet() {
        print("hello from " + this.name);
    }

    virtual fn area(): int {
        return 0;
    }
}

// Extends the base string rather than rebuilding it.
class Box extends Shape {
    w: int;
    h: int;

    fn init(w: int, h: int) {
        super.init("box");
        this.w = w;
        this.h = h;
    }

    override fn describe(): string {
        return super.describe() + " " + str(this.w) + "x" + str(this.h);
    }

    // named arguments survive the super call
    override fn scaled(w: int, h: int): int {
        return super.scaled(h: h * 2, w: w) + 1;
    }

    override fn greet() {
        super.greet();
        print("  (a box)");
    }
}

class Cube extends Box {
    override fn describe(): string {
        return "cube: " + super.describe();
    }

    override fn greet() {
        print("cube first");
        super.greet();
    }

    // Box does not define area(), so this super call resolves past the middle
    // of the chain to Shape's implementation.
    override fn area(): int {
        return super.area() + this.w * this.h;
    }
}

fn main() {
    let s = new Shape("blob");
    print(s.describe());

    let b = new Box(3, 4);
    print(b.describe());
    print(b.scaled(2, 5));
    b.greet();

    let c = new Cube(2, 2);
    print(c.describe());
    c.greet();
    print(c.area());

    // through a base-typed reference: still the override, and the override's
    // super call still reaches exactly one level up from where it is written
    let shapes: Shape[] = [s, b, c];
    for (let sh in shapes) {
        print("- " + sh.describe());
    }
}
