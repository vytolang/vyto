// vyto/desktop/secret: a small secret kept in the app's own file, readable
// only by the user who saved it (DPAPI on Windows, mode 0600 elsewhere).
import { secret_save, secret_load, secret_found, secret_private, secret_remove, secret_encrypted } from "vyto/desktop/secret";
import { readfile, file_exists, file_remove, writefile } from "vyto/io/file";

fn main() {
    let p = "tests/tmp/117_secret.sec";
    if (file_exists(p)) { file_remove(p); }

    // nothing there yet
    let none = secret_load(p);
    print(`missing: [{none}] found={secret_found()}`);

    print(`saved: {secret_save(p, "consumer-secret-123")}`);
    // binary operands evaluate right to left: load first, then ask
    let got = secret_load(p);
    print("loaded: " + got + ` found={secret_found()}`);
    print(`private: {secret_private(p)}`);
    // where the file is not encrypted, it is at least only the owner's;
    // where it is (Windows), the plain text must not be in it
    print(`plain text in the file: {readfile(p).contains("consumer-secret-123") && secret_encrypted()}`);

    // replaced, not appended to
    secret_save(p, "second");
    print("replaced: " + secret_load(p));

    // an empty secret is a secret: found, and ""
    secret_save(p, "");
    let e = secret_load(p);
    print(`empty: [{e}] found={secret_found()}`);

    // a damaged or foreign file reads as nothing, never as garbage
    writefile(p, "not a secret file");
    let d = secret_load(p);
    print(`damaged: [{d}] found={secret_found()}`);

    print(`removed: {secret_remove(p)} again: {secret_remove(p)}`);
    print(`no .tmp left behind: {!file_exists(p + ".tmp")}`);
}
