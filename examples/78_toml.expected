title       = Vyto service
debug       = false
workers     = 8
hosts       = 3 -> alpha, gamma
bind        = 0.0.0.0
port        = 8080
tls enabled = true
missing     = []
with default= 3
routes      = 2
  / -> static
  /api -> proxy

as JSON:
{"bind":"0.0.0.0","port":8080,"timeout":2.5,"tls":{"enabled":true,"cert":"/etc/ssl/app.pem"}}

underscores = 1000000
hex         = 3735928559
octal       = 493
binary      = 11
negative    = -17
basic       = a\tb\nc
literal     = C:\path\no\escapes
multi-line  = first\nsecond
line-folded = one two
unicode     = café
datetime    = 1979-05-27T07:32:00Z
date        = 1979-05-27
time        = 07:32:00

dotted      = {"a":{"b":{"c":1,"d":2}}}
inline      = {"point":{"x":1,"y":2}}

duplicate   = duplicate key 'a' at line 2
bad number  = invalid value '01' at line 1
unterminated= unterminated string at line 1
junk after  = unexpected text after value at line 1

re-encoded:
title = "Vyto service"
debug = false
workers = 8
hosts = ["alpha", "beta", "gamma"]

[server]
bind = "0.0.0.0"
port = 8080
timeout = 2.5

[server.tls]
enabled = true
cert = "/etc/ssl/app.pem"

[[route]]
path = "/"
kind = "static"

[[route]]
path = "/api"
kind = "proxy"

round trip stable = true
